;; Affine I64 SUM / AVG shapes of issue 1463, 10M rows.  Each line:
;; <shape> <median ms of R calls after two warm ones> <answer>
(set n 10000000)
(set v (% (* (til n) 7919) 1000003))
(set T (table [v k w t u] (list v (% (til n) 1000) (% (til n) 10) (+ 1700000000000000000 (til n)) (% (til n) 1000))))
(set R 31)
(set B (fn [name q] (do (q) (q) (println (format "% % %" name (med (map (fn [i] (timeit (q))) (til R))) (q))))))
(set S (fn [r] (first (at r 's))))
(B "sum(v*2)" (fn [] (S (select {s: (sum (* v 2)) from: T}))))
(B "sum(v+1)" (fn [] (S (select {s: (sum (+ v 1)) from: T}))))
(B "sum(v-1)" (fn [] (S (select {s: (sum (- v 1)) from: T}))))
(B "sum(3v+7)" (fn [] (S (select {s: (sum (+ (* v 3) 7)) from: T}))))
(B "sum(t+1)" (fn [] (S (select {s: (sum (+ t 1)) from: T}))))
(B "sum(u*1e6)" (fn [] (S (select {s: (sum (* u 1000000)) from: T}))))
(B "sum(v+MAX)" (fn [] (S (select {s: (sum (+ v 9223372036854775807)) from: T}))))
(B "avg(v+7)" (fn [] (S (select {s: (avg (+ v 7)) from: T}))))
(B "avg(t+1)" (fn [] (S (select {s: (avg (+ t 1)) from: T}))))
(B "avg(u*50000)" (fn [] (S (select {s: (avg (* u 50000)) from: T}))))
(B "avg(u*70000)" (fn [] (S (select {s: (avg (* u 70000)) from: T}))))
(B "avg(u*1e6)" (fn [] (S (select {s: (avg (* u 1000000)) from: T}))))
(B "avg(u*1e6+5)" (fn [] (S (select {s: (avg (+ (* u 1000000) 5)) from: T}))))
(B "avg(u*1e8+1e15)" (fn [] (S (select {s: (avg (+ (* u 100000000) 1000000000000000)) from: T}))))
(B "sum(v)" (fn [] (S (select {s: (sum v) from: T}))))
(B "sum(v+1),count" (fn [] (S (select {s: (sum (+ v 1)) c: (count v) from: T}))))
(B "sum(v+1),avg(v+1)" (fn [] (S (select {s: (sum (+ v 1)) a: (avg (+ v 1)) from: T}))))
(B "by(k%2):sum(v+1)" (fn [] (S (select {s: (sum (+ v 1)) by: (% k 2) from: T}))))
(B "by(k):sum(v+1)" (fn [] (S (select {s: (sum (+ v 1)) by: k from: T}))))
(B "by(k):avg(v+7)" (fn [] (S (select {s: (avg (+ v 7)) by: k from: T}))))
(B "where(w<5):sum(v+1)" (fn [] (S (select {s: (sum (+ v 1)) where: (< w 5) from: T}))))
(B "where(w<5):avg(v+7)" (fn [] (S (select {s: (avg (+ v 7)) where: (< w 5) from: T}))))
(B "where(k<500):sum(v*2)" (fn [] (S (select {s: (sum (* v 2)) where: (< k 500) from: T}))))
(B "eager:sum(v+1)" (fn [] (sum (+ v 1))))
(B "eager:sum(3v+7)" (fn [] (sum (+ (* v 3) 7))))
(exit 0)
