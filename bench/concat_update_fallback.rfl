(set n 2000000)
(set i (til n))
(set T (table [x k s] (list i (% i 1000000) (take ['ab 'cd] n))))
(set sfx (fn [v] (concat v "!")))
(println "no-concat")
(map (fn [_] (println (timeit (update {n: (+ (count s) (count (distinct x))) by: k from: T})))) (til 4))
(println "computed-text")
(map (fn [_] (println (timeit (update {n: (+ (count (concat (upper s) "!")) (count (distinct x))) by: k from: T})))) (til 4))
(println "helper")
(map (fn [_] (println (timeit (update {n: (+ (count (sfx s)) (count (distinct x))) by: k from: T})))) (til 4))
(exit 0)
