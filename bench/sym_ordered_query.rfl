;; Regression benchmark for #738 / PR #743. Run a release build with:
;; ./rayforce -c 8 bench/sym_ordered_query.rfl
;; Timings are milliseconds; the first of five runs warms each query.
;; Vocabulary padding is outside the timed regions. Peak memory exceeds 1 GiB.

(set Tiny (table [s] (list (as 'SYM ["zz" "mm" "" "aa" "mm"]))))
(println "tiny-small-vocabulary")
(map (fn [_] (println (timeit (select {from: Tiny where: (< s 'mm)})))) (til 5))
(set pad (as 'SYM (as 'STR (+ 10000000 (til 1000000)))))
(set pad null)
(println "tiny-1m-vocabulary")
(map (fn [_] (println (timeit (select {from: Tiny where: (< s 'mm)})))) (til 5))
(set vocabulary (as 'SYM (as 'STR (til 1000))))
(set ids (% (til 20000000) 1000))
(set T (table [a b n] (list (at vocabulary ids) (at vocabulary (% (+ ids 337) 1000)) ids)))
(println "column-column-20m-1m-vocabulary")
(map (fn [_] (println (timeit (select {v: (< a b) from: T})))) (til 5))
(println "literal-projection-20m-1m-vocabulary")
(map (fn [_] (println (timeit (select {v: (< a "500") from: T})))) (til 5))
(println "count-20m-1m-vocabulary")
(map (fn [_] (println (timeit (count (select {from: T where: (< a "500")}))))) (til 5))
(println "group-20m-1m-vocabulary")
(map (fn [_] (println (timeit (select {v: (count a) from: T where: (< a "500") by: n})))) (til 5))
(set T null)
(set ids null)
(set B (table [s] (list (as 'SYM (at ["zz" "mm" "" "aa" "mm"] (% (til 2000000) 5))))))
(println "literal-2m-1m-vocabulary")
(map (fn [_] (println (timeit (select {v: (< s 'mm) from: B})))) (til 5))
(set pad (as 'SYM (as 'STR (+ 11000000 (til 3000000)))))
(set pad null)
(println "tiny-4m-vocabulary")
(map (fn [_] (println (timeit (select {from: Tiny where: (< s 'mm)})))) (til 5))
(set pad (as 'SYM (as 'STR (+ 14000000 (til 300000)))))
(set pad null)
(println "literal-2m-above-cutoff")
(map (fn [_] (println (timeit (select {v: (< s 'mm) from: B})))) (til 5))
;; Warm metric keys and query syntax before measuring literal pollution.
(set LL "warmup")
(set literal_probe (fn [i] (do (set LL (format "unseen-743-%" i)) (count (select {from: Tiny where: (< s LL)})))))
(set probes (til 10000))
(literal_probe -1)
(.sys.mem)
(set before (at (.sys.mem) 'sym-count))
(map literal_probe probes)
(println "runtime-symbol-growth-for-10000-string-literals")
(println (- (at (.sys.mem) 'sym-count) before))
(exit 0)
