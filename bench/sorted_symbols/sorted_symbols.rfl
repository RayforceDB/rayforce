;; One first xasc per process; set numeric to 1 for the integer control.
(set n 2630400)
(set numeric 0)
(set ids (til n))
(set syms (asc (as 'SYM (map (fn [i] (format "s%" i)) (til 100)))))
(set ts (as 'TIMESTAMP (div ids 100)))
(set secondary (if numeric (% ids 100) (take syms n)))
(set b (table [ts sym] (list ts secondary)))
(set elapsed_ms (timeit (set sorted (xasc b [ts sym]))))
(set valid (and (== (count sorted) n)
                (all (== (at sorted 'ts) ts))
                (all (== (at sorted 'sym) secondary))))
;; A small reversed control verifies that xasc is doing real sorting.
(set control (xasc (reverse (take b 6)) [ts sym]))
(set valid (and valid (all (== (at control 'ts) (take ts 6)))
                      (all (== (at control 'sym) (take secondary 6)))))
(if (not valid) (raise "symbol-sort: incorrect result"))
(println (format "BENCH|%|%|%" elapsed_ms (as 'I64 valid) (count sorted)))
(println (format "META|%" (.sys.build)))
