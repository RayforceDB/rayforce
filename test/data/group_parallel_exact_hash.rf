;; Direct LIST group above the parallel routing floor. A symbol prevents packing.
(set offsets (% (til 200000) 5000))
(set small (concat (as 'LIST offsets) (list 'tail)))
(set B 4611686018427387904)
(set wide (concat (as 'LIST (+ B offsets)) (list 'tail)))
(set g (group wide))
(set expected (concat (as 'LIST (+ B (til 5000))) (list 'tail)))
(set best (fn [f] (min (map (fn [i] (f)) (til 3)))))
(set ordered (and (identical (key g) expected) (identical (value g) (value (group small)))))
(set ms (best (fn [] (timeit (group small)))))
(set mw (best (fn [] (timeit (group wide)))))
;; Each shape independently exercises fallback with no wide integers or spans.
(set pad (as 'LIST (% (til 100000) 3)))
(set tail-pair (fn [pair] (last (value (group (concat pad pair))))))
(set atom-group (at (value (group (concat pad (list 2.0)))) 2))
(set floats (and (identical (last atom-group) 100000)
                 (and (identical (tail-pair (list (list 1 2) (list 1 2.0))) [100000 100001])
                      (identical (tail-pair (list (dict [a] (list 2)) (dict [a] (list 2.0)))) [100000 100001]))))
;; Wide integer and float dict values require first-seen serial grouping.
(set da (dict [k] (list 9007199254740993)))
(set db (dict [k] (list 9007199254740992)))
(set df (dict [k] (list 9007199254740992.0)))
(set dict-pairs (list (list da db df) (list da df db) (list db da df) (list db df da)))
(set ds (til 90000))
(set dfirst (filter ds (< (% ds 3) 2)))
(set dsecond (filter ds (== (% ds 3) 2)))
(set dalt-first (filter ds (!= (% ds 3) 1)))
(set dalt-second (filter ds (== (% ds 3) 1)))
(set dict-rows (fn [v] (value (group (at v (% ds 3))))))
(set dict-fallback (and (identical (dict-rows (at dict-pairs 0)) (list dalt-first dalt-second))
  (and (identical (dict-rows (at dict-pairs 1)) (list dfirst dsecond))
  (and (identical (dict-rows (at dict-pairs 2)) (list dalt-first dalt-second))
  (and (identical (dict-rows (at dict-pairs 3)) (list dfirst dsecond))
  (and (identical (dict-rows (list df da db)) (list ds))
       (identical (dict-rows (list df db da)) (list ds))))))))
;; An early float can stop the first pass before the wide integers or span.
(set n 70000)
(set pad (as 'LIST (% (til n) 3)))
(set ds (til n))
(set g0 (+ 1 (filter ds (== (% ds 3) 0))))
(set g1 (+ 1 (filter ds (== (% ds 3) 1))))
(set g2 (+ 1 (filter ds (== (% ds 3) 2))))
(set f 9007199254740992.0)
(set a 9007199254740993)
(set b 9007199254740992)
(set wide (value (group (concat (list f) (concat pad (list a b))))))
(set span (as 'TIMESPAN 2))
(set spans (value (group (concat (list 0.0) (concat pad (list span))))))
(set late-taint (all (list (identical wide (list [0 70001 70002] g0 g1 g2)) (identical spans (list (concat [0] g0) g1 (concat g2 [70001]))))))
(println (if (and late-taint (and dict-fallback (and floats (and ordered (< mw (* 8 (+ 1.0 ms))))))) "ok" (list ordered floats dict-fallback late-taint ms mw)))
