;; @requires: posix (temporary fixture cleanup)
;; Unequal partitions rule out median-of-partition-medians.
(.sys.exec "rm -rf /tmp/rfl_span_rank973") -- 0
(set A973 (table [g s] (list [0 1 0 2 3] (as 'TIMESPAN [0 2 100 0Nl -4]))))
(set B973 (table [g s] (list [0 1 2 3] (as 'TIMESPAN [1 4 0Nl -1]))))
(set ALL973 (concat A973 B973))
(set CHECK973 (fn [t] (list (type (at (select {m: (med s) from: t}) 'm)) (at (select {m: (med s) from: t}) 'm) (at (select {m: (med s) from: t by: g asc: g}) 'm) (nil? (at (select {m: (med s) from: t by: g asc: g}) 'm)) (at (select {m: (med s) from: t where: (== g 0)}) 'm))))
(CHECK973 ALL973) -- (list 'F64 [1.0] [1.0 3.0 0Nf -2.5] [false false true false] [1.0])
(.db.splayed.set "/tmp/rfl_span_rank973/plain" ALL973 {compress:false})
(set D973 (.db.splayed.get "/tmp/rfl_span_rank973/plain"))
(CHECK973 D973) -- (list 'F64 [1.0] [1.0 3.0 0Nf -2.5] [false false true false] [1.0])
(CHECK973 D973) -- (list 'F64 [1.0] [1.0 3.0 0Nf -2.5] [false false true false] [1.0])
(.db.splayed.set "/tmp/rfl_span_rank973/encoded" ALL973 {compress:true})
(set E973 (.db.splayed.get "/tmp/rfl_span_rank973/encoded"))
(CHECK973 E973) -- (list 'F64 [1.0] [1.0 3.0 0Nf -2.5] [false false true false] [1.0])
(CHECK973 E973) -- (list 'F64 [1.0] [1.0 3.0 0Nf -2.5] [false false true false] [1.0])
(.db.splayed.set "/tmp/rfl_span_rank973/p/2024.01.01/t" A973 {compress:false})
(.db.splayed.set "/tmp/rfl_span_rank973/p/2024.01.02/t" B973 {compress:true})
(set P973 (.db.parted.get "/tmp/rfl_span_rank973/p" 't))
(CHECK973 P973) -- (list 'F64 [1.0] [1.0 3.0 0Nf -2.5] [false false true false] [1.0])
(CHECK973 P973) -- (list 'F64 [1.0] [1.0 3.0 0Nf -2.5] [false false true false] [1.0])
(.sys.exec "rm -rf /tmp/rfl_span_rank973") -- 0
