;; Keyless aggregates (no by:) over enough rows for the pooled scalar
;; path: each worker keeps one accumulator block, merged at the end.  The
;; combined multi-aggregate form must agree with the single-aggregate
;; forms and with the plain vector reductions, for integer, float and
;; nullable inputs, with and without a where filter.
(set N 200000)
(set i (til N))
(set a (as 'I64 (% (* i 7919) 1000)))
(set f (as 'F64 (% (* i 31) 977)))
(set n (as 'I64 (map (fn [k] (if (== 0 (% k 13)) 0N (% k 500))) i)))
(set g (as 'F64 (map (fn [k] (if (== 0 (% k 17)) 0N (* 0.5 (% k 300)))) i)))
(set T (table [a f n g] (list a f n g)))
(set R (select {from: T s: (sum a) c: (count a) av: (avg f) mn: (min f) mx: (max a) sd: (stddev f) v: (var a) sn: (sum n) avn: (avg n) mnn: (min n) mxn: (max n) sg: (sum g) avg: (avg g) vg: (var g)}))
(count R) -- 1
(== (at (at R 's) 0) (sum a)) -- true
(== (at (at R 'c) 0) (count a)) -- true
(== (at (at R 'av) 0) (avg f)) -- true
(== (at (at R 'mn) 0) (min f)) -- true
(== (at (at R 'mx) 0) (max a)) -- true
(< (abs (- (at (at R 'sd) 0) (stddev f))) 1e-9) -- true
(< (abs (- (at (at R 'v) 0) (var a))) 1e-6) -- true
(== (at (at R 'sn) 0) (sum n)) -- true
(== (at (at R 'avn) 0) (avg n)) -- true
(== (at (at R 'mnn) 0) (min n)) -- true
(== (at (at R 'mxn) 0) (max n)) -- true
(== (at (at R 'sg) 0) (sum g)) -- true
(< (abs (- (at (at R 'avg) 0) (avg g))) 1e-9) -- true
(< (abs (- (at (at R 'vg) 0) (var g))) 1e-6) -- true
;; the single-aggregate forms take the specialised tight loops; they must
;; match the combined form
(== (at (at (select {from: T s: (sum a)}) 's) 0) (at (at R 's) 0)) -- true
(== (at (at (select {from: T av: (avg f)}) 'av) 0) (at (at R 'av) 0)) -- true
(== (at (at (select {from: T c: (count n)}) 'c) 0) (count n)) -- true
;; with a where filter (row selection through the same accumulators)
(set W (select {from: T s: (sum a) c: (count a) av: (avg f) mn: (min n) mx: (max g) sn: (sum n) where: (> a 500)}))
(set ORA (select {from: T a: a f: f n: n g: g where: (> a 500)}))
(== (at (at W 's) 0) (sum (at ORA 'a))) -- true
(== (at (at W 'c) 0) (count (at ORA 'a))) -- true
(== (at (at W 'av) 0) (avg (at ORA 'f))) -- true
(== (at (at W 'mn) 0) (min (at ORA 'n))) -- true
(== (at (at W 'mx) 0) (max (at ORA 'g))) -- true
(== (at (at W 'sn) 0) (sum (at ORA 'n))) -- true
;; many aggregates at once (the per-worker block scales with the count)
(set B (select {from: T a1: (sum a) a2: (sum f) a3: (sum n) a4: (sum g) a5: (min a) a6: (min f) a7: (max n) a8: (max g) a9: (avg a) a10: (avg f) a11: (count a) a12: (var f) a13: (stddev a)}))
(== (at (at B 'a1) 0) (sum a)) -- true
(== (at (at B 'a4) 0) (sum g)) -- true
(== (at (at B 'a7) 0) (max n)) -- true
(== (at (at B 'a10) 0) (avg f)) -- true
(< (abs (- (at (at B 'a13) 0) (stddev a))) 1e-9) -- true
;; float partials belong to fixed chunks of the rows, folded in chunk order,
;; not to whichever worker claimed the rows: sums whose partials overflow
;; (p) or cancel (c) give one answer on every call, here and in the vector
;; reductions
(set PB (table [p c] (list (take [1.7976931348623157e308 -1.7976931348623157e308 3.2] 131073) (take [1e16 1.0 -1e16] 131073))))
(set PBF (fn [] (ser (list (sum (at PB 'p)) (sum (at PB 'c)) (avg (at PB 'p)) (var (+ (at PB 'c) 0.0)) (select {from: PB s: (sum p)}) (select {from: PB s: (sum p) a: (avg p)}) (select {from: PB s: (sum c) v: (var c) mx: (max p)}) (select {from: PB s: (sum p) a: (avg c) where: (> c 0)})))))
(set PB0 (PBF))
(set PBN 0)
(times 8 (if (all (== PB0 (PBF))) (set PBN (+ PBN 1))))
PBN -- 8
;; several aggregates of null-free narrow and wide integers, read input by
;; input: each must equal its vector reduction, with no filter, under a
;; filter whose morsels are whole, empty and partial, and with PROD / FIRST
;; (row by row) beside them
(set NT (table [i x y z u t] (list i (as 'I32 (- (% (* i 37) 2001) 1000)) (as 'I16 (- (% (* i 13) 601) 300)) (- (* (% i 977) 1000000007) 500000000000) (as 'U8 (% (* i 11) 256)) (as 'TIMESTAMP (* (% (* i 7) 100003) 1000)))))
(set NR (select {from: NT c: (count i) sx: (sum x) ax: (avg x) mnx: (min x) mxx: (max x) sy: (sum y) mny: (min y) mxy: (max y) sz: (sum z) az: (avg z) mnz: (min z) mxz: (max z) su: (sum u) mxu: (max u) mnt: (min t) mxt: (max t) lin: (sum (+ (* 3 z) (- x 7)))}))
(set NV (list N (sum (at NT 'x)) (avg (at NT 'x)) (min (at NT 'x)) (max (at NT 'x)) (sum (at NT 'y)) (min (at NT 'y)) (max (at NT 'y)) (sum (at NT 'z)) (avg (at NT 'z)) (min (at NT 'z)) (max (at NT 'z)) (sum (at NT 'u)) (max (at NT 'u)) (min (at NT 't)) (max (at NT 't)) (sum (+ (* 3 (at NT 'z)) (- (at NT 'x) 7)))))
(== (map (fn [k] (at (at NR k) 0)) (key NR)) NV) -- (take [true] 17)
;; rows 0..2999 all pass (whole morsels, then a partial one), every 7th
;; row past them, and none of rows 100000..150000
(set NP (and (or (< i 3000) (== 0 (% i 7))) (or (< i 100000) (>= i 150000))))
(set NF (select {from: NT where: (and (or (< i 3000) (== 0 (% i 7))) (or (< i 100000) (>= i 150000))) c: (count i) sx: (sum x) ax: (avg x) mnx: (min x) mxx: (max x) sy: (sum y) mny: (min y) mxy: (max y) sz: (sum z) az: (avg z) mnz: (min z) mxz: (max z) su: (sum u) mxu: (max u) mnt: (min t) mxt: (max t) lin: (sum (+ (* 3 z) (- x 7)))}))
(set NS (select {from: NT where: NP}))
(set NFV (list (count (at NS 'i)) (sum (at NS 'x)) (avg (at NS 'x)) (min (at NS 'x)) (max (at NS 'x)) (sum (at NS 'y)) (min (at NS 'y)) (max (at NS 'y)) (sum (at NS 'z)) (avg (at NS 'z)) (min (at NS 'z)) (max (at NS 'z)) (sum (at NS 'u)) (max (at NS 'u)) (min (at NS 't)) (max (at NS 't)) (sum (+ (* 3 (at NS 'z)) (- (at NS 'x) 7)))))
(== (map (fn [k] (at (at NF k) 0)) (key NF)) NFV) -- (take [true] 17)
(set NQ (select {from: NT where: NP p: (prod u) fx: (first x) sx: (sum x) mxz: (max z)}))
(list (at (at NQ 'fx) 0) (== (at (at NQ 'sx) 0) (sum (at NS 'x))) (== (at (at NQ 'mxz) 0) (max (at NS 'z)))) -- (list (at (at NS 'x) 0) true true)
(== (at (at NQ 'p) 0) (prod (at NS 'u))) -- true
