;; parted_f64_agg.rfl — coverage for agg_parted_sum / agg_parted_avg /
;; agg_parted_minmax with a F64 base type.
;;
;; Lines targeted in src/ops/agg.c:
;;   agg_parted_sum  F64 branch  : 132-142 (parted sum on F64 segs)
;;   agg_parted_avg  F64 branch  : 173-177 (non-F64 int inner loop is NOT
;;                                          exercised here — see parted I64 test)
;;   agg_parted_minmax F64 branch: 195-202 (want_max ? v>best_f : v<best_f)
;;
;; A two-partition table is written to /tmp via .db.splayed.set and loaded
;; with .db.parted.get.  Each probe hits the parted dispatch in
;; ray_sum_fn / ray_avg_fn / ray_min_fn / ray_max_fn (line 220/305/329/351).
;;
;; Each assertion covers ≥3 regions:
;;   1. RAY_IS_PARTED branch check
;;   2. agg_parted_* dispatch
;;   3. segment loop + accumulator update + return

;; ─── fixture setup ───────────────────────────────────────────────────
(.sys.exec "rm -rf /tmp/rfl_agg_pf64")
(set TA (table [v] (list (as 'F64 [1.0 2.0 3.0]))))
(set TB (table [v] (list (as 'F64 [4.0 5.0]))))
(.db.splayed.set "/tmp/rfl_agg_pf64/1/t/" TA)
(.db.splayed.set "/tmp/rfl_agg_pf64/2/t/" TB)
(set Pf (.db.parted.get "/tmp/rfl_agg_pf64/" 't))

;; Parted F64 sum (agg_parted_sum F64 branch: lines 132-142)
(sum (at Pf 'v)) -- 15.0

;; Parted F64 avg (agg_parted_avg F64 inner branch for non-integer path, line 166-171)
(avg (at Pf 'v)) -- 3.0

;; Parted F64 min (agg_parted_minmax F64 branch: lines 195-202, want_max=0)
(min (at Pf 'v)) -- 1.0

;; Parted F64 max (agg_parted_minmax F64 branch: lines 195-202, want_max=1)
(max (at Pf 'v)) -- 5.0

;; Return types must be f64
(type (sum (at Pf 'v))) -- 'f64
(type (avg (at Pf 'v))) -- 'f64
(type (min (at Pf 'v))) -- 'f64
(type (max (at Pf 'v))) -- 'f64

;; ─── larger fixture: three partitions, verify accumulator across segs ──
(.sys.exec "rm -rf /tmp/rfl_agg_pf64b")
(set TC (table [v] (list (as 'F64 [10.0 20.0 30.0]))))
(set TD (table [v] (list (as 'F64 [40.0 50.0 60.0]))))
(set TE (table [v] (list (as 'F64 [70.0 80.0 90.0]))))
(.db.splayed.set "/tmp/rfl_agg_pf64b/1/t/" TC)
(.db.splayed.set "/tmp/rfl_agg_pf64b/2/t/" TD)
(.db.splayed.set "/tmp/rfl_agg_pf64b/3/t/" TE)
(set Pf2 (.db.parted.get "/tmp/rfl_agg_pf64b/" 't))

;; sum = 10+20+...+90 = 450
(sum (at Pf2 'v)) -- 450.0
;; avg = 450/9 = 50.0
(avg (at Pf2 'v)) -- 50.0
;; min first seg (10), max last seg (90)
(min (at Pf2 'v)) -- 10.0
(max (at Pf2 'v)) -- 90.0

;; ─── parted F64 per-group aggregation via select (grouped dispatch) ───
;; Distinct path from bare (sum (at P 'v)): grouping over a parted F64
;; column. Masked per-group lookups assert the computed aggregate VALUE,
;; not just cardinality. Groups span both partitions.
;;   part 1: k=[0 0 1] v=[10 20 30]   part 2: k=[1 1 0] v=[40 50 60]
;;   group 0 -> {10,20,60}  group 1 -> {30,40,50}
(.sys.exec "rm -rf /tmp/rfl_agg_pf64g")
(set TG1 (table [k v] (list (as 'I64 [0 0 1]) (as 'F64 [10.0 20.0 30.0]))))
(set TG2 (table [k v] (list (as 'I64 [1 1 0]) (as 'F64 [40.0 50.0 60.0]))))
(.db.splayed.set "/tmp/rfl_agg_pf64g/1/t/" TG1)
(.db.splayed.set "/tmp/rfl_agg_pf64g/2/t/" TG2)
(set Pfg (.db.parted.get "/tmp/rfl_agg_pf64g/" 't))
;; group 0 sum = 10+20+60 = 90
(at (at (select {s: (sum v) by: k where: (== k 0) from: Pfg}) 's) 0) -- 90.0
;; group 1 sum = 30+40+50 = 120
(at (at (select {s: (sum v) by: k where: (== k 1) from: Pfg}) 's) 0) -- 120.0
;; group 0 min = 10, max = 60
(at (at (select {mn: (min v) by: k where: (== k 0) from: Pfg}) 'mn) 0) -- 10.0
(at (at (select {mx: (max v) by: k where: (== k 0) from: Pfg}) 'mx) 0) -- 60.0
;; group 1 avg = 120/3 = 40.0
(at (at (select {a: (avg v) by: k where: (== k 1) from: Pfg}) 'a) 0) -- 40.0
;; cardinality invariant: two distinct groups
(count (select {s: (sum v) by: k from: Pfg})) -- 2
(.sys.exec "rm -rf /tmp/rfl_agg_pf64g")

;; ─── parted I64 avg (non-F64 inner loop: lines 173-177) ─────────────
;; When base is I64 (not F64), agg_parted_avg takes the else branch
;; at line 172 and uses agg_read_i64 to coerce each element to double.
(.sys.exec "rm -rf /tmp/rfl_agg_pi64")
(set Ti1 (table [v] (list (as 'I64 [10 20 30]))))
(set Ti2 (table [v] (list (as 'I64 [40 50]))))
(.db.splayed.set "/tmp/rfl_agg_pi64/1/t/" Ti1)
(.db.splayed.set "/tmp/rfl_agg_pi64/2/t/" Ti2)
(set Pi (.db.parted.get "/tmp/rfl_agg_pi64/" 't))
;; avg = (10+20+30+40+50)/5 = 30
(avg (at Pi 'v)) -- 30.0
(sum (at Pi 'v)) -- 150
(min (at Pi 'v)) -- 10
(max (at Pi 'v)) -- 50

;; ─── parted I64 sum wrap via raw-column expression fallback ──────────
;; `(first (list …))` deliberately defeats expr_compile today, leaving the
;; raw parted column visible to the runtime agg_parted_sum path.  If the
;; planner learns this shape later, this test may need a different wrapper.
;; (The column is taken with `at`: inside a select's per-row evaluation a
;; literal column name now stands for the row's cell, not the column.)
(.sys.exec "rm -rf /tmp/rfl_agg_pwrap")
(set Tw1 (table [v] (list [9223372036854775807])))
(set Tw2 (table [v] (list [9223372036854775807])))
(.db.splayed.set "/tmp/rfl_agg_pwrap/1/t/" Tw1)
(.db.splayed.set "/tmp/rfl_agg_pwrap/2/t/" Tw2)
(set Pw (.db.parted.get "/tmp/rfl_agg_pwrap/" 't))
(sum (first (list (at Pw 'v)))) -- -2

;; ─── parted DATE sum type error (agg_parted_sum line 129) ────────────
;; DATE base type is explicitly excluded from sum — hits the type error path.
(.sys.exec "rm -rf /tmp/rfl_agg_pdate")
(set Td1 (table [d] (list (list 2024.01.01 2024.01.02 2024.01.03))))
(set Td2 (table [d] (list (list 2024.01.04 2024.01.05))))
(.db.splayed.set "/tmp/rfl_agg_pdate/1/t/" Td1)
(.db.splayed.set "/tmp/rfl_agg_pdate/2/t/" Td2)
(set Pd (.db.parted.get "/tmp/rfl_agg_pdate/" 't))
;; sum on parted DATE → type error (agg_parted_sum line 129)
(sum (at Pd 'd)) !- type

;; ─── parted TIMESTAMP / LIST sum type errors ─────────────────────────
;; TIMESTAMP is an absolute point, not a duration.  LIST is a non-numeric
;; wrapper; this guards against using the permissive plan-time admission check
;; as the final runtime gate, which would silently return 0 for parted LIST.
(.sys.exec "rm -rf /tmp/rfl_agg_pts /tmp/rfl_agg_plist")
(set Tts1 (table [ts] (list (as 'TIMESTAMP [1 2 3]))))
(set Tts2 (table [ts] (list (as 'TIMESTAMP [4 5]))))
(.db.splayed.set "/tmp/rfl_agg_pts/1/t/" Tts1)
(.db.splayed.set "/tmp/rfl_agg_pts/2/t/" Tts2)
(set Pts (.db.parted.get "/tmp/rfl_agg_pts/" 't))
;; The whole-column gate.  (A per-row lambda in a select projection,
;; `((fn [c] (sum c)) 'ts)`, sums one cell at a time and is no gate: it
;; only raised `type` here because the fallback could not read a parted
;; column at all — it returns the cells over a flat table, and now over a
;; parted one too.)
(sum (at Pts 'ts)) !- type
(count (select {r: ((fn [c] (sum c)) 'ts) from: Pts})) -- 5
(set Tl1 (table [l] (list (list [1 2] [3 4]))))
(set Tl2 (table [l] (list (list [5 6]))))
(.db.splayed.set "/tmp/rfl_agg_plist/1/t/" Tl1)
(.db.splayed.set "/tmp/rfl_agg_plist/2/t/" Tl2)
(set Pl (.db.parted.get "/tmp/rfl_agg_plist/" 't))
(sum (at Pl 'l)) !- type
(count (select {r: ((fn [c] (sum (first (list c)))) 'l) from: Pl})) -- 3

;; ─── parted two-input aggregates (#730, #780) ────────────────────────
;; wsum/wavg/cov/scov/pearson_corr over a parted table go through the
;; concat fallback, which flattens only the columns the group references.
;; A column used ONLY as the second input (agg_ins2) used to be left out,
;; so the aggregate read it as missing (0.0 / 0Nf / garbage).
(.sys.exec "rm -rf /tmp/rfl_agg_pbin /tmp/rfl_agg_pbinw")
(.db.splayed.set "/tmp/rfl_agg_pbinw/2024.01.01/t/" (table [a b] (list [1 2 3] [10.0 20.0 30.0])))
(.db.splayed.set "/tmp/rfl_agg_pbinw/2024.01.02/t/" (table [a b] (list [4 5] [40.0 50.0])))
(set Pbw (.db.parted.get "/tmp/rfl_agg_pbinw/" 't))
(first (at (select {w: (wavg a b) from: Pbw}) 'w)) -- (wavg [1 2 3 4 5] [10.0 20.0 30.0 40.0 50.0])
(at (select {w: (wsum a b) from: Pbw}) 'w) -- [550.0]
(first (at (select {w: (wavg a b) from: Pbw where: (> a 1)}) 'w)) -- (wavg [2 3 4 5] [20.0 30.0 40.0 50.0])
(set mkbin (fn [lo n] (do (set i (+ lo (til n))) (table [w x y] (list (% i 7) (as 'F64 (% (* i 13) 101)) (as 'I64 (% (* i 7) 53)))))))
(.db.splayed.set "/tmp/rfl_agg_pbin/1/t/" (mkbin 0 300))
(.db.splayed.set "/tmp/rfl_agg_pbin/2/t/" (mkbin 300 300))
(.db.splayed.set "/tmp/rfl_agg_pbin/3/t/" (mkbin 600 300))
(set Pb (.db.parted.get "/tmp/rfl_agg_pbin/" 't))
(set Fb (concat (concat (mkbin 0 300) (mkbin 300 300)) (mkbin 600 300)))
;; grouped: x is referenced only as the second input in each select
(at (select {c: (wsum y x) from: Pb by: w asc: w}) 'c) -- (at (select {c: (wsum y x) from: Fb by: w asc: w}) 'c)
(at (select {c: (wavg y x) from: Pb by: w asc: w}) 'c) -- (at (select {c: (wavg y x) from: Fb by: w asc: w}) 'c)
(< (max (abs (- (at (select {c: (cov y x) from: Pb by: w asc: w}) 'c) (at (select {c: (cov y x) from: Fb by: w asc: w}) 'c)))) 0.000001) -- true
(< (max (abs (- (at (select {c: (scov y x) from: Pb by: w asc: w}) 'c) (at (select {c: (scov y x) from: Fb by: w asc: w}) 'c)))) 0.000001) -- true
;; pearson_corr read a missing x as all 0Nf, and (< 0Nf eps) is true — the
;; tolerance compare alone cannot fail, so pin non-null first.
(set PcP (at (select {c: (pearson_corr y x) from: Pb by: w asc: w}) 'c))
(set PcF (at (select {c: (pearson_corr y x) from: Fb by: w asc: w}) 'c))
(any (nil? PcF)) -- false
(any (nil? PcP)) -- false
(< (max (abs (- PcP PcF))) 0.000001) -- true
(at (select {c: (wsum y x) from: Pb where: (> w 2) by: w asc: w}) 'c) -- (at (select {c: (wsum y x) from: Fb where: (> w 2) by: w asc: w}) 'c)
;; ungrouped
(at (select {c: (wsum y x) from: Pb}) 'c) -- (at (select {c: (wsum y x) from: Fb}) 'c)
(at (select {c: (wavg y x) from: Pb}) 'c) -- (at (select {c: (wavg y x) from: Fb}) 'c)
(set PuP (first (at (select {c: (pearson_corr y x) from: Pb}) 'c)))
(set PuF (first (at (select {c: (pearson_corr y x) from: Fb}) 'c)))
(nil? PuF) -- false
(nil? PuP) -- false
(< (abs (- PuP PuF)) 0.000001) -- true
;; second operand an EXPRESSION over a column referenced nowhere else: the
;; optimizer's liveness/DCE passes walked agg_ins but not agg_ins2, so that
;; subtree was marked dead, its source column was left out of the parted
;; flatten and the select failed with `schema`.  Oracle: the same aggregate
;; over a flat table holding the expression as a plain column x2.
(set Fx (table [w y x2] (list (at Fb 'w) (at Fb 'y) (* (at Fb 'x) 2.0))))
(set Wk (at (select {c: (wsum y x2) from: Fx by: w asc: w}) 'c))
(set Ak (at (select {c: (wavg y x2) from: Fx by: w asc: w}) 'c))
(set Ck (at (select {c: (cov y x2) from: Fx by: w asc: w}) 'c))
(set Rk (at (select {c: (pearson_corr y x2) from: Fx by: w asc: w}) 'c))
(any (nil? Ck)) -- false
(any (nil? Rk)) -- false
;; grouped, flat
(at (select {c: (wsum y (* x 2.0)) from: Fb by: w asc: w}) 'c) -- Wk
(at (select {c: (wavg y (* x 2.0)) from: Fb by: w asc: w}) 'c) -- Ak
(< (max (abs (- (at (select {c: (cov y (* x 2.0)) from: Fb by: w asc: w}) 'c) Ck))) 0.000001) -- true
(< (max (abs (- (at (select {c: (pearson_corr y (* x 2.0)) from: Fb by: w asc: w}) 'c) Rk))) 0.000001) -- true
;; grouped, parted
(at (select {c: (wsum y (* x 2.0)) from: Pb by: w asc: w}) 'c) -- Wk
(at (select {c: (wavg y (* x 2.0)) from: Pb by: w asc: w}) 'c) -- Ak
(set CkP (at (select {c: (cov y (* x 2.0)) from: Pb by: w asc: w}) 'c))
(set RkP (at (select {c: (pearson_corr y (* x 2.0)) from: Pb by: w asc: w}) 'c))
(any (nil? CkP)) -- false
(any (nil? RkP)) -- false
(< (max (abs (- CkP Ck))) 0.000001) -- true
(< (max (abs (- RkP Rk))) 0.000001) -- true
;; keyless, flat and parted
(set Wu (at (select {c: (wsum y x2) from: Fx}) 'c))
(set Au (at (select {c: (wavg y x2) from: Fx}) 'c))
(set Cu (first (at (select {c: (cov y x2) from: Fx}) 'c)))
(set Ru (first (at (select {c: (pearson_corr y x2) from: Fx}) 'c)))
(nil? Cu) -- false
(nil? Ru) -- false
(at (select {c: (wsum y (* x 2.0)) from: Fb}) 'c) -- Wu
(at (select {c: (wavg y (* x 2.0)) from: Fb}) 'c) -- Au
(< (abs (- (first (at (select {c: (cov y (* x 2.0)) from: Fb}) 'c)) Cu)) 0.000001) -- true
(< (abs (- (first (at (select {c: (pearson_corr y (* x 2.0)) from: Fb}) 'c)) Ru)) 0.000001) -- true
(at (select {c: (wsum y (* x 2.0)) from: Pb}) 'c) -- Wu
(at (select {c: (wavg y (* x 2.0)) from: Pb}) 'c) -- Au
(set CuP (first (at (select {c: (cov y (* x 2.0)) from: Pb}) 'c)))
(set RuP (first (at (select {c: (pearson_corr y (* x 2.0)) from: Pb}) 'c)))
(nil? CuP) -- false
(nil? RuP) -- false
(< (abs (- CuP Cu)) 0.000001) -- true
(< (abs (- RuP Ru)) 0.000001) -- true
;; a constant second operand — literal or constant-folded once the folder
;; reaches agg_ins2 — is an atom; the pair loops indexed it per row (garbage)
;; until it was broadcast like a constant first operand.
(set Sy (* 6.0 (at (select {c: (sum y) from: Fb by: w asc: w}) 'c)))
(at (select {c: (wsum y 6.0) from: Fb by: w asc: w}) 'c) -- Sy
(at (select {c: (wsum y (* 2.0 3.0)) from: Fb by: w asc: w}) 'c) -- Sy
(at (select {c: (wsum y 6.0) from: Pb by: w asc: w}) 'c) -- Sy
(at (select {c: (wsum y (* 2.0 3.0)) from: Pb by: w asc: w}) 'c) -- Sy
(at (select {c: (wavg y 6.0) from: Fb by: w asc: w}) 'c) -- [6.0 6.0 6.0 6.0 6.0 6.0 6.0]
(first (at (select {c: (wsum y 6.0) from: Fb}) 'c)) -- (sum Sy)
(first (at (select {c: (wsum y 6.0) from: Pb}) 'c)) -- (sum Sy)
;; ungrouped over > RAY_PARALLEL_THRESHOLD rows: the keyless group takes the
;; radix emit, whose key-column VLAs were sized n_keys == 0 (UBSan abort).
(.sys.exec "rm -rf /tmp/rfl_agg_pbin")
(.db.splayed.set "/tmp/rfl_agg_pbin/1/t/" (mkbin 0 40000))
(.db.splayed.set "/tmp/rfl_agg_pbin/2/t/" (mkbin 40000 40000))
(set Pb (.db.parted.get "/tmp/rfl_agg_pbin/" 't))
(set Fb (concat (mkbin 0 40000) (mkbin 40000 40000)))
(at (select {c: (wsum y x) from: Pb}) 'c) -- (at (select {c: (wsum y x) from: Fb}) 'c)
(at (select {c: (wavg y x) from: Pb}) 'c) -- (at (select {c: (wavg y x) from: Fb}) 'c)

;; ─── cleanup ─────────────────────────────────────────────────────────
(.sys.exec "rm -rf /tmp/rfl_agg_pf64 /tmp/rfl_agg_pf64b /tmp/rfl_agg_pf64g /tmp/rfl_agg_pi64 /tmp/rfl_agg_pwrap /tmp/rfl_agg_pdate /tmp/rfl_agg_pts /tmp/rfl_agg_plist /tmp/rfl_agg_pbin /tmp/rfl_agg_pbinw")
