;; Outside a query first and last take the element by position for every type, nulls included (#1420).
;; Inside a select, keyless or by:, they skip a typed vector's nulls (#1368).

(first [0Nl 3]) -- 0Nl
(last [3 0Nl]) -- 0Nl
(first [0Nf 3.0]) -- 0Nf
(last [3.0 0Nf]) -- 0Nf
(first (as 'F32 [0Nf 3.0])) -- 0Ne
(first (as 'I32 [0Nl 3])) -- 0Ni
(first (as 'TIMESTAMP [0Nl 3])) -- 0Np
(first [3 0Nl]) -- 3
(last [0Nl 3]) -- 3
(first (as 'I64 [])) -- 0Nl
(set x [0Nl 3])
(first (+ x 1)) -- 0Nl

;; A select skips them, whichever route the argument takes.
(set T (table [k v f i] (list [a a b] [0Nl 3 0Nl] [0Nf 2.5 0Nf] [0 1 2])))
(at (select {a: (first v) b: (last f) from: T}) 'a) -- [3]
(at (select {a: (first v) b: (last f) from: T}) 'b) -- [2.5]
(at (select {s: (first (+ v 1)) from: T}) 's) -- [4]
(at (select {s: (first v) from: T by: k asc: k}) 's) -- [3 0Nl]
(at (select {s: (last f) from: T by: k asc: k}) 's) -- [2.5 0Nf]
;; by: with an argument evaluated per group (a global indexed by a column)
(set GI [0Nl 20 30])
(at (select {s: (first (at GI i)) from: T by: k asc: k}) 's) -- [20 30]
(at (select {s: (last (at GI (- 2 i))) from: T by: k asc: k}) 's) -- [20 0Nl]

;; A stored column answers as the vector does: positional outside a query.
(.sys.exec "rm -rf /tmp/rfl_first_last_positional") -- 0
(set S (table [v] (list (concat [0Nl] (til 140000)))))
(.db.splayed.set "/tmp/rfl_first_last_positional/g0/" S {compress:false})
(.db.splayed.set "/tmp/rfl_first_last_positional/g2/" S {compress:true})
(first (at (.db.splayed.get "/tmp/rfl_first_last_positional/g0/") 'v)) -- 0Nl
(first (at (.db.splayed.get "/tmp/rfl_first_last_positional/g2/") 'v)) -- 0Nl
(at (select {s: (first v) from: (.db.splayed.get "/tmp/rfl_first_last_positional/g2/")}) 's) -- [0]
(.sys.exec "rm -rf /tmp/rfl_first_last_positional") -- 0

;; pivot's first and last are the builtin's: a null cell is that cell.
(set W (table [k p v] (list [a a b b] [x x x x] [0Nl 1 2 0Nl])))
(identical (pivot W 'k 'p 'v first) (pivot W 'k 'p 'v (fn [c] (first c)))) -- true
(identical (pivot W 'k 'p 'v last) (pivot W 'k 'p 'v (fn [c] (last c)))) -- true
(at (pivot W 'k 'p 'v first) 'x) -- [0Nl 2]
