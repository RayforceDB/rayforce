;; Keyless aggregate transport preserves literal and bound scalar probabilities.
(set Q981 (table [s t keep] (list (as 'F64 [0 8 16 24]) [1 3 5 7] [false true false true])))
(quantile (at Q981 's) 0.25) -- 6.0
(at (select {q: (quantile s 0.25) from: Q981}) 'q) -- [6.0]
(type (at (select {q: (quantile s 0.25) from: Q981}) 'q)) -- 'F64
(at (select {q: (quantile s 0.75) from: Q981}) 'q) -- [18.0]
(at (select {q: (quantile s 0) from: Q981}) 'q) -- [0.0]
(at (select {q: (quantile s 1) from: Q981}) 'q) -- [24.0]
(at (select {p: (percentile s 25) from: Q981}) 'p) -- [6.0]
(percentile (at Q981 's) 0.25) -- 0.06
(at (select {p: (percentile s 0.25) from: Q981}) 'p) -- [0.06]
(at (select {p: (percentile s 100) from: Q981}) 'p) -- [24.0]
(value (select {a: (quantile s 0) b: (quantile s 0.25) c: (med s) d: (quantile s 0.75) e: (quantile s 1) f: (percentile s 25) z: (sum t) from: Q981})) -- (list [0.0] [6.0] [12.0] [18.0] [24.0] [6.0] [16])
(value (select {q: (quantile s 0.25) w: (wsum s t) from: Q981})) -- (list [6.0] [272.0])
(at (select {q: (quantile s 0.25) from: Q981 where: keep}) 'q) -- [12.0]
(at (select {q: (quantile s 0.25) from: Q981 where: false}) 'q) -- [0Nf]
(set N981 (table [s] (list (as 'F64 [0Nf 0Nf]))))
(at (select {q: (quantile s 0.25) from: N981}) 'q) -- [0Nf]
;; A bound probability must not silently fall back to the median.
(set P981 0.5)
(quantile (at Q981 's) P981) -- 12.0
(at (select {q: (quantile s P981) from: Q981}) 'q) -- [12.0]
(value (select {a: (quantile s 0) b: (quantile s P981) c: (quantile s 0.25) from: Q981})) -- (list [0.0] [12.0] [6.0])
(set P981 0.25)
(quantile (at Q981 's) P981) -- 6.0
(at (select {q: (quantile s P981) from: Q981}) 'q) -- [6.0]
(value (select {a: (quantile s 0) b: (quantile s P981) c: (quantile s 0.75) from: Q981})) -- (list [0.0] [6.0] [18.0])
(set P981 0)
(at (select {q: (quantile s P981) from: Q981}) 'q) -- [0.0]
((fn [P981] (at (select {q: (quantile s P981) from: Q981}) 'q)) 0.75) -- [18.0]
(set PP981 50)
(value (select {a: (percentile s 25) b: (percentile s PP981) from: Q981})) -- (list [6.0] [12.0])
(set PP981 25)
(at (select {p: (percentile s PP981) from: Q981}) 'p) -- [6.0]
;; Existing grouped parameter transport must remain correct.
(set G981 (table [g s] (list [0 0 1 1] (as 'F64 [0 8 16 24]))))
(at (select {q: (quantile s 0.25) from: G981 by: g asc: g}) 'q) -- [2.0 18.0]
(at (select {q: (percentile s 25) from: G981 by: g asc: g}) 'q) -- [2.0 18.0]
;; Many distinct inputs/parameter slots; 40 outputs do not force the 4096-node arena to grow.
(value (select {q0: (quantile (+ s 0) 0.25) q1: (quantile (+ s 1) 0.25) q2: (quantile (+ s 2) 0.25) q3: (quantile (+ s 3) 0.25) q4: (quantile (+ s 4) 0.25) q5: (quantile (+ s 5) 0.25) q6: (quantile (+ s 6) 0.25) q7: (quantile (+ s 7) 0.25) q8: (quantile (+ s 8) 0.25) q9: (quantile (+ s 9) 0.25) q10: (quantile (+ s 10) 0.25) q11: (quantile (+ s 11) 0.25) q12: (quantile (+ s 12) 0.25) q13: (quantile (+ s 13) 0.25) q14: (quantile (+ s 14) 0.25) q15: (quantile (+ s 15) 0.25) q16: (quantile (+ s 16) 0.25) q17: (quantile (+ s 17) 0.25) q18: (quantile (+ s 18) 0.25) q19: (quantile (+ s 19) 0.25) q20: (quantile (+ s 20) 0.25) q21: (quantile (+ s 21) 0.25) q22: (quantile (+ s 22) 0.25) q23: (quantile (+ s 23) 0.25) q24: (quantile (+ s 24) 0.25) q25: (quantile (+ s 25) 0.25) q26: (quantile (+ s 26) 0.25) q27: (quantile (+ s 27) 0.25) q28: (quantile (+ s 28) 0.25) q29: (quantile (+ s 29) 0.25) q30: (quantile (+ s 30) 0.25) q31: (quantile (+ s 31) 0.25) q32: (quantile (+ s 32) 0.25) q33: (quantile (+ s 33) 0.25) q34: (quantile (+ s 34) 0.25) q35: (quantile (+ s 35) 0.25) q36: (quantile (+ s 36) 0.25) q37: (quantile (+ s 37) 0.25) q38: (quantile (+ s 38) 0.25) q39: (quantile (+ s 39) 0.25) from: Q981})) -- (list [6.0] [7.0] [8.0] [9.0] [10.0] [11.0] [12.0] [13.0] [14.0] [15.0] [16.0] [17.0] [18.0] [19.0] [20.0] [21.0] [22.0] [23.0] [24.0] [25.0] [26.0] [27.0] [28.0] [29.0] [30.0] [31.0] [32.0] [33.0] [34.0] [35.0] [36.0] [37.0] [38.0] [39.0] [40.0] [41.0] [42.0] [43.0] [44.0] [45.0])
