;; Invariants for `count`.

(count [1 2 3]) -- 3
(count []) -- 0
(count "hello") -- 5
(count 42) -- 1

;; concat additive: count(a ++ b) == count(a) + count(b)
(set A (rand 50 1000))
(set B (rand 80 1000))
(count (concat A B)) -- (+ (count A) (count B))
;; absolute pins: rand's first arg is the length, so counts are deterministic
;; (the invariant above is self-referential — both sides call count)
(count A) -- 50
(count B) -- 80
(count (concat A B)) -- 130

;; til n has count n
(count (til 123)) -- 123

;; ─── edge cases: empty / single / atom / heterogeneous list ──────────
;; empty string -> count 0
(count "") -- 0
;; single-char string -> count 1
(count "x") -- 1
;; empty list (heterogeneous) -> 0
(count (list)) -- 0
;; list with elements -> ray_len
(count (list 1 "two" 'three)) -- 3
;; F64 atom -> 1
(count 3.14) -- 1
;; SYM atom -> 1
(count 'foo) -- 1
;; null atom -> 1
(count 0Ni) -- 1
;; dict (atom_eq treats dict as collection)
(count (dict ['a 'b 'c] [1 2 3])) -- 3
;; table count == nrow
(count (table [a b] (list [1 2 3 4 5] [10 20 30 40 50]))) -- 5
;; empty table
(count (table [a b] (list (as 'I64 []) (as 'I64 [])))) -- 0

;; ─── keyless select: count and the other non-variance aggregates ─────
;; gcc 13.3 -O3 (loop unswitching on the aggregate-op switch in
;; emit_agg_columns) returned 0 for every one of these; a where: filter
;; made count wrong as well.
(set WC (table [v] (list (% (til 50000) 1013))))
(at (select {from: WC where: (> v 10) c: (count v)}) 'c) -- [49450]
(at (select {from: WC c: (count v)}) 'c) -- [50000]
(at (select {from: WC where: (> v 10) c: (sum v)}) 'c) -- [25179275]
(at (select {from: WC c: (sum v)}) 'c) -- [25182025]
(at (select {from: WC where: (> v 10) c: (min v)}) 'c) -- [11]
(at (select {from: WC where: (> v 10) c: (max v)}) 'c) -- [1012]
(at (select {from: WC where: (> v 10) c: (first v)}) 'c) -- [11]
(at (select {from: WC where: (> v 10) c: (last v)}) 'c) -- [362]
(first (at (select {from: WC where: (> v 10) c: (avg v)}) 'c)) -- (/ 25179275.0 49450.0)
(select {from: WC where: (> v 10) c: (count v) s: (sum v) lo: (min v) hi: (max v)}) -- (table [c s lo hi] (list [49450] [25179275] [11] [1012]))
