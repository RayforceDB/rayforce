;; Aggregation behaviour: nulls are skipped (databases-style), counts include them.

;; sum is identity over all-null
(sum (as 'I64 [])) -- 0

;; count(v) doesn't depend on values
(count [1 2 3 4 5]) -- 5
(count [0N 0N 0N 0N 0N]) -- 5

;; avg counts only non-null elements in its denominator
(avg [10 20 0N 40]) -- 23.333333333333332
(avg [0N 0N 5]) -- 5.0

;; first/last outside a query are positional (#1420); in a select they skip nulls
(first [0N 0N 7 8]) -- 0Nl
(last [7 8 0N 0N]) -- 0Nl
(at (select {f: (first v) from: (table [v] (list [0N 0N 7 8]))}) 'f) -- [7]
(at (select {l: (last v) from: (table [v] (list [7 8 0N 0N]))}) 'l) -- [8]
