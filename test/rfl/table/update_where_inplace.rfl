;; update_where_inplace.rfl — a where-update into a named table writes the
;; matched rows in place (#475 follow-up: update must carry realtime
;; ingestion like insert and upsert).
;;
;; Regression: ray_update with `where:` evaluated the predicate and every
;; update expression over the whole table, then rebuilt every updated column
;; cell by cell — O(rows present) per call with a large constant, and an
;; attached .idx.hash on the key column was never consulted.  These lines pin
;; the observable semantics the in-place path must preserve.

;; ── basic: only matched rows change, returns the symbol ──
(set b (table [px sz side] (list [10 20 30] [1 2 3] ['bid 'ask 'bid])))
(update {from: 'b sz: 99 where: (== px 20)}) -- 'b
(at b 'sz) -- [1 99 3]
(at b 'side) -- [bid ask bid]
;; a shared owner sees the pre-update value
(set alias b)
(update {from: 'b sz: 0 where: (== px 10)})
(at b 'sz) -- [0 99 3]
(at alias 'sz) -- [1 99 3]

;; ── row-wise expressions over the matched rows, several columns at once ──
(set b (table [px sz side] (list [10 20 30 40] [1 2 3 4] ['bid 'ask 'bid 'ask])))
(update {from: 'b sz: (+ sz 100) side: 'ask where: (> px 15)})
(at b 'sz) -- [1 102 103 104]
(at b 'side) -- [bid ask ask ask]
(update {from: 'b sz: (* px 2) where: (== side 'bid)})
(at b 'sz) -- [20 102 103 104]

;; ── atoms and promotions ──
(set p (table [k i f s] (list [1 2 3] [10 20 30] [1.5 2.5 3.5] (list "a" "b" "c"))))
(update {from: 'p f: 7 where: (== k 2)})
(at p 'f) -- [1.5 7.0 3.5]
(update {from: 'p i: 2.9 where: (== k 2)}) !- type
(update {from: 'p i: (* f 2) where: (== k 3)})
(at p 'i) -- [10 20 7]
(update {from: 'p f: (+ i 1) where: (== k 1)})
(at p 'f) -- [11.0 7.0 3.5]
(update {from: 'p s: "zz" where: (== k 3)})
(at p 's) -- (list "a""b""zz")
(update {from: 'p s: 5 where: (== k 3)}) !- type
(at p 's) -- (list "a""b""zz")
(update {from: 'p i: 0Nl where: (== k 1)})
(nil? (at (at p 'i) 0)) -- true
(sum (at p 'i)) -- 27
(update {from: 'p f: 0Nf where: (== k 2)})
(nil? (at (at p 'f) 1)) -- true
(sum (at p 'f)) -- 14.5

;; ── every row, no row ──
(set e (table [k v] (list [1 2 3] [1 2 3])))
(update {from: 'e v: 0 where: (> k 0)})
(at e 'v) -- [0 0 0]
(update {from: 'e v: 9 where: (== k 99)})
(at e 'v) -- [0 0 0]
(count e) -- 3

;; ── errors leave the table untouched ──
(set e (table [k v] (list [1 2 3] [1 2 3])))
(update {from: 'e v: 'sym where: (== k 2)}) !- type
(at e 'v) -- [1 2 3]
(update {from: 'e v: [1 2] where: (== k 2)}) !- length
(at e 'v) -- [1 2 3]

;; ── aggregates keep their whole-table meaning ──
(set a (table [k v] (list [1 2 3] [10 30 20])))
(update {from: 'a v: (max v) where: (== k 1)})
(at a 'v) -- [30 30 20]

;; ── boxed and sym columns ──
(set l (table [k v s] (list [1 2] (list [1 2] "x") ['a 'b])))
(update {from: 'l v: 'tag where: (== k 2)})
(at (at l 'v) 1) -- 'tag
(at (at l 'v) 0) -- [1 2]
(update {from: 'l s: 'c where: (== k 1)})
(at l 's) -- [c b]

;; ── hash-indexed key column: fast lookup, never a stale answer ──
(set h (table [px sz] (list (til 1000) (til 1000))))
(set h (update {from: h px: (.idx.hash px)}))
(update {from: 'h sz: -1 where: (== px 500)})
(at (at h 'sz) 500) -- -1
(at (at h 'sz) 499) -- 499
(update {from: 'h sz: (+ sz 1) where: (== px 500)})
(at (at h 'sz) 500) -- 0
(select {from: h where: (== px 500)}) -- (table [px sz] (list [500] [0]))
(update {from: 'h sz: 7 where: (== px 5000)})
(sum (at h 'sz)) -- 499000
;; the indexed column itself rewritten: an equality on it must see new data
(update {from: 'h px: 5000 where: (== sz 1)})
(select {from: h where: (== px 5000)}) -- (table [px sz] (list [5000] [1]))
(select {from: h where: (== px 1)}) -- (table [px sz] (list (as 'I64 []) (as 'I64 [])))
;; sym key with an index
(set q (table [sym bid] (list ['aa 'bb 'cc] [1.0 2.0 3.0])))
(set q (update {from: q sym: (.idx.hash sym)}))
(update {from: 'q bid: 2.5 where: (== sym 'bb)})
(at q 'bid) -- [1.0 2.5 3.0]
(set want 'cc)
(update {from: 'q bid: 3.5 where: (== sym want)})
(at q 'bid) -- [1.0 2.5 3.5]
(update {from: 'q bid: 9.0 where: (== sym 'zz)})
(at q 'bid) -- [1.0 2.5 3.5]

;; ── value-semantic from: returns a new table, binding untouched ──
(set v (table [k x] (list [1 2] [1 2])))
(update {from: v x: 9 where: (== k 2)}) -- (table [k x] (list [1 2] [1 9]))
(at v 'x) -- [1 2]

;; ── larger: correctness at a size where the scan matters ──
(set big (table [px sz] (list (til 20000) (til 20000))))
(update {from: 'big sz: (- 0 sz) where: (>= px 19000)})
(at (at big 'sz) 18999) -- 18999
(at (at big 'sz) 19000) -- -19000
(sum (at big 'sz)) -- 160991000
