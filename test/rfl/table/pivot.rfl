;; Invariants for `pivot` — wide-table reshape across one (or more) row
;; keys, one pivot key, and one value column with an aggregator.

(set trades (table [sym side qty] (list ['AAPL 'GOOG 'AAPL 'MSFT 'AAPL 'GOOG] ['Buy 'Sell 'Sell 'Buy 'Buy 'Buy] [100 50 75 200 50 30])))

;; ────────────── pivot with sum aggregator ──────────────
(set Pivot-Sum (pivot trades 'sym 'side 'qty sum))

;; row count is the number of distinct row-keys
(count Pivot-Sum) -- 3

;; per-side sums match what a hand group-by would produce
(sum (at Pivot-Sum 'Buy))  -- 380
(sum (at Pivot-Sum 'Sell)) -- 125

;; representative scattered cells (rows ordered by first-seen sym: AAPL,GOOG,MSFT)
;; AAPL Buy = 100+50 = 150, AAPL Sell = 75
(at (at Pivot-Sum 'Buy) 0)  -- 150
(at (at Pivot-Sum 'Sell) 0) -- 75
;; GOOG Buy = 30, GOOG Sell = 50
(at (at Pivot-Sum 'Buy) 1)  -- 30
(at (at Pivot-Sum 'Sell) 1) -- 50
;; MSFT Buy = 200, MSFT Sell has no source row -> NULL (review 2.10: missing
;; cells are null, not a real 0, so "no data" stays distinguishable)
(at (at Pivot-Sum 'Buy) 2)  -- 200
(nil? (at (at Pivot-Sum 'Sell) 2)) -- true

;; total across pivoted columns equals total across the source value col
(+ (sum (at Pivot-Sum 'Buy)) (sum (at Pivot-Sum 'Sell))) -- (sum (at trades 'qty))

;; ────────────── pivot with count aggregator ──────────────
(set Pivot-Count (pivot trades 'sym 'side 'qty count))

(count Pivot-Count) -- 3

;; representative scattered count cells (same row order: AAPL,GOOG,MSFT)
;; AAPL: Buy seen twice (100,50), Sell once (75)
(at (at Pivot-Count 'Buy) 0)  -- 2
(at (at Pivot-Count 'Sell) 0) -- 1
;; GOOG: Buy once (30), Sell once (50)
(at (at Pivot-Count 'Buy) 1)  -- 1
(at (at Pivot-Count 'Sell) 1) -- 1
;; MSFT: Buy once (200), Sell has no source row -> NULL (review 2.10: a
;; missing count cell is "no rows here" = null, distinct from a real 0; a
;; group only exists when >=1 row matched, so present count cells are >=1)
(at (at Pivot-Count 'Buy) 2)  -- 1
(nil? (at (at Pivot-Count 'Sell) 2)) -- true

;; total cells == total source rows (sum skips the null missing cells)
(+ (sum (at Pivot-Count 'Buy)) (sum (at Pivot-Count 'Sell))) -- (count trades)

;; ────────────── pivot with avg / min / max aggregators ──────────────
;; Each aggregator hits a separate combine path in ray_pivot_fn.
(set tk (table [k1 k2 v] (list ['A 'A 'B 'B 'A] ['x 'y 'x 'y 'y] [1 2 3 4 5])))

(set Pavg (pivot tk 'k1 'k2 'v avg))
(count Pavg) -- 2
(at (at Pavg 'x) 0) -- 1.0
(at (at Pavg 'y) 0) -- 3.5
(at (at Pavg 'x) 1) -- 3.0
(at (at Pavg 'y) 1) -- 4.0

(set Pmin (pivot tk 'k1 'k2 'v min))
(count Pmin) -- 2
(at (at Pmin 'x) 0) -- 1
(at (at Pmin 'y) 0) -- 2

(set Pmax (pivot tk 'k1 'k2 'v max))
(count Pmax) -- 2
(at (at Pmax 'x) 0) -- 1
(at (at Pmax 'y) 1) -- 4

;; ────────────── pivot with f64 value column ──────────────
(set tf (table [k1 k2 v] (list ['A 'A 'B] ['x 'y 'x] [1.5 2.5 3.5])))
(set Pf (pivot tf 'k1 'k2 'v sum))
(at (at Pf 'x) 0) -- 1.5
(at (at Pf 'y) 0) -- 2.5
(at (at Pf 'x) 1) -- 3.5
;; B has no 'y row → NULL (review 2.10: missing F64 cell is NULL_F64, not a
;; real 0.0).  The column is HAS_NULLS so null-aware ops + the §2.1 validator
;; are satisfied.
(nil? (at (at Pf 'y) 1)) -- true

;; ────────────── pivot with negative-zero F64 value (zero-fill identity) ──────────────
;; A pivot VALUE column containing -0.0 alongside real values: sum keeps them.
(set tnz (table [k1 k2 v] (list ['A 'B 'C] ['x 'x 'x] [1.5 -0.0 2.5])))
(set Pnz (pivot tnz 'k1 'k2 'v sum))
(count Pnz) -- 3
;; expected: A→1.5, B→0.0 (the -0.0), C→2.5
(at (at Pnz 'x) 0) -- 1.5
(at (at Pnz 'x) 1) -- 0.0
(at (at Pnz 'x) 2) -- 2.5

;; ── F64 pivot-KEY column with -0.0 (FIXED) ──
;; pivot KEY is F64 holding 0.0 and -0.0.  FIXED: ray_pivot_fn collapses
;; -0.0 -> +0.0 in the F64 pivot key once up front (cold-path bit-check, not in
;; the group-by hot loop), so 0.0/-0.0 form ONE merged "0" column carrying both
;; values; previously they split into two same-named "0" columns and (at Pkz
;; '0) saw only the first (value 7), shadowing the -0.0 value 9.
(set tkz (table [r c v] (list ['A 'A] [0.0 -0.0] [7 9])))
(set Pkz (pivot tkz 'r 'c 'v sum))
(sum (at Pkz '0)) -- 16

;; ────────────── pivot with vector row-key (multi-key) ──────────────
(set tm (table [r c v] (list [1 1 2 2] ['x 'y 'x 'y] [10 20 30 40])))
(set Pm (pivot tm ['r] 'c 'v sum))
(count Pm) -- 2
(at (at Pm 'x) 0) -- 10
(at (at Pm 'y) 0) -- 20
(at (at Pm 'x) 1) -- 30

;; ────────────── union-all: row-wise concat of two same-schema tables ──────────────
;; Was 0%-covered before; the C-API was reachable from REPL but had no
;; .rfl tests.
(set Tu1 (table [a b] (list [1 2 3] [10 20 30])))
(set Tu2 (table [a b] (list [4 5]   [40 50])))
(count (union-all Tu1 Tu2))      -- 5
(sum (at (union-all Tu1 Tu2) 'a)) -- 15
(sum (at (union-all Tu1 Tu2) 'b)) -- 150
(at (at (union-all Tu1 Tu2) 'a) 0) -- 1
(at (at (union-all Tu1 Tu2) 'a) 4) -- 5
;; empty + non-empty edges
(set Tu0 (select {from: Tu1 where: (> a 100)}))   ;; 0 rows, same schema
(count (union-all Tu0 Tu1)) -- 3
(count (union-all Tu1 Tu0)) -- 3

;; ────────────── pivot with TWO row keys (vector form) ──────────────
(set T2k (table [a b c v] (list ['X 'X 'Y 'Y 'X 'Y] [1 2 1 2 1 2] ['p 'q 'p 'q 'q 'p] [10 20 30 40 50 60])))
(set P2k (pivot T2k ['a 'b] 'c 'v sum))
(count P2k) -- 4
(count (key P2k)) -- 4
(at (at P2k 'p) 0) -- 10
(at (at P2k 'q) 0) -- 50
(at (at P2k 'p) 3) -- 60
(at (at P2k 'q) 3) -- 40

;; ────────────── pivot with I64 row key ──────────────
(set Ti (table [k c v] (list [1 1 2 2 3] ['x 'y 'x 'y 'x] [10 20 30 40 50])))
(set Pi (pivot Ti 'k 'c 'v sum))
(count Pi) -- 3
(at (at Pi 'x) 0) -- 10
(at (at Pi 'y) 1) -- 40
(at (at Pi 'x) 2) -- 50

;; ────────────── pivot with DATE row key ──────────────
(set Td (table [d c v] (list [2024.01.01 2024.01.01 2024.01.02 2024.01.02] ['x 'y 'x 'y] [10 20 30 40])))
(set Pd (pivot Td 'd 'c 'v sum))
(count Pd) -- 2
(at (at Pd 'x) 0) -- 10
(at (at Pd 'y) 1) -- 40

;; ────────────── pivot count vs sum on missing cells (review 2.10) ──────
;; B has an 'x row but no 'y row, so the (B,'y) cell is missing for both the
;; sum and count pivots.  A missing cell is NULL (no data), never a real 0 —
;; "no data" must stay distinguishable from a genuine 0.
(set Ts (table [r c v] (list ['A 'A 'B] ['x 'y 'x] [1 2 3])))
(set Pcs (pivot Ts 'r 'c 'v sum))
(nil? (at (at Pcs 'y) 1)) -- true
;; present cell that genuinely sums to a value stays a value (not nulled)
(at (at Pcs 'x) 1) -- 3
(set PcsFn (pivot Ts 'r 'c 'v (fn [xs] (sum xs))))
(nil? (at (at PcsFn 'y) 1)) -- true
(at (at PcsFn 'x) 1) -- 3
(set Pcc (pivot Ts 'r 'c 'v count))
(nil? (at (at Pcc 'y) 1)) -- true
(at (at Pcc 'x) 1) -- 1

;; ── present real-0 SUM cell stays 0, missing stays null (the core 2.10 ──
;; distinction: a real 0 and "no data" must not collapse to the same value) ──
(set Tz (table [r c v] (list ['A 'A 'B] ['x 'y 'x] [0 5 7])))
(set Pz (pivot Tz 'r 'c 'v sum))
;; (A,'x) summed a real 0 -> stays 0 (NOT null)
(at (at Pz 'x) 0) -- 0
(nil? (at (at Pz 'x) 0)) -- false
;; (B,'y) is missing -> null
(nil? (at (at Pz 'y) 1)) -- true
