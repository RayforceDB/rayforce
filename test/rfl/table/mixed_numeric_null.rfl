;; Mixed numeric LIST promotion must convert the source null, not its bits.
;; @also-unfused
(set _mn_source (list 1.5 3 0Nl 2))
(set _mn (at (table [v] (list _mn_source)) 'v))
(type _mn) -- 'F64
_mn -- [1.5 3.0 0Nf 2.0]
(nil? _mn) -- [false false true false]
(nil? (at _mn 2)) -- true
(min _mn) -- 1.5
(sum _mn) -- 6.5
_mn_source -- (list 1.5 3 0Nl 2)
(at (table [v] (list (list 0Nl 1.5 2))) 'v) -- [0Nf 1.5 2.0]
(at (table [v] (list (list 1 0Nl 1.5))) 'v) -- [1.0 0Nf 1.5]
(at (table [v] (list (list 0Nf 0Nl 2))) 'v) -- [0Nf 0Nf 2.0]
(at (table [v] (list (list 1 0Nl 2))) 'v) -- [1 0Nl 2]
;; Typed-vector columns do not take the LIST promotion path.
(type (at (table [v] (list (as 'I16 [1 0Nl 2]))) 'v)) -- 'I16
(type (at (table [v] (list (as 'I32 [1 0Nl 2]))) 'v)) -- 'I32
(type (at (table [v] (list (as 'F32 [1.5 0Nf 2.0]))) 'v)) -- 'F32
;; Append/replace have their own coercion path: typed nulls must stay null.
(set _mn_t (table [k v] (list [1] [2.0])))
(at (insert _mn_t (list 2 0Nl)) 'v) -- [2.0 0Nf]
(at (insert _mn_t (list 2 (as 'I32 0Nl))) 'v) -- [2.0 0Nf]
(at (insert _mn_t (list 2 (as 'I16 0Nl))) 'v) -- [2.0 0Nf]
(at (upsert _mn_t 1 (list 1 0Nl)) 'v) -- [0Nf]
(at (upsert _mn_t 1 (list 2 (as 'I32 0Nl))) 'v) -- [2.0 0Nf]
(at _mn_t 'v) -- [2.0]
;; Integer append coercions preserve source sentinels at the target width.
(at (insert (table [v] (list [1])) (list (as 'I16 0Nl))) 'v) -- [1 0Nl]
(at (insert (table [v] (list [1])) (list (as 'I32 0Nl))) 'v) -- [1 0Nl]
(at (insert (table [v] (list [1])) (list (as 'U8 255))) 'v) -- [1 255]
(at (insert (table [v] (list [1.0])) (list (as 'U8 255))) 'v) -- [1.0 255.0]
(at (insert (table [v] (list (as 'F32 [1.0]))) (list (as 'F32 0Nf))) 'v) -- (as 'F32 [1.0 0Nf])
;; Temporal columns retain their own type and null, not an integer promotion.
(at (table [v] (list (list (as 'DATE 1) (as 'DATE 0Nl)))) 'v) -- (as 'DATE [1 0Nl])
(at (table [v] (list (list (as 'TIMESTAMP 1) (as 'TIMESTAMP 0Nl)))) 'v) -- (as 'TIMESTAMP [1 0Nl])
(at (insert (table [v] (list (as 'TIME [1]))) (list (as 'TIME 0Nl))) 'v) -- (as 'TIME [1 0Nl])
