;; Ported from test_lang_rf.inc::test_rf_alter.

;; ========== ALTER SET ON VECTORS ==========
(set v [1 2 3 4 5]) (alter 'v set 0 100) v -- [100 2 3 4 5]
;; ========== ALTER CONCAT ON VECTORS ==========
(set v [1 2 3]) (alter 'v concat 4) v -- [1 2 3 4]

;; ========== ALTER SET ON LISTS (boxed heterogeneous) ==========
(set L (list 1 'a "x" 3.14)) (alter 'L set 1 'changed) L -- (list 1 'changed "x" 3.14)
(set L (list 10 20 30 40 50)) (alter 'L set [0 2 4] 99) L -- (list 99 20 99 40 99)

;; ========== ALTER CONCAT ON LISTS ==========
(set L (list 1 'a "x")) (alter 'L concat 99) L -- (list 1 'a "x" 99)

;; ========== ALTER REMOVE — list-only (atom or vec of indices) ==========
(set L (list 10 20 30 40 50)) (alter 'L remove 2) L -- (list 10 20 40 50)
(set L (list 10 20 30 40 50)) (alter 'L remove [1 3]) L -- (list 10 30 50)
(set L (list 'a 'b 'c)) (alter 'L remove 0) L -- (list 'b 'c)

;; ========== ALTER SET — different vec types (exercises store_typed_elem dispatch) ==========
(set v [1.0 2.0 3.0]) (alter 'v set 1 9.9) v -- [1.0 9.9 3.0]
(set v [1h 2h 3h]) (alter 'v set 0 99h) v -- [99h 2h 3h]
(set v ['a 'b 'c]) (alter 'v set 1 'X) v -- ['a 'X 'c]
(set v [true false true]) (alter 'v set 0 false) v -- [false false true]

;; ── a sole-owned target is amended in place, a shared one is not ────────
;; alter set used to hand ray_cow a reference it had just retained, so the
;; `rc == 1` test inside could never be true and every write copied the whole
;; vector.  Sole ownership is rc == 2 here — the binding's reference and
;; alter's own.  What must not change is the observable part: a value another
;; binding can still see is copied before the write, so that binding keeps the
;; value it had.
(set AA [1 2 3 4])
(set BB AA)
(alter 'AA set 0 99)
AA -- [99 2 3 4]
BB -- [1 2 3 4]

(set CC (list 1 2 3))
(set DD CC)
(alter 'CC set 1 88)
CC -- (list 1 88 3)
DD -- (list 1 2 3)

;; sole owner: the amend lands and nothing else observes it
(set EE [10 20 30])
(alter 'EE set 2 7)
EE -- [10 20 7]
(alter 'EE set [0 1] 5)
EE -- [5 5 7]

;; a slice is not ours to write through, so it keeps taking the copy path
(set FF [1 2 3 4 5])
(set GG (drop FF 2))
(alter 'GG set 0 42)
GG -- [42 4 5]
FF -- [1 2 3 4 5]

;; ── a dotted target takes the copy when anything on its path is shared ──
;; `ray_env_get` resolves `d.x` to the leaf inside the container, and that
;; leaf usually holds the only reference to itself — so an rc test on it says
;; nothing about whether the container is shared.  Writing through it would be
;; seen by every alias of the dict, and env_set_dotted's COW-rebuild of the
;; chain cannot undo a write that already landed.  Only a chain of dicts each
;; held once is amended in place (test_link.c pins that it is in place).
(set DA (dict ['x] (list (til 3))))
(set DB DA)
(alter 'DA.x set 0 99)
DA.x -- [99 1 2]
DB.x -- [0 1 2]

;; A table-column target is not a writable dictionary path. Report the
;; unsupported target rather than silently discarding a publication error.
(set TA (table [c] (list (til 3))))
(set TB TA)
(alter 'TA.c set 0 77) !- type
(at TA 'c) -- [0 1 2]
(at TB 'c) -- [0 1 2]

;; sole-owned chain: amended in place, at any depth
(set DC (dict [cash v] (list 100 (til 4))))
(alter 'DC.v set 1 50)
(alter 'DC.v set [2 3] 7)
DC.v -- [0 50 7 7]
DC.cash -- 100
(set DN (dict [a] (list (dict [v] (list (til 3))))))
(alter 'DN.a.v set 2 60)
DN.a.v -- [0 1 60]

;; an alias of the head, of an inner dict, or of the leaf itself keeps its value
(set DM DN)
(alter 'DN.a.v set 0 9)
DN.a.v -- [9 1 60]
DM.a.v -- [0 1 60]
(set DI DN.a)
(alter 'DN.a.v set 1 8)
DN.a.v -- [9 8 60]
DI.v -- [9 1 60]
(set DL DC.v)
(alter 'DC.v set 0 -1)
DC.v -- [-1 50 7 7]
DL -- [0 50 7 7]

;; an indexed leaf: dropping the index copies it, and the copy is bound
(set DX (dict [v] (list (.idx.zone [5 1 9]))))
(alter 'DX.v set 0 2)
DX.v -- [2 1 9]
(.idx.has? DX.v) -- false

