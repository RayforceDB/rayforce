;; Invariants for `.emb.cos-dist` (cosine distance).

;; identical integer-coord vectors: distance exactly 0
(.emb.cos-dist [1.0 0.0] [1.0 0.0]) -- 0.0

;; near-zero tolerance for unit-diagonal identical
1 -- (as 'I64 (< (abs (.emb.cos-dist [1.0 1.0] [1.0 1.0])) 0.0001))

;; orthogonal: cos = 0, distance = 1
(.emb.cos-dist [1.0 0.0] [0.0 1.0]) -- 1.0

;; opposite: cos = -1, distance = 2
(.emb.cos-dist [1.0 0.0] [-1.0 0.0]) -- 2.0

;; length mismatch errors
(.emb.cos-dist [1.0 2.0 3.0] [1.0 2.0]) !- length
