;; Invariants for `.emb.norm` (L2 norm).

(.emb.norm [3.0 4.0]) -- 5.0
(.emb.norm [0.0 0.0]) -- 0.0
(.emb.norm [1.0]) -- 1.0
(.emb.norm [1.0 2.0 2.0]) -- 3.0

;; non-negative
1 -- (as 'I64 (>= (.emb.norm [1.0 -2.0 3.0]) 0.0))

;; scale-homogeneous: norm(k*v) == |k|*norm(v)
1 -- (as 'I64 (< (abs (- (.emb.norm [3.0 4.0]) 5.0)) 0.0001))
