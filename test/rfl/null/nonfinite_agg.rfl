;; ─── the slice kernel: c grouped-indexed, then sorted and parted ───
(set I (til 100))
(set k (% I 3))
(set r (% I 50))
(set x (Pick (as 'F64 (% I 97)) [1e200 -1e200] (at XC r)))
(set n (Pick (as 'F64 (% I 89)) [0Nf] (at NC r)))
(set y (Pick (as 'F64 (- (% I 13) 6)) [1e200] (at YC r)))
(set z (Pick (as 'F64 (% I 11)) [1.5e308 -1.5e308] (at ZC r)))
