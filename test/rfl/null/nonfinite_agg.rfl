;; ─── parted: the 70k rows as two partitions ───────────────────────
(.sys.exec "rm -rf /tmp/rfl_nonfinite_agg")
;; numeric columns only: a SYM column written here, read back, then written
;; again by the unfused pass fails with io in the test process (dev too)
(set H (div (count T) 2)) (set T (table [k j x n y z w t s] (list k j x n y z w t s)))
(.db.splayed.set "/tmp/rfl_nonfinite_agg/2024.01.01/t/" (take T H) "/tmp/rfl_nonfinite_agg/.sym")
(.db.splayed.set "/tmp/rfl_nonfinite_agg/2024.01.02/t/" (drop T H) "/tmp/rfl_nonfinite_agg/.sym")
(set P (.db.parted.get "/tmp/rfl_nonfinite_agg" 't))
(count P) -- 70000
(at (select {r: (sum (* x y)) from: P}) 'r) -- (enlist (sum (* x y)))
(at (select {r: (avg (* x y)) from: P}) 'r) -- (enlist (avg (* x y)))
(at (select {r: (min (* x y)) from: P}) 'r) -- (enlist (min (* x y)))
(at (select {r: (max (* x y)) from: P}) 'r) -- (enlist (max (* x y)))
(at (select {r: (count (* x y)) from: P}) 'r) -- (enlist (count (* x y)))
