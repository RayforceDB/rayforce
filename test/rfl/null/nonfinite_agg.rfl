;; ─── flat, 70k rows (the parallel scan) ───────────────────────────
(set I (til 70000))
(set k (% I 3))
(set r (% I 50))
(set x (Pick (as 'F64 (% I 97)) [1e200 -1e200] (at XC r)))
(set n (Pick (as 'F64 (% I 89)) [0Nf] (at NC r)))
(set y (Pick (as 'F64 (- (% I 13) 6)) [1e200] (at YC r)))
(set z (Pick (as 'F64 (% I 11)) [1.5e308 -1.5e308] (at ZC r)))
(set w (Pick (as 'F64 (% I 5)) [-1.5e308 1.5e308] (at WC r)))
(set t (Pick (as 'F64 (% I 9)) [1e200] (at SC r)))
(set s (Pick (+ 2.0 (* 2.0 (as 'F64 (% I 2)))) [1e-200 0.0] (at SC r)))
(set j (% I 2)) (set c (at ['a 'b 'c 'd] (% I 4)))
(set T (table [k j c x n y z w t s] (list k j c x n y z w t s)))
(set W (where (> k 0)))
(at (select {r: (sum (* x y)) from: T}) 'r) -- (enlist (sum (* x y)))
(at (select {r: (avg (* x y)) from: T}) 'r) -- (enlist (avg (* x y)))
(at (select {r: (min (* x y)) from: T}) 'r) -- (enlist (min (* x y)))
(at (select {r: (max (* x y)) from: T}) 'r) -- (enlist (max (* x y)))
(at (select {r: (count (* x y)) from: T}) 'r) -- (enlist (count (* x y)))
(at (select {r: (sum (* x y)) from: T where: (> k 0)}) 'r) -- (enlist (sum (at (* x y) W)))
(at (select {r: (sum (* x y)) from: T by: k}) 'r) -- (map (fn [g] (sum (at (* x y) (where (== k g))))) [0 1 2])
