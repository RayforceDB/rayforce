;; `read` / `read-bytes` must read until EOF, not to the size the file
;; reports — issue #572.
;;
;; The size came from fseek/ftell, and everything under /proc and /sys
;; reports 0 while yielding data when actually read.  The failure was
;; silent: no error, no short-read signal, just a well-formed "" that any
;; caller branching on the content would act on.  Sizing from the file also
;; made an ordinary file that changed between the measure and the read an
;; io error rather than a successful read.

;; ────────────── pre-flight ──────────────
(.sys.exec "rm -rf /tmp/rf_read_eof && mkdir -p /tmp/rf_read_eof")
(.sys.exec "printf 'hello world\\n' > /tmp/rf_read_eof/ordinary.txt")
(.sys.exec "printf '' > /tmp/rf_read_eof/empty.txt")
(.sys.exec "dd if=/dev/zero of=/tmp/rf_read_eof/big.txt bs=1000 count=300 2>/dev/null")

;; ────────────── ordinary files still behave ──────────────
(read "/tmp/rf_read_eof/ordinary.txt")        -- "hello world\n"
(count (read-bytes "/tmp/rf_read_eof/ordinary.txt")) -- 12

;; A genuinely empty file is still "" — the fix must not turn absence of
;; content into an error.
(read "/tmp/rf_read_eof/empty.txt")           -- ""
(count (read-bytes "/tmp/rf_read_eof/empty.txt")) -- 0

;; Larger than any single growth step, to exercise the loop.
(count (read "/tmp/rf_read_eof/big.txt"))       -- 300000
(count (read-bytes "/tmp/rf_read_eof/big.txt")) -- 300000

;; ────────────── files that cannot be sized ──────────────
;; The issue's own examples are under /proc, which is Linux-only, and this
;; harness has no way to skip a line per platform — they live in
;; test_lang.c as lang/io/read_procfs_zero_size, which SKIPs off Linux.
;; The FIFO below is the portable member of the same class: it cannot be
;; seeked at all, so it must be read to EOF on every platform.

;; ────────────── pipes ──────────────
;; A FIFO cannot be seeked, so sizing from the file made this an io error.
;; Reading until EOF makes it work like any other stream.
(.sys.exec "rm -f /tmp/rf_read_eof/fifo && mkfifo /tmp/rf_read_eof/fifo")
(.sys.exec "(printf 'from-a-fifo\\n' > /tmp/rf_read_eof/fifo &) ; sleep 0")
(read "/tmp/rf_read_eof/fifo") -- "from-a-fifo\n"

;; ────────────── errors stay loud ──────────────
(try (read "/tmp/rf_read_eof/does-not-exist") (fn [e] 'io-rejected)) -- 'io-rejected
(try (read-bytes "/tmp/rf_read_eof/does-not-exist") (fn [e] 'io-rejected)) -- 'io-rejected
;; A directory is not readable as a file.
(try (read "/tmp/rf_read_eof") (fn [e] 'io-rejected)) -- 'io-rejected

;; ────────────── cleanup ──────────────
(.sys.exec "rm -rf /tmp/rf_read_eof")
