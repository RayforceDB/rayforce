;; @requires: posix  (servers are spawned and stopped through bash: test/serve.sh, /dev/tcp, kill)
;; A server that holds a shared-memory connection and is stopped then continued
;; (SIGSTOP, SIGCONT: a debugger, a container freeze, a timed-out request's peer)
;; must stay up.  epoll_wait returned EINTR on the continue, xport_woke overwrote
;; the errno before it was looked at, the poll loop returned -1, and a server whose
;; script comes from a pipe or /dev/null took that for a request to exit and ended
;; with status 0 (#1391).

(.sys.exec "rm -rf /tmp/rfl_stop_cont")
(.sys.exec "mkdir -p /tmp/rfl_stop_cont; echo '(set ping (fn [] 42))' > /tmp/rfl_stop_cont/peer.rfl") -- 0
(.sys.exec "test/serve.sh /tmp/rfl_stop_cont/a -c 1 /tmp/rfl_stop_cont/peer.rfl") -- 0
(.sys.exec "bash -c 'D=/tmp/rfl_stop_cont; printf \"(set peer (.ipc.open \\\"127.0.0.1:%s\\\" 1000))\\n(set ping (fn [] 42))\\n\" $(cat $D/a/port) > $D/owner.rfl'") -- 0
(.sys.exec "test/serve.sh /tmp/rfl_stop_cont/b -c 1 /tmp/rfl_stop_cont/owner.rfl") -- 0

(.sys.exec "bash -c 'D=/tmp/rfl_stop_cont; kill -STOP $(cat $D/b/pid); sleep 0.5; kill -CONT $(cat $D/b/pid); sleep 1; kill -0 $(cat $D/b/pid)'") -- 0
(.sys.exec "bash -c 'D=/tmp/rfl_stop_cont; B=$(cat $D/b/port); (echo > /dev/tcp/127.0.0.1/$B)'") -- 0

(.sys.exec "bash -c 'D=/tmp/rfl_stop_cont; kill $(cat $D/a/pid) $(cat $D/b/pid) 2>/dev/null; rm -rf $D; exit 0'") -- 0
