;; @requires: posix  (the server is spawned and stopped through a POSIX shell)
;; The server answered a failed request and then released the error object, which
;; does nothing: errors are not reference counted, so every failed request left
;; a 64-byte block behind (300 failing requests: 19200 bytes).  A server that
;; outlives its clients grows with every bad message it is sent.

(.sys.exec "pkill -TERM -f 'rayforce -p 19981' 2>/dev/null; true")
(.sys.exec "./rayforce -p 19981 </dev/null >/dev/null 2>&1 &")
(.sys.exec "for i in $(seq 30); do bash -c '(echo > /dev/tcp/127.0.0.1/19981) 2>/dev/null' && exit 0; sleep 0.1; done; exit 1") -- 0

(set h (.ipc.open "127.0.0.1:19981"))
(set smem (fn [] (at (.ipc.send h "(.sys.mem)") 'bytes-allocated)))

;; the same on success, as the control
(.ipc.send h "(+ 1 2)")
(set s0 (smem))
(times 300 (.ipc.send h "(+ 1 2)"))
(< (- (smem) s0) 2000) -- true

;; an evaluation error, a message that does not parse, and a value that is no call
(try (.ipc.send h "(+ 1 'a)") 0)
(set s1 (smem))
(times 300 (try (.ipc.send h "(+ 1 'a)") 0))
(< (- (smem) s1) 2000) -- true

(set s2 (smem))
(times 300 (try (.ipc.send h "(+ 1") 0))
(< (- (smem) s2) 2000) -- true

(set s3 (smem))
(times 300 (try (.ipc.send h (list 1 2 3)) 0))
(< (- (smem) s3) 2000) -- true

;; an asynchronous message that fails has nowhere to report it
(set s4 (smem))
(times 300 (.ipc.post h "(+ 1 'a)"))
(.ipc.send h "(+ 1 2)")
(< (- (smem) s4) 2000) -- true

;; a frame whose body does not decode: the decoder answers an error object, which
;; the request handler never freed (a block per frame, for anyone who can reach the
;; port).  Sent raw: the 2-byte handshake, then a header (prefix, version 4, flags,
;; endianness, message type 1 = sync, an 8-byte size of 4) and 4 bytes of nothing.
(set s5 (smem))
(.sys.exec "bash -c 'for i in $(seq 120); do exec 3<>/dev/tcp/127.0.0.1/19981; printf \"\\004\\000\" >&3; sleep 0.01; printf \"\\372\\336\\372\\316\\004\\000\\000\\001\\004\\000\\000\\000\\000\\000\\000\\000\\005\\001\\002\\003\" >&3; sleep 0.01; exec 3>&-; done'")
(.ipc.send h "(+ 1 2)")
(< (- (smem) s5) 3000) -- true

(try (.ipc.send h "(exit 0)") 0)
(.sys.exec "pkill -TERM -f 'rayforce -p 19981' 2>/dev/null; true")
