;; Standalone string transforms. The same operations already lower inside
;; select/update; these assertions pin the direct builtin surface.

(upper "Abc42!") -- "ABC42!"
(lower "AbC42!") -- "abc42!"
(trim "  abc  ") -- "abc"
(trim "\tabc\n") -- "abc"

(upper 'abc) -- 'ABC
(lower 'AbC) -- 'abc

(upper ["ab" "Cd" "EF"]) -- ["AB" "CD" "EF"]
(lower ["AB" "cD" "ef"]) -- ["ab" "cd" "ef"]
(trim [" a " "\tb\t" ""]) -- ["a" "b" ""]
(upper ['ab 'Cd 'EF]) -- ['AB 'CD 'EF]
(lower ['AB 'cD 'EF]) -- ['ab 'cd 'ef]

(substr "abcdef" 2 3) -- "bcd"
(substr "abcdef" 0 2) -- "ab"
(substr "abcdef" 5 -1) -- "ef"
(substr 'abcdef 2 3) -- 'bcd
(substr ["abcdef" "xyz"] 2 2) -- ["bc" "yz"]
(substr (as 'STR (list "abcdefghijklmnopqrstuvwxyz" "short")) 5 -1) -- ["efghijklmnopqrstuvwxyz" "t"]
(substr ["abcdef" "xyz"] [1 2] [3 9]) -- ["abc" "yz"]

;; Null start/length propagates to the empty (null) string — a STR/SYM has no
;; null distinct from ""/'.  A null integer atom is INT64_MIN, so it must be
;; handled before the 1-based->0-based `start - 1` (else signed-overflow UB;
;; regression for src/ops/strop.c substr_atom + src/ops/string.c exec_substr).
(substr "abcdef" 0N 3) -- ""
(substr "abcdef" 2 0N) -- ""
(substr "abcdef" 0N 0N) -- ""
(substr 'abcdef 0N 3) -- '
(substr 'abcdef 2 0N) -- '
;; Columnar path: a scalar null start/length nulls every row.
(substr ["abcdef" "xyz"] 0N 2) -- ["" ""]
(substr ["abcdef" "xyz"] 1 0N) -- ["" ""]

(replace "banana" "a" "A") -- "bAnAnA"
(replace "banana" "na" "NA") -- "baNANA"
(replace 'banana "a" "A") -- 'bAnAnA
(replace ["a-b" "c-d"] "-" "_") -- ["a_b" "c_d"]
(replace (upper ["a-b" "c-d"]) "-" "_") -- ["A_B" "C_D"]
(concat ["a" "b"] "/") -- ["a/" "b/"]
(concat "/" ["a" "b"]) -- ["/a" "/b"]

(substr [1 2 3] 1 1) !- type
(replace ["a"] 1 "x") !- type

;; A string literal reaches the compiled string ops as an atom, whose len
;; field aliases its payload: the ops read that many rows past it.  An update
;; with (strlen "abc") or (trim " ab") crashed, (upper (first s)) beside a
;; column returned hundreds of garbage rows, and substr / replace asked for
;; petabytes.
(set TsL (table [x s t] (list (til 4) ['ab 'cd 'ef 'gh] (list "ab" "cd" "ef" "gh"))))
(at (update {y: (strlen "abc") from: TsL}) 'y) -- [3 3 3 3]
(at (update {x: (strlen "abc") from: TsL}) 'x) -- [3 3 3 3]
(at (update {y: (trim " ab") from: TsL}) 'y) -- ["ab" "ab" "ab" "ab"]
(at (update {y: (upper "ab") from: TsL}) 'y) -- ["AB" "AB" "AB" "AB"]
(at (update {y: (lower 'AB) from: TsL}) 'y) -- ['ab 'ab 'ab 'ab]
(at (select {a: (upper (first s)) b: x from: TsL}) 'a) -- ['AB 'AB 'AB 'AB]
(at (select {a: (upper (first t)) b: x from: TsL}) 'a) -- ["AB" "AB" "AB" "AB"]
(at (update {y: (substr "abcdef" 1 3) from: TsL}) 'y) -- ["abc" "abc" "abc" "abc"]
(at (update {y: (replace "abcabc" "b" "x") from: TsL}) 'y) -- ["axcaxc" "axcaxc" "axcaxc" "axcaxc"]
;; concat reads a symbol literal or scalar's text: only SYM vectors were read,
;; so (concat 'ab 'cd) in a query came back null and (concat (first s) "x")
;; dropped the symbol.
(at (select {y: (concat 'ab 'cd) z: x from: TsL}) 'y) -- ['abcd 'abcd 'abcd 'abcd]
(at (select {y: (concat (first s) "x") z: x from: TsL}) 'y) -- ['abx 'abx 'abx 'abx]
(at (select {y: (concat s 'zz) from: TsL}) 'y) -- ['abzz 'cdzz 'efzz 'ghzz]
(at (select {y: (concat t 'q) from: TsL}) 'y) -- ["abq" "cdq" "efq" "ghq"]
