;; Standalone string transforms. The same operations already lower inside
;; select/update; these assertions pin the direct builtin surface.

(upper "Abc42!") -- "ABC42!"
(lower "AbC42!") -- "abc42!"
(trim "  abc  ") -- "abc"
(trim "\tabc\n") -- "abc"

(upper 'abc) -- 'ABC
(lower 'AbC) -- 'abc

(upper ["ab" "Cd" "EF"]) -- ["AB" "CD" "EF"]
(lower ["AB" "cD" "ef"]) -- ["ab" "cd" "ef"]
(trim [" a " "\tb\t" ""]) -- ["a" "b" ""]
(upper ['ab 'Cd 'EF]) -- ['AB 'CD 'EF]
(lower ['AB 'cD 'EF]) -- ['ab 'cd 'ef]

(substr "abcdef" 2 3) -- "bcd"
(substr "abcdef" 0 2) -- "ab"
(substr "abcdef" 5 -1) -- "ef"
(substr 'abcdef 2 3) -- 'bcd
(substr ["abcdef" "xyz"] 2 2) -- ["bc" "yz"]
(substr (as 'STR (list "abcdefghijklmnopqrstuvwxyz" "short")) 5 -1) -- ["efghijklmnopqrstuvwxyz" "t"]
(substr ["abcdef" "xyz"] [1 2] [3 9]) -- ["abc" "yz"]

;; Null start/length propagates to the empty (null) string — a STR/SYM has no
;; null distinct from ""/'.  A null integer atom is INT64_MIN, so it must be
;; handled before the 1-based->0-based `start - 1` (else signed-overflow UB;
;; regression for src/ops/strop.c substr_atom + src/ops/string.c exec_substr).
(substr "abcdef" 0N 3) -- ""
(substr "abcdef" 2 0N) -- ""
(substr "abcdef" 0N 0N) -- ""
(substr 'abcdef 0N 3) -- '
(substr 'abcdef 2 0N) -- '
;; Columnar path: a scalar null start/length nulls every row.
(substr ["abcdef" "xyz"] 0N 2) -- ["" ""]
(substr ["abcdef" "xyz"] 1 0N) -- ["" ""]

(replace "banana" "a" "A") -- "bAnAnA"
(replace "banana" "na" "NA") -- "baNANA"
(replace 'banana "a" "A") -- 'bAnAnA
(replace ["a-b" "c-d"] "-" "_") -- ["a_b" "c_d"]
(replace (upper ["a-b" "c-d"]) "-" "_") -- ["A_B" "C_D"]
(concat ["a" "b"] "/") -- ["a/" "b/"]
(concat "/" ["a" "b"]) -- ["/a" "/b"]

(substr [1 2 3] 1 1) !- type
(replace ["a"] 1 "x") !- type

;; A string literal reaches the compiled string ops as an atom, whose len
;; field aliases its payload: the ops read that many rows past it.  An update
;; with (strlen "abc") or (trim " ab") crashed, (upper (first s)) beside a
;; column returned hundreds of garbage rows, and substr / replace asked for
;; petabytes.
(set TsL (table [x s t] (list (til 4) ['ab 'cd 'ef 'gh] (list "ab" "cd" "ef" "gh"))))
(at (update {y: (strlen "abc") from: TsL}) 'y) -- [3 3 3 3]
(at (update {x: (strlen "abc") from: TsL}) 'x) -- [3 3 3 3]
(at (update {y: (trim " ab") from: TsL}) 'y) -- ["ab" "ab" "ab" "ab"]
(at (update {y: (upper "ab") from: TsL}) 'y) -- ["AB" "AB" "AB" "AB"]
(at (update {y: (lower 'AB) from: TsL}) 'y) -- ['ab 'ab 'ab 'ab]
(at (select {a: (upper (first s)) b: x from: TsL}) 'a) -- ['AB 'AB 'AB 'AB]
(at (select {a: (upper (first t)) b: x from: TsL}) 'a) -- ["AB" "AB" "AB" "AB"]
(at (update {y: (substr "abcdef" 1 3) from: TsL}) 'y) -- ["abc" "abc" "abc" "abc"]
(at (update {y: (replace "abcabc" "b" "x") from: TsL}) 'y) -- ["axcaxc" "axcaxc" "axcaxc" "axcaxc"]
;; concat reads a symbol literal or scalar's text: only SYM vectors were read,
;; so (concat 'ab 'cd) in a query came back null and (concat (first s) "x")
;; dropped the symbol.
(at (select {y: (concat 'ab 'cd) z: x from: TsL}) 'y) -- ['abcd 'abcd 'abcd 'abcd]
(at (select {y: (concat (first s) "x") z: x from: TsL}) 'y) -- ['abx 'abx 'abx 'abx]
(at (select {y: (concat s 'zz) from: TsL}) 'y) -- ['abzz 'cdzz 'efzz 'ghzz]
(at (select {y: (concat t 'q) from: TsL}) 'y) -- ["abq" "cdq" "efq" "ghq"]

;; A SYM vector long enough for the pool (above RAY_PARALLEL_THRESHOLD):
;; str-find resolves its strings in parallel, substr at scalar bounds cuts
;; each distinct code once and fills the rows from their code's rank.  Each
;; result is checked row by row against the atom builtin, on a vector of
;; the runtime domain and on a column read back from a splayed table (a
;; FILE domain).  Picks: the first codes, the repeat of the first, the
;; middle, the last.
(.sys.exec "rm -rf /tmp/rfl_sso_sym")
(set ssoN 70000)
(set ssoS (as 'SYM (map (fn [i] (format "http://www.host%.example.org/p/%" (% i 311) i)) (til ssoN))))
(set ssoE (as 'SYM (map (fn [i] (if (== (% i 5) 0) "" (format "k%" (% i 13)))) (til ssoN))))
(set ssoPick [0 1 2 310 311 312 1000 34999 69998 69999])
(set ssoRef (fn [f v] (map (fn [i] (f (at v i))) ssoPick)))
(all (== (at (substr ssoS 8 -1) ssoPick) (ssoRef (fn [x] (substr x 8 -1)) ssoS))) -- true
(all (== (at (substr ssoS 16 3) ssoPick) (ssoRef (fn [x] (substr x 16 3)) ssoS))) -- true
(all (== (at (substr ssoS 60 3) ssoPick) (ssoRef (fn [x] (substr x 60 3)) ssoS))) -- true
(all (== (at (substr ssoE 2 -1) ssoPick) (ssoRef (fn [x] (substr x 2 -1)) ssoE))) -- true
(count (distinct (substr ssoS 16 3))) -- 311
(count (distinct (substr ssoE 2 -1))) -- 14
(all (== (at (str-find ssoS "host") ssoPick) (ssoRef (fn [x] (str-find x "host")) ssoS))) -- true
(all (== (at (str-find ssoE "9") ssoPick) (ssoRef (fn [x] (str-find x "9")) ssoE))) -- true
(sum (fills (str-find ssoE "9"))) -- 69991
(.db.splayed.set "/tmp/rfl_sso_sym/t" (table [s e] (list ssoS ssoE)))
(set ssoF (.db.splayed.get "/tmp/rfl_sso_sym/t"))
(all (== (at (at (select {from: ssoF r: (substr s 8 -1)}) 'r) ssoPick) (ssoRef (fn [x] (substr x 8 -1)) ssoS))) -- true
(all (== (at (at (select {from: ssoF r: (substr e 2 -1)}) 'r) ssoPick) (ssoRef (fn [x] (substr x 2 -1)) ssoE))) -- true
(all (== (at (at (select {from: ssoF r: (str-find s "/p/")}) 'r) ssoPick) (ssoRef (fn [x] (str-find x "/p/")) ssoS))) -- true
(at (select {from: ssoF by: (substr s 12 7) c: (count s) desc: c take: 1}) 'c) -- [226]
(.sys.exec "rm -rf /tmp/rfl_sso_sym")
;; The same column with per-column compressed symfiles: an entry is decoded
;; into the reading thread's ring, so str-find reads a file's strings one at
;; a time and substr leaves such a column to its row loop.
(.sys.exec "rm -rf /tmp/rfl_sso_z")
(.db.splayed.set "/tmp/rfl_sso_z/t" (table [s e] (list ssoS ssoE)) {symfile: 'column compress: true})
(set ssoZ (.db.splayed.get "/tmp/rfl_sso_z/t"))
(all (== (at (select {from: ssoZ r: (str-find s "/p/")}) 'r) (str-find ssoS "/p/"))) -- true
(all (== (at (select {from: ssoZ r: (str-find e "9")}) 'r) (str-find ssoE "9"))) -- true
(all (== (at (select {from: ssoZ r: (substr s 8 -1)}) 'r) (substr ssoS 8 -1))) -- true
(all (== (at (select {from: ssoZ r: (substr e 2 -1)}) 'r) (substr ssoE 2 -1))) -- true
(.sys.exec "rm -rf /tmp/rfl_sso_z")
