;; str_atom_long.rfl — string-atom take / at / filter past the 8 KiB
;; stack buffer.  These paths used to fail with "limit" once the result
;; exceeded 8192 bytes; they must work for any length.

(count (take "ab" 8192))   -- 8192
(count (take "ab" 8193))   -- 8193
(count (take "ab" 200000)) -- 200000
(count (take "ab" -20001)) -- 20001
(count (take 'x' 9000))    -- 9000
(at (take "abc" 20000) 19999) -- "b"
(at (take "abc" -20000) 0)    -- "b"

;; (at str idx-vector)
(count (at (take "ab" 20000) (til 20000))) -- 20000
(at (take "ab" 20000) [0 1 19999])         -- "abb"
(at (take "ab" 20000) [0 20000])           !- domain

;; index vector longer than the 8 KiB stack buffer: `at` takes a heap buffer
;; and must release it on the error path too.
(at (take "ab" 20000) (concat (til 9000) [20000])) !- domain
(at (take "ab" 20000) (concat (til 9000) [-1]))    !- domain

;; The buffer lives on the runtime's own heap, so LeakSanitizer cannot see a
;; missed release; pin it through the allocator's live-byte counter instead.
;; 50 failing calls would strand ~16 KiB each if the buffer were not freed.
(set _sl_s (take "ab" 20000))
(set _sl_hi (concat (til 9000) [20000]))
(set _sl_lo (concat (til 9000) [-1]))
(set _sl_r 0)
(set _sl_m0 (at (.sys.mem) 'bytes-allocated))
(set _sl_r (map (fn [i] (try (at _sl_s _sl_hi) (fn [e] 0))) (til 50)))
(set _sl_r (map (fn [i] (try (at _sl_s _sl_lo) (fn [e] 0))) (til 50)))
(set _sl_r 0)
(< (- (at (.sys.mem) 'bytes-allocated) _sl_m0) 65536) -- true

;; filter by a bool mask
(count (filter (take "ab" 20000) (take [true false] 20000))) -- 10000
