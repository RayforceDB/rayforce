;; eval_fallback_parted.rfl — a projection the DAG declines (temporal + - *)
;; over a partitioned table is answered by the eval-level fallback (review of
;; #690).
;;
;; The fallback evaluated projections straight over the parted table; its
;; per-row reader has no arm for segmented columns, so `x: (+ d 1)` over a
;; .db.parted.get table raised `type` while the same query over a flat table
;; worked.  Parted columns are now flattened before the fallback runs, as
;; `update` already does.
;; @requires: posix

(.sys.exec "rm -rf /tmp/rfl_evalfb_parted")
(set T (table [i str d name] (list [1 2 3 4] (list "a" "" "ccc" "dd") [2001.01.01 2002.01.01 2003.01.01 2004.01.01] [Alice Bob Carol Dan])))
(.db.splayed.set "/tmp/rfl_evalfb_parted/2024.01.01/t/" T "/tmp/rfl_evalfb_parted/.sym")
(.db.splayed.set "/tmp/rfl_evalfb_parted/2024.01.02/t/" T "/tmp/rfl_evalfb_parted/.sym")
(set P (.db.parted.get "/tmp/rfl_evalfb_parted/" 't))

;; ─── control: a compiled projection over the parted table ───────────────────
(count (select {i: i from: P})) -- 8

;; ─── temporal arithmetic alone, and beside passthroughs of every kind ────────
(at (select {x: (+ d 1) from: P}) 'x) -- (+ (at P 'd) 1)
(at (select {i: i x: (+ d 1) from: P}) 'i) -- [1 2 3 4 1 2 3 4]
(type (at (select {name: name x: (+ d 1) from: P}) 'name)) -- 'SYM
(at (select {name: name x: (+ d 1) from: P}) 'name) -- [Alice Bob Carol Dan Alice Bob Carol Dan]
(type (at (select {str: str x: (+ d 1) from: P}) 'str)) -- 'STR
(at (select {str: str x: (+ d 1) from: P}) 'str) -- (list "a" "" "ccc" "dd" "a" "" "ccc" "dd")
;; with a where: clause
(at (select {i: i x: (+ d 1) from: P where: (> i 2)}) 'i) -- [3 4 3 4]

;; ─── arithmetic on the partition key itself ─────────────────────────────────
;; The key scans as the MAPCOMMON wrapper, which named no value type to the
;; planner's type guards: `(+ date 1)` ran as raw integer arithmetic and came
;; back as day counts (8768, not 2024.01.03), `(in (+ date 0) [..])` compared
;; those against a DATE set and kept no row, and the arithmetic on a SYM key
;; added to interned ids.  Oracle: the same select over a flat copy.
(set F (select {from: P where: (> i 0)}))
(at (select {i: i from: P where: (in (+ date 0) [2024.01.02])}) 'i) -- [1 2 3 4]
(at (select {i: i from: P where: (in (+ date 0) [2024.01.02])}) 'i) -- (at (select {i: i from: F where: (in (+ date 0) [2024.01.02])}) 'i)
(at (select {i: i from: P where: (in (+ date 1) [2024.01.02])}) 'i) -- [1 2 3 4]
(at (select {i: i from: P where: (not (in (- date 1) [2023.12.31]))}) 'i) -- [1 2 3 4]
(at (select {i: i from: P where: (and (> i 2) (in (+ date 0) [2024.01.01]))}) 'i) -- [3 4]
(count (select {i: i from: P where: (in (+ date 0) [2024.01.05])})) -- 0
(at (select {c: (count i) from: P where: (in (+ date 0) [2024.01.02])}) 'c) -- [4]
(type (at (select {c: (count i) by: {m: (+ date 1)} from: P}) 'm)) -- 'DATE
(at (select {c: (count i) by: {m: (+ date 1)} from: P}) 'm) -- [2024.01.02 2024.01.03]
(at (select {c: (count i) by: {m: (+ date 1)} from: P}) 'm) -- (at (select {c: (count i) by: {m: (+ date 1)} from: F}) 'm)
(at (select {c: (count i) by: {m: (+ date 1)} from: P where: (> i 2)}) 'c) -- [2 2]
(at (select {c: (count i) by: {m: (- date 1) n: name} from: P where: (> i 3)}) 'm) -- [2023.12.31 2024.01.01]
(at (select {x: (+ date 1) from: P}) 'x) -- (at (select {x: (+ date 1) from: F}) 'x)
(at (select {m: (max (+ date 1)) from: P}) 'm) -- [2024.01.03]
;; A where: the planner declines is evaluated over the columns it reads,
;; flattened: one read through a quoted symbol (the column inside a query)
;; too, and every column when it calls a helper the planner does not
;; inline, whose reads it does not show.  Both raised `cannot add ? and i64`.
(at (select {i: i from: P where: (in (+ 'date 0) [2024.01.02])}) 'i) -- [1 2 3 4]
(at (select {i: i from: P where: (in (+ 'date 0) [2024.01.02])}) 'i) -- (at (select {i: i from: F where: (in (+ 'date 0) [2024.01.02])}) 'i)
(set gdx (fn [x] (set gdq 1) (+ date x)))
(at (select {i: i from: P where: (== (gdx 1) 2024.01.03)}) 'i) -- [1 2 3 4]
(at (select {i: i from: P where: (== (gdx 1) 2024.01.03)}) 'i) -- (at (select {i: i from: F where: (== (gdx 1) 2024.01.03)}) 'i)
;; The key's value type guards unary ops, aggregate admission and `and`
;; too.  The wrapper holds one value per partition, which `neg`/`abs` read
;; as the rows (dates came back), and `sum` folded the day counts.  A unary
;; op on the key is evaluated, as the builtin over the key's values; `sum`
;; rejects a DATE key as it rejects a flat DATE column.
(select {d: (neg date) from: P}) !- type
(select {d: (abs date) from: P}) !- type
(neg (at F 'date)) !- type
(select {c: (sum date) from: P}) !- type
(select {c: (sum date) from: F}) !- type
(select {c: (sum date) by: i from: P}) !- type
(select {c: (sum date) by: i from: F}) !- type
(select {c: (+ (sum date) 0) from: P}) !- type
(select {c: (and date (> i 0)) from: P}) !- type
(select {c: (and date (> i 0)) from: F}) !- type
(at (select {d: (min date) from: P}) 'd) -- (at (select {d: (min date) from: F}) 'd)
;; (at (select {d: (neg date) from: F}) 'd) !- type   ;; xfail BUG: over a flat DATE column the fused DAG negates the day counts ([-8766 ...], abs likewise) where the builtin and the parted key raise type
(.sys.exec "rm -rf /tmp/rfl_evalfb_parted")

;; An integer key keeps its I64 lane; a partition with no rows takes part.
(.sys.exec "rm -rf /tmp/rfl_evalfb_parted_int")
(.db.splayed.set "/tmp/rfl_evalfb_parted_int/1/t/" (table [i] (list [1 2])))
(.db.splayed.set "/tmp/rfl_evalfb_parted_int/2/t/" (table [i] (list (take [1] 0))))
(.db.splayed.set "/tmp/rfl_evalfb_parted_int/3/t/" (table [i] (list [3 4 5])))
(set PI (.db.parted.get "/tmp/rfl_evalfb_parted_int/" 't))
(at (select {i: i from: PI where: (in (+ part 0) [3])}) 'i) -- [3 4 5]
(at (select {i: i from: PI where: (in (* part 2) [2])}) 'i) -- [1 2]
(at (select {c: (count i) by: {m: (+ part 1)} from: PI}) 'm) -- [2 4]
(type (at (select {c: (count i) by: {m: (+ part 1)} from: PI}) 'm)) -- 'I64
(set FI (select {from: PI where: (> i 0)}))
(at (select {d: (neg part) from: PI}) 'd) -- [-1 -1 -3 -3 -3]
(at (select {d: (neg part) from: PI}) 'd) -- (at (select {d: (neg part) from: FI}) 'd)
(at (select {d: (abs (neg part)) from: PI}) 'd) -- (at (select {d: (abs (neg part)) from: FI}) 'd)
(.sys.exec "rm -rf /tmp/rfl_evalfb_parted_int")

;; A SYM key has no arithmetic, as over a flat SYM column.
(.sys.exec "rm -rf /tmp/rfl_evalfb_parted_sym")
(.db.splayed.set "/tmp/rfl_evalfb_parted_sym/1.2.3/t/" (table [i] (list [1 2])))
(.db.splayed.set "/tmp/rfl_evalfb_parted_sym/4.5.6/t/" (table [i] (list [3])))
(set PS (.db.parted.get "/tmp/rfl_evalfb_parted_sym/" 't))
(select {x: (+ part 1) from: PS}) !- type
(select {i: i from: PS where: (in (+ part 1) [2])}) !- type
(select {c: (count i) by: {m: (+ part 1)} from: PS}) !- type
;; nor a sum: it summed the interned ids
(select {c: (sum part) from: PS}) !- type
(select {c: (sum part) from: (select {from: PS where: (> i 0)})}) !- type
(select {c: (sum part) by: i from: PS}) !- type
(.sys.exec "rm -rf /tmp/rfl_evalfb_parted_sym")
