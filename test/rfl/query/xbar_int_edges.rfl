(at (select {from: T r: (xbar (min v v) 7)}) 'r) -- E
(at (select {from: T r: (xbar v w)}) 'r) -- E
(asc (at (select {from: T by: {k: (xbar v 7)} c: (count v)}) 'k)) -- (asc (distinct E))
(first (at (select {from: T where: (== (xbar v 7) (at E 0)) c: (count v)}) 'c)) -- (sum (== E (at E 0)))
