;; @also-unfused
;; xbar_int_edges.rfl -- a query's xbar near the ends of an integer or
;; temporal lane gives the eager vector xbar's answer, with no signed overflow
;; (issue #1348).
;;
;; floor(a / b) * b of a value within |b| of the lane's minimum (b > 0) or
;; maximum (b < 0) lies past the range.  The eager vector kernel wraps it
;; through unsigned arithmetic; the atom xbar, which the query reaches through
;; its per-row route and the eager vector-by-vector form, multiplied signed and
;; overflowed.  Every golden here is the eager vector xbar over an atom bucket.
;; Each bucket is checked through the eager atom xbar, the eager vector-by-vector
;; form, the query's DAG projection, its per-row route (`(min v v)` declines the
;; DAG compile), a vector divisor column, a by-dict key and a where predicate.
;; The null (the lane's minimum) stays null, and a power-of-two bucket that
;; rounds a value down to the minimum reads it back as null, as eager does.

;; --- the issue's repro ---
(set f [7.9 -7.9 1.5 1e300 -1e300 0.0 2.5])
(set Tf (table [f] (list f)))
(at (select {from: Tf r: (xbar (as 'TIMESTAMP f) 1000)}) 'r) -- (xbar (as 'TIMESTAMP f) 1000)
(at (select {from: Tf r: (xbar (as 'TIMESTAMP f) -1000)}) 'r) -- (xbar (as 'TIMESTAMP f) -1000)
(at (select {from: Tf r: (xbar (as 'I64 (as 'TIMESTAMP f)) 1000)}) 'r) -- (xbar (as 'I64 (as 'TIMESTAMP f)) 1000)

;; --- I64 ---
(set V (concat (as 'I64 [-9223372036854775807 -9223372036854775806 -9223372036854775805 -9223372036854775308 -9223372036854775001 -9223372036854774809 -9223372036854774808 -9223372036854774785 -9223372036854774784 -9223372036854774783 9223372036854775807 9223372036854775806 9223372036854775805 9223372036854775308 9223372036854775001 9223372036854774809 9223372036854774808 9223372036854774785 9223372036854774784 9223372036854774783 0 5 -5]) 0Nl))
(set n (count V))
(set E (xbar V 1000))
(set T (table [v w] (list V (take 1000 n))))
(map (fn [x] (xbar x 1000)) V) -- E
(xbar V (take 1000 n)) -- E
(at (select {from: T r: (xbar v 1000)}) 'r) -- E
(at (select {from: T r: (xbar (min v v) 1000)}) 'r) -- E
(at (select {from: T r: (xbar v w)}) 'r) -- E
(asc (at (select {from: T by: {k: (xbar v 1000)} c: (count v)}) 'k)) -- (asc (distinct E))
(first (at (select {from: T where: (== (xbar v 1000) (at E 0)) c: (count v)}) 'c)) -- (sum (== E (at E 0)))
