;; Whole-column verbs (distinct / asc / desc / reverse / where) as SELECT projections.
;;
;; These builtins consume an entire column and return a vector; the DAG has no
;; bucket for them, so the projection lands in the eval fallback.  Previously the
;; fallback scattered the verb per-row: `distinct` errored ("argument must be a
;; list, got <type>") and asc/desc/reverse SILENTLY returned the column
;; untouched (reordering a 1-element slice is a no-op).  They are now evaluated
;; once against the full column (src/ops/query.c: eval_expr_whole_column).
;;
;; Oracle: a whole-column projection must equal the standalone verb applied to
;; the column, so each assertion compares against the eager form rather than a
;; hardcoded order (distinct is sorted for ints, first-occurrence for syms).

(set T (table [v] (list [3 1 2 2 1])))

;; ── projection result == standalone verb over the column ────────────────────
(at (select {v: (distinct v) from: T}) 'v) -- (distinct [3 1 2 2 1])
(at (select {v: (asc v)      from: T}) 'v) -- (asc [3 1 2 2 1])
(at (select {v: (desc v)     from: T}) 'v) -- (desc [3 1 2 2 1])
(at (select {v: (reverse v)  from: T}) 'v) -- (reverse [3 1 2 2 1])

;; ── a single distinct column defines the output length ──────────────────────
(count (select {v: (distinct v) from: T})) -- 3

;; ── WHERE filters BEFORE the whole-column verb sees the column ───────────────
;;   rows where v>1 → [3 2 2] → distinct of that
(at (select {v: (distinct v) from: T where: (> v 1)}) 'v) -- (distinct [3 2 2])

;; ── order the distinct result (single fluent query, issue #16 shape) ─────────
(at (xasc  (select {v: (distinct v) from: T}) 'v) 'v) -- [1 2 3]
(at (xdesc (select {v: (distinct v) from: T}) 'v) 'v) -- [3 2 1]

;; ── SYM column distinct (first-occurrence order) ────────────────────────────
(at (select {d: (distinct d) from: (table [d] (list ['zebra 'apple 'mango 'apple]))}) 'd) -- ['zebra 'apple 'mango]

;; ── where: the indices of the true rows, over the whole column ──────────────
;;   Scattered per row it was handed one b8 cell, and failed with "where:
;;   argument must be a b8 vector, got b8".  A null compares false, as the
;;   where: clause drops it.
(set TW (table [i j] (list [1 0Nl 3 4] [5 6 7 8])))
(at (select {w: (where (> i 2)) from: TW}) 'w) -- (where (> [1 0Nl 3 4] 2))
(at (select {w: (where (> i 2)) from: TW}) 'w) -- [2 3]
(at (select {c: (count (where (> i 2))) from: TW}) 'c) -- [2]
(first (at (select {c: (count (where (> i 2))) from: TW}) 'c)) -- (count (select {from: TW where: (> i 2)}))
(at (select {c: (count (where (> i 2))) from: TW where: (> j 5)}) 'c) -- [2]
(at (select {c: (first (where (> i 2))) from: TW}) 'c) -- [2]
(select {w: (where (> i 2)) j: j from: TW}) !- length
(where true) !- type

;; ── ragged result rejected: a length-changing column beside a full column ────
(select {a: (distinct v) b: v from: T}) !- length

;; A scalar that reaches the projection as a one-element vector rather than
;; an atom (arithmetic over a reduction, or an `if` whose parts are all
;; scalar) broadcasts like an atom next to a full column.  The table used to
;; take its row count from the first column, so these came back with 1 row
;; and columns of different lengths.
(set TB (table [x] (list (til 6))))
(count (select {k: (+ (sum x) 0) y: x from: TB})) -- 6
(at (select {k: (+ (sum x) 0) y: x from: TB}) 'k) -- [15 15 15 15 15 15]
(at (select {k: (if true 7 0) y: x from: TB}) 'k) -- [7 7 7 7 7 7]
(at (select {y: x k: (if (> (count x) 3) 1 0) from: TB}) 'k) -- [1 1 1 1 1 1]
(at (select {k: (if true 7 0) y: x from: TB where: (> x 2)}) 'k) -- [7 7 7]
;; every column a scalar: the one-row result stays
(count (select {k: (+ (sum x) 0) from: TB})) -- 1
(count (select {k: (+ (sum x) 0) y: x from: (table [x] (list (til 0)))})) -- 0

;; The same over a parted table, whose columns count rows across partitions.
(.sys.exec "rm -rf /tmp/rfl_scalar_bcast_parted")
(.db.splayed.set "/tmp/rfl_scalar_bcast_parted/1/t/" (table [x] (list (til 4))))
(.db.splayed.set "/tmp/rfl_scalar_bcast_parted/2/t/" (table [x] (list (+ 10 (til 3)))))
(set TPB (.db.parted.get "/tmp/rfl_scalar_bcast_parted/" 't))
(at (select {k: (+ (sum x) 0) y: x from: TPB}) 'k) -- (take 39 7)
(at (select {y: x k: (if true 7 0) from: TPB}) 'k) -- (take 7 7)
(count (select {k: (+ (sum x) 0) from: TPB})) -- 1
(.sys.exec "rm -rf /tmp/rfl_scalar_bcast_parted") -- 0

;; A scalar aggregate over a whole-column verb, `(first (asc k))`, has no DAG
;; node and lands in the scalar-aggregate eval fallback, which binds every
;; column whole.  Over a parted table it bound the parted column itself, and
;; `asc` rejected it ("asc expects a vector", #732).  Parted == flat for
;; first/last over asc/desc, with or without where:, across column types.
(.sys.exec "rm -rf /tmp/rfl_scalar_asc_parted")
(set W1 (table [s k f t d n] (list ['b 'a 'c] [3 1 2] [1.5 0.5 2.5] (list "bb" "aa" "cc") [2024.03.02 2024.03.01 2024.03.05] [7 0Nl 5])))
(set W2 (table [s k f t d n] (list ['a ' 'd] [5 4 6] [-1.0 4.0 0Nf] (list "ab" "" "zz") [2024.02.01 2024.04.01 2024.01.09] [0Nl 2 9])))
(.db.splayed.set "/tmp/rfl_scalar_asc_parted/2024.01.01/t/" W1)
(.db.splayed.set "/tmp/rfl_scalar_asc_parted/2024.01.02/t/" W2)
(set TPW (.db.parted.get "/tmp/rfl_scalar_asc_parted/" 't))
(set TFW (table [s k f t d n] (list (concat (at W1 's) (at W2 's)) (concat (at W1 'k) (at W2 'k)) (concat (at W1 'f) (at W2 'f)) (concat (at W1 't) (at W2 't)) (concat (at W1 'd) (at W2 'd)) (concat (at W1 'n) (at W2 'n)))))
(at (select {x: (first (asc k)) from: TPW}) 'x) -- [1]
(select {x: (first (asc k)) from: TPW}) -- (select {x: (first (asc k)) from: TFW})
(select {x: (last (asc k)) y: (first (desc k)) from: TPW}) -- (select {x: (last (asc k)) y: (first (desc k)) from: TFW})
(select {x: (first (asc f)) y: (last (asc f)) from: TPW}) -- (select {x: (first (asc f)) y: (last (asc f)) from: TFW})
(select {x: (first (asc s)) y: (last (asc s)) z: (first (desc s)) from: TPW}) -- (select {x: (first (asc s)) y: (last (asc s)) z: (first (desc s)) from: TFW})
(select {x: (first (asc t)) y: (last (asc t)) from: TPW}) -- (select {x: (first (asc t)) y: (last (asc t)) from: TFW})
(select {x: (first (asc d)) y: (last (desc d)) from: TPW}) -- (select {x: (first (asc d)) y: (last (desc d)) from: TFW})
(select {x: (first (asc n)) y: (last (asc n)) from: TPW}) -- (select {x: (first (asc n)) y: (last (asc n)) from: TFW})
(select {x: (first (asc k)) c: (count k) m: (min s) from: TPW}) -- (select {x: (first (asc k)) c: (count k) m: (min s) from: TFW})
(select {x: (first (asc s)) y: (last (asc k)) from: TPW where: (> k 1)}) -- (select {x: (first (asc s)) y: (last (asc k)) from: TFW where: (> k 1)})
;; A scalar aggregate whose source reads no column has nothing of the
;; table to bind: over a parted table it answers as over a flat one.
(at (select {x: (count [1 2 3]) from: TPW}) 'x) -- [3]
(at (select {x: (first (asc [3 1 2])) from: TPW}) 'x) -- [1]
(select {x: (count [1 2 3]) y: (first (asc [3 1 2])) from: TPW}) -- (select {x: (count [1 2 3]) y: (first (asc [3 1 2])) from: TFW})

;; An aggregate source that reads no column and has no DAG node, `(til 5)`,
;; is one collection whatever the row: `(count (til 5))` is 5, as outside a
;; select.  It was evaluated row by row and counted once per row (the row
;; count; `sum`/`max` rejected the list of per-row vectors).  A scalar
;; source keeps its per-row meaning: `(sum 1)` is the row count.
(at (select {x: (count (til 5)) from: TFW}) 'x) -- [5]
(at (select {x: (count (til 5)) from: TPW}) 'x) -- [5]
(at (select {x: (count (til 5)) from: TFW where: (> k 2)}) 'x) -- [5]
(at (select {x: (count (til 5)) from: TPW where: (> k 2)}) 'x) -- [5]
(at (select {x: (count (+ 1 (til 5))) y: (count k) from: TPW}) 'x) -- [5]
(at (select {x: (max (til 5)) from: TFW}) 'x) -- [4]
(at (select {x: (max (til 5)) from: TPW}) 'x) -- [4]
(set n5 5)
(at (select {x: (count (til n5)) from: TPW}) 'x) -- [5]
(at (select {x: (count (til 5)) from: TFW by: s asc: s}) 'x) -- [5 5 5 5 5]
(at (select {x: (count (til 5)) from: TPW by: s asc: s}) 'x) -- [5 5 5 5 5]
(at (select {x: (sum 1) from: TPW}) 'x) -- [6]
(at (select {x: (count 1) from: TFW}) 'x) -- [6]
;; Grouped, every aggregate over such a source takes it whole in each
;; group; the groups are uneven ('a holds two rows), so counting or summing
;; the group's rows shows.
(at (select {x: (sum (til 5)) from: TFW by: s asc: s}) 'x) -- [10 10 10 10 10]
(at (select {x: (sum (til 5)) from: TPW by: s asc: s}) 'x) -- [10 10 10 10 10]
(at (select {x: (min (+ 1 (til 5))) y: (max (til 5)) from: TFW by: s asc: s}) 'x) -- [1 1 1 1 1]
(at (select {x: (min (+ 1 (til 5))) y: (max (til 5)) from: TPW by: s asc: s}) 'y) -- [4 4 4 4 4]
(at (select {x: (avg (til 5)) from: TFW by: s asc: s}) 'x) -- [2.0 2.0 2.0 2.0 2.0]
(at (select {x: (avg (til 5)) from: TPW by: s asc: s}) 'x) -- [2.0 2.0 2.0 2.0 2.0]
(at (select {x: (first (reverse (til 5))) y: (last (til 5)) z: (sum k) from: TFW by: s asc: s}) 'x) -- [4 4 4 4 4]
(at (select {x: (first (reverse (til 5))) y: (last (til 5)) z: (sum k) from: TPW by: s asc: s}) 'y) -- [4 4 4 4 4]
(at (select {x: (sum (til 5)) z: (sum k) from: TPW by: s asc: s}) 'z) -- (at (select {z: (sum k) from: TFW by: s asc: s}) 'z)

;; Without by: the source is evaluated once, scalar or collection, so an
;; effect in it runs once, not once per row.
;; `where` returns the positions it keeps, not one value per row: an
;; aggregate over it takes what it returns, in each group (positions within
;; the group) and over the whole table.  Grouped, count/sum/max read the
;; group's rows instead (count gave the group sizes).
(set TWi (table [i j] (list [1 1 3 4 5] [5 5 6 6 6])))
(at (select {c: (count (where (> i 2))) by: j from: TWi}) 'c) -- [0 3]
(at (select {c: (first (where (> i 2))) by: j from: TWi}) 'c) -- [0Nl 0]
(at (select {c: (sum (where (> i 2))) d: (sum i) by: j from: TWi}) 'c) -- [0 3]
(at (select {c: (count (where (> i 2))) from: TWi}) 'c) -- [3]
(at (select {c: (sum (where (> i 2))) from: TWi where: (> i 1)}) 'c) -- [3]
(at (select {x: (count (where (> k 2))) from: TFW by: s asc: s}) 'x) -- [1 1 1 0 1]
(at (select {x: (count (where (> k 2))) from: TPW by: s asc: s}) 'x) -- [1 1 1 0 1]
(at (select {x: (sum (where (> k 2))) y: (max (where (> k 2))) from: TPW by: s asc: s}) 'x) -- [0 1 0 0 0]
(at (select {x: (sum (where (> k 2))) y: (max (where (> k 2))) from: TPW by: s asc: s}) 'y) -- [0 1 0 0Nl 0]
(at (select {x: (count (where (> k 2))) from: TPW}) 'x) -- [4]

;; A grouped source that reads no column and gives one value stands for
;; every row of the group, as without by: (`(sum 1)` is the row count): 2 in
;; groups of 1 2 1 1 1 rows sums to 2 4 2 2 2.  It is evaluated once, not
;; once per group; it was taken as one value per group (1 per group).
(at (select {x: (sum (at [1 2 3] 1)) from: TFW by: s asc: s}) 'x) -- [2 4 2 2 2]
(at (select {x: (sum (at [1 2 3] 1)) from: TPW by: s asc: s}) 'x) -- [2 4 2 2 2]
(at (select {x: (count (at [1 2 3] 1)) from: TPW by: s asc: s}) 'x) -- [1 2 1 1 1]
(at (select {x: (first (at ['p 'q] 1)) from: TFW by: s asc: s}) 'x) -- ['q 'q 'q 'q 'q]
(set TB (table [a b] (list (til 10) (< (til 10) 3))))
(at (select {x: (sum (at [1 2 3] 0)) from: TB by: b}) 'x) -- [3 7]
(at (select {x: (sum (at [1 2 3] 1)) from: TB by: b}) 'x) -- [6 14]
(at (select {x: (sum (at [1 2 3] 1)) from: TB by: b where: (> a 1)}) 'x) -- [2 14]
(set ticks 0)
(at (select {x: (sum (do (set ticks (+ ticks 1)) (at [1 2 3] 1))) from: TPW by: s asc: s}) 'x) -- [2 4 2 2 2]
ticks -- 1
(set ticks 0)
(at (select {x: (sum (do (set ticks (+ ticks 1)) (til 5))) y: (sum k) from: TFW by: s asc: s}) 'x) -- [10 10 10 10 10]
ticks -- 1

;; A vector constant in an aggregate stands for a column: one of the
;; table's length is sliced per group and filtered by where: (the table's
;; rows before the filter; a parted table's rows across its partitions).
;; Any other length is a length error; it was read past its end.  One
;; value spreads over the rows, and count keeps the vector's own length.
(set W6 [10 20 30 40 50 60])
(at (select {x: (sum W6) from: TFW}) 'x) -- [210]
(at (select {x: (sum W6) from: TPW}) 'x) -- [210]
(at (select {x: (sum W6) from: TFW where: (> k 2)}) 'x) -- [160]
(at (select {x: (sum W6) from: TPW where: (> k 2)}) 'x) -- [160]
(at (select {x: (sum W6) from: TFW by: s asc: s}) 'x) -- [50 60 10 30 60]
(at (select {x: (sum W6) from: TPW by: s asc: s}) 'x) -- [50 60 10 30 60]
(at (select {x: (sum W6) from: TPW by: s where: (> k 2) asc: s}) 'x) -- [50 40 10 60]
(at (select {x: (sum [7]) from: TFW}) 'x) -- [42]
(set L3 [5 1 9])
(select {x: (sum [1 2 3]) from: TFW}) !- length
(select {x: (sum [1 2 3]) from: TPW}) !- length
(select {x: (avg L3) from: TFW}) !- length
(select {x: (sum (+ 1 L3)) from: TFW}) !- length
(select {x: (max [1 2 3]) from: TFW by: s}) !- length
(select {x: (max L3) from: TPW by: s}) !- length
(select {x: (first L3) from: TFW by: s}) !- length
(select {x: (sum [1 2 3 4]) from: TFW where: (> k 2)}) !- length
(at (select {x: (count L3) from: TFW}) 'x) -- [3]
(at (select {x: (count L3) from: TPW by: s asc: s}) 'x) -- [3 3 3 3 3]

(set ticks 0)
(at (select {x: (sum (do (set ticks (+ ticks 1)) (at [1 2 3] 0))) from: TFW}) 'x) -- [6]
ticks -- 1
(set ticks 0)
(at (select {x: (count (at (do (set ticks (+ ticks 1)) (til 3)) 1)) from: TPW where: (> k 2)}) 'x) -- [4]
ticks -- 1
(set ticks 0)
(at (select {x: (count (do (set ticks (+ ticks 1)) (til 5))) from: TPW}) 'x) -- [5]
ticks -- 1
(.sys.exec "rm -rf /tmp/rfl_scalar_asc_parted") -- 0
