;; @also-unfused
;; #1573: in a query, a numeric as over a STR column parses the strings, as
;; the eager cast does.  The compiled cast read the column's string
;; descriptors as numbers: [0 0 0] in a select, pointer-like values in an
;; update, and different on every run.
(set T (table [c k] (list ["1" "" "3"] [1 1 2])))
(at (select {r: (as 'I64 c) from: T}) 'r) -- (as 'I64 (at T 'c))
(at (select {r: (as 'I64 c) from: T}) 'r) -- [1 0Nl 3]
(at (select {r: (as 'F64 c) from: T}) 'r) -- [1.0 0Nf 3.0]
(at (select {r: (as 'I32 c) from: T}) 'r) -- (as 'I32 (at T 'c))
(at (select {r: (as 'I16 c) from: T}) 'r) -- (as 'I16 (at T 'c))
(at (select {r: (as 'U8 c) from: T}) 'r) -- (as 'U8 (at T 'c))
(at (select {r: (as 'BOOL c) from: T}) 'r) -- (as 'BOOL (at T 'c))
(at (select {r: (as 'F32 c) from: T}) 'r) -- (as 'F32 (at T 'c))
(at (select {r: ((quote as) 'F64 c) from: T}) 'r) -- [1.0 0Nf 3.0]
;; update, where: and nested in arithmetic
(at (update {r: (as 'I64 c) from: T}) 'r) -- [1 0Nl 3]
(at (update {r: (as 'F64 c) from: T where: (== k 1)}) 'r) -- [1.0 0Nf 0Nf]
(at (select {r: (as 'I64 c) from: T where: (> (as 'I64 c) 1)}) 'r) -- [3]
(at (select {r: (+ 1 (as 'I64 c)) from: T}) 'r) -- [2 0Nl 4]
;; under by:
(at (select {r: (sum (as 'F64 c)) from: T by: k}) 'r) -- [1.0 3.0]
