;; @requires: posix  (splayed / parted fixtures under /tmp, cleaned through a POSIX shell via .sys.exec)
;; @also-unfused
;; A temporal result computed in a query (xbar, %, a cast to DATE / TIME)
;; keeps its nulls for every reader, as the eager form does (#1339).
;;
;; The DAG lowers `(xbar d 7)` to x - (x % b) in an integer lane and casts
;; the result back to DATE; a TIME / DATE cast leaves its result in an I32
;; lane typed DATE / TIME.  The fused ISNULL kernel dispatched on that type
;; and, finding no DATE arm, read the 4-byte lane as 8-byte values: no
;; NULL_I64 there, so `nil?` came back all false (and with it `not`, `sum`
;; and `where:` over it).  Every answer here is the eager one.

(set nul (fn [v m z] (at (concat v (enlist z)) (+ (til (count v)) (* (- (count v) (til (count v))) (as 'I64 m))))))
(set mk (fn [J m] (table [d t p i g] (list (nul (+ 2024.01.01 (% J 400)) m 0Nd) (nul (as 'TIME (* 1237 (% J 50000))) m 0Nt) (nul (+ 2024.01.01D00:00:00.000000000 (* 1000003 J)) m 0Np) (nul (as 'I32 (% (* J 37) 9000)) m 0Ni) (% J 3)))))

;; per form: values, nil?, fill, sum of not nil?, count under where:,
;; nil? under where:, update nil?, update fill, sum of nil? by:

;; (xbar d 7)
(set Q0 (fn [tb] (list (at (select {r: (xbar d 7) from: tb}) 'r) (at (select {r: (nil? (xbar d 7)) from: tb}) 'r) (at (select {r: (fill 2000.01.01 (xbar d 7)) from: tb}) 'r) (at (select {c: (sum (not (nil? (xbar d 7)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (xbar d 7)))}) 'c) (at (select {r: (nil? (xbar d 7)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (xbar d 7)) from: tb}) 'r) (at (update {r: (fill 2000.01.01 (xbar d 7)) from: tb}) 'r) (select {c: (sum (nil? (xbar d 7))) from: tb by: g}))))
(set E0 (fn [tb] (list (xbar (at tb 'd) 7) (nil? (xbar (at tb 'd) 7)) (fill 2000.01.01 (xbar (at tb 'd) 7)) (enlist (sum (not (nil? (xbar (at tb 'd) 7))))) (enlist (sum (not (nil? (xbar (at tb 'd) 7))))) (at (nil? (xbar (at tb 'd) 7)) (where (> (at tb 'g) 0))) (nil? (xbar (at tb 'd) 7)) (fill 2000.01.01 (xbar (at tb 'd) 7)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (xbar (at tb 'd) 7)))) by: g}))))
;; (xbar d 7i)
(set Q1 (fn [tb] (list (at (select {r: (xbar d 7i) from: tb}) 'r) (at (select {r: (nil? (xbar d 7i)) from: tb}) 'r) (at (select {r: (fill 2000.01.01 (xbar d 7i)) from: tb}) 'r) (at (select {c: (sum (not (nil? (xbar d 7i)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (xbar d 7i)))}) 'c) (at (select {r: (nil? (xbar d 7i)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (xbar d 7i)) from: tb}) 'r) (at (update {r: (fill 2000.01.01 (xbar d 7i)) from: tb}) 'r) (select {c: (sum (nil? (xbar d 7i))) from: tb by: g}))))
(set E1 (fn [tb] (list (xbar (at tb 'd) 7i) (nil? (xbar (at tb 'd) 7i)) (fill 2000.01.01 (xbar (at tb 'd) 7i)) (enlist (sum (not (nil? (xbar (at tb 'd) 7i))))) (enlist (sum (not (nil? (xbar (at tb 'd) 7i))))) (at (nil? (xbar (at tb 'd) 7i)) (where (> (at tb 'g) 0))) (nil? (xbar (at tb 'd) 7i)) (fill 2000.01.01 (xbar (at tb 'd) 7i)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (xbar (at tb 'd) 7i)))) by: g}))))
;; (xbar t 1000)
(set Q2 (fn [tb] (list (at (select {r: (xbar t 1000) from: tb}) 'r) (at (select {r: (nil? (xbar t 1000)) from: tb}) 'r) (at (select {r: (fill 00:00:00.000 (xbar t 1000)) from: tb}) 'r) (at (select {c: (sum (not (nil? (xbar t 1000)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (xbar t 1000)))}) 'c) (at (select {r: (nil? (xbar t 1000)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (xbar t 1000)) from: tb}) 'r) (at (update {r: (fill 00:00:00.000 (xbar t 1000)) from: tb}) 'r) (select {c: (sum (nil? (xbar t 1000))) from: tb by: g}))))
(set E2 (fn [tb] (list (xbar (at tb 't) 1000) (nil? (xbar (at tb 't) 1000)) (fill 00:00:00.000 (xbar (at tb 't) 1000)) (enlist (sum (not (nil? (xbar (at tb 't) 1000))))) (enlist (sum (not (nil? (xbar (at tb 't) 1000))))) (at (nil? (xbar (at tb 't) 1000)) (where (> (at tb 'g) 0))) (nil? (xbar (at tb 't) 1000)) (fill 00:00:00.000 (xbar (at tb 't) 1000)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (xbar (at tb 't) 1000)))) by: g}))))
;; (xbar t 00:00:01.000)
(set Q3 (fn [tb] (list (at (select {r: (xbar t 00:00:01.000) from: tb}) 'r) (at (select {r: (nil? (xbar t 00:00:01.000)) from: tb}) 'r) (at (select {r: (fill 00:00:00.000 (xbar t 00:00:01.000)) from: tb}) 'r) (at (select {c: (sum (not (nil? (xbar t 00:00:01.000)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (xbar t 00:00:01.000)))}) 'c) (at (select {r: (nil? (xbar t 00:00:01.000)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (xbar t 00:00:01.000)) from: tb}) 'r) (at (update {r: (fill 00:00:00.000 (xbar t 00:00:01.000)) from: tb}) 'r) (select {c: (sum (nil? (xbar t 00:00:01.000))) from: tb by: g}))))
(set E3 (fn [tb] (list (xbar (at tb 't) 00:00:01.000) (nil? (xbar (at tb 't) 00:00:01.000)) (fill 00:00:00.000 (xbar (at tb 't) 00:00:01.000)) (enlist (sum (not (nil? (xbar (at tb 't) 00:00:01.000))))) (enlist (sum (not (nil? (xbar (at tb 't) 00:00:01.000))))) (at (nil? (xbar (at tb 't) 00:00:01.000)) (where (> (at tb 'g) 0))) (nil? (xbar (at tb 't) 00:00:01.000)) (fill 00:00:00.000 (xbar (at tb 't) 00:00:01.000)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (xbar (at tb 't) 00:00:01.000)))) by: g}))))
;; (xbar p 1000000000)
(set Q4 (fn [tb] (list (at (select {r: (xbar p 1000000000) from: tb}) 'r) (at (select {r: (nil? (xbar p 1000000000)) from: tb}) 'r) (at (select {r: (fill 2000.01.01D00:00:00.000000000 (xbar p 1000000000)) from: tb}) 'r) (at (select {c: (sum (not (nil? (xbar p 1000000000)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (xbar p 1000000000)))}) 'c) (at (select {r: (nil? (xbar p 1000000000)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (xbar p 1000000000)) from: tb}) 'r) (at (update {r: (fill 2000.01.01D00:00:00.000000000 (xbar p 1000000000)) from: tb}) 'r) (select {c: (sum (nil? (xbar p 1000000000))) from: tb by: g}))))
(set E4 (fn [tb] (list (xbar (at tb 'p) 1000000000) (nil? (xbar (at tb 'p) 1000000000)) (fill 2000.01.01D00:00:00.000000000 (xbar (at tb 'p) 1000000000)) (enlist (sum (not (nil? (xbar (at tb 'p) 1000000000))))) (enlist (sum (not (nil? (xbar (at tb 'p) 1000000000))))) (at (nil? (xbar (at tb 'p) 1000000000)) (where (> (at tb 'g) 0))) (nil? (xbar (at tb 'p) 1000000000)) (fill 2000.01.01D00:00:00.000000000 (xbar (at tb 'p) 1000000000)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (xbar (at tb 'p) 1000000000)))) by: g}))))
;; (xbar p 01:00:00.000)
(set Q5 (fn [tb] (list (at (select {r: (xbar p 01:00:00.000) from: tb}) 'r) (at (select {r: (nil? (xbar p 01:00:00.000)) from: tb}) 'r) (at (select {r: (fill 2000.01.01D00:00:00.000000000 (xbar p 01:00:00.000)) from: tb}) 'r) (at (select {c: (sum (not (nil? (xbar p 01:00:00.000)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (xbar p 01:00:00.000)))}) 'c) (at (select {r: (nil? (xbar p 01:00:00.000)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (xbar p 01:00:00.000)) from: tb}) 'r) (at (update {r: (fill 2000.01.01D00:00:00.000000000 (xbar p 01:00:00.000)) from: tb}) 'r) (select {c: (sum (nil? (xbar p 01:00:00.000))) from: tb by: g}))))
(set E5 (fn [tb] (list (xbar (at tb 'p) 01:00:00.000) (nil? (xbar (at tb 'p) 01:00:00.000)) (fill 2000.01.01D00:00:00.000000000 (xbar (at tb 'p) 01:00:00.000)) (enlist (sum (not (nil? (xbar (at tb 'p) 01:00:00.000))))) (enlist (sum (not (nil? (xbar (at tb 'p) 01:00:00.000))))) (at (nil? (xbar (at tb 'p) 01:00:00.000)) (where (> (at tb 'g) 0))) (nil? (xbar (at tb 'p) 01:00:00.000)) (fill 2000.01.01D00:00:00.000000000 (xbar (at tb 'p) 01:00:00.000)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (xbar (at tb 'p) 01:00:00.000)))) by: g}))))
;; (xbar p 1D)
(set Q6 (fn [tb] (list (at (select {r: (xbar p 1D) from: tb}) 'r) (at (select {r: (nil? (xbar p 1D)) from: tb}) 'r) (at (select {r: (fill 2000.01.01D00:00:00.000000000 (xbar p 1D)) from: tb}) 'r) (at (select {c: (sum (not (nil? (xbar p 1D)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (xbar p 1D)))}) 'c) (at (select {r: (nil? (xbar p 1D)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (xbar p 1D)) from: tb}) 'r) (at (update {r: (fill 2000.01.01D00:00:00.000000000 (xbar p 1D)) from: tb}) 'r) (select {c: (sum (nil? (xbar p 1D))) from: tb by: g}))))
(set E6 (fn [tb] (list (xbar (at tb 'p) 1D) (nil? (xbar (at tb 'p) 1D)) (fill 2000.01.01D00:00:00.000000000 (xbar (at tb 'p) 1D)) (enlist (sum (not (nil? (xbar (at tb 'p) 1D))))) (enlist (sum (not (nil? (xbar (at tb 'p) 1D))))) (at (nil? (xbar (at tb 'p) 1D)) (where (> (at tb 'g) 0))) (nil? (xbar (at tb 'p) 1D)) (fill 2000.01.01D00:00:00.000000000 (xbar (at tb 'p) 1D)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (xbar (at tb 'p) 1D)))) by: g}))))
;; (% d 7)
(set Q7 (fn [tb] (list (at (select {r: (% d 7) from: tb}) 'r) (at (select {r: (nil? (% d 7)) from: tb}) 'r) (at (select {r: (fill 2000.01.01 (% d 7)) from: tb}) 'r) (at (select {c: (sum (not (nil? (% d 7)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (% d 7)))}) 'c) (at (select {r: (nil? (% d 7)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (% d 7)) from: tb}) 'r) (at (update {r: (fill 2000.01.01 (% d 7)) from: tb}) 'r) (select {c: (sum (nil? (% d 7))) from: tb by: g}))))
(set E7 (fn [tb] (list (% (at tb 'd) 7) (nil? (% (at tb 'd) 7)) (fill 2000.01.01 (% (at tb 'd) 7)) (enlist (sum (not (nil? (% (at tb 'd) 7))))) (enlist (sum (not (nil? (% (at tb 'd) 7))))) (at (nil? (% (at tb 'd) 7)) (where (> (at tb 'g) 0))) (nil? (% (at tb 'd) 7)) (fill 2000.01.01 (% (at tb 'd) 7)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (% (at tb 'd) 7)))) by: g}))))
;; (% t 1000)
(set Q8 (fn [tb] (list (at (select {r: (% t 1000) from: tb}) 'r) (at (select {r: (nil? (% t 1000)) from: tb}) 'r) (at (select {r: (fill 00:00:00.000 (% t 1000)) from: tb}) 'r) (at (select {c: (sum (not (nil? (% t 1000)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (% t 1000)))}) 'c) (at (select {r: (nil? (% t 1000)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (% t 1000)) from: tb}) 'r) (at (update {r: (fill 00:00:00.000 (% t 1000)) from: tb}) 'r) (select {c: (sum (nil? (% t 1000))) from: tb by: g}))))
(set E8 (fn [tb] (list (% (at tb 't) 1000) (nil? (% (at tb 't) 1000)) (fill 00:00:00.000 (% (at tb 't) 1000)) (enlist (sum (not (nil? (% (at tb 't) 1000))))) (enlist (sum (not (nil? (% (at tb 't) 1000))))) (at (nil? (% (at tb 't) 1000)) (where (> (at tb 'g) 0))) (nil? (% (at tb 't) 1000)) (fill 00:00:00.000 (% (at tb 't) 1000)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (% (at tb 't) 1000)))) by: g}))))
;; (% p 1000)
(set Q9 (fn [tb] (list (at (select {r: (% p 1000) from: tb}) 'r) (at (select {r: (nil? (% p 1000)) from: tb}) 'r) (at (select {r: (fill 2000.01.01D00:00:00.000000000 (% p 1000)) from: tb}) 'r) (at (select {c: (sum (not (nil? (% p 1000)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (% p 1000)))}) 'c) (at (select {r: (nil? (% p 1000)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (% p 1000)) from: tb}) 'r) (at (update {r: (fill 2000.01.01D00:00:00.000000000 (% p 1000)) from: tb}) 'r) (select {c: (sum (nil? (% p 1000))) from: tb by: g}))))
(set E9 (fn [tb] (list (% (at tb 'p) 1000) (nil? (% (at tb 'p) 1000)) (fill 2000.01.01D00:00:00.000000000 (% (at tb 'p) 1000)) (enlist (sum (not (nil? (% (at tb 'p) 1000))))) (enlist (sum (not (nil? (% (at tb 'p) 1000))))) (at (nil? (% (at tb 'p) 1000)) (where (> (at tb 'g) 0))) (nil? (% (at tb 'p) 1000)) (fill 2000.01.01D00:00:00.000000000 (% (at tb 'p) 1000)) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (% (at tb 'p) 1000)))) by: g}))))
;; (as 'DATE i)
(set Q10 (fn [tb] (list (at (select {r: (as 'DATE i) from: tb}) 'r) (at (select {r: (nil? (as 'DATE i)) from: tb}) 'r) (at (select {r: (fill 2000.01.01 (as 'DATE i)) from: tb}) 'r) (at (select {c: (sum (not (nil? (as 'DATE i)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (as 'DATE i)))}) 'c) (at (select {r: (nil? (as 'DATE i)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (as 'DATE i)) from: tb}) 'r) (at (update {r: (fill 2000.01.01 (as 'DATE i)) from: tb}) 'r) (select {c: (sum (nil? (as 'DATE i))) from: tb by: g}))))
(set E10 (fn [tb] (list (as 'DATE (at tb 'i)) (nil? (as 'DATE (at tb 'i))) (fill 2000.01.01 (as 'DATE (at tb 'i))) (enlist (sum (not (nil? (as 'DATE (at tb 'i)))))) (enlist (sum (not (nil? (as 'DATE (at tb 'i)))))) (at (nil? (as 'DATE (at tb 'i))) (where (> (at tb 'g) 0))) (nil? (as 'DATE (at tb 'i))) (fill 2000.01.01 (as 'DATE (at tb 'i))) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (as 'DATE (at tb 'i))))) by: g}))))
;; (as 'TIME i)
(set Q11 (fn [tb] (list (at (select {r: (as 'TIME i) from: tb}) 'r) (at (select {r: (nil? (as 'TIME i)) from: tb}) 'r) (at (select {r: (fill 00:00:00.000 (as 'TIME i)) from: tb}) 'r) (at (select {c: (sum (not (nil? (as 'TIME i)))) from: tb}) 'c) (at (select {c: (count g) from: tb where: (not (nil? (as 'TIME i)))}) 'c) (at (select {r: (nil? (as 'TIME i)) from: tb where: (> g 0)}) 'r) (at (update {r: (nil? (as 'TIME i)) from: tb}) 'r) (at (update {r: (fill 00:00:00.000 (as 'TIME i)) from: tb}) 'r) (select {c: (sum (nil? (as 'TIME i))) from: tb by: g}))))
(set E11 (fn [tb] (list (as 'TIME (at tb 'i)) (nil? (as 'TIME (at tb 'i))) (fill 00:00:00.000 (as 'TIME (at tb 'i))) (enlist (sum (not (nil? (as 'TIME (at tb 'i)))))) (enlist (sum (not (nil? (as 'TIME (at tb 'i)))))) (at (nil? (as 'TIME (at tb 'i))) (where (> (at tb 'g) 0))) (nil? (as 'TIME (at tb 'i))) (fill 00:00:00.000 (as 'TIME (at tb 'i))) (select {c: (sum n) from: (table [g n] (list (at tb 'g) (nil? (as 'TIME (at tb 'i))))) by: g}))))

;; ── flat: a null first, in the middle, last; all nulls; none ──────────
(set J (til 6))
(set T1 (mk J (== J 0)))
(set T2 (mk J (== J 2)))
(set T3 (mk J (== J 5)))
(set T4 (mk J (>= J 0)))
(set T5 (mk J (< J 0)))
(nil? (at (select {r: (xbar d 7) from: T2}) 'r)) -- [false false true false false false]
(at (select {r: (nil? (xbar d 7)) from: T2}) 'r) -- [false false true false false false]
(at (select {r: (nil? (xbar t 1000)) from: T2}) 'r) -- [false false true false false false]
(at (select {r: (nil? (% d 7)) from: T2}) 'r) -- [false false true false false false]
(at (select {r: (nil? (as 'DATE i)) from: T4}) 'r) -- [true true true true true true]
(at (select {c: (count g) from: T2 where: (nil? (xbar d 7))}) 'c) -- [1]
;; readers of the nil? mask: if, and, or, where: with a second conjunct
(at (select {r: (if (nil? (xbar d 7)) 1 2) from: T2}) 'r) -- [2 2 1 2 2 2]
(at (select {r: (and (nil? (xbar d 7)) (nil? (xbar t 1000))) from: T2}) 'r) -- [false false true false false false]
(at (select {r: (or (nil? (% t 1000)) (== g 2)) from: T2}) 'r) -- [false false true false false true]
(at (select {r: d from: T2 where: (nil? (xbar d 7))}) 'r) -- [0Nd]
(at (select {r: d from: T2 where: (and (> g -1) (not (nil? (xbar t 1000))))}) 'r) -- (at (at T2 'd) [0 1 3 4 5])

