;; ── flat, 70k rows: past the parallel threshold, nulls across morsels ──
(set n 70000)
(set J (til n))
(set B (mk J (or (== 0 (% J 997)) (or (== J 35000) (== J (- n 1))))))
(at (select {c: (sum (nil? (xbar d 7))) from: B}) 'c) -- [73]
(Q0 B) -- (E0 B)
(Q2 B) -- (E2 B)
(Q4 B) -- (E4 B)
(Q7 B) -- (E7 B)
(Q10 B) -- (E10 B)

;; ── splayed and parted: nulls first, in the middle, last ────────────
(.sys.exec "rm -rf /tmp/rfl_xbar_temporal_nulls")
(set J (til 9))
(set M (mk J (or (== J 0) (or (== J 4) (== J 8)))))
(.db.splayed.set "/tmp/rfl_xbar_temporal_nulls/sp/t/" M "/tmp/rfl_xbar_temporal_nulls/sp/.sym")
(set S (.db.splayed.get "/tmp/rfl_xbar_temporal_nulls/sp/t/" "/tmp/rfl_xbar_temporal_nulls/sp/.sym"))
(at (select {c: (sum (nil? (xbar d 7))) from: S}) 'c) -- [3]
(Q0 S) -- (E0 S)
(Q1 S) -- (E1 S)
(Q2 S) -- (E2 S)
(Q3 S) -- (E3 S)
(Q4 S) -- (E4 S)
(Q5 S) -- (E5 S)
(Q6 S) -- (E6 S)
(Q7 S) -- (E7 S)
(Q8 S) -- (E8 S)
(Q9 S) -- (E9 S)
(Q10 S) -- (E10 S)
(Q11 S) -- (E11 S)

;; parted: two partitions, a null in each
(.db.splayed.set "/tmp/rfl_xbar_temporal_nulls/db/2024.01.01/t/" (take M 5) "/tmp/rfl_xbar_temporal_nulls/db/.sym")
(.db.splayed.set "/tmp/rfl_xbar_temporal_nulls/db/2024.01.02/t/" (drop M 5) "/tmp/rfl_xbar_temporal_nulls/db/.sym")
(set P (.db.parted.get "/tmp/rfl_xbar_temporal_nulls/db/" 't))
(at (select {c: (sum (nil? (xbar d 7))) from: P}) 'c) -- [3]
(Q0 P) -- (E0 P)
(Q1 P) -- (E1 P)
(Q2 P) -- (E2 P)
(Q3 P) -- (E3 P)
(Q4 P) -- (E4 P)
(Q5 P) -- (E5 P)
(Q6 P) -- (E6 P)
(Q7 P) -- (E7 P)
(Q8 P) -- (E8 P)
(Q9 P) -- (E9 P)
(Q10 P) -- (E10 P)
(Q11 P) -- (E11 P)
(.sys.exec "rm -rf /tmp/rfl_xbar_temporal_nulls")
