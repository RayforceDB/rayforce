;; Literal/bound collection concatenation must not become string concatenation.
(set T (table [x] (list [1 2 3])))
(at (select {v: (concat [2] [1]) from: T}) 'v) -- [2 1]
(at (select {from: T where: (in x (concat [2] [1]))}) 'x) -- [1 2]
(at (select {from: T where: (not-in x (concat [2] [1]))}) 'x) -- [3]
(set A [2])
(set B [1])
(at (select {v: (concat A B) from: T}) 'v) -- [2 1]
(at (select {v: (concat [2] (concat [1] [3])) from: T}) 'v) -- [2 1 3]
(at (select {v: (concat [0Nl] [1]) from: T}) 'v) -- [0Nl 1]
(at (select {v: (concat [2.0] [1.0]) from: T}) 'v) -- [2.0 1.0]
(at (select {v: (concat ['a] ['b]) from: T}) 'v) -- ['a 'b]
(at (select {v: (concat ["a"] ["b"]) from: T}) 'v) -- ["a" "b"]

;; Numeric columns concatenate once, not independently for each row.
(at (select {v: (concat x [4]) from: T}) 'v) -- [1 2 3 4]
(at (select {v: (concat [0] x) from: T}) 'v) -- [0 1 2 3]
(at (select {v: (concat x x) from: T}) 'v) -- [1 2 3 1 2 3]
(at (select {n: (count (concat x [4])) from: T}) 'n) -- [4]
(at (select {from: T where: (in x (concat x [4]))}) 'x) -- [1 2 3]

;; Existing row-wise string concatenation, including forced query fallback.
(set S (table [s ts] (list ['a 'b] [2024.01.01D00:00:00.000000000 2024.01.01D00:00:00.000000001])))
(at (select {v: (concat s "!") from: S}) 'v) -- ['a! 'b!]
(at (select {v: (concat "[" s "]") from: S}) 'v) -- (as 'SYM (list "[a]" "[b]"))
(at (select {v: (concat [2] [1]) other: (+ ts 1) from: S}) 'v) -- [2 1]
(set SS (table [s ts] (list (as 'STR (list "a" "b")) (at S 'ts))))
(at (select {v: (concat s "!") other: (+ ts 1) from: SS}) 'v) -- ["a!" "b!"]
(at (select {v: (concat "a" "b") other: (+ ts 1) from: SS}) 'v) -- ["ab" "ab"]
