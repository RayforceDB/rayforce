;; Projection pushdown into an inner select: as the immediate from: of a
;; select whose clauses read columns only by name, the inner select builds
;; only the outputs the outer one names.  An output nobody reads is still
;; compiled — a later output may read it by its alias — but no column of
;; it is built.  Observed through (.sys.mem)'s sym-map-runs: `(lower URL)`
;; over a SYM column of 4096 rows or more runs the per-code path once per
;; evaluation that builds its rows.  Values against the same query without
;; the unread output, and the inner select alone.
(set N 6000)
(set i (til N))
(set hosts ["Example.COM" "news.Site.org" "Shop.Market.NET" "Blog.Daily.com"])
(set U (as 'SYM (map (fn [k] (format (if (== 0 (% k 3)) "http://www.%/p/%.html" "https://www.%/p/%.php") (at hosts (% k 4)) (% k 97))) i)))
(set T (table [URL v w] (list U (% (* 7919 i) 2003) (% i 2))))
(set runs (fn [] (at (.sys.mem) 'sym-map-runs)))
(>= (runs) 0) -- true
(set FP (fn [t] (ser (map (fn [c] (as 'STR (at t c))) (cols t)))))
;; the inner select alone builds both lower-cased columns: two runs
(set m0 (runs))
(set I (select {from: T lu: (lower URL) x: (upper URL) kind: (if (like lu "*.html") "html" "php") w: w v: v}))
(- (runs) m0) -- 2
(cols I) -- ['lu 'x 'kind 'w 'v]
;; under an outer grouping that names kind, w and v: x is not built at all,
;; and kind — a function of URL through lu — is evaluated once per symbol
;; over the vocabulary (no row-wise lower: no run); the result is the same
(set m0 (runs))
(set G (select {from: (select {from: T lu: (lower URL) x: (upper URL) kind: (if (like lu "*.html") "html" "php") w: w v: v}) by: [kind w] c: (count v) d: (count (distinct v)) asc: [kind w]}))
(- (runs) m0) -- 0
(type (at G 'kind)) -- 'STR
(count G) -- 4
(set G2 (select {from: (select {from: T kind: (if (like (lower URL) "*.html") "html" "php") w: w v: v}) by: [kind w] c: (count v) d: (count (distinct v)) asc: [kind w]}))
(all (== (FP G) (FP G2))) -- true
;; the distinct counts, exactly: the distinct (kind, w, v) tuples per (kind, w)
(set O (select {from: (select {from: I by: [kind w v]}) by: [kind w] d: (count v) asc: [kind w]}))
(all (== (at G 'd) (at O 'd))) -- true
(sum (at G 'c)) -- 6000
;; by hand: the html rows are k = 0 mod 3, w = k mod 2: v = 7919 k mod 2003 over k = 0 mod 6
(count (distinct (at (select {from: T where: (and (== 0 (% i 3)) (== w 0))}) 'v))) -- 1000
(at (at (select {from: G where: (and (== kind "html") (== w 0))}) 'd) 0) -- 1000
;; an outer clause that names x keeps it: the aggregate over x answers
(set Gx (select {from: (select {from: T lu: (lower URL) x: (upper URL) kind: (if (like lu "*.html") "html" "php") w: w v: v}) by: [kind w] c: (count v) mx: (max x) asc: [kind w]}))
(all (== (at Gx 'c) (at G 'c))) -- true
(== (as 'STR (at (at Gx 'mx) 0)) (max (upper (as 'STR (at (select {from: T where: (and (like (lower URL) "*.html") (== w 0))}) 'URL))))) -- true
;; an inner select that sorts keeps every output (a sort key may name one)
(set Gs (select {from: (select {from: T lu: (lower URL) x: (upper URL) kind: (if (like lu "*.html") "html" "php") w: w v: v asc: x}) by: [kind w] c: (count v) asc: [kind w]}))
(all (== (at Gs 'c) (at G 'c))) -- true
(cols (select {from: T lu: (lower URL) x: (upper URL) w: w asc: x})) -- ['lu 'x 'w]
;; an outer select with no outputs of its own reads every column: all are built
(set m0 (runs))
(set Ga (select {from: (select {from: T lu: (lower URL) x: (upper URL) w: w})}))
(- (runs) m0) -- 2
(cols Ga) -- ['lu 'x 'w]
;; an outer select that names one output gets that one
(set m0 (runs))
(set Gb (select {from: (select {from: T lu: (lower URL) x: (upper URL) w: w}) n: (count w)}))
(- (runs) m0) -- 0
(at (at Gb 'n) 0) -- 6000
;; the bare name as the one group or sort key is a key use too
(set m0 (runs))
(set Gk (select {from: (select {from: T lu: (lower URL) x: (upper URL) kind: (if (like lu "*.html") "html" "php") w: w v: v}) by: kind c: (count v) asc: kind}))
(- (runs) m0) -- 0
(type (at Gk 'kind)) -- 'STR
(all (== (at Gk 'c) (at (select {from: G by: kind c: (sum c) asc: kind}) 'c))) -- true
(sum (at Gk 'c)) -- 6000
;; an alias the kept output reads through several arms is evaluated once
;; over the vocabulary, not once per arm: 20000 distinct URLs, five rows
;; each, three arms reading lu — one run of (lower URL) (each arm sees
;; 4096 symbols or more, so a run per arm would count)
(set N2 100000)
(set i2 (til N2))
(set U2 (as 'SYM (map (fn [j] (format (if (== 0 (% j 3)) "http://www.%/p/%.html" (== 1 (% j 3)) "https://www.%/p/%.php" "https://img.%/p/%.jpg") (at hosts (% j 4)) j)) (% i2 20000))))
(count (distinct U2)) -- 20000
(set T2 (table [URL v] (list U2 (% i2 7))))
(set m0 (runs))
(set G3 (select {from: (select {from: T2 lu: (lower URL) kind: (if (like lu "*.html") "html" (like lu "*.php") "php" (like lu "*.jpg") "jpg" "other") v: v}) by: [kind] c: (count v) d: (count (distinct v)) asc: kind}))
(- (runs) m0) -- 1
(type (at G3 'kind)) -- 'STR
(as 'STR (at G3 'kind)) -- ["html" "jpg" "php"]
;; by hand: of j = 0..19999, 6667 are 0 mod 3, 6667 are 1 mod 3, 6666 are 2
;; mod 3, five rows each; v = k mod 7 takes all seven values in each class
(at G3 'c) -- [33335 33330 33335]
(at G3 'd) -- [7 7 7]
;; and against the row-wise evaluation and the tuple-distinct oracle
(set G3R (select {from: (select {from: T2 kind: (if (like (lower URL) "*.html") "html" (like (lower URL) "*.php") "php" (like (lower URL) "*.jpg") "jpg" "other") v: v}) by: [kind] c: (count v) d: (count (distinct v)) asc: kind}))
(all (== (FP G3) (FP G3R))) -- true
(set O3 (select {from: (select {from: (select {from: T2 lu: (lower URL) kind: (if (like lu "*.html") "html" (like lu "*.php") "php" (like lu "*.jpg") "jpg" "other") v: v}) by: [kind v]}) by: [kind] d: (count v) asc: kind}))
(all (== (at G3 'd) (at O3 'd))) -- true
;; an output the outer select compares with a genuine STR column, or with
;; another output, is built row-wise (STR): the per-symbol positions have
;; a domain of their own and compare with literals only
(set s (at ["html" "php" "x"] (% i 3)))
(set Ts (table [URL s v] (list U s (% (* 7919 i) 2003))))
(set Ms (select {from: Ts lu: (lower URL) kind: (if (like lu "*.html") "html" "php") k2: (if (like lu "*.php") "php" "html") s: s v: v}))
(set m0 (runs))
(set Cs (select {from: (select {from: Ts lu: (lower URL) kind: (if (like lu "*.html") "html" "php") s: s v: v}) where: (== kind s) c: (count v)}))
(- (runs) m0) -- 1
(at (at Cs 'c) 0) -- (at (at (select {from: Ms where: (== kind s) c: (count v)}) 'c) 0)
(at (at Cs 'c) 0) -- (sum (== (at Ms 'kind) (at Ms 's)))
(set m0 (runs))
(set Ck (select {from: (select {from: Ts lu: (lower URL) kind: (if (like lu "*.html") "html" "php") k2: (if (like lu "*.php") "php" "html") v: v}) where: (== kind k2) c: (count v) m: (max k2)}))
(- (runs) m0) -- 1
(at (at Ck 'c) 0) -- (at (at (select {from: Ms where: (== kind k2) c: (count v) m: (max k2)}) 'c) 0)
(as 'STR (at (at Ck 'm) 0)) -- (max (at Ms 'k2))
(at (at Ck 'c) 0) -- 6000
;; compared with a literal, the output stays per symbol and answers the same
(set m0 (runs))
(set Cl (select {from: (select {from: Ts lu: (lower URL) kind: (if (like lu "*.html") "html" "php") s: s v: v}) where: (== kind "html") c: (count v)}))
(- (runs) m0) -- 0
(at (at Cl 'c) 0) -- (sum (== (at Ms 'kind) "html"))
(at (at Cl 'c) 0) -- 2000
;; an inner output named as an input column, or named twice, is read by the
;; later outputs as the row-wise select binds it: every projection stays
;; row-wise, and the groups are the materialized inner select's
(set Ns 30000)
(set is (til Ns))
(set Us (as 'SYM (map (fn [k] (format "Http://X/%.Html" (% k 50))) is)))
(set TSh (table [URL v] (list Us (% is 7))))
(set FG (fn [r] (ser (xasc (table [k c] (list (as 'STR (at r 'kind)) (at r 'c))) 'k))))
(set MSh (select {from: TSh URL: (lower URL) kind: (if (like URL "*7.html") "a" "b") v: v}))
(set m0 (runs))
(set GSh (select {from: (select {from: TSh URL: (lower URL) kind: (if (like URL "*7.html") "a" "b") v: v}) by: kind c: (count v)}))
(- (runs) m0) -- 1
(count GSh) -- 2
(all (== (FG GSh) (FG (select {from: MSh by: kind c: (count v)})))) -- true
(at (select {from: GSh where: (== kind "a")}) 'c) -- [3000]
(set MDu (select {from: TSh lu: (lower URL) lu: (upper URL) kind: (if (like lu "*7.HTML") "a" "b") v: v}))
(set GDu (select {from: (select {from: TSh lu: (lower URL) lu: (upper URL) kind: (if (like lu "*7.HTML") "a" "b") v: v}) by: kind c: (count v)}))
(all (== (FG GDu) (FG (select {from: MDu by: kind c: (count v)})))) -- true
(count GDu) -- (count (distinct (at MDu 'kind)))
;; under a where, with count distinct and a sort key
(set GW2 (select {from: (select {from: TSh URL: (lower URL) kind: (if (like URL "*7.html") "a" "b") v: v where: (> v 2)}) by: kind c: (count v) d: (count (distinct v)) asc: kind}))
(set OW2 (select {from: (select {from: MSh where: (> v 2)}) by: kind c: (count v) d: (count (distinct v)) asc: kind}))
(all (== (ser (map (fn [c] (as 'STR (at GW2 c))) (cols GW2))) (ser (map (fn [c] (as 'STR (at OW2 c))) (cols OW2))))) -- true
(at (at GW2 'c) 0) -- (count (where (and (> (at TSh 'v) 2) (like (lower (at TSh 'URL)) "*7.html"))))
(at (at GW2 'c) 1) -- (count (where (and (> (at TSh 'v) 2) (not (like (lower (at TSh 'URL)) "*7.html")))))
(at GW2 'd) -- [4 4]
(at (select {from: (select {from: TSh URL: (lower URL) kind: (if (like URL "*7.html") "a" "b") v: v}) dk: (count (distinct kind))}) 'dk) -- [2]
