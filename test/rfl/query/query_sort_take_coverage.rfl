;; Coverage for sort/take paths in `src/ops/query.c`:
;;
;;   `apply_sort_take` (line ~349):
;;     - take without sort, atom positive (lines ~363-398)
;;     - take without sort, atom negative/tail (line ~381-384)
;;     - sort + take (multi-key sort), TopK fast path
;;     - TopK multi-key path (n_keys > 1) (lines ~487-498)
;;
;;   `atom_i64_const` with I32/DATE/TIME/BOOL/U8 types (lines ~1438-1447)
;;   Called from `expr_affine_of_sym` and `parse_gt_name_i64`

;; ────────────────────────────────────────────────────────────────────
;; take without sort: eval-level group path (LIST keys groups)
;; apply_sort_take at lines 363-409 (sort=false, take_val_expr set)
;; ────────────────────────────────────────────────────────────────────
(set Tsst (table [k v] (list ["aa" "bb" "aa" "bb" "cc" "dd" "ee"] [1 2 3 4 5 6 7])))

;; take: positive atom — slice [0, k) of result
(count (select {s: (sum v) by: k from: Tsst take: 3})) -- 3
;; Sum is sum of the first 3 groups encountered: aa=4, bb=6, cc=5 → 15
(sum (at (select {s: (sum v) by: k from: Tsst take: 3}) 's)) -- 15

;; take: 1 → a single group; bucket order unspecified, so pin "aa" (sum 4).
(count (select {s: (sum v) by: k from: Tsst take: 1})) -- 1
(at (at (select {s: (sum v) by: k from: Tsst take: 1 where: (== k "aa")}) 's) 0) -- 4

;; take: bigger than n_groups → clamped to n_groups ; sum of all 5 = 28.
(count (select {s: (sum v) by: k from: Tsst take: 100})) -- 5
(sum (at (select {s: (sum v) by: k from: Tsst take: 100}) 's)) -- 28

;; ────────────────────────────────────────────────────────────────────
;; TopK multi-key sort + take → n_keys > 1 path (lines 487-498)
;; Multi-key sort triggers ray_topk_table_multi
;; ────────────────────────────────────────────────────────────────────
(set Ttopk (table [a b v] (list [3 1 2 3 1 2] [10 20 30 10 20 30] [100 200 300 400 500 600])))
;; Top-3 by (a, b) ascending: (1,20)×2, (2,30)×2, (3,10)×2 → first 3 sorted = {1,1,2}.
(count (select {from: Ttopk asc: [a b] take: 3})) -- 3
(sum (at (select {from: Ttopk asc: [a b] take: 3}) 'a)) -- 4
;; Top-3 by (asc b, desc a) - asc b is primary; b=10×2(a=3,3), b=20×2(a=1,1) →
;; top-3 = b=10,10,20 → a={3,3,1} sum 7.
(count (select {from: Ttopk asc: b desc: a take: 3})) -- 3
(sum (at (select {from: Ttopk asc: b desc: a take: 3}) 'a)) -- 7

;; Flat table (no LIST cols) — topk fast path eligible
(set Tflat (table [x y v] (list [5 3 1 4 2] [10 30 50 20 40] [100 300 500 200 400])))
;; Top-2 by x asc: rows with x=1(v=500), x=2(v=400) ; sum v 900.
(count (select {from: Tflat asc: [x y] take: 2})) -- 2
(sum (at (select {from: Tflat asc: [x y] take: 2}) 'v)) -- 900
;; Top-4 by x+y asc → first 4 rows when sorted = x∈{1,2,3,4} ; sum 10.
(count (select {from: Tflat asc: [x y] take: 4})) -- 4
(sum (at (select {from: Tflat asc: [x y] take: 4}) 'x)) -- 10

;; ────────────────────────────────────────────────────────────────────
;; atom_i64_const with narrow types:
;; Called from parse_gt_name_i64 which parses (> sym literal) predicates
;; for can_defer_single_key_where → post_group_where_expr
;; The I32/BOOL/U8/I16 branches are uncovered; we can exercise them
;; indirectly through parse_gt_name_i64 via match_group_count_emit_filter:
;; atom_i64_const is called on the threshold atom in (> cnt_col K)
;; When K is a numeric literal, it comes as I64 from the parser
;; but parse_gt_name_i64's threshold switch (1522-1528) covers I32/I16/U8/BOOL
;; These are unreachable from RFL because the RFL parser emits I64 atoms
;; for all integer literals.
;; ────────────────────────────────────────────────────────────────────

;; ────────────────────────────────────────────────────────────────────
;; No-sort take with negative atom (tail rows) — line 380-383
;; Groups result with count n_groups, take -K = last K groups
;; ────────────────────────────────────────────────────────────────────
(set Tntake (table [k v] (list ['A 'B 'C 'D 'E] [10 20 30 40 50])))
;; No-sort with take: -2 should return last 2 groups
;; apply_sort_take: atom_n<0 → start=n_groups-2, amount=2
(count (select {s: (sum v) by: k from: Tntake take: -2})) -- 2

;; No-sort with take: -1 → last 1 group
(count (select {s: (sum v) by: k from: Tntake take: -1})) -- 1

;; ────────────────────────────────────────────────────────────────────
;; TopK with sort + take on a non-by select (apply_sort_take in sort path)
;; DAG path: sort a materialized table using a temporary DAG
;; ────────────────────────────────────────────────────────────────────
(set Tsortake (table [a b c] (list [3 1 4 1 5 9] [2 6 5 3 5 8] [100 200 300 400 500 600])))
;; Sort by a asc + take 3 → rows with a={1,1,3}, sum 5.
(count (select {from: Tsortake asc: a take: 3})) -- 3
(sum (at (select {from: Tsortake asc: a take: 3}) 'a)) -- 5

;; Sort by b desc + take 2 → rows with b={8,6}, sum 14.
(count (select {from: Tsortake desc: b take: 2})) -- 2
(sum (at (select {from: Tsortake desc: b take: 2}) 'b)) -- 14

;; Sort by [a b] asc + take 4 → top 4 by (a,b): a={1,1,3,4}, sum 9.
(count (select {from: Tsortake asc: [a b] take: 4})) -- 4
(sum (at (select {from: Tsortake asc: [a b] take: 4}) 'a)) -- 9

;; Single STR key with take uses the same bounded table path as numeric keys.
(set Tstrtake (table [s v] (list (as 'STR (list "delta" "alpha" "charlie" "bravo" "echo" "bravo")) [4 1 3 2 5 6])))
(count (select {from: Tstrtake asc: s take: 3})) -- 3
(sum (at (select {from: Tstrtake asc: s take: 3}) 'v)) -- 9
(count (select {from: Tstrtake desc: s take: 3})) -- 3
(sum (at (select {from: Tstrtake desc: s take: 3}) 'v)) -- 12

;; ────────────────────────────────────────────────────────────────────
;; BOOL group-by result reorder with NULL column (lines 7117-7121)
;; When group-by on BOOL key produces result where first BOOL group
;; doesn't match first row of input (hash may put true before false),
;; the swap path at 7099 reverses row order in all result columns.
;; Lines 7117-7121 fire when a result column has HAS_NULLS set
;; (col->attrs & RAY_ATTR_HAS_NULLS != 0) in the reverse-copy loop.
;;
;; Requires:
;;   1. BOOL key → exec_group puts false before true (numerically: 0 < 1)
;;   2. Input starts with true → first_val=true, result_first=false →
;;      first_val != result_first → swap triggered at 7099
;;   3. A result column has HAS_NULLS after grp_finalize_nulls pass.
;;
;; Use (min v) aggregation: for the true group (all null inputs),
;; grp_finalize_nulls finds NULL_I32 sentinel in result → sets HAS_NULLS.
;; ────────────────────────────────────────────────────────────────────
;; Table starting with true key: k=[true,false,true,false], v I32 column
;; Inject I32 null into v column where k==true (rows 0 and 2).
;; exec_group puts false first; original first row has k=true →
;; first_val=true != result_first=false → swap triggered at 7099.
;; min(v) for true group = null (all nulls) → grp_finalize_nulls sets HAS_NULLS
;; → lines 7117-7121 execute during column reverse-copy.
(set Tbool_base (table [k v] (list [true false true false] (as 'I32 [10 99 20 30]))))
(set Tbool_null (update {v: 0Ni from: Tbool_base where: k}))
;; Non-agg group-by: DAG first-of-group, swap triggered (no HAS_NULLS from DAG)
(count (select {by: k from: Tbool_null})) -- 2
;; Agg group-by with min: true group all-null → grp_finalize_nulls sets HAS_NULLS.
;; Bucket order unspecified; pin the true (all-null) group via where: k so its
;; min(v) is the null we assert.
(count (select {s: (min v) by: k from: Tbool_null})) -- 2
(nil? (at (at (select {s: (min v) by: k from: Tbool_null where: k}) 's) 0)) -- true

;; ────────────────────────────────────────────────────────────────────
;; take: vec[2] range form — lines 400-405 in apply_sort_take
;; When take expr evaluates to an I64 vec of length 2 [start, count],
;; ray_take_fn is called with the range directly.
;;
;; apply_sort_take is called for GROUP-BY selects (not non-group-by).
;; Non-group-by selects with take: vec[2] go through lines 7029-7030.
;; ────────────────────────────────────────────────────────────────────
(set Trange (table [v] (list [10 20 30 40 50])))
;; Non-group-by take: [1 3] → goes through lines 7029-7030 (DAG path)
(count (select {v: v from: Trange take: [1 3]})) -- 3
(at (at (select {v: v from: Trange take: [1 3]}) 'v) 0) -- 20

;; take: [0 2] → rows 0,1
(count (select {v: v from: Trange take: [0 2]})) -- 2

;; Group-by take: [start count] vec form → goes through apply_sort_take lines 400-405
(set Tgrprange (table [k v] (list ['A 'B 'C 'A 'B] [1 2 3 4 5])))
;; 3 groups: A=5, B=7, C=3. take: [1 2] → skip 1, take 2 (range-take path).
;; The count holds regardless of bucket order:
(count (select {s: (sum v) by: k from: Tgrprange take: [1 2]})) -- 2
;; Pin order with asc: k → A(5),B(7),C(3); skip 1 → B,C; first sum = 7.
(at (at (select {s: (sum v) by: k from: Tgrprange asc: k take: [1 2]}) 's) 0) -- 7

;; ────────────────────────────────────────────────────────────────────
;; take: domain error — lines 407-409 in apply_sort_take
;; When take expr is neither an atom nor a vec[2], domain error fires.
;; (Also lines 7032-7034 for non-group-by case)
;; ────────────────────────────────────────────────────────────────────
;; Non-group-by take: vec[3] → domain at lines 7032-7034
(select {v: v from: Trange take: [1 2 3]}) !- domain
;; Group-by take: vec[3] → domain at lines 407-409 in apply_sort_take
(select {s: (sum v) by: k from: Tgrprange take: [1 2 3]}) !- domain

;; ────────────────────────────────────────────────────────────────────
;; Computed sort key → bad_clause = 1 (lines 454-456 in apply_sort_take)
;; apply_sort_take is called on post-group-by results.  When asc:/desc:
;; value is a computed expression (not a SYM name or SYM vec), the
;; code sets bad_clause=1, skips TopK, and falls through to the DAG
;; sort path which passes the result unsorted.
;;
;; NOTE: For non-group-by selects, the main DAG path (line 7007-7009)
;; rejects computed sort keys with a "domain" error BEFORE apply_sort_take.
;; So bad_clause=1 is only reachable via group-by post-sort.
;; ────────────────────────────────────────────────────────────────────
(set Tcomp (table [k v] (list ['A 'B 'C 'A 'B] [1 2 3 4 5])))
;; asc: (+ s 0) on group result: s = sum(v) per group.
;; apply_sort_take gets this expression → bad_clause=1 → unsorted take.
(count (select {s: (sum v) from: Tcomp by: k asc: (+ s 0) take: 2})) -- 2

;; ────────────────────────────────────────────────────────────────────
;; simplify_agg_idiom: col_expr is not a name ref (line 1858)
;; `(first (asc col_expr))` where col_expr = (+ v 1) (not a name ref)
;; → col_expr->type == RAY_LIST, not -RAY_SYM → return false at 1858.
;; dep_candidate optimization not applied → falls back to per-group eval.
;; (+ v 1) is not compilable as an agg DAG node → evaluated per group
;; (it raised "failed to compile aggregation argument").
;; ────────────────────────────────────────────────────────────────────
(set T1858 (table [k v] (list ['a 'a 'b 'b] [1 2 3 4])))
;; (first (asc (+ v 1))): inner col_expr = (+ v 1) is LIST → line 1858
;; simplify_agg_idiom returns false → the aggregate runs per group
(select {m: (first (asc (+ v 1))) by: k from: T1858}) -- (table [k m] (list [a b] [2 4]))

(set TLimLazy (table [s v] (list (take ['a 'b 'c] 120) (til 120))))
(count (select {s: s from: TLimLazy where: (!= s 'c) take: 20})) -- 20
(count (where (== (at (select {s: s from: TLimLazy where: (!= s 'c) take: 20}) 's) 'a))) -- 10
(count (select {s: s from: TLimLazy where: (!= s 'c) take: -20})) -- 20
(count (where (== (at (select {s: s from: TLimLazy where: (!= s 'c) take: -20}) 's) 'a))) -- 10

(set TByStrKey (table [r] (list (list "aa/x" "bb/y" "aa/z" ""))))
(count (select {c: (count r) from: TByStrKey where: (!= r "") by: {k: (substr r 1 (str-find (concat r "/") "/"))}})) -- 2
(at (at (select {c: (count r) from: TByStrKey where: (!= r "") by: {k: (substr r 1 (str-find (concat r "/") "/"))} desc: c take: 1}) 'k) 0) -- "aa"
(at (at (select {c: (count r) from: TByStrKey where: (!= r "") by: {k: (substr r 1 (str-find (concat r "/") "/"))} desc: c take: 1}) 'c) 0) -- 2

(set TStrConst (table [k v] (list (list "a" "b" "a") [1 2 3])))
(type (at (select {one: 1 c: (count v) from: TStrConst by: k desc: c take: 1}) 'one)) -- 'I64
(at (at (select {one: 1 c: (count v) from: TStrConst by: k desc: c take: 1}) 'one) 0) -- 1

(set NHol 200000)
(set THol (table [k s v] (list (as 'STR (% (til NHol) 1000)) (as 'STR (til NHol)) (til NHol))))
(count (select {m: (min s) c: (count s) from: THol by: k})) -- 1000
(set RHolF (select {m: (min s) c: (count s) from: THol where: (>= v 100000) by: k}))
(count RHolF) -- 1000
(sum (at RHolF 'c)) -- 100000
(at (at (select {m: m from: RHolF where: (== k "0")}) 'm) 0) -- "100000"
(set RHolF2 (select {m: (min s) c: (count s) from: THol where: (>= v 100000) by: k}))
(sum (at RHolF2 'c)) -- 100000
(at (at (select {m: m from: RHolF2 where: (== k "0")}) 'm) 0) -- "100000"

;; ────────────────────────────────────────────────────────────────────
;; Computed by: key with no outputs.  The DAG no-agg branch regroups a
;; computed key (key_sym < 0) at eval level and returned that result
;; without apply_sort_take, so asc:/desc:/take: were dropped and every
;; group came back in first-seen order.  Oracles: the same key
;; materialized as a column (a plain key), and the computed key beside an
;; output.  The key column keeps its derived name, `x`.
;; ────────────────────────────────────────────────────────────────────
(set Tck (table [x y] (list [3 1 4 2 3 1] [30 10 40 20 31 11])))
(set Tckp (update {k: (* x 2) from: Tck}))
(select {by: (* x 2) from: Tck desc: x take: 2}) -- (table [x y] (list [8 6] [40 30]))
(at (select {by: (* x 2) from: Tck desc: x take: 2}) 'x) -- (at (select {c: (count y) by: (* x 2) from: Tck desc: x take: 2}) 'x)
(at (select {by: (* x 2) from: Tck desc: x take: 2}) 'y) -- (at (select {by: k from: Tckp desc: k take: 2}) 'y)
;; asc: and desc: alone, on the key and on a source column
(select {by: (* x 2) from: Tck asc: x}) -- (table [x y] (list [2 4 6 8] [10 20 30 40]))
(at (select {by: (* x 2) from: Tck desc: y}) 'x) -- [8 6 4 2]
(at (select {by: (* x 2) from: Tck desc: y}) 'y) -- (at (select {by: k from: Tckp desc: y}) 'y)
;; take: alone keeps first-seen group order: head, tail, range, more than the groups
(select {by: (* x 2) from: Tck take: 2}) -- (table [x y] (list [6 2] [30 10]))
(at (select {by: (* x 2) from: Tck take: -1}) 'y) -- (at (select {by: k from: Tckp take: -1}) 'y)
(at (select {by: (* x 2) from: Tck take: [1 2]}) 'y) -- (at (select {by: k from: Tckp take: [1 2]}) 'y)
(at (select {by: (* x 2) from: Tck desc: x take: 10}) 'x) -- [8 6 4 2]
;; where: filters the rows before the grouping
(select {by: (* x 2) from: Tck where: (> y 15) asc: x take: 2}) -- (table [x y] (list [4 6] [20 30]))
;; several rows per group: the first row of each, as for a plain key
(select {by: (% x 2) from: Tck asc: x}) -- (table [x y] (list [0 1] [40 30]))
(at (select {by: (% x 2) from: Tck desc: y take: 1}) 'y) -- [40]
;; a null key sorts as the plain key's null does
(set Tckn (table [x y] (list [1 0N 3 0N 5] [10 20 30 40 50])))
(set Tcknp (update {k: (* x 2) from: Tckn}))
(at (select {by: (* x 2) from: Tckn desc: x}) 'y) -- (at (select {by: k from: Tcknp desc: k}) 'y)
(at (select {by: (* x 2) from: Tckn asc: x take: 2}) 'y) -- (at (select {by: k from: Tcknp asc: k take: 2}) 'y)
(at (select {by: (* x 2) from: Tckn asc: x take: 2}) 'y) -- [20 10]
;; STR and LIST columns are gathered whole.  The branch built every column
;; with store_typed_elem, which has no STR case: the cells came back empty
;; or stale, and a sort on them read an unset string pool.
(set Tcks (table [x r] (list [3 1 4 2 3 1] (list "c-long-string-over-12" "a-long-string-over-12" "d-long-string-over-12" "b-long-string-over-12" "c2" "a2"))))
(set Tcksp (update {k: (* x 2) from: Tcks}))
(at (select {by: (* x 2) from: Tcks}) 'r) -- ["c-long-string-over-12" "a-long-string-over-12" "d-long-string-over-12" "b-long-string-over-12"]
(at (select {by: (* x 2) from: Tcks}) 'r) -- (at (select {by: k from: Tcksp}) 'r)
(at (select {by: (* x 2) from: Tcks desc: r}) 'r) -- (at (select {by: k from: Tcksp desc: r}) 'r)
(at (select {by: (* x 2) from: Tcks desc: r}) 'x) -- [8 6 4 2]
(at (select {by: (* x 2) from: Tcks desc: r take: 2}) 'r) -- (at (select {by: k from: Tcksp desc: r take: 2}) 'r)
(at (select {by: (* x 2) from: Tcks desc: r take: 2}) 'r) -- ["d-long-string-over-12" "c-long-string-over-12"]
(set Tckl (table [x l] (list [3 1 4 2] (list [1 2] [3] [4 5 6] [7]))))
(set Tcklp (update {k: (* x 2) from: Tckl}))
(at (select {by: (* x 2) from: Tckl}) 'l) -- (at (select {by: k from: Tcklp}) 'l)
(at (select {by: (* x 2) from: Tckl desc: x take: 2}) 'l) -- (at (select {by: k from: Tcklp desc: k take: 2}) 'l)
(at (select {by: (* x 2) from: Tckl desc: x take: 2}) 'l) -- (list [4 5 6] [1 2])
;; a STR computed key, over more rows than one gather chunk
(set Tckb (table [x r] (list (til 8192) (concat "row-string-over-twelve-" (as 'STR (% (til 8192) 700))))))
(set Tckbp (update {k: (concat r "!") from: Tckb}))
(count (select {by: (concat r "!") from: Tckb})) -- 700
(at (select {by: (concat r "!") from: Tckb desc: r take: 3}) 'r) -- (at (select {by: k from: Tckbp desc: k take: 3}) 'k)
(at (select {by: (concat r "!") from: Tckb desc: r take: 3}) 'x) -- [99 98 97]
(at (select {by: (concat r "!") from: Tckb asc: x take: -2}) 'r) -- (at (select {by: k from: Tckbp asc: x take: -2}) 'k)
;; a dotted key takes the same branch; the by-dict form is the oracle
(set Tckt (table [ts v] (list [2024.01.02D10:00:00.000000000 2024.01.01D09:00:00.000000000 2024.01.02D11:00:00.000000000 2024.01.03D08:00:00.000000000 2024.01.01D12:00:00.000000000] [1 2 3 4 5])))
(select {by: ts.date from: Tckt desc: date take: 2}) -- (select {by: {date: ts.date} from: Tckt desc: date take: 2})
(select {by: ts.date from: Tckt asc: date}) -- (select {by: {date: ts.date} from: Tckt asc: date})
(select {by: ts.date from: Tckt where: (> v 1) desc: v take: -2}) -- (select {by: {date: ts.date} from: Tckt where: (> v 1) desc: v take: -2})
(at (select {by: ts.date from: Tckt desc: date take: 2}) 'v) -- [4 1]
;; a LIST-valued key: ray_is_vec leaves out RAY_LIST, so the key column was
;; never gathered and the source column it replaces was dropped with it.
;; The plain LIST key is the oracle.  The identity lambda is a row-aligned
;; LIST key that the planned grouping and this branch evaluate alike.
(set Tckk (table [x l] (list [3 1 4 2] (list [1 2] [3] [4 5 6] [3]))))
(select {by: ((fn [a] a) l) from: Tckk}) -- (select {by: l from: Tckk})
(at (select {by: ((fn [a] a) l) from: Tckk}) 'l) -- (at (select {c: (count x) by: ((fn [a] a) l) from: Tckk}) 'l)
(select {by: ((fn [a] a) l) from: Tckk desc: x}) -- (select {by: l from: Tckk desc: x})
(select {by: ((fn [a] a) l) from: Tckk desc: x take: 2}) -- (select {by: l from: Tckk desc: x take: 2})
(select {by: ((fn [a] a) l) from: Tckk desc: x take: 2}) -- (table [l x] (list (list [4 5 6] [1 2]) [4 3]))
(select {by: ((fn [a] a) l) from: Tckk desc: x take: -2}) -- (select {by: l from: Tckk desc: x take: -2})
(select {by: ((fn [a] a) l) from: Tckk where: (== x 4)}) -- (select {by: l from: Tckk where: (== x 4)})
(select {by: ((fn [a] a) l) from: Tckk where: (> x 100)}) -- (select {by: l from: Tckk where: (> x 100)})
;; a key of another length is no row-aligned key: its group rows would index
;; past the gathered columns.  A LIST key gets past the planned grouping's
;; own length check, which looks at vectors only.
(select {by: ((fn [a] (concat a a)) l) from: Tckk desc: x}) !- length
(select {by: (concat l l) from: Tckk desc: x}) !- length
;; (concat x 99), bare or in a lambda, is a collection of 5 values: the
;; whole-column key evaluation refuses it
(select {by: (concat x 99) from: Tckk}) !- length
(select {by: ((fn [a] (concat a 99)) x) from: Tckk}) !- length
;; a concat of collections is no text: the planner leaves it to the whole
;; column, where an aligned one groups as the column it equals
(set Eck (take [1] 0))
(value (select {c: (count x) by: (concat x Eck) from: Tckk})) -- (value (select {c: (count x) by: x from: Tckk}))
(at (select {by: (concat x Eck) from: Tckk desc: x}) (quote x)) -- (at (select {by: x from: Tckk desc: x}) (quote x))
;; any key the planner cannot lower is evaluated over the whole column, as
;; its lambda form and its materialised vector are: with and without
;; outputs, sorted and taken, filtered; a misaligned one is refused
(set Trk (table [x s] (list [3 1 4 2 3 1] [a b a c b a])))
(set Krev (reverse (at Trk 'x)))
(value (select {c: (count x) by: (reverse x) from: Trk})) -- (value (select {c: (count x) by: ((fn [a] (reverse a)) x) from: Trk}))
(at (select {c: (count x) by: (reverse x) from: Trk}) 'c) -- (at (select {c: (count x) by: {k: Krev} from: Trk}) 'c)
(select {by: (reverse x) from: Trk}) -- (select {by: ((fn [a] (reverse a)) x) from: Trk})
(select {by: (asc x) from: Trk desc: x take: 2}) -- (select {by: ((fn [a] (asc a)) x) from: Trk desc: x take: 2})
(select {c: (count x) by: (asc x) from: Trk desc: c take: 2}) -- (select {c: (count x) by: ((fn [a] (asc a)) x) from: Trk desc: c take: 2})
(at (select {by: (til (count x)) from: Trk where: (> x 1)}) (quote key)) -- (at (select {by: ((fn [a] (til (count a))) x) from: Trk where: (> x 1)}) (quote x))
(at (select {by: (til (count x)) from: Trk where: (> x 1)}) (quote s)) -- (at (select {by: ((fn [a] (til (count a))) x) from: Trk where: (> x 1)}) (quote s))
(select {c: (count x) by: (reverse x) from: Trk where: (> x 1)}) -- (select {c: (count x) by: ((fn [a] (reverse a)) x) from: Trk where: (> x 1)})
(select {by: (distinct x) from: Trk}) !- length
(select {c: (count x) by: (distinct x) from: Trk}) !- length
;; an unknown column reads as schema, lowered or not; an unknown function
;; stays a name error
(select {c: (count x) by: (reverse nosuch) from: Trk}) !- schema
(select {by: (reverse nosuch) from: Trk}) !- schema
(select {c: (count x) by: (+ nosuch 1) from: Trk}) !- schema
(select {c: (count x) by: (reverse nosuch) from: Trk where: (> x 1)}) !- schema
(select {c: (count x) by: (nosuchfn x) from: Trk}) !- name
;; a name the key binds itself, by let or set in a do, is no column; a key
;; that binds names is left to the evaluator, which reports any unknown one
(value (select {c: (count x) by: (do (let qk x) (reverse qk)) from: Trk})) -- (value (select {c: (count x) by: (reverse x) from: Trk}))
(at (select {c: (count x) by: (do (set qkg x) (reverse qkg)) from: Trk}) (quote c)) -- [2 2 1 1]
(select {c: (count x) by: (do (let qk x) (reverse nosuch)) from: Trk}) !- name
(select {c: (count x) by: (do (reverse qk2) (let qk2 x)) from: Trk}) !- name
;; a name bound inside nested forms, by set or let in a do, an if, or
;; through a binder called by another name, is the evaluator's to resolve:
;; the unknown-column check never refuses such a key
(set fnest (fn [a] (let b a) (reverse b)))
;; (a key with an effect runs row by row: each row's key is its x)
(at (select {by: (fnest (do (do (set qn1 x)) qn1)) from: Trk}) 'x) -- (at (select {by: x from: Trk}) 'x)
(count (select {by: (reverse (if true (set qn2 x) (set qn2 s))) from: Trk})) -- (count (select {by: (reverse x) from: Trk}))
(count (select {by: (reverse (do (do (do (set qn3 x))) (do (do qn3)))) from: Trk})) -- (count (select {by: (reverse x) from: Trk}))
(set setalias set)
(count (select {by: (reverse (do (setalias qn4 x) qn4)) from: Trk})) -- (count (select {by: (reverse x) from: Trk}))
;; a binder reached through a lambda parameter, or placed in a built key as
;; the builtin itself, binds too
(set runb (fn [x] (select {by: (reverse (do (x qb s) qb)) from: Trk})))
(count (runb set)) -- (count (select {by: s from: Trk}))
(set syk (fn [n] (as 'SYMBOL n)))
(set Kset (list (syk "reverse") (list (syk "do") (list set (syk "qo") (syk "x")) (syk "qo"))))
(count (eval (list select (dict [from by] (list Trk Kset))))) -- 4
;; text concat is still planned, and groups the same
(at (select {c: (count x) by: (concat s "z") from: Trk}) 'c) -- [3 2 1]
;; one value is one group, holding the first row
(select {by: ((fn [a] [7]) x) from: Tcks}) -- (table [x r] (list [7] (list "c-long-string-over-12")))
;; a name that is no column (a global vector) is grouped by its values, as
;; the with-output and by-dict forms group it.  The branch took it for a
;; column and dereferenced the NULL its lookup returned.
(set Tckg (table [x y] (list [3 1 4 2] [30 10 40 20])))
(set Vck1 [7])
(set Vck4 [1 1 2 2])
(set VckL (list [1] [1] [2] [2]))
(select {by: Vck1 from: Tckg}) -- (table [Vck1 x y] (list [7] [3] [30]))
(select {by: Vck4 from: Tckg}) -- (table [Vck4 x y] (list [1 2] [3 4] [30 40]))
(value (select {by: Vck4 from: Tckg})) -- (value (select {by: {k: Vck4} from: Tckg}))
(at (select {by: Vck4 from: Tckg}) 'Vck4) -- (first (value (select {c: (count y) by: Vck4 from: Tckg})))
(select {by: Vck4 from: Tckg desc: y take: 1}) -- (table [Vck4 x y] (list [2] [4] [40]))
(select {by: Vck1 from: Tckg where: (> y 15)}) -- (table [Vck1 x y] (list [7] [3] [30]))
(key (select {by: Vck1 from: Tckg where: (> y 100)})) -- ['Vck1 'x 'y]
(count (select {by: Vck1 from: Tckg where: (> y 100)})) -- 0
;; a global LIST is no key here, as with an output
(select {by: VckL from: Tckg}) !- schema
(select {c: (count y) by: VckL from: Tckg}) !- schema
;; a local that shadows a column: the grouping groups by the local, as the
;; with-output form does, and names its key column after no column.  The
;; branch looked the key up by the column's name and read unset group keys.
(set Tcksh (table [x y] (list [3 1 4 2] [30 10 40 20])))
(set Tcksl (table [k s l] (list [1 2 3 4] (list "aa" "bb" "cc" "dd") (list [1] [2] [3] [4]))))
((fn [y] (select {by: y from: Tcksh})) [10 10 30 30]) -- (table [y x] (list [10 30] [3 4]))
((fn [y] (at (select {by: y from: Tcksh}) 'y)) [10 10 30 30]) -- ((fn [y] (first (value (select {c: (first x) by: y from: Tcksh})))) [10 10 30 30])
((fn [y] (at (select {by: y from: Tcksh}) 'x)) [10 10 30 30]) -- ((fn [y] (at (select {c: (first x) by: y from: Tcksh}) 'c)) [10 10 30 30])
((fn [k] (select {by: k from: Tcksl})) [9 9 9 9]) -- (table [k s l] (list [9] (list "aa") (list [1])))
((fn [] (let y [10 10 30 30]) (select {by: y from: Tcksh}))) -- (table [y x] (list [10 30] [3 4]))
((fn [y] (select {by: y from: Tcksh desc: y})) [10 10 30 30]) -- (table [y x] (list [30 10] [4 3]))
((fn [y] (select {by: y from: Tcksh where: (> x 0)})) [10 10 30 30]) -- (table [y x] (list [10 30] [3 4]))
;; xfail: a where: that drops rows refuses the local (4 values for 3 rows),
;; where the with-output form filters the local too: [10 30] [3 4]
;; ((fn [y] (select {by: y from: Tcksh where: (> x 1)})) [10 10 30 30]) -- (table [y x] (list [10 30] [3 4]))
;; a name bound to one value is one group, as the with-output form groups
;; it; the branch handed the atom to a grouping that takes vectors only.
;; A name bound to a function is no key.
(set Acka 5)
(set Acks "abc")
(select {by: Acka from: Tckg}) -- (table [Acka x y] (list [5] [3] [30]))
(at (select {by: Acka from: Tckg}) 'Acka) -- (first (value (select {c: (first x) by: Acka from: Tckg})))
(at (select {by: Acka from: Tckg}) 'x) -- (at (select {c: (first x) by: Acka from: Tckg}) 'c)
(select {by: Acks from: Tckg where: (> x 3)}) -- (table [Acks x y] (list (list "abc") [4] [40]))
((fn [] (let F 2.5) (select {by: F from: Tckg}))) -- (table [F x y] (list [2.5] [3] [30]))
(type (at (select {by: Acka from: Tckg where: (> y 100)}) 'Acka)) -- 'I64
(count (select {by: Acka from: Tckg where: (> y 100)})) -- 0
(select {by: sum from: Tckg}) !- domain
(select {c: (count y) by: sum from: Tckg}) !- domain
;; a key that evaluates lazily (a moving window) is materialised first
(set Tcklz (update {k: (mmax 2 x) from: Tckg}))
(at (select {by: (mmax 2 x) from: Tckg}) (quote x)) -- (at (select {by: k from: Tcklz}) (quote k))
(at (select {by: (mmax 2 x) from: Tckg}) (quote y)) -- (at (select {by: k from: Tcklz}) (quote y))
(at (select {by: (mmax 2 x) from: Tckg desc: x}) (quote y)) -- (at (select {by: k from: Tcklz desc: k}) (quote y))
(type (at (select {by: (mmax 2 x) from: Tckg where: (> y 100)}) (quote x))) -- (quote I64)
;; a computed by-dict key with a where: and no outputs keeps every column, in
;; the table's order: the prefilter narrowed the table to the columns the
;; clauses name, which are all an output-less select returns
(set Tckp3 (table [x y z] (list [3 1 4 2] [30 10 40 20] [7 8 9 6])))
(set Tckp3k (update {k: (* x 2) from: Tckp3}))
(select {by: {k: (* x 2)} from: Tckp3 where: (> y 15)}) -- (select {by: k from: Tckp3k where: (> y 15)})
(select {by: {k: (* x 2)} from: Tckp3 where: (> y 15)}) -- (table [k x y z] (list [6 8 4] [3 4 2] [30 40 20] [7 9 6]))
(key (select {by: {a: x b: (* y 2)} from: Tckp3 where: (> y 15)})) -- ['a 'b 'x 'y 'z]
(select {by: {k: (* x 2)} from: Tckp3 where: (> y 15) desc: k take: 2}) -- (table [k x y z] (list [8 6] [4 3] [40 30] [9 7]))
;; on a parted table every no-output form matches the same select on the
;; materialised table; each read a parted column as a plain one and failed
(.sys.exec "rm -rf /tmp/rfl_ckparted")
(.db.splayed.set "/tmp/rfl_ckparted/2024.01.01/t/" (table [x y s r] (list [3 1 4] [30 10 40] ['c 'a 'd] (list "c-long-string-over-12" "a" "d"))))
(.db.splayed.set "/tmp/rfl_ckparted/2024.01.02/t/" (table [x y s r] (list [2 3 1 5] [20 31 11 50] ['b 'c 'a 'e] (list "b" "c2" "a2" "e"))))
(set Pck (.db.parted.get "/tmp/rfl_ckparted/" 't))
(set Mck (select {from: Pck where: (>= y 0)}))
(count (select {by: x from: Pck})) -- 5
(select {by: x from: Pck}) -- (select {by: x from: Mck})
(select {by: x from: Pck desc: y take: 2}) -- (select {by: x from: Mck desc: y take: 2})
(select {by: (% x 2) from: Pck asc: x}) -- (select {by: (% x 2) from: Mck asc: x})
(select {by: s from: Pck}) -- (select {by: s from: Mck})
(select {by: r from: Pck}) -- (select {by: r from: Mck})
(select {by: [x s] from: Pck}) -- (select {by: [x s] from: Mck})
(select {by: {k: (* x 2)} from: Pck}) -- (select {by: {k: (* x 2)} from: Mck})
(select {by: date from: Pck}) -- (select {by: date from: Mck})
(select {by: x from: Pck where: (> y 15)}) -- (select {by: x from: Mck where: (> y 15)})
;; a where: on the key column itself: kept on the row path, which flattens
;; the rows it keeps (deferred, it left the no-output paths a parted key)
(select {by: x from: Pck where: (> x 2)}) -- (select {by: x from: Mck where: (> x 2)})
(select {by: x from: Pck where: (>= x 0)}) -- (select {by: x from: Mck where: (>= x 0)})
(select {by: date from: Pck where: (> date 2024.01.01)}) -- (select {by: date from: Mck where: (> date 2024.01.01)})
;; a key the planner cannot lower reads whole columns of a parted table, as
;; of the flat one: a helper, a builtin with no kernel; with and without
;; outputs, sorted and taken, filtered
(set fkp (fn [] (% x 2)))
(select {by: (fkp) from: Pck}) -- (select {by: (fkp) from: Mck})
(select {c: (count y) by: (fkp) from: Pck}) -- (select {c: (count y) by: (fkp) from: Mck})
(select {by: (reverse x) from: Pck}) -- (select {by: (reverse x) from: Mck})
(select {c: (count y) by: (reverse x) from: Pck}) -- (select {c: (count y) by: (reverse x) from: Mck})
(select {s: (sum y) by: (reverse x) from: Pck desc: s take: 2}) -- (select {s: (sum y) by: (reverse x) from: Mck desc: s take: 2})
(select {c: (count y) by: (reverse x) from: Pck where: (> y 15)}) -- (select {c: (count y) by: (reverse x) from: Mck where: (> y 15)})
(select {by: (reverse x) from: Pck desc: y take: 2}) -- (select {by: (reverse x) from: Mck desc: y take: 2})
(select {by: (fkp) from: Pck asc: r}) -- (select {by: (fkp) from: Mck asc: r})
(select {c: (count y) by: (distinct x) from: Pck}) !- length
;; and as a by-dict value: a helper or a builtin with no kernel, beside
;; outputs, sorted, filtered, with a second key, with no output
(select {c: (count y) by: {k: (fkp)} from: Pck}) -- (select {c: (count y) by: {k: (fkp)} from: Mck})
(select {c: (count y) by: {k: (reverse x)} from: Pck}) -- (select {c: (count y) by: {k: (reverse x)} from: Mck})
(select {sy: (sum y) by: {k: (fkp)} from: Pck desc: sy take: 2}) -- (select {sy: (sum y) by: {k: (fkp)} from: Mck desc: sy take: 2})
(select {c: (count y) by: {k: (fkp)} from: Pck where: (> y 15)}) -- (select {c: (count y) by: {k: (fkp)} from: Mck where: (> y 15)})
(select {c: (count y) by: {k: (fkp) ks: s} from: Pck}) -- (select {c: (count y) by: {k: (fkp) ks: s} from: Mck})
(select {by: {k: (fkp)} from: Pck}) -- (select {by: {k: (fkp)} from: Mck})
;; a where: before a computed key keeps every column when a helper reads
;; one the clauses do not name (x here)
(set Tnw (table [x y z] (list [3 1 4 2 3] [10 20 30 40 50] [1 1 1 1 1])))
(select {c: (count y) by: {k: (fkp)} from: Tnw where: (> y 15)}) -- (select {c: (count y) by: {k: (% x 2)} from: Tnw where: (> y 15)})
;; a sort without by: sorts the keys and gathers the rows they keep; the
;; flat sort it fell to read parted columns as plain ones and failed
(select {from: Pck desc: x}) -- (select {from: Mck desc: x})
(select {from: Pck asc: y}) -- (select {from: Mck asc: y})
(select {from: Pck desc: x take: 2}) -- (select {from: Mck desc: x take: 2})
(select {from: Pck asc: x take: -2}) -- (select {from: Mck asc: x take: -2})
;; take: 0 with a sort keeps no row, on every path (the flat sort fused
;; with its take read 0 as no limit and kept every row)
(select {from: Pck asc: x take: 0}) -- (select {from: Mck asc: x take: 0})
(count (select {from: Mck asc: x take: 0})) -- 0
(count (select {from: Pck asc: x take: 0})) -- 0
(count (select {from: Mck desc: x take: 0})) -- 0
(count (select {x: x from: Mck asc: x take: 0})) -- 0
(count (select {x: x from: Pck asc: x take: 0})) -- 0
(count (select {y: y from: Pck desc: x take: 0})) -- 0
(count (select {from: Mck asc: [x y] take: 0})) -- 0
(count (select {from: Mck where: (> y 15) asc: x take: 0})) -- 0
(count (select {from: Pck where: (> y 15) asc: x take: 0})) -- 0
(key (select {x: x from: Mck asc: x take: 0})) -- [x]
(select {from: Pck asc: x take: [1 3]}) -- (select {from: Mck asc: x take: [1 3]})
(select {from: Pck asc: [x y]}) -- (select {from: Mck asc: [x y]})
(select {from: Pck asc: x desc: y}) -- (select {from: Mck asc: x desc: y})
(select {from: Pck where: (> y 15) desc: x take: 2}) -- (select {from: Mck where: (> y 15) desc: x take: 2})
(select {from: Pck asc: s}) -- (select {from: Mck asc: s})
(select {from: Pck desc: r take: 3}) -- (select {from: Mck desc: r take: 3})
(select {from: Pck desc: date}) -- (select {from: Mck desc: date})
(select {from: Pck desc: 'y}) -- (select {from: Mck desc: 'y})
(select {x: x from: Pck desc: x}) -- (select {x: x from: Mck desc: x})
(select {y: y from: Pck desc: x}) -- (select {y: y from: Mck desc: x})
;; a where: that keeps every row leaves no selection and hands the sort the
;; parted table itself; it sorts it flattened, as a partial where: does
(select {from: Pck where: (>= y 0) desc: x}) -- (select {from: Mck desc: x})
(select {from: Pck where: (>= y 0) asc: [x y]}) -- (select {from: Mck asc: [x y]})
(select {from: Pck where: (>= y 0) desc: x take: 2}) -- (select {from: Mck desc: x take: 2})
(select {from: Pck where: (>= y 0) asc: s}) -- (select {from: Mck asc: s})
(select {from: Pck where: (>= y 0) desc: r take: 3}) -- (select {from: Mck desc: r take: 3})
(select {from: Pck where: (>= y 0) desc: date}) -- (select {from: Mck desc: date})
(select {y: y from: Pck where: (>= y 0) desc: x}) -- (select {y: y from: Mck desc: x})
(select {x: x from: Pck where: (>= y 0) desc: y take: 2}) -- (select {x: x from: Mck desc: y take: 2})
;; a ragged parted table (a partition lacks a column) sorts, filters and
;; projects as the flat table with typed nulls in that partition's rows,
;; the way it prints and serializes; the missing rows come from the
;; partition-key counts.  The partition without the column is in the
;; middle here, then last.
(.sys.exec "rm -rf /tmp/rfl_ckragged")
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.01/t/" (table [a b h] (list [0 1] [0.5 1.5] [true false])))
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.02/t/" (table [a] (list [2 3 4])))
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.03/t/" (table [a b h] (list [5 6] [5.5 6.5] [true true])))
(set Prg (.db.parted.get "/tmp/rfl_ckragged/" 't))
(set Frg (table [date a b h] (list [2024.01.01 2024.01.01 2024.01.02 2024.01.02 2024.01.02 2024.01.03 2024.01.03] [0 1 2 3 4 5 6] [0.5 1.5 0Nf 0Nf 0Nf 5.5 6.5] [true false false false false true true])))
(select {from: Prg where: (>= a 0) desc: a take: 3}) -- (select {from: Frg desc: a take: 3})
(select {from: Prg where: (>= a 0) asc: h}) -- (select {from: Frg asc: h})
(select {from: Prg where: (>= a 0) desc: b}) -- (select {from: Frg desc: b})
(select {from: Prg desc: b}) -- (select {from: Frg desc: b})
(select {from: Prg asc: a take: 3}) -- (select {from: Frg asc: a take: 3})
(select {from: Prg where: (>= a 0)}) -- Frg
(count (select {from: Prg where: (>= a 0)})) -- 7
(de (ser (select {from: Prg where: (>= a 0)}))) -- Frg
(select {from: Prg where: (> a 1)}) -- (select {from: Frg where: (> a 1)})
(select {b: b h: h from: Prg where: (> a 1)}) -- (select {b: b h: h from: Frg where: (> a 1)})
(select {b: b from: Prg where: (> a 1) desc: a take: 2}) -- (select {b: b from: Frg where: (> a 1) desc: a take: 2})
(select {from: Prg take: 4}) -- (select {from: Frg take: 4})
(select {from: Prg take: -4}) -- (select {from: Frg take: -4})
(select {s: (sum b) n: (count b) f: (first b) from: Prg by: date}) -- (select {s: (sum b) n: (count b) f: (first b) from: Frg by: date})
(.sys.exec "rm -rf /tmp/rfl_ckragged")
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.01/t/" (table [a b] (list [0 1] [0.5 1.5])))
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.02/t/" (table [a b] (list [2 3] [2.5 3.5])))
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.03/t/" (table [a] (list [4 5])))
(set Prg (.db.parted.get "/tmp/rfl_ckragged/" 't))
(set Frg (table [date a b] (list [2024.01.01 2024.01.01 2024.01.02 2024.01.02 2024.01.03 2024.01.03] [0 1 2 3 4 5] [0.5 1.5 2.5 3.5 0Nf 0Nf])))
(select {from: Prg where: (>= a 0) asc: b}) -- (select {from: Frg asc: b})
(select {from: Prg where: (>= a 0) desc: a take: 2}) -- (select {from: Frg desc: a take: 2})
(select {from: Prg desc: a take: 2}) -- (select {from: Frg desc: a take: 2})
(.sys.exec "rm -rf /tmp/rfl_ckragged")
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.01/t/" (table [a b] (list [0 1] [0.5 1.5])))
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.02/t/" (table [a] (list (as 'I64 []))))
(.db.splayed.set "/tmp/rfl_ckragged/2024.01.03/t/" (table [a b] (list [5 6] [5.5 6.5])))
(set Prg (.db.parted.get "/tmp/rfl_ckragged/" 't))
(set Frg (table [date a b] (list [2024.01.01 2024.01.01 2024.01.03 2024.01.03] [0 1 5 6] [0.5 1.5 5.5 6.5])))
(select {from: Prg where: (>= a 0) desc: a take: 3}) -- (select {from: Frg desc: a take: 3})
(select {from: Prg where: (>= a 0) asc: b}) -- (select {from: Frg asc: b})
(.sys.exec "rm -rf /tmp/rfl_ckragged")
;; a select with no clauses answers the parted table itself, uncopied; it
;; counts, prints and serializes as its rows: ser writes each parted column
;; as the flat vector it stands for, byte for byte, and de reads a flat table
(count (select {from: Pck})) -- (count Mck)
(ser Pck) -- (ser Mck)
(ser (select {from: Pck})) -- (ser Mck)
(de (ser Pck)) -- Mck
(de (ser (select {from: Pck}))) -- Mck
(ser (list Pck 1)) -- (ser (list Mck 1))
(ser (dict [k] (list Pck))) -- (ser (dict [k] (list Mck)))
(format "%" (select {from: Pck})) -- (format "%" Mck)
;; and a parted table formats as its rows (its column types were `?`)
(format "%" Pck) -- (format "%" Mck)
;; sort keys no output carries, or carried under another name: the sort
;; reads them as columns whatever the outputs are named, as the flat one
;; does; an output naming another output reads that output
(select {y: y s: s from: Pck desc: x take: 2}) -- (select {y: y s: s from: Mck desc: x take: 2})
(select {s: s from: Pck asc: [y x] take: -2}) -- (select {s: s from: Mck asc: [y x] take: -2})
(select {z: x r: r from: Pck asc: x}) -- (select {z: x r: r from: Mck asc: x})
(select {date: date y: y from: Pck desc: y take: 3}) -- (select {date: date y: y from: Mck desc: y take: 3})
(select {x: y r: r from: Pck desc: x}) -- (select {x: y r: r from: Mck desc: x})
(select {x: y y: x from: Pck desc: y}) -- (select {x: y y: x from: Mck desc: y})
(select {x: y z: x y: y from: Pck desc: y}) -- (select {x: y z: x y: y from: Mck desc: y})
;; an output named after a lambda parameter reads the parameter, not the
;; column it hides
(set runs (fn [tbl x] (select {y: y x: x from: tbl desc: y})))
(runs Pck 7) -- (runs Mck 7)
;; a dotted output (a field of the partition date) is no stored column: the
;; flat sort answers it
(select {month: date.mm from: Pck desc: x}) -- (select {month: date.mm from: Mck desc: x})
(select {day: date.dd from: Pck asc: y}) -- (select {day: date.dd from: Mck asc: y})
(select {month: date.mm y: y from: Pck desc: y take: 2}) -- (select {month: date.mm y: y from: Mck desc: y take: 2})
;; with take: too (the per-partition top-k sorted each partition on the
;; column and merged them on the output of that name)
(select {x: y r: r from: Pck desc: x take: 3}) -- (select {x: y r: r from: Mck desc: x take: 3})
(select {x: y y: x from: Pck desc: y take: 2}) -- (select {x: y y: x from: Mck desc: y take: 2})
;; it groups on the columns the clauses name and gathers the others at the
;; rows kept: a sort key only in desc:/asc:, a by-dict value's column, the
;; partition key sorted, every row its own group, a key from a global
(select {by: x from: Pck desc: r take: 3}) -- (select {by: x from: Mck desc: r take: 3})
(select {by: x from: Pck asc: s}) -- (select {by: x from: Mck asc: s})
(select {by: {k: y} from: Pck}) -- (select {by: {k: y} from: Mck})
(select {by: {k: (% y 20)} from: Pck}) -- (select {by: {k: (% y 20)} from: Mck})
(select {by: date from: Pck desc: date}) -- (select {by: date from: Mck desc: date})
(select {by: y from: Pck}) -- (select {by: y from: Mck})
(select {by: y from: Pck desc: y}) -- (select {by: y from: Mck desc: y})
(set Vck7 [1 1 2 2 3 3 3])
(select {by: Vck7 from: Pck}) -- (select {by: Vck7 from: Mck})
(select {by: x from: Pck take: [1 2]}) -- (select {by: x from: Mck take: [1 2]})
;; a quoted symbol naming the key or the sort column is that column too
(select {by: 's from: Pck}) -- (select {by: 's from: Mck})
(select {by: 'r from: Pck}) -- (select {by: 'r from: Mck})
(select {by: 'date from: Pck}) -- (select {by: 'date from: Mck})
(select {by: s from: Pck desc: 'y}) -- (select {by: s from: Mck desc: 'y})
(select {by: s from: Pck asc: 'r take: 2}) -- (select {by: s from: Mck asc: 'r take: 2})
(.sys.exec "rm -rf /tmp/rfl_ckparted")
;; a column named as a computed key is (`key`): the key replaces it in the
;; result, as on the flattened table
(.sys.exec "rm -rf /tmp/rfl_ckpkey")
(.db.splayed.set "/tmp/rfl_ckpkey/2024.01.01/t/" (table [x key] (list [3 1 4] [7 8 9])))
(.db.splayed.set "/tmp/rfl_ckpkey/2024.01.02/t/" (table [x key] (list [2 3 1 5] [6 5 4 3])))
(set Pckk (.db.parted.get "/tmp/rfl_ckpkey/" 't))
(set Mckk (select {from: Pckk where: (>= x 0)}))
(select {by: (+ (% x 2) 1) from: Pckk}) -- (select {by: (+ (% x 2) 1) from: Mckk})
(select {by: 5 from: Pckk}) -- (select {by: 5 from: Mckk})
(.sys.exec "rm -rf /tmp/rfl_ckpkey")
;; columns a key's naming checks read are grouped on for real: a dotted
;; key's tail names a column (mm), so the key takes the full name; a
;; by-dict alias that names a column is refused
(.sys.exec "rm -rf /tmp/rfl_ckpkn")
(.db.splayed.set "/tmp/rfl_ckpkn/2024.01.01/t/" (table [x mm dd] (list [0 1 2] [7 8 9] [5 5 6])))
(.db.splayed.set "/tmp/rfl_ckpkn/2024.02.02/t/" (table [x mm dd] (list [10 11 12] [7 8 9] [5 5 6])))
(set Pckn (.db.parted.get "/tmp/rfl_ckpkn/" 't))
(set Mckn (select {from: Pckn where: (>= x 0)}))
(select {by: date.mm from: Pckn}) -- (select {by: date.mm from: Mckn})
(select {by: date.dd from: Pckn}) -- (select {by: date.dd from: Mckn})
(select {by: {mm: (% x 2)} from: Mckn}) !- domain
(select {by: {mm: (% x 2)} from: Pckn}) !- domain
(.sys.exec "rm -rf /tmp/rfl_ckpkn")
;; the row-number column the parted paths add is never one the select
;; names: a by-dict key, a bound variable a key reads, a sort key
(.sys.exec "rm -rf /tmp/rfl_ckrown")
(.db.splayed.set "/tmp/rfl_ckrown/2024.01.01/t/" (table [i s] (list [3 1 2 5] [b a b c])))
(.db.splayed.set "/tmp/rfl_ckrown/2024.01.02/t/" (table [i s] (list [4 0 7] [a c a])))
(set Prn (.db.parted.get "/tmp/rfl_ckrown/" 't))
(set Mrn (select {from: Prn where: (>= i 0)}))
(select {by: {__row: s} from: Prn}) -- (select {by: {__row: s} from: Mrn})
(count (select {by: {__row: s} from: Prn})) -- 3
;; nor one a select reads unseen: a helper that reads a column by name, or
;; a name made at run time (the column a helper or eval reads is not in
;; the clauses, so the narrow copy would miss it or offer the row number)
(set hx (fn [] i))
(select {by: {k: (hx)} from: Prn}) -- (select {by: {k: (hx)} from: Mrn})
(set hr2 (fn [] __row))
(select {by: {k: (hr2)} from: Mrn}) !- name
(select {by: {k: (hr2)} from: Prn}) !- name
(select {by: {k: (eval (parse "__row"))} from: Mrn}) !- name
(select {by: {k: (eval (parse "__row"))} from: Prn}) !- name
(select {by: {k: (eval (as 'SYMBOL "__row"))} from: Mrn}) !- name
(select {by: {k: (eval (as 'SYMBOL "__row"))} from: Prn}) !- name
;; the helper called by a quoted name, through a computed callee, or out of
;; a list
(set hy (fn [x] i))
(set Ly (list hy))
(select {by: {k: ('hy 0)} from: Prn}) -- (select {by: {k: ('hy 0)} from: Mrn})
(select {by: {k: ((first Ly) 0)} from: Prn}) -- (select {by: {k: ((first Ly) 0)} from: Mrn})
(select {by: {k: (first (map (first Ly) [0]))} from: Prn}) -- (select {by: {k: (first (map (first Ly) [0]))} from: Mrn})
;; or by a dotted name into a dict of helper names ({f: hy} holds the name)
(set Dl {f: hy})
(select {by: {k: (Dl.f 0)} from: Prn}) -- (select {by: {k: (Dl.f 0)} from: Mrn})
(count (select {by: {k: (Dl.f 0)} from: Prn})) -- 7
(set hz (fn [] __row))
(set Dz {g: hz})
(select {by: {k: (Dz.g)} from: Mrn}) !- name
(select {by: {k: (Dz.g)} from: Prn}) !- name
;; or by a name bound to the helper's name
(set gy 'hy)
(select {by: {k: (gy 0)} from: Prn}) -- (select {by: {k: (gy 0)} from: Mrn})
(set __row [1 1 2 2 3 3 3])
(select {by: {k: __row} from: Prn}) -- (select {by: {k: __row} from: Mrn})
(count (select {by: {k: __row} from: Prn})) -- 3
;; a helper reading the bound __row reads the variable, as on the flat table
(set hr (fn [] __row))
(select {by: {k: (hr)} from: Prn}) -- (select {by: {k: (hr)} from: Mrn})
(count (select {by: {k: (hr)} from: Prn})) -- 3
;; a builtin that evaluates a name, called by another name, is code too:
;; it reads the variable, as on the flat table, not the row number
(set getv resolve)
(set rname '__row)
(select {by: {k: (getv rname)} from: Prn}) -- (select {by: {k: (getv rname)} from: Mrn})
(count (select {by: {k: (getv rname)} from: Prn})) -- 3
(set getq 'resolve)
(select {by: {k: (getq rname)} from: Prn}) -- (select {by: {k: (getq rname)} from: Mrn})
(set evq eval)
(set paq parse)
(select {by: {k: (evq (paq "__row"))} from: Prn}) -- (select {by: {k: (evq (paq "__row"))} from: Mrn})
(count (select {by: {k: (evq (paq "__row"))} from: Prn})) -- 3
;; the builtin itself placed in a built query is code as well
(set Erow (list resolve (syk "rname")))
(set Qrp (dict [from by] (list Prn (dict [k] (list Erow)))))
(set Qrm (dict [from by] (list Mrn (dict [k] (list Erow)))))
(eval (list select Qrp)) -- (eval (list select Qrm))
(count (eval (list select Qrp))) -- 3
;; a lambda parameter hides the column of its name: the helper passed in it
;; reads a column (s) the clauses do not name
(set runl (fn [tbl i] (select {by: {k: (i)} from: tbl})))
(runl Prn (fn [] s)) -- (runl Mrn (fn [] s))
(select {i: i from: Prn desc: i take: 2}) -- (select {i: i from: Mrn desc: i take: 2})
(select {from: Prn asc: s}) -- (select {from: Mrn asc: s})
(set __row 0)
(.sys.exec "rm -rf /tmp/rfl_ckrown")
;; a lambda parameter or let hides the column of its name in an output on
;; every sorted and taken route, as it does without take: (the parameter
;; and let bindings take precedence over query columns).  The fused top-k
;; and positional take gathered the column by name; the parted per-segment
;; routes ran the select on each partition, where a local of the whole
;; table's rows met a segment's rows.  A sort key names a column either way.
(.sys.exec "rm -rf /tmp/rfl_cklocal")
(.db.splayed.set "/tmp/rfl_cklocal/p/2024.01.01/t/" (table [x y] (list [3 1 4] [30 10 40])))
(.db.splayed.set "/tmp/rfl_cklocal/p/2024.01.02/t/" (table [x y] (list [2 3 1] [20 35 15])))
(.db.splayed.set "/tmp/rfl_cklocal/q/2024.01.01/t/" (table [x y] (list [1 2 3] [10 15 20])))
(.db.splayed.set "/tmp/rfl_cklocal/q/2024.01.02/t/" (table [x y] (list [4 5 6] [30 35 40])))
(.db.splayed.set "/tmp/rfl_cklocal/s/t/" (table [x y] (list [3 1 4 2 3 1] [30 10 40 20 35 15])))
(set Plc (.db.parted.get "/tmp/rfl_cklocal/p/" 't))
(set Qlc (.db.parted.get "/tmp/rfl_cklocal/q/" 't))
(set Slc (.db.splayed.get "/tmp/rfl_cklocal/s/t/"))
(set Tlc (select {from: Plc where: (> x 0)}))
(set Ulc (select {from: Qlc where: (> x 0)}))
(set lca (fn [tbl y] (select {x: x yy: y from: tbl asc: x take: 4})))
(set lcan (fn [tbl y] (select {x: x yy: y from: tbl asc: x})))
(at (lca Tlc 5) 'yy) -- [5 5 5 5]
(lca Tlc 5) -- (select {from: (lcan Tlc 5) take: 4})
(lca Slc 5) -- (select {from: (lcan Slc 5) take: 4})
(lca Plc 5) -- (select {from: (lcan Plc 5) take: 4})
(set lcd (fn [tbl y] (select {x: x yy: y from: tbl desc: x take: 3})))
(set lcdn (fn [tbl y] (select {x: x yy: y from: tbl desc: x})))
(lcd Tlc 5) -- (select {from: (lcdn Tlc 5) take: 3})
(lcd Slc 5) -- (select {from: (lcdn Slc 5) take: 3})
(lcd Plc 5) -- (select {from: (lcdn Plc 5) take: 3})
;; take: alone, and a where: with take: alone (the positional fused take)
(set lct (fn [tbl y] (select {x: x yy: y from: tbl take: 3})))
(set lctn (fn [tbl y] (select {x: x yy: y from: tbl})))
(lct Tlc 5) -- (select {from: (lctn Tlc 5) take: 3})
(lct Plc 5) -- (select {from: (lctn Plc 5) take: 3})
(at (lct Plc 5) 'yy) -- [5 5 5]
(lct Plc 5) -- (lct Tlc 5)
(at (lct Plc 5) 'x) -- [3 1 4]
(set lcw (fn [tbl y] (select {x: x yy: y from: tbl where: (> x 1) take: 2})))
(set lcwe (fn [tbl y] (select {x: x yy: y from: tbl where: (> x 1) take: -2})))
(set lcwn (fn [tbl y] (select {x: x yy: y from: tbl where: (> x 1)})))
(at (lcw Tlc 5) 'yy) -- [5 5]
(lcw Tlc 5) -- (select {from: (lcwn Tlc 5) take: 2})
(lcw Slc 5) -- (select {from: (lcwn Slc 5) take: 2})
(lcw Plc 5) -- (select {from: (lcwn Plc 5) take: 2})
(lcwe Tlc 5) -- (select {from: (lcwn Tlc 5) take: -2})
(lcwe Slc 5) -- (select {from: (lcwn Slc 5) take: -2})
(lcwe Plc 5) -- (select {from: (lcwn Plc 5) take: -2})
;; a where: with a sort and take:
(set lcws (fn [tbl y] (select {x: x yy: y from: tbl where: (> x 1) asc: x take: 2})))
(set lcwsn (fn [tbl y] (select {x: x yy: y from: tbl where: (> x 1) asc: x})))
(lcws Tlc 5) -- (select {from: (lcwsn Tlc 5) take: 2})
(lcws Slc 5) -- (select {from: (lcwsn Slc 5) take: 2})
(lcws Plc 5) -- (select {from: (lcwsn Plc 5) take: 2})
;; a let, and several sort keys (a key named like the local is the column)
(set lcl (fn [tbl] (let y 7) (select {x: x yy: y from: tbl asc: x take: 4})))
(at (lcl Tlc) 'yy) -- [7 7 7 7]
(at (lcl Plc) 'yy) -- [7 7 7 7]
(set lcm (fn [tbl y] (select {x: x yy: y from: tbl asc: [x y] take: 3})))
(set lcmn (fn [tbl y] (select {x: x yy: y from: tbl asc: [x y]})))
(lcm Tlc 5) -- (select {from: (lcmn Tlc 5) take: 3})
(lcm Plc 5) -- (select {from: (lcmn Plc 5) take: 3})
(set lck (fn [tbl x] (select {x: x yy: y from: tbl asc: x take: 3})))
(set lckn (fn [tbl x] (select {x: x yy: y from: tbl asc: x})))
(count (lck Tlc 5)) -- 3
(count (lck Plc 5)) -- 3
(at (lck Tlc 5) 'x) -- [5 5 5]
(at (lck Plc 5) 'x) -- [5 5 5]
;; OPEN: which x a sort key names when a parameter x hides the column and
;; an output is named x is undecided.  The ungrouped path sorts by the
;; source column (yy [10 15 20] here), the grouped path by the output of
;; that name (`(fn [tbl x] (select {x: (first x) yy: (sum y) by: y from: tbl
;; asc: x}))`), so the order is not pinned until one rule covers both:
;; (lck Tlc 5) -- (table [x yy] (list [5 5 5] [10 15 20]))
(lck Tlc 5) -- (select {from: (lckn Tlc 5) take: 3})
(lck Plc 5) -- (select {from: (lckn Plc 5) take: 3})
;; a local of the table's rows: gathered in the sorted order, on the flat,
;; splayed and parted table alike
(set Vlc [9 8 7 6 5 4])
(set lcv (fn [tbl x] (select {x: x yy: y from: tbl asc: y take: 4})))
(set lcvn (fn [tbl x] (select {x: x yy: y from: tbl asc: y})))
(at (lcv Tlc Vlc) 'x) -- [8 4 6 9]
(lcv Tlc Vlc) -- (select {from: (lcvn Tlc Vlc) take: 4})
(lcv Slc Vlc) -- (select {from: (lcvn Slc Vlc) take: 4})
(lcv Plc Vlc) -- (select {from: (lcvn Plc Vlc) take: 4})
(set lcy (fn [tbl y] (select {x: x yy: y from: tbl desc: x take: 2})))
(set lcyn (fn [tbl y] (select {x: x yy: y from: tbl desc: x})))
(at (lcy Ulc Vlc) 'yy) -- [4 5]
(lcy Ulc Vlc) -- (select {from: (lcyn Ulc Vlc) take: 2})
(lcy Qlc Vlc) -- (select {from: (lcyn Qlc Vlc) take: 2})
(lcy Plc Vlc) -- (select {from: (lcyn Plc Vlc) take: 2})
;; on partitions sorted on the key, without take:
(set lcq (fn [tbl y] (select {x: x yy: y from: tbl asc: x})))
(lcq Qlc Vlc) -- (lcq Ulc Vlc)
(at (lcq Qlc Vlc) 'yy) -- Vlc
(lcq Qlc 5) -- (lcq Ulc 5)
;; a where: reading a local of the table's rows filters the whole table
(set Mlc [false true false true false true])
(set lcm2 (fn [tbl m] (select {y: y from: tbl where: m asc: y take: 2})))
(set lcm2n (fn [tbl m] (select {y: y from: tbl where: m asc: y})))
(at (lcm2n Ulc Mlc) 'y) -- [15 30 40]
(lcm2n Qlc Mlc) -- (lcm2n Ulc Mlc)
(lcm2 Ulc Mlc) -- (select {from: (lcm2n Ulc Mlc) take: 2})
(lcm2 Qlc Mlc) -- (select {from: (lcm2n Ulc Mlc) take: 2})
;; a local scalar in a where: is one value on every route
(set lcs (fn [tbl x] (select {y: y from: tbl where: (> x 1) asc: y take: 2})))
(at (lcs Qlc 5) 'y) -- [10 15]
(at (lcs Ulc 5) 'y) -- [10 15]
(count (lcs Qlc 0)) -- 0
;; a grouped select: the key and an aggregate read the local
(set lcb (fn [tbl x] (select {s: (sum y) by: x from: tbl desc: s take: 1})))
(set lcbn (fn [tbl x] (select {s: (sum y) by: x from: tbl desc: s})))
(set Klc [1 1 1 2 2 2])
(lcb Tlc Klc) -- (select {from: (lcbn Tlc Klc) take: 1})
(lcb Plc Klc) -- (select {from: (lcbn Plc Klc) take: 1})
(lcb Slc Klc) -- (select {from: (lcbn Slc Klc) take: 1})
(value (lcb Slc Klc)) -- (list [1] [80])
;; the parted routes stream a where: only when the DAG streams it: compiled,
;; a local or a global is a constant, and only a scalar constant streams.
;; The set of in / not-in is no row operand: a membership list reads the
;; same on every segment, whatever its length (one partition's rows here,
;; or none), and streams
(set lcin (fn [tbl m] (select {x: x y: y from: tbl where: (in x m) desc: x take: 2})))
(set lcio (fn [tbl m] (select {x: x y: y from: tbl where: (in x m) asc: x})))
(set lcc1 (fn [tbl c] (select {x: x from: tbl where: (> x c.lo) desc: x take: 2})))
(set lcc2 (fn [tbl c] (select {x: x from: tbl where: (> x (at c 'lo)) asc: x take: 2})))
(set lcc3 (fn [tbl u] (select {x: x from: tbl where: (in x u.x) desc: x take: 2})))
(set Bsr (at (.sys.mem) 'sort-perpart-runs))
(lcin Qlc [1 4 5 9]) -- (table [x y] (list [5 4] [35 30]))
(- (at (.sys.mem) 'sort-perpart-runs) Bsr) -- 2
(set Bso (at (.sys.mem) 'sort-perpart-runs))
(lcio Qlc [1 4 5 9]) -- (table [x y] (list [1 4 5] [10 30 35]))
(- (at (.sys.mem) 'sort-perpart-runs) Bso) -- 2
(lcio Qlc [1 4 5 9]) -- (lcio Ulc [1 4 5 9])
(set Bso (at (.sys.mem) 'sort-perpart-runs))
(lcio Qlc [1 4 5]) -- (lcio Ulc [1 4 5])
(- (at (.sys.mem) 'sort-perpart-runs) Bso) -- 2
(set Bso (at (.sys.mem) 'sort-perpart-runs))
(count (lcio Qlc [])) -- 0
(- (at (.sys.mem) 'sort-perpart-runs) Bso) -- 2
(set Bso (at (.sys.mem) 'sort-perpart-runs))
(at (select {x: x from: Qlc where: (within x [2 5]) desc: x take: 3}) 'x) -- [5 4 3]
(- (at (.sys.mem) 'sort-perpart-runs) Bso) -- 2
;; a path into a config dict or a table passed in is no form the DAG
;; compiles: it is answered on the whole table
(set Bsc (at (.sys.mem) 'sort-perpart-runs))
(select {from: (lcc1 Qlc {lo: 2 hi: 9}) take: 9}) -- (lcc1 Ulc {lo: 2 hi: 9})
(- (at (.sys.mem) 'sort-perpart-runs) Bsc) -- 0
(set Bsc (at (.sys.mem) 'sort-perpart-runs))
(lcc2 Qlc {lo: 2 hi: 9}) -- (lcc2 Ulc {lo: 2 hi: 9})
(- (at (.sys.mem) 'sort-perpart-runs) Bsc) -- 0
(set Bsc (at (.sys.mem) 'sort-perpart-runs))
(lcc3 Qlc (table [x] (list [1 5]))) -- (table [x] (list [5 1]))
(- (at (.sys.mem) 'sort-perpart-runs) Bsc) -- 0
;; a computed value of the table's or a partition's length (a til, the
;; first of a list holding a mask, a helper returning a mask, a nested
;; select over the outer table) is no row operand the DAG streams: parted
;; answers as flat
(set Bsc (at (.sys.mem) 'sort-perpart-runs))
(select {x: x from: Qlc where: (< (til 3) 2) desc: x take: 2}) !- length
(select {x: x from: Ulc where: (< (til 3) 2) desc: x take: 2}) !- length
(select {x: x from: Qlc where: (< (til 6) 3) desc: x take: 2}) -- (select {x: x from: Ulc where: (< (til 6) 3) desc: x take: 2})
(at (select {x: x from: Qlc where: (< (til 6) 3) desc: x take: 2}) 'x) -- [3 2]
(set Lwm (list [true false true false true true]))
(set gwm (fn [] [true false true false true true]))
(set cyl (fn [t] (at t 'y)))
(select {x: x from: Qlc where: (first Lwm) desc: x take: 3}) !- schema
(select {x: x from: Ulc where: (first Lwm) desc: x take: 3}) !- schema
;; xfail BUG: the first of a global list holding a mask raises schema
;; ("column 'Lwm' not found") in a where: on the flat table too, where it
;; should filter by the mask
;; (at (select {x: x from: Ulc where: (first Lwm) desc: x take: 3}) 'x) -- [6 5 3]
(at (select {x: x from: Qlc where: (gwm) desc: x take: 3}) 'x) -- [6 5 3]
(select {x: x from: Qlc where: (gwm) asc: x}) -- (select {x: x from: Ulc where: (gwm) asc: x})
(at (select {x: x from: Qlc where: (in y (cyl (select {y: y from: Qlc where: (> x 4)}))) desc: x take: 3}) 'x) -- [6 5]
(select {x: x from: Qlc where: (in y (cyl (select {y: y from: Qlc where: (> x 4)}))) asc: x}) -- (select {x: x from: Ulc where: (in y (cyl (select {y: y from: Ulc where: (> x 4)}))) asc: x})
(- (at (.sys.mem) 'sort-perpart-runs) Bsc) -- 0
;; a mask as long as one partition, local or global, is no mask of the
;; table: the parted routes raise length as the flat ones do (they
;; filtered each partition with it); a global mask of the table's rows
;; filters the whole table
(set Gsm [true false true])
(set Gwm [true false true false true true])
(lcm2 Qlc [true false true]) !- length
(lcm2 Ulc [true false true]) !- length
(lcm2n Qlc [true false true]) !- length
(select {y: y from: Qlc where: Gsm desc: y take: 2}) !- length
(select {y: y from: Ulc where: Gsm desc: y take: 2}) !- length
(select {y: y from: Qlc where: Gwm desc: y take: 2}) -- (select {y: y from: Ulc where: Gwm desc: y take: 2})
(select {y: y from: Qlc where: Gwm asc: y}) -- (select {y: y from: Ulc where: Gwm asc: y})
(at (select {y: y from: Qlc where: Gwm asc: y}) 'y) -- [10 20 35 40]
;; a where: over the rows' order or the whole column (a scan, an aggregate)
;; is the whole table's, not each partition's
(select {x: x from: Qlc where: (> (sums x) 5) asc: x}) -- (select {x: x from: Ulc where: (> (sums x) 5) asc: x})
(at (select {x: x from: Qlc where: (> (sums x) 5) asc: x}) 'x) -- [3 4 5 6]
(select {x: x from: Qlc where: (> x (avg x)) asc: x take: 2}) -- (select {x: x from: Ulc where: (> x (avg x)) asc: x take: 2})
(at (select {x: x from: Qlc where: (> x (avg x)) asc: x take: 2}) 'x) -- [4 5]
(select {x: x from: Qlc where: (> (deltas x) 0) desc: x take: 2}) -- (select {x: x from: Ulc where: (> (deltas x) 0) desc: x take: 2})
;; only row-wise ops keep a partition's rows: a set of in or not-in that
;; reads a column, bin, concat and the vector distances are the whole
;; table's (each answered per partition)
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(select {x: x from: Qlc where: (in x (- (/ y 5) 2)) asc: x}) -- (select {x: x from: Ulc where: (in x (- (/ y 5) 2)) asc: x})
(at (select {x: x from: Qlc where: (in x (- (/ y 5) 2)) asc: x}) 'x) -- [1 2 4 5 6]
(at (select {x: x from: Qlc where: (in x (- (/ y 5) 4)) asc: x}) 'x) -- [2 3 4]
(at (select {x: x from: Qlc where: (in x (- (/ y 5) 4)) desc: x take: 2}) 'x) -- [4 3]
(at (select {x: x from: Qlc where: (not-in x (- (/ y 5) 4)) desc: x take: 2}) 'x) -- [6 5]
(select {x: x from: Qlc where: (not-in x (- (/ y 5) 2)) asc: x}) -- (select {x: x from: Ulc where: (not-in x (- (/ y 5) 2)) asc: x})
(select {x: x from: Qlc where: (> (bin y y) 2) asc: x take: 2}) -- (select {x: x from: Ulc where: (> (bin y y) 2) asc: x take: 2})
(select {x: x from: Qlc where: (in x (concat (- (/ y 5) 2) [9])) asc: x}) -- (select {x: x from: Ulc where: (in x (concat (- (/ y 5) 2) [9])) asc: x})
(select {x: x from: Qlc where: (> (* 5 y) (inner-prod x x)) asc: x}) -- (select {x: x from: Ulc where: (> (* 5 y) (inner-prod x x)) asc: x})
(select {x: x from: Qlc where: (> (* 0.01 y) (cos-dist x y)) asc: x}) -- (select {x: x from: Ulc where: (> (* 0.01 y) (cos-dist x y)) asc: x})
(select {x: x from: Qlc where: (> (* 3 y) (l2-dist x (* 0 x))) asc: x}) -- (select {x: x from: Ulc where: (> (* 3 y) (l2-dist x (* 0 x))) asc: x})
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
;; a lookup into a value by a column and a membership in a subquery's
;; result (its table as long as a partition) are no forms the DAG
;; compiles: they are answered on the whole table
(set Dlc (dict [1 2 3 4 5 6] [0 0 1 1 0 1]))
(set Ulc3 (table [x z] (list [1 5 9] [0 0 0])))
(set cxlc (fn [t] (at t 'x)))
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(at (select {x: x from: Qlc where: (== (at Dlc x) 1) desc: x take: 2}) 'x) -- [6 4]
(at ((fn [t d] (select {x: x from: t where: (== (at d x) 1) desc: x take: 2})) Qlc Dlc) 'x) -- [6 4]
(at (select {x: x from: Qlc where: (in x (cxlc (select {x: x from: Ulc3 where: (> x 2)}))) desc: x take: 2}) 'x) -- [5]
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
;; a helper the DAG inlines streams when its body is row-wise in its
;; parameters, bound or written inline; one that reads an aggregate,
;; directly or through another helper, a draw through a helper, eval, and
;; a computed callee are answered on the whole table
(set f2lc (fn [v] (* 2 v)))
(set galc (fn [] (avg x)))
(set halc (fn [] (galc)))
(set rlc (fn [] (rand 6 100)))
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(at (select {x: x from: Qlc where: (> (f2lc x) 5) desc: x take: 2}) 'x) -- [6 5]
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 2
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(select {x: x from: Qlc where: (> (f2lc x) 5) asc: x}) -- (select {x: x from: Ulc where: (> (f2lc x) 5) asc: x})
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 2
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(at (select {x: x from: Qlc where: (> ((fn [v] (* 2 v)) x) 5) desc: x take: 2}) 'x) -- [6 5]
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 2
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(at (select {x: x from: Qlc where: (> x (halc)) asc: x take: 2}) 'x) -- [4 5]
(at (select {x: x from: Qlc where: (> x (galc)) asc: x}) 'x) -- [4 5 6]
(at (select {x: x from: Qlc where: (> x ((fn [] (avg x)))) asc: x take: 2}) 'x) -- [4 5]
(count (select {x: x from: Qlc where: (>= (rlc) 0) desc: x take: 2})) -- 2
(at (select {x: x from: Qlc where: (eval (list > 'x 4)) desc: x take: 2}) 'x) -- [6 5]
(at (select {x: x from: Qlc where: (> ((if (> 1 0) f2lc neg) x) 5) desc: x take: 2}) 'x) -- [6 5]
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
;; an output a helper computes takes the general path (the routes gather
;; bare columns)
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(select {x: x d: (f2lc x) from: Qlc desc: x take: 2}) -- (select {x: x d: (f2lc x) from: Ulc desc: x take: 2})
(select {x: x d: ((fn [v] (* 2 v)) x) from: Qlc asc: x}) -- (select {x: x d: ((fn [v] (* 2 v)) x) from: Ulc asc: x})
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
;; a mask as long as one partition read through a dict path, an at chain or
;; a table column is no mask of the table: parted raises length as flat does
(set Cdm {m: [true false true] a: {b: {d: {e: [true false true]}}}})
(set Cdw {a: {b: {d: {e: [true false true false true true]}}}})
(set lcdm (fn [t c] (select {x: x from: t where: c.m asc: x})))
(set lcde (fn [t c] (select {x: x from: t where: c.a.b.d.e asc: x})))
(set lcda (fn [t c] (select {x: x from: t where: (at (at (at (at c 'a) 'b) 'd) 'e) asc: x})))
(set lctm (fn [t u] (select {x: x from: t where: u.m asc: x})))
(lcdm Qlc Cdm) !- length
(lcdm Ulc Cdm) !- length
(lcde Qlc Cdm) !- length
(lcde Ulc Cdm) !- length
(lcda Qlc Cdm) !- length
(lctm Qlc (table [m] (list [true false true]))) !- length
(lctm Ulc (table [m] (list [true false true]))) !- length
(lcde Qlc Cdw) -- (lcde Ulc Cdw)
(at (lcde Qlc Cdw) 'x) -- [1 3 5 6]
;; the null test, if and within between row-wise bounds stream; sym-name
;; and a cast to STR are no forms the DAG compiles, so str-find, like and
;; a text concat over them are answered on the whole table
(.db.splayed.set "/tmp/rfl_cklocal/w/2024.01.01/t/" (table [x y s] (list [1 2 3] [10.0 0Nf 20.0] ['a 'b 'c])))
(.db.splayed.set "/tmp/rfl_cklocal/w/2024.01.02/t/" (table [x y s] (list [4 5 6] [30.0 35.0 0Nf] ['a 'x 'b])))
(set Pwr (.db.parted.get "/tmp/rfl_cklocal/w/" 't))
(set Fwr (select {from: Pwr where: (> x 0)}))
(set lcw1 (fn [t] (select {x: x from: t where: (not (nil? y)) desc: x take: 2})))
(set lcw2 (fn [t] (select {x: x from: t where: (if (> x 3) (nil? y) (> y 5)) desc: x take: 2})))
(set lcw3 (fn [t] (select {x: x from: t where: (>= (str-find (as 'STR s) "a") 0) desc: x take: 2})))
(set lcw4 (fn [t] (select {x: x from: t where: (like (sym-name s) "a*") desc: x take: 2})))
(set lcw5 (fn [t] (select {x: x from: t where: (like (concat (as 'STR s) "z") "az") desc: x take: 2})))
(set lcw6 (fn [t] (select {x: x from: t where: (within y (list x 100)) desc: x take: 2})))
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(at (lcw1 Pwr) 'x) -- [5 4]
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 2
(lcw1 Pwr) -- (lcw1 Fwr)
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(lcw2 Pwr) -- (lcw2 Fwr)
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 2
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(lcw3 Pwr) -- (lcw3 Fwr)
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(lcw4 Pwr) -- (lcw4 Fwr)
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(lcw5 Pwr) -- (lcw5 Fwr)
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
(at (lcw5 Pwr) 'x) -- [4 1]
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(lcw6 Pwr) -- (lcw6 Fwr)
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 2
(at (lcw6 Pwr) 'x) -- [5 4]
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(at (select {x: x from: Pwr where: (like s "a*") desc: x take: 2}) 'x) -- [4 1]
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 2
;; the clock verbs read the clock, not a row: answered on the whole table
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(at (select {x: x from: Pwr where: (< 0 (as 'I64 (timestamp 'local))) desc: x take: 2}) 'x) -- [6 5]
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
;; a concat of collections is not row-wise (it changes the length)
(set Brw (at (.sys.mem) 'sort-perpart-runs))
(select {x: x from: Pwr where: (in x (concat (as 'I64 y) [4])) desc: x take: 2}) -- (select {x: x from: Fwr where: (in x (concat (as 'I64 y) [4])) desc: x take: 2})
(- (at (.sys.mem) 'sort-perpart-runs) Brw) -- 0
;; a draw is one draw over the table, not one per partition
(set Bsd (at (.sys.mem) 'sort-perpart-runs))
(count (select {x: x from: Qlc where: (>= (rand 6 100) 0) desc: x take: 2})) -- 2
(- (at (.sys.mem) 'sort-perpart-runs) Bsd) -- 0
;; count and count(distinct) of a bound vector (a lambda parameter, a let,
;; a global) count the collection, whole, in every group, whatever its name
;; (functions.md: counting a constant collection returns its length): a
;; parameter named like a column is no column, on every count-distinct
;; route (the composite rewrite, the per-group kernel, the high-cardinality
;; global hash, the eval-level grouping), flat, splayed and parted, with and
;; without take:.  The routes read the column of the name.  A key a local
;; holds groups by the local's values.
(.db.splayed.set "/tmp/rfl_cklocal/c/2024.01.01/t/" (table [k y] (list [1 1 2] [10 10 20])))
(.db.splayed.set "/tmp/rfl_cklocal/c/2024.01.02/t/" (table [k y] (list [2 3 3] [30 40 50])))
(.db.splayed.set "/tmp/rfl_cklocal/d/t/" (table [k y] (list [1 1 2 2 3 3] [10 10 20 30 40 50])))
(set Pcd (.db.parted.get "/tmp/rfl_cklocal/c/" 't))
(set Scd (.db.splayed.get "/tmp/rfl_cklocal/d/t/"))
(set Tcd (table [k y] (list [1 1 2 2 3 3] [10 10 20 30 40 50])))
(set Vcd [1 2 3 3 4 4])
(set cdl (fn [tbl y] (at (select {c: (count (distinct y)) by: k from: tbl}) 'c)))
(set cdle (fn [tbl y] (at (select {c: (count (distinct (+ y 0))) by: k from: tbl}) 'c)))
(set cdz (fn [tbl z] (at (select {c: (count (distinct z)) by: k from: tbl}) 'c)))
(cdl Tcd Vcd) -- [4 4 4]
(cdl Tcd Vcd) -- (cdz Tcd Vcd)
(cdl Tcd Vcd) -- (cdle Tcd Vcd)
(cdl Scd Vcd) -- [4 4 4]
(cdl Pcd Vcd) -- [4 4 4]
(cdz Pcd Vcd) -- [4 4 4]
;; a helper that reads a column, itself or through another helper, reads
;; the rows: its operand is counted per group, as sum sees it
(set gycd (fn [] y))
(set hycd (fn [z] (+ y z)))
(set iycd (fn [] (gycd)))
(at (select {c: (count (distinct (gycd))) by: k from: Tcd}) 'c) -- [1 2 2]
(at (select {c: (count (distinct (gycd))) by: k from: Scd}) 'c) -- [1 2 2]
(at (select {c: (count (distinct (gycd))) by: k from: Pcd}) 'c) -- [1 2 2]
(at (select {c: (count (distinct (hycd 0))) by: k from: Tcd}) 'c) -- [1 2 2]
(at (select {c: (count (distinct (hycd 0))) by: k from: Scd}) 'c) -- [1 2 2]
(at (select {c: (count (distinct (hycd 0))) by: k from: Pcd}) 'c) -- [1 2 2]
(at (select {c: (count (distinct (iycd))) by: k from: Tcd}) 'c) -- [1 2 2]
(at (select {c: (count (distinct (iycd))) by: k from: Pcd}) 'c) -- [1 2 2]
(at (select {c: (sum (gycd)) by: k from: Tcd}) 'c) -- [20 50 90]
((fn [tbl y] (at (select {c: (count y) by: k from: tbl}) 'c)) Tcd Vcd) -- ((fn [tbl z] (at (select {c: (count z) by: k from: tbl}) 'c)) Tcd Vcd)
(set cdlt (fn [tbl y] (select {c: (count (distinct y)) by: k from: tbl desc: c take: 1})))
(set cdltn (fn [tbl y] (select {c: (count (distinct y)) by: k from: tbl desc: c})))
(value (cdlt Tcd Vcd)) -- (list [1] [4])
(cdlt Tcd Vcd) -- (select {from: (cdltn Tcd Vcd) take: 1})
(cdlt Scd Vcd) -- (select {from: (cdltn Scd Vcd) take: 1})
(cdlt Pcd Vcd) -- (select {from: (cdltn Pcd Vcd) take: 1})
(set cdlw (fn [tbl y] (at (select {c: (count (distinct y)) by: k from: tbl where: (> k 1)}) 'c)))
(cdlw Tcd Vcd) -- [4 4]
(cdlw Pcd Vcd) -- [4 4]
(cdlw Tcd Vcd) -- ((fn [tbl z] (at (select {c: (count (distinct z)) by: k from: tbl where: (> k 1)}) 'c)) Tcd Vcd)
;; NOTE: sum and first of a bound vector of the table's length stay row-wise
;; on the DAG grouping (s below is per group), unlike count: that
;; inconsistency is kept as it is
(value ((fn [tbl y] (select {c: (count (distinct y)) s: (sum y) by: k from: tbl})) Tcd Vcd)) -- (list [1 2 3] [4 4 4] [3 6 8])
;; a scalar local is no list, as outside a query
(cdl Tcd 7) !- type
(cdl Pcd 7) !- type
;; over 50000 groups (the global hash): the column y has 2 values per group,
;; the parameter 3 values in all
(set Nhc 120000)
(set Thc (table [k y] (list (% (til Nhc) 60000) (til Nhc))))
(distinct (cdl Thc (% (til Nhc) 3))) -- [3]
(count (cdl Thc (% (til Nhc) 3))) -- 60000
;; dense keys take the composite (K, X) rewrite
(set Tdn (table [k y] (list (% (til 1200) 3) (% (til 1200) 4))))
(cdl Tdn (% (til 1200) 6)) -- [6 6 6]
(cdl Tdn (% (til 1200) 6)) -- (cdz Tdn (% (til 1200) 6))
(value (cdlt Tdn (% (til 1200) 6))) -- (list [0] [6])
;; a key a local holds, or a global vector, groups by its values
(set Kcd [1 1 1 2 2 2])
(set cdk (fn [tbl k] (at (select {c: (count (distinct y)) by: k from: tbl}) 'c)))
(cdk Tcd Kcd) -- [2 3]
(cdk Scd Kcd) -- [2 3]
(cdk Pcd Kcd) -- [2 3]
(at (select {c: (count (distinct y)) by: Kcd from: Tcd}) 'c) -- [2 3]
;; the key keeps its name on the aggregate grouping too (its constant carried
;; no name there)
(set cdks (fn [tbl k] (select {s: (sum y) by: k from: tbl})))
(key (cdks Tcd Kcd)) -- [k s]
(key (cdks Scd Kcd)) -- [k s]
(key (cdks Pcd Kcd)) -- [k s]
(value (cdks Pcd Kcd)) -- (list [1 2] [40 120])
(key (select {s: (sum y) by: Kcd from: Tcd})) -- [Kcd s]
(key (select {s: (sum y) by: Kcd from: Tcd where: (> y 15)})) -- [Kcd s]
(key ((fn [tbl k] (select {s: (sum y) by: k from: tbl where: (> y 15)})) Pcd Kcd)) -- [k s]
(set cdkt (fn [tbl k] (select {c: (count (distinct y)) by: k from: tbl desc: c take: 1})))
(value (cdkt Tcd Kcd)) -- (list [2] [3])
(value (cdkt Pcd Kcd)) -- (list [2] [3])
(value ((fn [tbl k] (select {c: (count (distinct y)) n: (count y) by: k from: tbl})) Tcd Kcd)) -- (list [1 2] [2 3] [3 3])
(cdk Tdn (% (til 1200) 2)) -- [2 2]
(value (cdkt Tdn (% (til 1200) 2))) -- (list [0] [2])
;; under a where: the key meets the rows it keeps, as the aggregate form's
(set cdkw (fn [tbl k] (select {c: (count (distinct y)) by: k from: tbl where: (> y 15)})))
(value (cdkw Tcd Kcd)) -- (list [1 2] [1 3])
(value (cdkw Pcd Kcd)) -- (list [1 2] [1 3])
(value (cdkw Tcd Kcd)) -- (value ((fn [tbl k] (select {c: (count y) by: k from: tbl where: (> y 15)})) Tcd Kcd))
;; a bound vector of another length than the table is a collection too; an
;; operand over a column of another length (a take of it) has no value for
;; some rows: the per-group kernel read past it
(set Tln (table [k y] (list (% (til 1000) 10) (til 1000))))
(cdl Tln (list "a" "b")) -- (cdz Tln (list "a" "b"))
(distinct (cdl Tln (list "a" "b"))) -- [2]
(distinct (cdl Tln [1 2])) -- [2]
(distinct (cdl Thc [1 2])) -- [2]
(select {c: (count (distinct (take y 2))) by: k from: Tln}) !- length
;; a named key must have one value per row of the table, under a where: too
;; (a key as long as the rows the where: keeps is no key of the table)
((fn [t k] (select {c: (count (distinct y)) by: k from: t where: (> y 15)})) Tcd [7 7 8 8]) !- length
((fn [t k] (select {c: (count y) by: k from: t where: (> y 15)})) Tcd [7 7 8 8]) !- length
;; the key meets the rows of the one run of where: (a predicate with an
;; effect runs once and the key follows what it kept), flat and parted
(set Ctg 0)
(set tgp (fn [v] (set Ctg (+ Ctg 1)) (if (== 1 (% Ctg 2)) (> v 15) (> v 35))))
(value ((fn [t k] (select {c: (count (distinct y)) by: k from: t where: (tgp y)})) Tcd Kcd)) -- (list [1 2] [1 3])
Ctg -- 1
(set Ctg 0)
(value ((fn [t k] (select {c: (count (distinct y)) by: k from: t where: (tgp y)})) Pcd Kcd)) -- (list [1 2] [1 3])
Ctg -- 1
(value ((fn [t k] (select {c: (count y) by: k from: t where: (> y 15)})) Pcd Kcd)) -- (list [1 2] [1 3])
(value ((fn [t k] (select {c: (count (distinct y)) d: (reverse y) by: k from: t where: (> y 15)})) Pcd Kcd)) -- (list [1 2] [1 3] (list [20] [50 40 30]))
;; with no outputs the select returns every input column, the partition
;; column too, and no hidden key: a where: on the name the key's local hides
;; leaves the parted table whole, as on its flat copy
(set nok (fn [t k] (select {from: t by: k where: (> k 1)})))
(set Fcd (select {from: Pcd where: (> y 0)}))
(key (nok Pcd [9 2 2 3 3 3])) -- [k date y]
(nok Pcd [9 2 2 3 3 3]) -- (nok Fcd [9 2 2 3 3 3])
(key (nok Pcd [9 2 2 3 3 3])) -- (key (nok Fcd [9 2 2 3 3 3]))
(key (nok Pcd [5 5 7 7 9 9])) -- (key (nok Fcd [5 5 7 7 9 9]))
(nok Pcd [5 5 7 7 9 9]) -- (nok Fcd [5 5 7 7 9 9])
(nok Scd [9 2 2 3 3 3]) -- (nok Tcd [9 2 2 3 3 3])
(nok Scd [5 5 7 7 9 9]) -- (nok Tcd [5 5 7 7 9 9])
(value (nok Scd [5 5 7 7 9 9])) -- (list [5 7 9] [10 20 40])
;; the carried key costs only the columns the clauses read: an aggregate
;; route leaves the parted table as it is (the grouping reads the name), and
;; the eval-level route copies the columns its clauses name, not the other
;; eight (a whole copy peaked at 13 MB here; the aggregate route stays
;; under 0.7 MB, 1.25 MB with a carried key; a where: on the key's hidden
;; name carries it at 1.35 MB, 5.8 MB as a whole copy)
(.db.splayed.set "/tmp/rfl_cklocal/m/2024.01.01/t/" (table [k y a b c d e f g h] (list (% (til 20000) 7) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000))))
(.db.splayed.set "/tmp/rfl_cklocal/m/2024.01.02/t/" (table [k y a b c d e f g h] (list (% (til 20000) 7) (+ 20000 (til 20000)) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000) (til 20000))))
(set Pmk (.db.parted.get "/tmp/rfl_cklocal/m/" 't))
(set Fmk (select {from: Pmk where: (> y -1)}))
(set Kmk (% (til 40000) 5))
(set fmk (fn [t k] (select {s: (sum y) by: k from: t where: (> y 15)})))
(set gmk (fn [t k] (select {s: (count (distinct y)) by: k from: t where: (> y 15)})))
(< (at (.mem.ts (fmk Pmk Kmk)) 'peak-live-bytes) 1000000) -- true
(< (at (.mem.ts (gmk Pmk Kmk)) 'peak-live-bytes) 8000000) -- true
(fmk Pmk Kmk) -- (fmk Fmk Kmk)
(set hmk (fn [t k] (select {s: (sum y) by: k from: t where: (> k 1)})))
(hmk Pmk Kmk) -- (hmk Fmk Kmk)
(< (at (.mem.ts (hmk Pmk Kmk)) 'peak-live-bytes) 3000000) -- true
(gmk Pmk Kmk) -- (gmk Fmk Kmk)
;; a where: on the name the key's local hides reads the local, on the
;; parted table as on the flat one (the carried key beside the parted
;; columns kept every row of such a comparison)
(set Kcr [3 3 1 1 2 2])
(set cdkr (fn [t k] (value (select {c: (count (distinct y)) by: k from: t where: (> k 1)}))))
(cdkr Tcd Kcr) -- (list [3 2] [1 2])
(cdkr Pcd Kcr) -- (cdkr Tcd Kcr)
(cdkr Scd Kcr) -- (cdkr Tcd Kcr)
((fn [t k] (value (select {c: (count (distinct y)) by: k from: t where: (< k 3)}))) Pcd Kcr) -- (list [1 2] [2 2])
((fn [t k] (value (select {c: (count (distinct y)) by: k from: t where: (== k 1)}))) Pcd Kcr) -- (list [1] [2])
;; the aggregate grouping by a local named like a column, under a where:
;; on that name, reads the local on a parted table too (it raised length)
((fn [t k] (value (select {c: (sum y) by: k from: t where: (> k 1)}))) Pcd Kcr) -- (list [2 3] [90 20])
((fn [t k] (value (select {c: (sum y) by: k from: t where: (> k 1)}))) Pcd Kcr) -- ((fn [t k] (value (select {c: (sum y) by: k from: t where: (> k 1)}))) Tcd Kcr)
;; the key's own name in an aggregate reads the local as any other name of
;; that value does on the same grouping
((fn [t k] (value (select {c: (count (distinct y)) m: (max k) n: (count k) by: k from: t}))) Tcd Kcr) -- ((fn [t k z] (value (select {c: (count (distinct y)) m: (max z) n: (count z) by: k from: t}))) Tcd Kcr Kcr)
((fn [t k] (value (select {c: (count (distinct y)) m: (max k) by: k from: t where: (> y 15)}))) Tcd Kcr) -- ((fn [t k z] (value (select {c: (count (distinct y)) m: (max z) by: k from: t where: (> y 15)}))) Tcd Kcr Kcr)
;; xfail BUG: aggregates of a bound vector depend on the grouping route: on
;; the DAG grouping (an integer key, aggregate outputs only) sum/max/first
;; are row-wise per group, on the eval-level grouping (a STR key, a key a
;; local holds, a row expression beside) they take the whole vector:
;; (max z) [4 4 4] and (sum z) [17 17 17] beside (reverse y), where the DAG
;; route gives [2 3 4] and [3 6 8]
;; ((fn [t z] (at (select {m: (max z) r: (reverse y) by: k from: t}) 'm)) Tcd Vcd) -- [2 3 4]
;; xfail BUG: on the eval-level grouping (a STR key, a key a local or a global
;; vector holds) an output calling a lambda literal that reduces its argument
;; runs once over the whole table and spreads that one value: [5 error error]
;; with a STR key, [5 error] with a local key (it raised domain before), where
;; the DAG path gives the per-group counts [1 2 2] for an integer key
;; (at (select {c: ((fn [v] (count (distinct v))) y) by: k from: (table [k y] (list (list "a" "a" "b" "b" "c" "c") [10 10 20 30 40 50]))}) 'c) -- [1 2 2]
;; ((fn [t k] (at (select {c: ((fn [v] (count (distinct v))) y) by: k from: t}) 'c)) Tcd Kcd) -- [2 3]
;; xfail BUG: a grouped row expression over a local vector under a where:
;; raises length (operand lengths 4 and 6); ungrouped it meets the rows the
;; where: keeps, as the grouped form should: [[23 34] [45 56]]
;; ((fn [t z] (at (select {d: (+ y z) by: k from: t where: (> y 15)}) 'd)) Tcd [1 2 3 4 5 6]) -- (list [23 34] [45 56])
(.sys.exec "rm -rf /tmp/rfl_cklocal")

;; ────────────────────────────────────────────────────────────────────
;; (take (select ...) n) and (first (select ...)) of a select of whole rows
;; run the select with take: n: the same rows as the full select's first n,
;; ties in source order; a select of fewer rows repeats as take does
;; ────────────────────────────────────────────────────────────────────
(set TH (table [r a s] (list (% (* (til 3000) 7919) 5) (til 3000) (take ['b 'a 'c 'a] 3000))))
(set THN (update {r: (if (== (% a 7) 0) 0Nl r) from: TH}))
(set thk 4)
(at (take (select {from: TH asc: r}) 4) 'a) -- [0 5 10 15]
(at (take (select {from: TH desc: s asc: a}) thk) 'a) -- [2 6 10 14]
;; the reference: the same select bound whole, then taken
(set thf (select {from: THN desc: r}))
(take (select {from: THN desc: r}) 5) -- (take thf 5)
(first (select {from: THN asc: r})) -- (first (select {from: THN asc: r take: 3000}))
(set thw (select {from: TH where: (> a 2990) asc: r}))
(count thw) -- 9
(take (select {from: TH where: (> a 2990) asc: r}) 9) -- (take thw 9)
(take (select {from: TH where: (> a 2990) asc: r}) 25) -- (take thw 25)
(set thd (select {from: TH where: (> a 100) desc: s}))
(take (select {from: TH where: (> a 100) desc: s}) 2000) -- (take thd 2000)
(first (select {from: TH where: (> a 100) desc: s})) -- (first thd)
(take (select {from: TH where: (> a 10)}) 3) -- (take (select {from: TH where: (> a 10) take: 3}) 3)
(at (first (select {from: TH})) 'a) -- 0
(first (select {from: TH where: (> a 5000) asc: r})) !- domain
(set the0 (select {from: TH where: (> a 5000) asc: r}))
(take (select {from: TH where: (> a 5000) asc: r}) 3) -- (take the0 3)
;; other counts and shapes take the whole select's result as before
(count (take (select {from: TH asc: r}) 0)) -- 0
(at (take (select {from: TH asc: r}) -2) 'a) -- (at (take (select {from: TH asc: r}) -2) 'a)
(take (select {from: TH asc: r}) 2.0) !- type
(at (take (select {x: a from: TH asc: r}) 3) 'x) -- [0 5 10]
(at (take (select {from: TH asc: r take: 10}) 3) 'a) -- [0 5 10]
(take (select {from: TH where: (> zz 1) asc: r}) 3) !- schema
(take (select {from: TH asc: r}) th_no_such_name) !- name
