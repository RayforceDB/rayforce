;; @requires: posix  (a second interpreter is run through a POSIX shell via .sys.exec)
;; helper_bytecode_provenance.rfl, the part that needs a fresh process.
;; a swallowed whole-column failure leaves no trace or message behind: a
;; later uncaught error in a fresh interpreter is reported at its own place
(write "/tmp/rfl_trace_clear.rfl" "(set TB (table [v] (list [1 2 3 10 20 30]))) (set kneg (fn [v] 1 (if (< v 0) (raise 'negative) (% v 7)))) (select {n: (count v) by: (kneg v) from: TB}) (+ 1 'a)")
(.sys.exec "./rayforce /tmp/rfl_trace_clear.rfl 2>&1 | grep -c negative | grep -qx 0") -- 0
