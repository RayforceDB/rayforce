;; @also-unfused
;; #1571: on the keyless evaluator fallback (an output beside one the
;; planner declines), a scalar an aggregate's source gives stands for every
;; row, as 1 does in (sum 1) and as on the planned route: (sum (count v))
;; over 4 rows is 16, under a where: keeping 3 rows 9.  The fallback folded
;; it once (4, 3).  A non-inlined helper's scalar is folded once on every
;; route, as pinned by #1401; whether it should spread is #1576.  Each line
;; is the fallback against the planned route, over 13 aggregates of 9
;; sources, with no where:, one keeping 3 rows and one keeping none; prod
;; over no row differs between the routes for any source (#1577) and is
;; left out.
(set T (table [k c d s v] (list [0 0 0 0] [1 5 6 2] [2024.01.01 2024.01.02 0Nd 2024.01.04] [aa bb cc aa] [10 20 30 40])))
(set hq (fn [y] (let q (count y)) q))
;; bind-first: the count bound to a name first
(set C 4)
(at (select {from: T s: (sum (count v)) z: (first (+ d 0))}) 's) -- (at (select {from: T s: (sum C)}) 's)
(at (select {from: T s: (sum (count v)) z: (first (+ d 0))}) 's) -- [16]
(at (select {from: T s: (sum (count v)) z: (first (+ d 0)) where: (> v 15)}) 's) -- [9]
;; the helper's scalar, folded on every route, as before
(at (select {from: T s: (sum (hq v)) z: (first (+ d 0))}) 's) -- [4]
(at (select {from: T s: (sum (hq v))}) 's) -- [4]
(at (select {from: T s: (sum (count v)) z: (first (+ d 0))}) 's) -- (at (select {from: T s: (sum (count v))}) 's)
(at (select {from: T s: (sum (count v)) z: (first (+ d 0)) where: (> v 15)}) 's) -- (at (select {from: T s: (sum (count v)) where: (> v 15)}) 's)
(at (select {from: T s: (sum (count v)) z: (first (+ d 0)) where: (> v 100)}) 's) -- (at (select {from: T s: (sum (count v)) where: (> v 100)}) 's)
(at (select {from: T s: (sum (+ 1 (count v))) z: (first (+ d 0))}) 's) -- (at (select {from: T s: (sum (+ 1 (count v)))}) 's)
(at (select {from: T s: (sum (+ 1 (count v))) z: (first (+ d 0)) where: (> v 15)}) 's) -- (at (select {from: T s: (sum (+ 1 (count v))) where: (> v 15)}) 's)
(at (select {from: T s: (sum (+ 1 (count v))) z: (first (+ d 0)) where: (> v 100)}) 's) -- (at (select {from: T s: (sum (+ 1 (count v))) where: (> v 100)}) 's)
(at (select {from: T s: (sum (max v)) z: (first (+ d 0))}) 's) -- (at (select {from: T s: (sum (max v))}) 's)
(at (select {from: T s: (sum (max v)) z: (first (+ d 0)) where: (> v 15)}) 's) -- (at (select {from: T s: (sum (max v)) where: (> v 15)}) 's)
