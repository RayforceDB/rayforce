(at (select {from: T s: (sum (sum c)) z: (first (+ d 0)) where: (> v 15)}) 's) -- (at (select {from: T s: (sum (sum c)) where: (> v 15)}) 's)
(at (select {from: T s: (sum (sum c)) z: (first (+ d 0)) where: (> v 100)}) 's) -- (at (select {from: T s: (sum (sum c)) where: (> v 100)}) 's)
