;; A group key projected under another name is an ordinary output (#1272).
(set S (table [a h] (list [1 1 2 3 3 3] [10 20 30 40 50 60])))
(cols (select {from: S x: a by: a})) -- [a x]
(cols (select {from: S u: (count h) x: a by: a})) -- [a u x]
(repr (at (select {from: S x: a by: a}) 'x)) -- (repr (at (select {from: S x: (+ a 0) by: a}) 'x))
(repr (at (select {from: S u: (count h) x: a by: a}) 'x)) -- (repr (at (select {from: S u: (count h) x: (+ a 0) by: a}) 'x))
(cols (select {from: S u: (count h) a: a by: a})) -- [a u]
