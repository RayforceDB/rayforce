(do (set M U) (update {l: (at l i) from: 'M }) (at M 'l)) -- (list [3] [1 2] [7] [3] [1 2])
(at (update {l: (at l i) from: U where: (> v 0)}) 'l) -- (list [3] [1 2] [7] [3] [1 2])
(do (set M U) (update {l: (at l i) from: 'M where: (> v 0)}) (at M 'l)) -- (list [3] [1 2] [7] [3] [1 2])
(at (update {l: (at l i) from: U where: (> v 2)}) 'l) -- (list [1 2] [3] [7] [3] [1 2])
(do (set M U) (update {l: (at l i) from: 'M where: (> v 2)}) (at M 'l)) -- (list [1 2] [3] [7] [3] [1 2])
(at (update {l: (at l i) from: U where: (> v 9)}) 'l) -- (list [1 2] [3] [7] [8 9 10] [4])
(do (set M U) (update {l: (at l i) from: 'M where: (> v 9)}) (at M 'l)) -- (list [1 2] [3] [7] [8 9 10] [4])
