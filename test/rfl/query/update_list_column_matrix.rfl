(at (update {w: (at l i) from: U }) 'w) -- (list [3] [1 2] [7] [3] [1 2])
(at (update {w: (at l i) from: U where: (> v 0)}) 'w) !- type
(at (update {w: (at l i) from: U where: (> v 2)}) 'w) !- type
(at (update {w: (at l i) from: U where: (> v 9)}) 'w) !- type
(at (update {l: (count l) from: U by: g}) 'l) -- [3 3 3 2 2]
(do (set M U) (update {l: (count l) from: 'M by: g}) (at M 'l)) -- [3 3 3 2 2]
(at (update {l: (count l) from: U }) 'l) -- [5 5 5 5 5]
(do (set M U) (update {l: (count l) from: 'M }) (at M 'l)) -- [5 5 5 5 5]
(at (update {l: (count l) from: U where: (> v 0)}) 'l) -- [5 5 5 5 5]
(do (set M U) (update {l: (count l) from: 'M where: (> v 0)}) (at M 'l)) -- [5 5 5 5 5]
(at (update {l: (count l) from: U where: (> v 2)}) 'l) -- (list [1 2] [3] 3 3 3)
(do (set M U) (update {l: (count l) from: 'M where: (> v 2)}) (at M 'l)) -- (list [1 2] [3] 3 3 3)
(at (update {l: (count l) from: U where: (> v 9)}) 'l) -- (list [1 2] [3] [7] [8 9 10] [4])
(do (set M U) (update {l: (count l) from: 'M where: (> v 9)}) (at M 'l)) -- (list [1 2] [3] [7] [8 9 10] [4])
(at (update {w: (count l) from: U by: g}) 'w) -- [3 3 3 2 2]
(at (update {w: (count l) from: U }) 'w) -- [5 5 5 5 5]
(at (update {w: (count l) from: U where: (> v 0)}) 'w) -- [5 5 5 5 5]
