;; @also-unfused
;; An unordered take: keyed on a BOOL column keeps the first N groups in
;; first-seen order, as every other key type does (issue #1247).  The take
;; was kept out of the group for a BOOL column key and the groups were put
;; back into first-occurrence order afterwards from the table's first row,
;; which a where: may drop; a composite key holding a BOOL was not reordered
;; at all.  Under a where: the first groups are those of the kept rows, and
;; so is the order of a select with no take: or a negative one.

(set K0 (fn [q] (at q (at (key q) 0))))
(set K01 (fn [q] (list (at q (at (key q) 0)) (at q (at (key q) 1)))))

;; kb at rows 0..7: false true false false true false false true
;; kl at rows 0..7: 0 1 0 1 0 1 0 1

;; ── a small table: the serial routes ───────────────────────────────────────
(set i (til 100))
(set S (table [kl kb x] (list (% i 2) (== (% (* i 7) 3) 1) i)))
(K0 (select {u: (count x) from: S by: kb take: 5}))                       -- [false true]
(K0 (select {u: (count x) from: S where: (> x 0) by: kb take: 5}))        -- [true false]
(K0 (select {u: (count x) from: S where: (> x 0) by: kb take: 1}))        -- [true]
(K0 (select {u: (count x) from: S where: (> x 2) by: kb take: 5}))        -- [false true]
(at (select {u: (count x) from: S where: (> x 0) by: kb take: 5}) 'u)    -- [33 66]
(K01 (select {u: (count x) from: S by: [kl kb] take: 5}))                 -- (list [0 1 1 0] [false true false true])
(K01 (select {u: (count x) from: S where: (> x 0) by: [kl kb] take: 5}))  -- (list [1 0 1 0] [true false false true])
(K01 (select {u: (count x) from: S where: (> x 0) by: [kb kl] take: 2}))  -- (list [true false] [1 0])

;; ── 200000 rows: the parallel routes ─────────────────────────────────────────
(set i (til 200000))
(set T (table [kl kb x] (list (% i 2) (== (% (* i 7) 3) 1) i)))
(K0 (select {u: (count x) from: T by: kb take: 5}))                       -- [false true]
(K0 (select {u: (count x) from: T where: (> x 0) by: kb take: 5}))        -- [true false]
(K0 (select {u: (count x) from: T where: (> x 0) by: kb take: 1}))        -- [true]
(K0 (select {u: (count x) from: T where: (> x 2) by: kb take: 5}))        -- [false true]
(at (select {u: (count x) from: T where: (> x 0) by: kb take: 5}) 'u)    -- [66667 133332]
(K01 (select {u: (count x) from: T by: [kl kb] take: 5}))                 -- (list [0 1 1 0] [false true false true])
(K01 (select {u: (count x) from: T where: (> x 0) by: [kl kb] take: 5}))  -- (list [1 0 1 0] [true false false true])
(K01 (select {u: (count x) from: T where: (> x 0) by: [kb kl] take: 2}))  -- (list [true false] [1 0])
;; the same answers as grouping the materialized where:
(K0 (select {u: (count x) from: T where: (> x 0) by: kb take: 5}))        -- (K0 (select {u: (count x) from: (select {from: T where: (> x 0)}) by: kb take: 5}))
(K01 (select {u: (count x) from: T where: (> x 0) by: [kl kb] take: 3}))  -- (K01 (select {u: (count x) from: (select {from: T where: (> x 0)}) by: [kl kb] take: 3}))
;; a range take from the front keeps the same groups
(K0 (select {u: (count x) from: T where: (> x 0) by: kb take: [0 2]}))    -- [true false]

;; ── no take:, or a negative one: first-occurrence among the kept rows ────────
(set N (table [kb kl x] (list [true false true] [5 6 5] [1 2 3])))
(K0 (select {u: (count x) from: N where: (> x 1) by: kb}))               -- [false true]
(K0 (select {u: (count x) from: N where: (> x 1) by: kb take: -1}))      -- [true]
(K0 (select {u: (count x) from: N by: kb}))                              -- [true false]
(K0 (select {u: (count x) from: N where: (> x 5) by: kb}))               -- []
(K0 (select {u: (count x) from: T where: (> x 0) by: kb}))               -- [true false]
(K0 (select {u: (count x) from: T where: (> x 0) by: kb take: -1}))      -- [false]
(at (select {u: (count x) from: T where: (> x 0) by: kb take: -1}) 'u)   -- [133332]
(K0 (select {u: (count x) from: T where: (> x 0) by: kb}))               -- (K0 (select {u: (count x) from: (select {from: T where: (> x 0)}) by: kb}))
;; the first kept row past the first morsel, in a partly kept one
(K0 (select {u: (count x) from: T where: (and (> x 3000) (== (% x 2) 1)) by: kb}))  -- [true false]
(K0 (select {u: (count x) from: T where: (and (> x 3000) (== (% x 2) 0)) by: kb}))  -- [false true]
(K0 (select {u: (count x) from: S where: (> x 0) by: kb}))               -- [true false]
