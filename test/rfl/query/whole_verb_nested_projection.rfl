;; @also-unfused
;; A whole-column verb (distinct where reverse asc desc iasc idesc rank) in a
;; select projection reads the whole (kept) column when it sits under a call
;; or is the last form of a `do`, as the bare verb, update and by: do.  The
;; projection was scattered row by row, so each call saw one cell: reverse,
;; asc and desc returned the column as it was, the others raised type
;; (#1654).  Each case below gives the bare verb's answer in its position.

(set T (table [i g c] (list (til 6) (% (til 6) 2) [3 1 4 1 5 9])))
(set cnt 0)
(set Hm2 (fn [v] (let q 1) (+ v q)))

;; ── reverse ──
(at (select {v: (+ 0 (reverse c)) from: T}) 'v) -- [9 5 1 4 1 3]
(at (select {v: (+ 0 (reverse c)) w: (Hm2 c) from: T}) 'v) -- [9 5 1 4 1 3]
(at (select {v: (+ 0 (reverse c)) from: T where: (> i 1)}) 'v) -- [9 5 1 4]
(at (select {v: (do 0 (reverse c)) from: T}) 'v) -- [9 5 1 4 1 3]
(at (select {v: (do 0 (reverse c)) w: (Hm2 c) from: T}) 'v) -- [9 5 1 4 1 3]
(at (select {v: (do 0 (reverse c)) from: T where: (> i 1)}) 'v) -- [9 5 1 4]
(at (select {v: (do (set cnt (+ cnt 1)) (reverse c)) from: T}) 'v) -- [9 5 1 4 1 3]
(at (select {v: (do (set cnt (+ cnt 1)) (reverse c)) w: (Hm2 c) from: T}) 'v) -- [9 5 1 4 1 3]
(at (select {v: (do (set cnt (+ cnt 1)) (reverse c)) from: T where: (> i 1)}) 'v) -- [9 5 1 4]
;; ── asc ──
(at (select {v: (+ 0 (asc c)) from: T}) 'v) -- [1 1 3 4 5 9]
(at (select {v: (+ 0 (asc c)) w: (Hm2 c) from: T}) 'v) -- [1 1 3 4 5 9]
(at (select {v: (+ 0 (asc c)) from: T where: (> i 1)}) 'v) -- [1 4 5 9]
(at (select {v: (do 0 (asc c)) from: T}) 'v) -- [1 1 3 4 5 9]
(at (select {v: (do 0 (asc c)) w: (Hm2 c) from: T}) 'v) -- [1 1 3 4 5 9]
(at (select {v: (do 0 (asc c)) from: T where: (> i 1)}) 'v) -- [1 4 5 9]
(at (select {v: (do (set cnt (+ cnt 1)) (asc c)) from: T}) 'v) -- [1 1 3 4 5 9]
(at (select {v: (do (set cnt (+ cnt 1)) (asc c)) w: (Hm2 c) from: T}) 'v) -- [1 1 3 4 5 9]
(at (select {v: (do (set cnt (+ cnt 1)) (asc c)) from: T where: (> i 1)}) 'v) -- [1 4 5 9]
;; ── desc ──
(at (select {v: (+ 0 (desc c)) from: T}) 'v) -- [9 5 4 3 1 1]
(at (select {v: (+ 0 (desc c)) w: (Hm2 c) from: T}) 'v) -- [9 5 4 3 1 1]
(at (select {v: (+ 0 (desc c)) from: T where: (> i 1)}) 'v) -- [9 5 4 1]
(at (select {v: (do 0 (desc c)) from: T}) 'v) -- [9 5 4 3 1 1]
(at (select {v: (do 0 (desc c)) w: (Hm2 c) from: T}) 'v) -- [9 5 4 3 1 1]
(at (select {v: (do 0 (desc c)) from: T where: (> i 1)}) 'v) -- [9 5 4 1]
(at (select {v: (do (set cnt (+ cnt 1)) (desc c)) from: T}) 'v) -- [9 5 4 3 1 1]
(at (select {v: (do (set cnt (+ cnt 1)) (desc c)) w: (Hm2 c) from: T}) 'v) -- [9 5 4 3 1 1]
(at (select {v: (do (set cnt (+ cnt 1)) (desc c)) from: T where: (> i 1)}) 'v) -- [9 5 4 1]
;; ── iasc ──
(at (select {v: (+ 0 (iasc c)) from: T}) 'v) -- [1 3 0 2 4 5]
(at (select {v: (+ 0 (iasc c)) w: (Hm2 c) from: T}) 'v) -- [1 3 0 2 4 5]
(at (select {v: (+ 0 (iasc c)) from: T where: (> i 1)}) 'v) -- [1 0 2 3]
(at (select {v: (do 0 (iasc c)) from: T}) 'v) -- [1 3 0 2 4 5]
(at (select {v: (do 0 (iasc c)) w: (Hm2 c) from: T}) 'v) -- [1 3 0 2 4 5]
(at (select {v: (do 0 (iasc c)) from: T where: (> i 1)}) 'v) -- [1 0 2 3]
(at (select {v: (do (set cnt (+ cnt 1)) (iasc c)) from: T}) 'v) -- [1 3 0 2 4 5]
(at (select {v: (do (set cnt (+ cnt 1)) (iasc c)) w: (Hm2 c) from: T}) 'v) -- [1 3 0 2 4 5]
(at (select {v: (do (set cnt (+ cnt 1)) (iasc c)) from: T where: (> i 1)}) 'v) -- [1 0 2 3]
;; ── idesc ──
(at (select {v: (+ 0 (idesc c)) from: T}) 'v) -- [5 4 2 0 1 3]
(at (select {v: (+ 0 (idesc c)) w: (Hm2 c) from: T}) 'v) -- [5 4 2 0 1 3]
(at (select {v: (+ 0 (idesc c)) from: T where: (> i 1)}) 'v) -- [3 2 0 1]
(at (select {v: (do 0 (idesc c)) from: T}) 'v) -- [5 4 2 0 1 3]
(at (select {v: (do 0 (idesc c)) w: (Hm2 c) from: T}) 'v) -- [5 4 2 0 1 3]
(at (select {v: (do 0 (idesc c)) from: T where: (> i 1)}) 'v) -- [3 2 0 1]
(at (select {v: (do (set cnt (+ cnt 1)) (idesc c)) from: T}) 'v) -- [5 4 2 0 1 3]
(at (select {v: (do (set cnt (+ cnt 1)) (idesc c)) w: (Hm2 c) from: T}) 'v) -- [5 4 2 0 1 3]
(at (select {v: (do (set cnt (+ cnt 1)) (idesc c)) from: T where: (> i 1)}) 'v) -- [3 2 0 1]
;; ── rank ──
(at (select {v: (+ 0 (rank c)) from: T}) 'v) -- [2 0 3 1 4 5]
(at (select {v: (+ 0 (rank c)) w: (Hm2 c) from: T}) 'v) -- [2 0 3 1 4 5]
(at (select {v: (+ 0 (rank c)) from: T where: (> i 1)}) 'v) -- [1 0 2 3]
(at (select {v: (do 0 (rank c)) from: T}) 'v) -- [2 0 3 1 4 5]
(at (select {v: (do 0 (rank c)) w: (Hm2 c) from: T}) 'v) -- [2 0 3 1 4 5]
(at (select {v: (do 0 (rank c)) from: T where: (> i 1)}) 'v) -- [1 0 2 3]
(at (select {v: (do (set cnt (+ cnt 1)) (rank c)) from: T}) 'v) -- [2 0 3 1 4 5]
(at (select {v: (do (set cnt (+ cnt 1)) (rank c)) w: (Hm2 c) from: T}) 'v) -- [2 0 3 1 4 5]
(at (select {v: (do (set cnt (+ cnt 1)) (rank c)) from: T where: (> i 1)}) 'v) -- [1 0 2 3]
;; ── distinct ──
(at (select {v: (+ 0 (distinct c)) from: T}) 'v) -- [3 1 4 5 9]
(at (select {v: (+ 0 (distinct c)) w: (Hm2 c) from: T}) 'v) !- length
(at (select {v: (+ 0 (distinct c)) from: T where: (> i 1)}) 'v) -- [4 1 5 9]
(at (select {v: (do 0 (distinct c)) from: T}) 'v) -- [3 1 4 5 9]
(at (select {v: (do 0 (distinct c)) w: (Hm2 c) from: T}) 'v) !- length
(at (select {v: (do 0 (distinct c)) from: T where: (> i 1)}) 'v) -- [4 1 5 9]
(at (select {v: (do (set cnt (+ cnt 1)) (distinct c)) from: T}) 'v) -- [3 1 4 5 9]
(at (select {v: (do (set cnt (+ cnt 1)) (distinct c)) w: (Hm2 c) from: T}) 'v) !- length
(at (select {v: (do (set cnt (+ cnt 1)) (distinct c)) from: T where: (> i 1)}) 'v) -- [4 1 5 9]
;; ── where ──
(at (select {v: (+ 0 (where (> c 2))) from: T}) 'v) -- [0 2 4 5]
(at (select {v: (+ 0 (where (> c 2))) w: (Hm2 c) from: T}) 'v) !- length
(at (select {v: (+ 0 (where (> c 2))) from: T where: (> i 1)}) 'v) -- [0 2 3]
(at (select {v: (do 0 (where (> c 2))) from: T}) 'v) -- [0 2 4 5]
(at (select {v: (do 0 (where (> c 2))) w: (Hm2 c) from: T}) 'v) !- length
(at (select {v: (do 0 (where (> c 2))) from: T where: (> i 1)}) 'v) -- [0 2 3]
(at (select {v: (do (set cnt (+ cnt 1)) (where (> c 2))) from: T}) 'v) -- [0 2 4 5]
(at (select {v: (do (set cnt (+ cnt 1)) (where (> c 2))) w: (Hm2 c) from: T}) 'v) !- length
(at (select {v: (do (set cnt (+ cnt 1)) (where (> c 2))) from: T where: (> i 1)}) 'v) -- [0 2 3]

;; the effect in the do runs once: the projection is read once, whole
(set cnt 0)
(at (select {v: (do (set cnt (+ cnt 1)) (reverse c)) from: T}) 'v) -- [9 5 1 4 1 3]
cnt -- 1

;; unchanged: the bare verb, update and by: (the reference for the cases
;; above), and a verb under an aggregate, which is one value
(at (select {v: (reverse c) from: T}) 'v) -- [9 5 1 4 1 3]
(at (update {v: (+ 0 (reverse c)) from: T}) 'v) -- [9 5 1 4 1 3]
(at (select {v: (+ 0 (reverse c)) from: T by: g}) 'v) -- (list [5 4 3] [9 1 1])
(at (select {m: (count (distinct c)) from: T}) 'm) -- [5]
;; a verb in an `if` arm keeps the row-by-row reading
(at (select {v: (if (> i 2) (+ 0 c) 0) from: T}) 'v) -- [0 0 0 1 5 9]

;; a helper the planner does not inline is called with the whole column too,
;; as update and by: call it (whole_verb_helper_projection.rfl)
(set Hm (fn [v] (let q 1) (reverse v)))
(at (select {v: (Hm c) from: T}) 'v) -- [9 5 1 4 1 3]
(at (update {v: (Hm c) from: T}) 'v) -- [9 5 1 4 1 3]
;; a helper whose body is the one call is inlined, and reads the whole column
(set Hi (fn [v] (reverse v)))
(at (select {v: (Hi c) from: T}) 'v) -- [9 5 1 4 1 3]

;; one value of a whole-column verb's value, `(at (reverse c) 0)`: one value,
;; as `(at c 0)` is: one row alone, broadcast beside an output with rows
(at (select {v: (at c 0) from: T}) 'v) -- [3]
(at (select {v: (at (reverse c) 0) from: T}) 'v) -- [9]
(at (select {v: (at (asc c) 0) from: T}) 'v) -- [1]
(at (select {v: (at (iasc c) 0) from: T}) 'v) -- [1]
(at (select {v: (at (reverse c) 0) from: T where: (> i 1)}) 'v) -- [9]
(value (select {v: (at c 0) w: (Hm2 c) from: T})) -- (list [3 3 3 3 3 3] [4 2 5 2 6 10])
(value (select {v: (at (reverse c) 0) w: (Hm2 c) from: T})) -- (list [9 9 9 9 9 9] [4 2 5 2 6 10])
(value (select {v: (at (distinct c) 0) w: (Hm2 c) from: T})) -- (list [3 3 3 3 3 3] [4 2 5 2 6 10])
