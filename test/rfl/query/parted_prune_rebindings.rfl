;; @requires: posix
;; Lexical heads deliberately differ from the spelling recognized by the
;; necessary partition mask. Both the parted result and the flat reference
;; must preserve the replacement operation, not prune by the old builtin.
(.sys.exec "rm -rf rf_prune_rebindings") -- 0
(.db.splayed.set "rf_prune_rebindings/2024.01.01/t/" (table [a] (list [10 20])) "rf_prune_rebindings/.sym")
(.db.splayed.set "rf_prune_rebindings/2024.01.02/t/" (table [a] (list [30 40])) "rf_prune_rebindings/.sym")
(.db.splayed.set "rf_prune_rebindings/2024.01.03/t/" (table [a] (list [50 60])) "rf_prune_rebindings/.sym")
(set _prb_part (.db.parted.get "rf_prune_rebindings/" 't))
(set _prb_flat (table [date a] (list [2024.01.01 2024.01.01 2024.01.02 2024.01.02 2024.01.03 2024.01.03] [10 20 30 40 50 60])))
(set _prb_cmp (fn [tb] ((fn [==] (select {from: tb where: (== date 2024.01.02) a: a})) !=)))
(at (_prb_cmp _prb_flat) 'a) -- [10 20 50 60]
(at (_prb_cmp _prb_part) 'a) -- [10 20 50 60]
;; The replacement ignores the date predicate: pruning by that old conjunct
;; would wrongly remove the third partition, where a=60.
(set _prb_and (fn [tb] ((fn [and] (select {from: tb where: (and (== date 2024.01.02) (> a 50)) a: a})) (fn [left right] right))))
(at (_prb_and _prb_flat) 'a) -- [60]
(at (_prb_and _prb_part) 'a) -- [60]
(.sys.exec "rm -rf rf_prune_rebindings") -- 0
