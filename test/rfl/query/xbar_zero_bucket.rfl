(at (select {from: T r: (xbar v 0D00:05:00)}) 'r) -- (xbar V 0D00:05:00)

;; --- F64 values and buckets ---
(set V [1.5 -2.5 0Nf 7.25])
(set T (table [v w z1 z2 nb i] (list V [0.5 2.0 1.5 3.0] [0.5 0.0 1.5 3.0] [0.5 2.0 0.0 3.0] [0.5 0Nf 1.5 3.0] [1 2 3 4])))
(xbar V 0.0) !- domain
(xbar V (at T 'z1)) !- domain
(xbar V (at T 'nb)) !- domain
(select {from: T r: (xbar v 0.0)}) !- domain
(select {from: T r: (xbar v 0Nf)}) !- domain
(select {from: T r: (xbar i 0.0)}) !- domain
(select {from: T r: (xbar v z1)}) !- domain
(select {from: T r: (xbar v z2)}) !- domain
(select {from: T r: (xbar v nb)}) !- domain
(select {from: T r: (xbar i z1)}) !- domain
(select {from: T by: {k: (xbar v z1)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v z1) 0.0) n: (count v)}) !- domain

;; --- the issue's repro, compositions and folded buckets ---
(set T (table [v w] (list [1 -1 0Nl] [0 0 0])))
(xbar (at T 'v) 0) !- domain
(xbar (at T 'v) (at T 'w)) !- domain
(select {from: T r: (xbar v 0)}) !- domain
(select {from: T r: (xbar v w)}) !- domain
(select {from: T by: {k: (xbar v 0)} n: (count v)}) !- domain
(select {from: T r: (xbar (min v v) 0)}) !- domain
(set T (table [k v w x] (list [1 1 2 2] [10 -11 12 0Nl] [3 0 3 3] [3 3 3 3])))
(select {from: T r: (+ 1 (xbar v w))}) !- domain
(select {from: T r: (xbar v (- 2 2))}) !- domain
(select {from: T r: (xbar v (- x 3))}) !- domain
(select {from: T r: (xbar v (* w x))}) !- domain
(select {from: T r: (xbar 5 0)}) !- domain
(select {from: T r: (xbar 5 w)}) !- domain
(select {from: T s: (sum (xbar v w))}) !- domain
(select {from: T by: k s: (sum (xbar v w))}) !- domain
(select {from: T by: k s: (sum (xbar v 0))}) !- domain
(select {from: T by: {b: (xbar v w)} s: (sum v)}) !- domain
(select {from: T by: {b: (xbar v w) k: k} s: (sum v)}) !- domain
(select {from: T where: (> (xbar v w) 0)}) !- domain
(select {from: T where: (and (> x 0) (> (xbar v w) 0))}) !- domain
(update {from: T r: (xbar v w)}) !- domain
;; the builtin's message: its vector-by-integer path says non-zero, the rest
;; also name null; an empty column is still an error for a literal bucket
(set M (fn [e] (at e 'msg)))
(try (select {from: T r: (xbar v 0)}) M) -- (try (xbar (at T 'v) 0) M)
(try (select {from: T r: (xbar v 0i)}) M) -- (try (xbar (at T 'v) 0i) M)
(try (select {from: T r: (xbar v 0Nl)}) M) -- (try (xbar (at T 'v) 0Nl) M)
(try (select {from: T r: (xbar v 0x00)}) M) -- (try (xbar (at T 'v) 0x00) M)
(try (select {from: T r: (xbar v w)}) M) -- (try (xbar (at T 'v) (at T 'w)) M)
(try (select {from: T by: {b: (xbar v 0)} n: (count v)}) M) -- (try (xbar (at T 'v) 0) M)
(try (select {from: T where: (> (xbar v w) 0)}) M) -- (try (xbar (at T 'v) (at T 'w)) M)
(try (select {from: T r: (xbar 5 0)}) M) -- (try (xbar 5 0) M)
(try (select {from: T r: (xbar (as 'U8 x) 0)}) M) -- (try (xbar (as 'U8 (at T 'x)) 0) M)
(set E (take T 0))
(xbar (at E 'v) 0) !- domain
(select {from: E r: (xbar v 0)}) !- domain
(select {from: E r: (xbar v 0h)}) !- domain
(select {from: E by: {b: (xbar v 0)} n: (count v)}) !- domain
(select {from: E where: (> (xbar v 0i) 0) n: (count v)}) !- domain
;; ... the other zero or null literals raise per row, so an empty column
;; gives an empty result
(at (select {from: E r: (xbar v 0Nl)}) 'r) -- (xbar (at E 'v) 0Nl)
(at (select {from: E r: (xbar v 0x00)}) 'r) -- (xbar (at E 'v) 0x00)
(at (select {from: E r: (xbar v w)}) 'r) -- (xbar (at E 'v) (at E 'w))
(at (select {from: E r: (xbar (as 'F64 v) 0.0)}) 'r) -- (xbar (as 'F64 (at E 'v)) 0.0)
(at (select {from: T r: (xbar v x)}) 'r) -- (xbar (at T 'v) (at T 'x))
(at (select {from: T r: (+ 1 (xbar v x))}) 'r) -- (+ 1 (xbar (at T 'v) (at T 'x)))
(at (select {from: T by: k s: (sum (xbar v x))}) 's) -- [-3 12]
;; a row where: drops is not bucketed, so its zero bucket is no error (as
;; the builtin over the kept rows, and the per-row route)
(set T (table [v w x f g] (list [10 -11 12 13] [3 0 3 0Nl] [3 -1 3 -1] [1.5 2.5 3.5 4.5] [0.5 0.0 1.0 0Nf])))
(at (select {from: T where: (> x 0) r: (xbar v w)}) 'r) -- (xbar [10 12] 3)
(at (select {from: T where: (> x 0) r: (xbar v w)}) 'r) -- (at (select {from: T where: (> x 0) r: (xbar (min v v) w)}) 'r)
(at (select {from: T where: (> x 0) r: (xbar f g)}) 'r) -- (xbar [1.5 3.5] [0.5 1.0])
(at (select {from: T where: (> x 0) r: (+ 1 (xbar v w))}) 'r) -- [10 13]
(at (select {from: T where: (> x 0) by: {k: (xbar v w)} n: (count v)}) 'k) -- [9 12]
(at (select {from: T where: (> x 0) s: (sum (xbar v w))}) 's) -- [21]
(at (select {from: T where: (> x 0) by: x s: (sum (xbar v w))}) 's) -- [21]
(at (select {from: T where: (> w 0) r: (xbar v w)}) 'r) -- [9 12]
(select {from: T where: (!= w 0) r: (xbar v w)}) !- domain
(count (select {from: T where: (and (> x 0) (> (xbar v w) 0))})) -- 2
;; (update buckets every row, the per-row route included)
(update {from: T where: (> x 0) v: (xbar (min v v) w)}) !- domain
(update {from: T where: (> x 0) v: (xbar v w)}) !- domain
;; ... while a kept row's zero bucket still raises
(select {from: T where: (> v 0) r: (xbar v w)}) !- domain
(select {from: T where: (> v 0) by: {k: (xbar v w)} n: (count v)}) !- domain
(select {from: T where: (> v -20) r: (xbar f g)}) !- domain
(update {from: T where: (> v 0) v: (xbar v w)}) !- domain
;; a conjunct of where: buckets only the rows the conjuncts before it keep,
;; with by: (one predicate under the group) as without it
(set T (table [v w] (list [10 11 12 13 14] [3 0 3 2 3])))
(at (select {from: T where: (and (> w 0) (> (xbar v w) 5))}) 'v) -- [10 12 13 14]
(at (select {from: T where: (and (> w 0) (> (xbar v w) 5)) by: {k: (xbar v w)} n: (count v)}) 'n) -- [1 3]
(at (select {from: T where: (and (!= w 0) (> (xbar v w) 5)) by: {k: (% v 2)} s: (sum (xbar v w))}) 's) -- [33 12]
(at (select {from: T where: (and (> v 0) (and (> w 0) (> (xbar v w) 5))) by: {k: (xbar v w)} n: (count v)}) 'n) -- [1 3]
(at (select {from: T where: (and (> w 0) (> v 0) (> (xbar v w) 5) (< v 100)) by: {k: (xbar v w)} n: (count v)}) 'n) -- [1 3]
(select {from: T where: (and (> (xbar v w) 5) (> w 0)) by: {k: (xbar v w)} n: (count v)}) !- domain
(select {from: T where: (and (> (xbar v w) 5) (> w 0))}) !- domain
(select {from: T where: (and (> v 0) (> (xbar v w) 5)) by: {k: (xbar v w)} n: (count v)}) !- domain
;; an arm of an if buckets only the rows that take it, a literal bucket too
(at (select {from: T r: (if (> v 100) (xbar v 0) v)}) 'r) -- [10 11 12 13 14]
(at (select {from: T r: (if (> v 100) (xbar v 0x00) v)}) 'r) -- [10 11 12 13 14]
(at (select {from: T r: (if (> v 100) (xbar v 0Nl) v)}) 'r) -- [10 11 12 13 14]
(at (select {from: T r: (if false (xbar v 0) v)}) 'r) -- [10 11 12 13 14]
(at (select {from: T r: (if false (xbar v w) v)}) 'r) -- [10 11 12 13 14]
(at (select {from: T r: (if true v (xbar v 0))}) 'r) -- [10 11 12 13 14]
(at (select {from: T r: (cond ((> v 100) (xbar v 0)) (else v))}) 'r) -- [10 11 12 13 14]
(at (select {from: T r: (if (> w 0) (xbar v w) v)}) 'r) -- [9 11 12 12 12]
(at (select {from: T r: (if (> (min v v) 100) (xbar v 0) v)}) 'r) -- [10 11 12 13 14]
(at (select {from: T by: {k: (if (> v 100) (xbar v 0) v)} n: (count v)}) 'k) -- [10 11 12 13 14]
(if false (xbar [1 2] 0) 7) -- 7
(select {from: T r: (if (> v 12) (xbar v 0) v)}) !- domain
(select {from: T r: (if true (xbar v 0) v)}) !- domain
(select {from: T r: (if (> v 0) (xbar v w) v)}) !- domain
(select {from: T r: (cond ((> v 12) (xbar v 0)) (else v))}) !- domain
;; the same over many morsels: one zero bucket on a dropped row in the middle
(set N 300000)
(set W (concat (take (+ 1 (% (til N) 5)) 150000) (concat [0] (take (+ 1 (% (til N) 5)) (- N 150001)))))
(set X (concat (take (+ 1 (% (til N) 7)) 150000) (concat [-1] (take (+ 1 (% (til N) 7)) (- N 150001)))))
(set B (table [v w x] (list (til N) W X)))
(set K (where (> X 0)))
(at (select {from: B where: (> x 0) r: (xbar v w)}) 'r) -- (xbar (at (til N) K) (at W K))
(first (at (select {from: B where: (> x 0) s: (sum (xbar v w))}) 's)) -- (sum (xbar (at (til N) K) (at W K)))
(count (select {from: B where: (> x 0) by: {k: (xbar v w)} n: (count v)})) -- (count (distinct (xbar (at (til N) K) (at W K))))
(select {from: B r: (xbar v w)}) !- domain
(set K2 (where (> W 0)))
(asc (at (select {from: B where: (and (> w 0) (> (xbar v w) 5)) by: {k: (% v 3)} s: (sum (xbar v w))}) 's)) -- (asc (at (select {from: (table [v w] (list (at (til N) K2) (at W K2))) where: (> (xbar v w) 5) by: {k: (% v 3)} s: (sum (xbar v w))}) 's))
(select {from: B where: (> v 100) r: (xbar v w)}) !- domain
(select {from: B where: (> v 100) by: {k: (xbar v w)} n: (count v)}) !- domain

;; --- a parted table: the zero sits in the second partition ---
(.sys.exec "rm -rf /tmp/rfl_xbar_zero")
(.db.splayed.set "/tmp/rfl_xbar_zero/1/t/" (table [v w x] (list [10 -11 12] [3 3 3] [3 3 3])))
(.db.splayed.set "/tmp/rfl_xbar_zero/2/t/" (table [v w x] (list [13 0Nl 15] [3 0 3] [3 -1 3])))
(set Pt (.db.parted.get "/tmp/rfl_xbar_zero/" 't))
(select {from: Pt r: (xbar v 0)}) !- domain
(select {from: Pt r: (xbar v w)}) !- domain
(select {from: Pt by: {k: (xbar v w)} n: (count v)}) !- domain
(select {from: Pt by: {k: (xbar v 0)} n: (count v)}) !- domain
(select {from: Pt where: (> (xbar v w) 0) n: (count v)}) !- domain
(select {from: Pt s: (sum (xbar v w))}) !- domain
(at (select {from: Pt r: (xbar v x)}) 'r) -- [9 -12 12 12 0Nl 15]
(asc (at (select {from: Pt by: {k: (xbar v x)} n: (count v)}) 'k)) -- [0Nl -12 9 12 15]
(at (select {from: Pt where: (> x 0) r: (xbar v w)}) 'r) -- [9 -12 12 12 15]
(at (select {from: Pt where: (> x 0) by: {k: (xbar v w)} n: (count v)}) 'n) -- [1 1 2 1]
(select {from: Pt where: (> w -5) r: (xbar v w)}) !- domain
(select {from: Pt where: (> w -5) by: {k: (xbar v w)} n: (count v)}) !- domain
(.sys.exec "rm -rf /tmp/rfl_xbar_zero")
