(select {from: T by: {k: (xbar v 0i)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v 0i) (xbar v 0i)) n: (count v)}) !- domain
(select {from: T r: (xbar v 0Ni)}) !- domain
(select {from: T r: (xbar v z1)}) !- domain
(select {from: T r: (xbar v z2)}) !- domain
(select {from: T by: {k: (xbar v z1)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v z2) (xbar v z2)) n: (count v)}) !- domain
(select {from: T r: (xbar v nb)}) !- domain
(at (select {from: T r: (xbar v 7i)}) 'r) -- (xbar V 7i)
(at (select {from: T r: (xbar v w)}) 'r) -- (xbar V W)
(asc (at (select {from: T by: {k: (xbar v w)} n: (count v)}) 'k)) -- (asc (distinct (xbar V W)))
(at (select {from: T where: (== (xbar v w) (xbar v w)) r: (xbar v w)}) 'r) -- (at (xbar V W) (where (== (xbar V W) (xbar V W))))
;; U8 by I64
(set W [3 7 2 5])
(set Z1 [3 0 2 5])
(set Z2 [3 7 0 5])
(set T (table [v w z1 z2 nb] (list V W Z1 Z2 [3 7 0N 5])))
(xbar V 0) !- domain
(xbar V Z1) !- domain
(xbar V Z2) !- domain
(xbar V 0Nl) !- domain
(xbar V (at T 'nb)) !- domain
(select {from: T r: (xbar v 0)}) !- domain
(select {from: T by: {k: (xbar v 0)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v 0) (xbar v 0)) n: (count v)}) !- domain
(select {from: T r: (xbar v 0Nl)}) !- domain
(select {from: T r: (xbar v z1)}) !- domain
(select {from: T r: (xbar v z2)}) !- domain
(select {from: T by: {k: (xbar v z1)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v z2) (xbar v z2)) n: (count v)}) !- domain
(select {from: T r: (xbar v nb)}) !- domain
(at (select {from: T r: (xbar v 7)}) 'r) -- (xbar V 7)
(at (select {from: T r: (xbar v w)}) 'r) -- (xbar V W)
(asc (at (select {from: T by: {k: (xbar v w)} n: (count v)}) 'k)) -- (asc (distinct (xbar V W)))
(at (select {from: T where: (== (xbar v w) (xbar v w)) r: (xbar v w)}) 'r) -- (at (xbar V W) (where (== (xbar V W) (xbar V W))))

