;; @also-unfused
;; xbar_zero_bucket.rfl -- a query's xbar by a zero or null bucket raises
;; domain, as the builtin does (issue #1355).
;;
;; The query lowers (xbar x b) to (- x (% x b)), and the modulo kernels turn
;; a zero (or null) divisor into a null, so a projection, a by: key and a
;; where: predicate gave nulls where (xbar V 0) raises.  A literal bucket is
;; now checked when the query compiles, a column bucket by the modulo kernels
;; of the fused evaluator and of the per-node executor.  Each lane pins the
;; builtin's error first, then every query route; a nonzero bucket keeps the
;; builtin's answer.  A TIMESPAN bucket buckets through the builtin's duration
;; kernel, whose zero gives a null: the query keeps that too.

;; --- U8 values ---
(set V (as 'U8 [0 5 200 17]))
;; U8 by U8
(set W (as 'U8 [3 7 2 5]))
(set Z1 (as 'U8 [3 0 2 5]))
(set Z2 (as 'U8 [3 7 0 5]))
(set T (table [v w z1 z2] (list V W Z1 Z2)))
(xbar V 0x00) !- domain
(xbar V Z1) !- domain
(xbar V Z2) !- domain
(select {from: T r: (xbar v 0x00)}) !- domain
(select {from: T by: {k: (xbar v 0x00)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v 0x00) (xbar v 0x00)) n: (count v)}) !- domain
(select {from: T r: (xbar v z1)}) !- domain
(select {from: T r: (xbar v z2)}) !- domain
(select {from: T by: {k: (xbar v z1)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v z2) (xbar v z2)) n: (count v)}) !- domain
(at (select {from: T r: (xbar v 0x07)}) 'r) -- (xbar V 0x07)
(at (select {from: T r: (xbar v w)}) 'r) -- (xbar V W)
(asc (at (select {from: T by: {k: (xbar v w)} n: (count v)}) 'k)) -- (asc (distinct (xbar V W)))
(at (select {from: T where: (== (xbar v w) (xbar v w)) r: (xbar v w)}) 'r) -- (at (xbar V W) (where (== (xbar V W) (xbar V W))))
;; U8 by I16
(set W (as 'I16 [3 7 2 5]))
(set Z1 (as 'I16 [3 0 2 5]))
(set Z2 (as 'I16 [3 7 0 5]))
(set T (table [v w z1 z2 nb] (list V W Z1 Z2 (as 'I16 [3 7 0N 5]))))
(xbar V 0h) !- domain
(xbar V Z1) !- domain
(xbar V Z2) !- domain
(xbar V 0Nh) !- domain
(xbar V (at T 'nb)) !- domain
(select {from: T r: (xbar v 0h)}) !- domain
(select {from: T by: {k: (xbar v 0h)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v 0h) (xbar v 0h)) n: (count v)}) !- domain
(select {from: T r: (xbar v 0Nh)}) !- domain
(select {from: T r: (xbar v z1)}) !- domain
(select {from: T r: (xbar v z2)}) !- domain
(select {from: T by: {k: (xbar v z1)} n: (count v)}) !- domain
(select {from: T where: (> (xbar v z2) (xbar v z2)) n: (count v)}) !- domain
(select {from: T r: (xbar v nb)}) !- domain
(at (select {from: T r: (xbar v 7h)}) 'r) -- (xbar V 7h)
(at (select {from: T r: (xbar v w)}) 'r) -- (xbar V W)
(asc (at (select {from: T by: {k: (xbar v w)} n: (count v)}) 'k)) -- (asc (distinct (xbar V W)))
(at (select {from: T where: (== (xbar v w) (xbar v w)) r: (xbar v w)}) 'r) -- (at (xbar V W) (where (== (xbar V W) (xbar V W))))
;; U8 by I32
(set W (as 'I32 [3 7 2 5]))
(set Z1 (as 'I32 [3 0 2 5]))
(set Z2 (as 'I32 [3 7 0 5]))
(set T (table [v w z1 z2 nb] (list V W Z1 Z2 (as 'I32 [3 7 0N 5]))))
