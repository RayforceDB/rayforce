;; A narrowing cast leaves an I32, I16 or one-byte lane in the compiled
;; expression; the next conversion read that lane as int64.
;; (+ (as 'I32 i) 1.5) came back as [8.59e+09 1.72e+10 1.5 1.5].
;; Oracle: the same expression outside a select.
(set iv [1 2 3 4 -5 0])
(set TC (table [i] (list iv)))
(at (select {x: (+ (as 'I32 i) 1.5) from: TC}) 'x) -- (+ (as 'I32 iv) 1.5)
(at (select {x: (+ (as 'I16 i) 1.5) from: TC}) 'x) -- (+ (as 'I16 iv) 1.5)
(at (select {x: (+ (as 'U8 i) 1.5) from: TC}) 'x) -- (+ (as 'U8 iv) 1.5)
(at (select {x: (* (as 'I32 i) 2) from: TC}) 'x) -- (* (as 'I32 iv) 2)
(at (select {x: (as 'F64 (as 'I32 i)) from: TC}) 'x) -- (as 'F64 (as 'I32 iv))
(at (select {x: (as 'I16 (as 'I32 i)) from: TC}) 'x) -- (as 'I16 (as 'I32 iv))
(at (select {x: (as 'I32 (as 'I16 i)) from: TC}) 'x) -- (as 'I32 (as 'I16 iv))
(at (select {x: (as 'U8 (as 'I32 i)) from: TC}) 'x) -- (as 'U8 (as 'I32 iv))
(at (select {x: (as 'I64 (as 'U8 i)) from: TC}) 'x) -- (as 'I64 (as 'U8 iv))
(at (select {i: i from: TC where: (> (as 'I32 i) 2.5)}) 'i) -- [3 4]

;; every narrow source into every narrow target, compiled
(at (select {x: (as 'I32 (as 'U8 i)) from: TC}) 'x) -- (as 'I32 (as 'U8 iv))
(at (select {x: (as 'I16 (as 'U8 i)) from: TC}) 'x) -- (as 'I16 (as 'U8 iv))
(at (select {x: (as 'U8 (as 'I16 i)) from: TC}) 'x) -- (as 'U8 (as 'I16 iv))
(at (select {x: (as 'I32 (as 'I32 i)) from: TC}) 'x) -- (as 'I32 iv)
(at (select {x: (as 'I16 (as 'I16 i)) from: TC}) 'x) -- (as 'I16 iv)
(at (select {x: (as 'U8 (as 'U8 i)) from: TC}) 'x) -- (as 'U8 iv)
;; nulls through the narrow lanes, compiled
(set ivn [1 0N 3 4 -5 0])
(set TCN (table [i] (list ivn)))
(at (select {x: (+ (as 'I32 i) 1.5) from: TCN}) 'x) -- (+ (as 'I32 ivn) 1.5)
(at (select {x: (+ (as 'I16 i) 1.5) from: TCN}) 'x) -- (+ (as 'I16 ivn) 1.5)
(at (select {x: (as 'I32 (as 'I16 i)) from: TCN}) 'x) -- (as 'I32 (as 'I16 ivn))

;; a cast to U8 of a nullable column runs in the element-wise fallback, which
;; wrote 8-byte doubles into the narrower target of a narrow-to-narrow cast
;; (a heap overrun past the result).
(set nv (at [0Nl -2 -1 0 1 2] (% (til 2000) 6)))
(set TV (table [v] (list nv)))
(sum (as 'I64 (at (select {r: (as 'BOOL (as 'U8 v)) from: TV}) 'r))) -- (sum (as 'I64 (as 'BOOL (as 'U8 nv))))
(at (select {r: (as 'I16 (as 'I32 v)) from: TV}) 'r) -- (as 'I16 (as 'I32 nv))
(at (select {r: (as 'U8 (as 'I16 v)) from: TV}) 'r) -- (as 'U8 (as 'I16 nv))
(at (select {r: (as 'I16 (as 'U8 v)) from: TV}) 'r) -- (as 'I16 (as 'U8 nv))
(at (select {r: (as 'I32 (as 'U8 v)) from: TV}) 'r) -- (as 'I32 (as 'U8 nv))
(count (til 100000)) -- 100000
