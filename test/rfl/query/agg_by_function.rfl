;; @requires: posix  (fixtures run through a POSIX shell via .sys.exec)
;; An aggregate is recognised by the RAY_FN_AGGR builtin a call's head
;; holds, not by its spelling (#1814): an alias, a parameter or a let holding
;; sum aggregates; a name spelled like an aggregate but holding another
;; function is that function; a column named like an aggregate does not hide
;; it, as before.  Each line compares with the named call, in memory,
;; splayed and parted.
(.sys.exec "rm -rf /tmp/rfl_agg_fn && mkdir -p /tmp/rfl_agg_fn") -- 0
(set T (table [g c i] (list ['a 'a 'b 'b 'b 'c 'a 'c 'b 'a] [true false true false true false true true false false] [10 20 30 40 50 60 70 80 90 10])))
(.db.splayed.set "/tmp/rfl_agg_fn/s/t/" T)
(.db.splayed.set "/tmp/rfl_agg_fn/p/2024.01.01/t/" (at T [0 1 2 3 4]) "/tmp/rfl_agg_fn/p/.sym")
(.db.splayed.set "/tmp/rfl_agg_fn/p/2024.01.02/t/" (at T [5 6 7 8 9]) "/tmp/rfl_agg_fn/p/.sym")
(set S (.db.splayed.get "/tmp/rfl_agg_fn/s/t/"))
(set P (.db.parted.get "/tmp/rfl_agg_fn/p/" 't))
;; the issue's cases: a name spelled like an aggregate holding a whole-column verb
((fn [sum] (select {from: T r: (sum i)})) desc) -- (select {from: T r: (desc i)})
((fn [] (let count reverse) (select {from: T r: (count i)}))) -- (select {from: T r: (reverse i)})
((fn [first] (select {from: S where: (> i 15) r: (first i)})) asc) -- (select {from: S where: (> i 15) r: (asc i)})
((fn [max] (select {from: P r: (+ 0 (max i))})) reverse) -- (select {from: P r: (+ 0 (reverse i))})
((fn [last] (update {from: T r: (last i)})) iasc) -- (update {from: T r: (iasc i)})
;; an alias, a parameter or a let holding an aggregate aggregates
(set total sum)
(select {from: T r: (total i)}) -- (select {from: T r: (sum i)})
(select {from: S where: (> i 15) r: (total i)}) -- (select {from: S where: (> i 15) r: (sum i)})
(select {from: P by: g r: (total i)}) -- (select {from: P by: g r: (sum i)})
((fn [n] (select {from: T r: (n i) c: c})) count) -- (select {from: T r: (count i) c: c})
((fn [] (let f first) (select {from: P by: g r: (f i)}))) -- (select {from: P by: g r: (first i)})
((fn [q] (select {from: S by: g r: (q i 50)})) percentile) -- (select {from: S by: g r: (percentile i 50)})
((fn [q] (select {from: T r: (q i 0.5)})) quantile) -- (select {from: T r: (quantile i 0.5)})
(at ((fn [m] (select {from: T r: (m i)})) med) 'r) -- [45.0]
;; a column named like an aggregate does not hide it
(set U (table [g price max count first] (list ['a 'a 'b] [10 20 30] [1 2 3] [7 8 9] [4 5 6])))
(at (select {from: U r: (max price)}) 'r) -- [30]
(at (select {from: U by: g r: (count price)}) 'r) -- [2 1]
(at (select {from: U by: g r: (first price)}) 'r) -- [10 30]
(at (select {from: U r: max}) 'r) -- [1 2 3]
;; med inside an expression, and a helper whose body is (med x), whether
;; global or a parameter: the median, where the expression was nyi
(set hm (fn [x ignored] (med x)))
(at (select {from: T r: (+ 0 (med i))}) 'r) -- (at (select {from: T r: (med i)}) 'r)
(at (select {from: P r: (+ 0 (med i))}) 'r) -- (at (select {from: P r: (med i)}) 'r)
(at (select {from: T r: (hm i 0.5)}) 'r) -- (at (select {from: T r: (med i)}) 'r)
(at ((fn [h] (select {from: T r: (h i 0.5)})) hm) 'r) -- (at (select {from: T r: (med i)}) 'r)
(count (at (select {from: S r: (med i) c: c}) 'r)) -- 10
(first (at (select {from: S r: (med i) c: c}) 'r)) -- 45.0
;; a global helper's free names are globals: the caller's local named sum
;; does not reach into the helper's (sum x)
(set hs (fn [x] (sum x)))
(at ((fn [sum] (select {from: T r: (hs i)})) desc) 'r) -- (at (select {from: T r: (sum i)}) 'r)
(at ((fn [sum] (select {from: T by: g r: (hs i)})) desc) 'r) -- (at (select {from: T by: g r: (sum i)}) 'r)
;; window: the function a funcs: entry names, as a select's aggregates
(set W (table [k t v] (list ['a 'a 'b 'b 'a 'b] [1 2 3 4 5 6] [5 2 9 4 4 7])))
(at (window {from: W part: [k] funcs: {x: (total v)}}) 'x) -- (at (window {from: W part: [k] funcs: {x: (sum v)}}) 'x)
(at ((fn [m] (window {from: W part: [k] funcs: {x: (m v)}})) max) 'x) -- (at (window {from: W part: [k] funcs: {x: (max v)}}) 'x)
(at ((fn [f] (window {from: W part: [k] order: [t] funcs: {x: (f v)}})) first) 'x) -- (at (window {from: W part: [k] order: [t] funcs: {x: (first v)}}) 'x)
((fn [sum] (window {from: W part: [k] funcs: {x: (sum v)}})) til) !- domain
(.sys.exec "rm -rf /tmp/rfl_agg_fn") -- 0

;; ── (count|first|last (asc ...)): the shortcut judges both heads by function (#1826) ──
;; (count (asc v)) is (count v) and (first (asc v)) is (min v) over a vector
;; column, under any name for count, first, last and asc
(set TA (table [k v l] (list [0 0 1 1 1] [3 1 2 5 4] (list [1 2] "a" 'x [3] 4))))
(set cnt1826 count) (set fst1826 first) (set lst1826 last) (set up1826 asc)
(at (select {n: (count (asc v)) from: TA by: k}) 'n) -- [2 3]
(at (select {n: (cnt1826 (up1826 v)) from: TA by: k}) 'n) -- [2 3]
(at (select {n: (count (desc v)) from: TA}) 'n) -- [5]
(at (select {n: (first (asc v)) from: TA by: k}) 'n) -- [1 2]
(at (select {n: (fst1826 (asc v)) from: TA by: k}) 'n) -- [1 2]
(at (select {n: (last (up1826 v)) from: TA by: k}) 'n) -- [3 5]
(at (select {n: (lst1826 (asc v)) from: TA}) 'n) -- [5]
;; asc and the other sort verbs raise on a LIST column, and the shortcut no
;; longer hides it: every form raises as eval does
(asc (at TA 'l)) !- type
(select {n: (count (asc l)) from: TA}) !- type
(select {n: (count (asc l)) from: TA by: k}) !- type
(select {n: (cnt1826 (asc l)) from: TA by: k}) !- type
(select {n: (count (desc l)) from: TA by: k}) !- type
(select {n: (count (iasc l)) from: TA by: k}) !- type
(select {n: (count (rank l)) from: TA by: k}) !- type
(select {n: (count (xrank 2 l)) from: TA by: k}) !- type
(select {n: (first (asc l)) from: TA by: k}) !- type
;; reverse and rotate take a list: their count is the list's
(at (select {n: (count (reverse l)) from: TA by: k}) 'n) -- [2 3]
(at (select {n: (count (rotate l 1)) from: TA by: k}) 'n) -- [2 3]
;; arithmetic over vector columns is a vector: its sort still takes the shortcut
(at (select {n: (count (asc (+ v 1))) from: TA by: k}) 'n) -- [2 3]
(at (select {n: (count (desc (* v 2.0))) from: TA by: k}) 'n) -- [2 3]
;; a column named like the verb is the column, as evaluation reads it in the
;; select: no verb, so no shortcut, and the call raises as it does keyless
(set up1846 asc)
(set TC (table [k v up1846] (list [0 0 1 1] [3 1 2 4] [10 20 30 40])))
(set TC2 (table [k v asc] (list [0 0 1 1] [3 1 2 4] [10 20 30 40])))
(select {from: TC r: (up1846 v)}) !- type
(select {from: TC by: k r: (first (up1846 v))}) !- type
(select {from: TC by: k r: (count (up1846 v))}) !- type
(select {from: TC by: k r: (last (up1846 v))}) !- type
(select {from: TC2 r: (count (asc v))}) !- type
(select {from: TC2 by: k r: (first (asc v))}) !- type
(select {from: TC2 by: k r: (count (asc v))}) !- type
;; a column named like the aggregate does not hide it (#1814): the shortcut stands
(set TC3 (table [k v count] (list [0 0 1 1] [3 1 2 4] [10 20 30 40])))
(at (select {from: TC3 by: k r: (count (asc v))}) 'r) -- [2 2]
(at (select {from: TC3 r: (count (asc v))}) 'r) -- [4]

;; ── the planner's other aggregate shortcuts judge the head by function (#1844) ──
(set T44 (table [k a b v] (list [0 0 1 1 1] [1 5 3 8 2] [4 2 6 1 9] [3 3 2 5 5])))
;; a count rebound to sum is sum under by:, never a distinct count
(at (select {r: (count (distinct v)) from: T44 by: k}) 'r) -- [1 2]
((fn [count] (at (select {r: (count (distinct v)) from: T44 by: k}) 'r)) sum) -- [3 7]
((fn [count] (at (select {r: (count (distinct v)) from: T44}) 'r)) sum) -- [10]
(set cnt1844 count)
(at (select {r: (cnt1844 (distinct v)) from: T44 by: k}) 'r) -- [1 2]
;; a key derived from one symbol column: min rebound to max is max
(set TQ44 (table [ref] (list (as 'SYMBOL (concat "http://h" (as 'STR (% (til 70000) 3)))))))
(== (at (select {from: TQ44 by: (substr ref 1 8) c: (max ref)}) 'c) (as 'SYMBOL ["http://h2"])) -- [true]
(== ((fn [min] (at (select {from: TQ44 by: (substr ref 1 8) c: (min ref)}) 'c)) max) (as 'SYMBOL ["http://h2"])) -- [true]
((fn [count] (at (select {from: TQ44 by: (substr ref 1 8) c: (count ref)}) 'c)) cnt1844) -- [70000]
;; a source read through first or last beside the group, under any name
(set N44 (list [1 2] [3 4]))
(at (select {r: (+ v (last (last N44))) from: T44 by: k}) 'r) -- (list [7 7] [6 9 9])
((fn [first] (at (select {r: (+ v (first (first N44))) from: T44 by: k}) 'r)) last) -- (list [7 7] [6 9 9])
(set fst1844 first)
(at (select {r: (+ v (fst1844 (fst1844 N44))) from: T44 by: k}) 'r) -- (list [4 4] [3 6 6])
;; med and the binary min/max answer as before under another name
(set md1844 med) (set mn1844 min)
(at (select {r: (md1844 v) from: T44 by: k}) 'r) -- [3.0 5.0]
((fn [med] (at (select {r: (med v) from: T44 by: k}) 'r)) avg) -- [3.0 4.0]
(at (select {r: (mn1844 a b) from: T44}) 'r) -- [1 2 3 1 2]
((fn [min] (at (select {r: (min a b) from: T44}) 'r)) max) -- [4 5 6 8 9]
;; distinct is no aggregate: a column named like it, or like an alias of it,
;; is the column, so no distinct count, and the call raises as it does keyless
(set dst1844 distinct)
(set TD44 (table [k v dst1844] (list [0 0 1 1 1] [3 3 2 5 5] [1 2 3 4 5])))
(set TD45 (table [k v distinct] (list [0 0 1 1 1] [3 3 2 5 5] [1 2 3 4 5])))
(select {r: (count (dst1844 v)) from: TD44}) !- type
(select {r: (count (dst1844 v)) from: TD44 by: k}) !- type
(select {r: (count (distinct v)) from: TD45}) !- type
(select {r: (count (distinct v)) from: TD45 by: k}) !- type
