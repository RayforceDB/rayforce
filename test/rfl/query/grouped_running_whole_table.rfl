;; Running functions under by: (#1249).  A running, moving or shift
;; function sees the whole table, the rows the where: drops included, in a
;; grouped select as in a keyless one (docs/queries/select.md "Running
;; functions under where:"), whatever its spelling: a builtin, a helper the
;; planner inlines, one it cannot inline (a builtin passed as a value, several
;; statements).  An aggregate over it aggregates each group's rows of the
;; whole-table column; a plain output is that column split by group.  The
;; answer is the same on flat, parted and splayed tables, with take:.
(set T (table [k i] (list [0 1 0 1 0 1] [1 2 4 8 16 32])))
(.sys.exec "rm -rf /tmp/rfl_grouped_running /tmp/rfl_grouped_running_s /tmp/rfl_grouped_running_d /tmp/rfl_grouped_running_ds")
(.db.splayed.set "/tmp/rfl_grouped_running/1/t/" (take T 3))
(.db.splayed.set "/tmp/rfl_grouped_running/2/t/" (take T -3))
(.db.splayed.set "/tmp/rfl_grouped_running_s/t/" T)
(set P (.db.parted.get "/tmp/rfl_grouped_running/" 't))
(set S (.db.splayed.get "/tmp/rfl_grouped_running_s/t/"))
(set hs (fn [x] (sums x)))
(set hd (fn [x] (deltas x)))
(set hm (fn [x] (msum 2 x)))
(set hl (fn [x] (lag x)))
(set lp (fn [x] (prior - x)))
(set hs2 (fn [x] (let y x) (sums y)))
(set hd2 (fn [x] (let y x) (deltas y)))
(set Z (fn [r] (at (xasc r 'k) 'z)))

;; The issue: (prior - x) in a helper the planner cannot inline ran per group.
(Z (select {from: T by: k z: (sum (prior - i))})) -- [10 21]
(Z (select {from: T by: k z: (sum (lp i))})) -- [10 21]
(Z (select {from: T by: k z: (sum (hs2 i))})) -- [39 81]
;; A plain running output is the whole-table column split by group.
(Z (select {from: T by: k z: (sums i)})) -- (list [1 7 31] [3 15 63])
(Z (select {from: T by: k where: (> i 2) z: (sums i)})) -- (list [7 31] [15 63])

;; Every spelling (a helper by name or written in place), with and without
;; where:, flat, parted and splayed.
(Z (select {from: T by: k z: (sums i)})) -- (list [1 7 31] [3 15 63])
(Z (select {from: T by: k z: (hs i)})) -- (list [1 7 31] [3 15 63])
(Z (select {from: T by: k z: ((fn [x] (sums x)) i)})) -- (list [1 7 31] [3 15 63])
(Z (select {from: T by: k z: (hs2 i)})) -- (list [1 7 31] [3 15 63])
(Z (select {from: T by: k z: (deltas i)})) -- (list [0Nl 2 8] [1 4 16])
(Z (select {from: T by: k z: (hd i)})) -- (list [0Nl 2 8] [1 4 16])
(Z (select {from: T by: k z: (hd2 i)})) -- (list [0Nl 2 8] [1 4 16])
(Z (select {from: T by: k z: ((fn [x] (let y x) (deltas y)) i)})) -- (list [0Nl 2 8] [1 4 16])
(Z (select {from: T by: k z: (prior - i)})) -- (list [0 2 8] [1 4 16])
(Z (select {from: T by: k z: (lp i)})) -- (list [0 2 8] [1 4 16])
(Z (select {from: T by: k z: ((fn [x] (prior - x)) i)})) -- (list [0 2 8] [1 4 16])
(Z (select {from: T by: k z: (msum 2 i)})) -- (list [1 6 24] [3 12 48])
(Z (select {from: T by: k z: (hm i)})) -- (list [1 6 24] [3 12 48])
(Z (select {from: T by: k z: ((fn [x] (let y x) (msum 2 y)) i)})) -- (list [1 6 24] [3 12 48])
(Z (select {from: T by: k z: (lag i)})) -- (list [0Nl 2 8] [1 4 16])
(Z (select {from: T by: k z: (hl i)})) -- (list [0Nl 2 8] [1 4 16])
(Z (select {from: T by: k z: (sum (sums i))})) -- [39 81]
(Z (select {from: T by: k z: (sum (hs i))})) -- [39 81]
(Z (select {from: T by: k z: (sum ((fn [x] (sums x)) i))})) -- [39 81]
(Z (select {from: T by: k z: (sum (hs2 i))})) -- [39 81]
