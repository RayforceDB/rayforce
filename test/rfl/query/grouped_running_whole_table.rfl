(Z (select {from: S by: k where: (== k 1) z: (last (hl i))})) -- [16]

;; take: keeps groups, not the rows a running call sees.
(Z (select {from: T by: k z: (sum (lp i)) take: 1})) -- [10]
(Z (select {from: P by: k where: (> i 2) z: (sum (hs2 i)) take: 1})) -- [38]
(Z (select {from: S by: k where: (> i 2) z: (lp i) take: 1})) -- (list [2 8])
;; last of a plain output is the (last ...) of the same call.
(map last (Z (select {from: T by: k z: (prior - i)}))) -- (Z (select {from: T by: k z: (last (prior - i))}))
(map last (Z (select {from: T by: k z: (hs2 i)}))) -- (Z (select {from: T by: k z: (last (hs2 i))}))
(map last (Z (select {from: P by: k where: (> i 2) z: (sums i)}))) -- (Z (select {from: P by: k where: (> i 2) z: (last (sums i))}))
;; An aggregate under a running call sees the whole table too.
(Z (select {from: T by: k z: (last (sums (- i (avg i))))})) -- [-21.5 0.0]
(Z (select {from: T by: k z: (- (last (sums i)) (first (prior - i)))})) -- [31 62]
;; A helper with an aggregate inside is called once over the whole table
;; when it gives one value per row ...
(set hz2 (fn [x] (let y x) (- y (avg y))))
(Z (select {from: T by: k z: (last (hz2 i))})) -- [5.5 21.5]
(Z (select {from: T by: k z: (hz2 i)})) -- (list [-9.5 -6.5 5.5] [-8.5 -2.5 21.5])
;; ... and per group when it does not, or when it fails over the whole table.
(set ha (fn [x] (let y x) (avg y)))
(Z (select {from: T by: k z: (sum (ha i))})) -- [7.0 14.0]
(set he (fn [x] (let y x) (if (> (count y) 3) (raise "big") (sums y))))
(Z (select {from: T by: k z: (sum (he i))})) -- [27 54]
;; An aggregate passed to a helper is the group's, as it is inline: the
;; helper call stays per group, and a running call in its arguments is
;; still taken over the whole table.
(set hz (fn [x y] (let q x) (- q y)))
(Z (select {from: T by: k z: (hz i (first i))})) -- (list [0 3 15] [0 6 30])
(Z (select {from: T by: k z: (hz i (avg i))})) -- (list [-6.0 -3.0 9.0] [-12.0 -6.0 18.0])
(Z (select {from: T by: k where: (> i 2) z: (hz i (first i))})) -- (list [0 12] [0 24])
(select {from: T by: k z: (sum (hz i (count i)))}) !- domain
(Z (select {from: T by: k z: (hz (sums i) (sum i))})) -- (list [-20 -14 10] [-39 -27 21])
;; A call that runs per group still takes the running calls in its
;; arguments over the whole table.
(set h3 (fn [x] (let n (count x)) (take x 2)))
(Z (select {from: T by: k z: (h3 (sums i))})) -- (list [1 7] [3 15])
(Z (select {from: P by: k where: (> i 2) z: (h3 (sums i))})) -- (list [7 31] [15 63])
;; A running call over a per-group alias runs across the groups, as before.
(Z (select {from: T by: k n: (sum i) z: (deltas n)})) -- [0Nl 21]
;; A running call in the where: or the by: is not an output: it is unchanged.
(Z (select {from: T by: k where: (> (sums i) 5) z: (sum i)})) -- [20 40]
;; update by: stays per group.
(at (update {from: T z: (sums i) by: k}) 'z) -- [1 2 5 10 21 42]
(at (update {from: T z: (hs2 i) by: k}) 'z) -- [1 2 5 10 21 42]
(at (update {from: T z: (lp i) by: k}) 'z) -- [0 0 3 6 12 24]

;; Against the whole-table oracle: the call over the whole table by update,
;; then grouped, on a larger table, several key shapes and outputs beside
;; (in key order: the order of the groups is not the point here).
(set N 3000)
(set x (til N))
(set D (table [k s i f t u] (list (% (* x 7919) 13) (at ['a 'b 'c 'd] (% (* x 31) 4)) (% (* x 104729) 1000) (* 0.5 (+ 1 (% (* x 13) 97))) (at ["x" "yy" "z"] (% x 3)) (at (concat (as 'GUID "11111111-1111-1111-1111-111111111111") (concat (as 'GUID "22222222-2222-2222-2222-222222222222") (as 'GUID "33333333-3333-3333-3333-333333333333"))) (% x 3)))))
(.db.splayed.set "/tmp/rfl_grouped_running_d/1/t/" (take D 1000))
(.db.splayed.set "/tmp/rfl_grouped_running_d/2/t/" (take (take D 2000) -1000))
(.db.splayed.set "/tmp/rfl_grouped_running_d/3/t/" (take D -1000))
(.db.splayed.set "/tmp/rfl_grouped_running_ds/t/" D)
(set DP (.db.parted.get "/tmp/rfl_grouped_running_d/" 't))
(set DS (.db.splayed.get "/tmp/rfl_grouped_running_ds/t/"))
(set g_sums (fn [v] (let y v) (sums y)))
(set g_prior (fn [v] (prior - v)))
(set g_dev (fn [v] (let y v) (- y (avg y))))
(set g_two (fn [a b] (let y (+ a b)) (deltas y)))
(xasc (select {from: D by: k r: (sums i)}) 'k) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: k r: zz}) 'k)
(xasc (select {from: D by: [k s] where: (> i 500) r: (sums i)}) ['k 's]) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: [k s] where: (> i 500) r: zz}) ['k 's])
(xasc (select {from: D by: t where: (== k 3) r: (sums i)}) 't) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: t where: (== k 3) r: zz}) 't)
(xasc (select {from: D by: u r: (sum (sums i))}) 'u) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: u r: (sum zz)}) 'u)
(xasc (select {from: D by: {g: (% i 7)} where: (> i 500) r: (sum (sums i))}) 'g) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: {g: (% i 7)} where: (> i 500) r: (sum zz)}) 'g)
(xasc (select {from: D by: k where: (== k 3) r: (sum (sums i)) p: i}) 'k) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: k where: (== k 3) r: (sum zz) p: i}) 'k)
(xasc (select {from: D by: [k s] r: (last (sums i)) p: i}) ['k 's]) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: [k s] r: (last zz) p: i}) ['k 's])
(xasc (select {from: D by: t where: (> i 500) r: (last (sums i)) p: i}) 't) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: t where: (> i 500) r: (last zz) p: i}) 't)
(xasc (select {from: D by: u where: (== k 3) r: (last (sums i)) p: i}) 'u) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: u where: (== k 3) r: (last zz) p: i}) 'u)
(xasc (select {from: D by: {g: (% i 7)} r: (max (sums i)) p: i}) 'g) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: {g: (% i 7)} r: (max zz) p: i}) 'g)
(xasc (select {from: D by: k where: (> i 500) r: (max (sums i)) c: (count i)}) 'k) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: k where: (> i 500) r: (max zz) c: (count i)}) 'k)
(xasc (select {from: D by: [k s] where: (== k 3) r: (max (sums i)) c: (count i)}) ['k 's]) -- (xasc (select {from: (update {from: D zz: (sums i)}) by: [k s] where: (== k 3) r: (max zz) c: (count i)}) ['k 's])
(xasc (select {from: D by: t r: (deltas i) c: (count i)}) 't) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: t r: zz c: (count i)}) 't)
(xasc (select {from: D by: u where: (> i 500) r: (deltas i) c: (count i)}) 'u) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: u where: (> i 500) r: zz c: (count i)}) 'u)
(xasc (select {from: D by: {g: (% i 7)} where: (== k 3) r: (deltas i) c: (count i)}) 'g) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: {g: (% i 7)} where: (== k 3) r: zz c: (count i)}) 'g)
(xasc (select {from: D by: k r: (sum (deltas i)) m: (first f)}) 'k) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: k r: (sum zz) m: (first f)}) 'k)
(xasc (select {from: D by: [k s] where: (> i 500) r: (sum (deltas i)) m: (first f)}) ['k 's]) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: [k s] where: (> i 500) r: (sum zz) m: (first f)}) ['k 's])
(xasc (select {from: D by: t where: (== k 3) r: (sum (deltas i)) m: (first f)}) 't) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: t where: (== k 3) r: (sum zz) m: (first f)}) 't)
(xasc (select {from: D by: u r: (last (deltas i)) m: (first f)}) 'u) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: u r: (last zz) m: (first f)}) 'u)
(xasc (select {from: D by: {g: (% i 7)} where: (> i 500) r: (last (deltas i)) m: (first f)}) 'g) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: {g: (% i 7)} where: (> i 500) r: (last zz) m: (first f)}) 'g)
(xasc (select {from: D by: k where: (== k 3) r: (last (deltas i)) d: (count (distinct s))}) 'k) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: k where: (== k 3) r: (last zz) d: (count (distinct s))}) 'k)
(xasc (select {from: D by: [k s] r: (max (deltas i)) d: (count (distinct s))}) ['k 's]) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: [k s] r: (max zz) d: (count (distinct s))}) ['k 's])
(xasc (select {from: D by: t where: (> i 500) r: (max (deltas i)) d: (count (distinct s))}) 't) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: t where: (> i 500) r: (max zz) d: (count (distinct s))}) 't)
(xasc (select {from: D by: u where: (== k 3) r: (max (deltas i)) d: (count (distinct s))}) 'u) -- (xasc (select {from: (update {from: D zz: (deltas i)}) by: u where: (== k 3) r: (max zz) d: (count (distinct s))}) 'u)
(xasc (select {from: D by: {g: (% i 7)} r: (prior - i) d: (count (distinct s))}) 'g) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: {g: (% i 7)} r: zz d: (count (distinct s))}) 'g)
(xasc (select {from: D by: k where: (> i 500) r: (prior - i) u1: 1}) 'k) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: k where: (> i 500) r: zz u1: 1}) 'k)
(xasc (select {from: D by: [k s] where: (== k 3) r: (prior - i) u1: 1}) ['k 's]) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: [k s] where: (== k 3) r: zz u1: 1}) ['k 's])
(xasc (select {from: D by: t r: (sum (prior - i)) u1: 1}) 't) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: t r: (sum zz) u1: 1}) 't)
(xasc (select {from: D by: u where: (> i 500) r: (sum (prior - i)) u1: 1}) 'u) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: u where: (> i 500) r: (sum zz) u1: 1}) 'u)
(xasc (select {from: D by: {g: (% i 7)} where: (== k 3) r: (sum (prior - i)) u1: 1}) 'g) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: {g: (% i 7)} where: (== k 3) r: (sum zz) u1: 1}) 'g)
(xasc (select {from: D by: k r: (last (prior - i))}) 'k) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: k r: (last zz)}) 'k)
(xasc (select {from: D by: [k s] where: (> i 500) r: (last (prior - i))}) ['k 's]) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: [k s] where: (> i 500) r: (last zz)}) ['k 's])
(xasc (select {from: D by: t where: (== k 3) r: (last (prior - i))}) 't) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: t where: (== k 3) r: (last zz)}) 't)
(xasc (select {from: D by: u r: (max (prior - i))}) 'u) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: u r: (max zz)}) 'u)
(xasc (select {from: D by: {g: (% i 7)} where: (> i 500) r: (max (prior - i))}) 'g) -- (xasc (select {from: (update {from: D zz: (prior - i)}) by: {g: (% i 7)} where: (> i 500) r: (max zz)}) 'g)
