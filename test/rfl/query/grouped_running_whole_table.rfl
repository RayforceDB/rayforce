(Z (select {from: T by: k z: (sum (hd2 i))})) -- [10 21]
(Z (select {from: T by: k z: (sum (prior - i))})) -- [10 21]
(Z (select {from: T by: k z: (sum (lp i))})) -- [10 21]
(Z (select {from: T by: k z: (sum (msum 2 i))})) -- [31 63]
(Z (select {from: T by: k z: (sum (hm i))})) -- [31 63]
(Z (select {from: T by: k z: (sum (lag i))})) -- [10 21]
(Z (select {from: T by: k z: (sum (hl i))})) -- [10 21]
(Z (select {from: T by: k z: (last (sums i))})) -- [31 63]
