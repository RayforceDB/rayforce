(Z (select {from: S by: k where: (== k 1) z: (lp i)})) -- (list [1 4 16])
(Z (select {from: S by: k where: (== k 1) z: (msum 2 i)})) -- (list [3 12 48])
(Z (select {from: S by: k where: (== k 1) z: (hm i)})) -- (list [3 12 48])
