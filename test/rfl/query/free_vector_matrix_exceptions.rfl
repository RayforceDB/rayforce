;; @also-unfused
;; The free-vector rule (#1462) at its exceptions: a one-element vector is
;; spread as an atom, and over an empty table nothing of a vector is read,
;; whatever the lengths.  Each answer is the one the rule leaves unchanged
;; from before it (an error by its code).  One case per line.
(set err (fn [e] (at e (quote code))))
(set t (table [g v] (list (take 'a 0) (til 0))))
(set W [7])
