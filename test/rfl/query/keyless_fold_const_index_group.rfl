;; @also-unfused
;; #1429, decided by the owner on 2026-11-24: fold over a column and at of a
;; column, whatever the index, see the group's rows under by:, and keyless
;; the rows a where: keeps, as every other expression of an output does.
;; Each answer is checked against the same expression evaluated outside the
;; query on the group's own columns (or the kept rows'), with first and last
;; skipping nulls as a query's do (#1368).  These are the cases #1401 pinned
;; to its parent's answers while the question was open; they now follow the
;; rule: keyless and under by:, with and without where:, alone and beside a
;; declined output.
(set T (table [k c d s v] (list [0 0 0 0] [1 5 6 2] [2024.01.01 2024.01.02 0Nd 2024.01.04] [aa bb cc aa] [10 20 30 40])))
(set G (table [g c d s v] (list [a a b b] [1 5 6 2] [2024.01.01 2024.01.02 0Nd 2024.01.04] [aa bb cc aa] [10 20 30 40])))
(set ct (fn [w c] (if w (at (select {from: T where: (> v 15)}) c) (at T c))))
(set cg (fn [w k c] (at (select {from: G where: (and (== g k) (or (not w) (> v 15)))}) c)))
(set fq (fn [x] (try (first (at x (where (not (nil? x))))) (fn [q] (first x)))))
(set lq (fn [x] (try (last (at x (where (not (nil? x))))) (fn [q] (last x)))))
(at (select {from: T s: (sum (at c [3 2 1 0]))}) 's) -- (enlist ((fn [c d s v] (sum (at c [3 2 1 0]))) (ct false (quote c)) (ct false (quote d)) (ct false (quote s)) (ct false (quote v))))
(at (select {from: T by: k s: (sum (at c [3 2 1 0]))}) 's) -- (enlist ((fn [c d s v] (sum (at c [3 2 1 0]))) (ct false (quote c)) (ct false (quote d)) (ct false (quote s)) (ct false (quote v))))
(at (select {from: G by: g s: (sum (at c [3 2 1 0]))}) 's) -- (raze (list ((fn [c d s v] (sum (at c [3 2 1 0]))) (cg false (quote a) (quote c)) (cg false (quote a) (quote d)) (cg false (quote a) (quote s)) (cg false (quote a) (quote v))) ((fn [c d s v] (sum (at c [3 2 1 0]))) (cg false (quote b) (quote c)) (cg false (quote b) (quote d)) (cg false (quote b) (quote s)) (cg false (quote b) (quote v)))))
(at (select {from: T s: (sum (at c [3 2 1 0])) where: (> v 15)}) 's) -- (enlist ((fn [c d s v] (sum (at c [3 2 1 0]))) (ct true (quote c)) (ct true (quote d)) (ct true (quote s)) (ct true (quote v))))
(at (select {from: T by: k s: (sum (at c [3 2 1 0])) where: (> v 15)}) 's) -- (enlist ((fn [c d s v] (sum (at c [3 2 1 0]))) (ct true (quote c)) (ct true (quote d)) (ct true (quote s)) (ct true (quote v))))
(at (select {from: G by: g s: (sum (at c [3 2 1 0])) where: (> v 15)}) 's) -- (raze (list ((fn [c d s v] (sum (at c [3 2 1 0]))) (cg true (quote a) (quote c)) (cg true (quote a) (quote d)) (cg true (quote a) (quote s)) (cg true (quote a) (quote v))) ((fn [c d s v] (sum (at c [3 2 1 0]))) (cg true (quote b) (quote c)) (cg true (quote b) (quote d)) (cg true (quote b) (quote s)) (cg true (quote b) (quote v)))))
