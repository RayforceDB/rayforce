;; @also-unfused
;; The shapes the planner and the query's per-row pass leave to the
;; evaluator reach its `if` with a condition over the query's rows.  That `if`
;; chooses per row for a boolean-vector condition, so each of them answers
;; per row (#1610, #1611, #1617, #1629; it raised `nyi` for a condition that
;; differs between the rows while the evaluator's `if` tested it whole,
;; #1630).  Both arms are evaluated.  A vector not derived from the rows
;; takes the same per-row choice, and a scalar condition is unchanged.

(set n 20)
(set T (table [a act i g] (list (at ['x 'y 'z 'w] (% (til n) 4)) (at ['New 'Accepted 'Rejected] (% (til n) 3)) (til n) (% (til n) 2))))
(set U (table [k v] (list ['x 'y] [1 2])))
(set cnt 0)
(set bump (fn [v] (do (set cnt (+ cnt 1)) v)))
(set H (fn [v w] (let k 1) (== v (if (== w 'New) 'x 'y))))
(set mk (fn [s] (fn [v w] (== v (if (== w 'New) s 'y)))))
(set C (mk 'x))

;; ── 1. the shapes the per-row pass does not cover answer per row ──
;; the rows where a column equals the arm its row takes, from plain masks
(set arm (at ['x 'y 'y] (% (til n) 3)))
(set hit (== (at T 'a) arm))
(set rows (at (at T 'i) (where hit)))
rows -- [0 1 5 12 13 17]
;; a side effect in the predicate (#1610)
(set cnt 0)
(at (select {from: T where: (== a (if (== act 'New) (bump (as 'sym "x")) 'y))}) 'i) -- rows
(at (select {from: T where: (do (set cnt 0) (== a (if (== act 'New) (as 'sym "x") 'y)))}) 'i) -- rows
;; a `try` whose handler has an effect: nothing raises, so it does not run
(set cnt 0)
(at (select {from: T where: (try (== a (if (== act 'New) 'x 'y)) (fn [e] (do (set cnt (+ cnt 1)) true)))}) 'i) -- rows
cnt -- 0
;; an `if` in a helper the planner does not inline, run as bytecode (#1611)
(at (select {from: T where: (H a act)}) 'i) -- rows
(at (select {from: T where: (C a act)}) 'i) -- rows
(at (select {from: T where: (and (>= i 0) (H a act))}) 'i) -- rows
;; a `let` read by a later argument of its `do` raises before the `if` (#1612)
(select {from: T where: (do (let k (if (== act 'New) 'x 'y)) (== a k))}) !- schema
;; under by:, a `let` name crossing aggregates: per group as written (#1617);
;; the later aggregate reads the rebound name, the arm each row takes
(set Tr (update {from: T h: hit r: arm}))
(at (select {m: (+ (sum (== a (let a (if (== act 'New) 'x 'y)))) (sum (== a 'x))) from: T by: g}) 'm) -- (at (select {m: (+ (sum h) (sum (== r 'x))) from: Tr by: g}) 'm)
;; a nested query in the predicate (#1629)
(at (select {from: T where: (== a (if (== act 'New) (first (at (select {k: k from: U}) 'k)) 'y))}) 'i) -- rows
(set nq (== (in (at T 'a) (at U 'k)) hit))
(at (select {from: T where: (== (in a (at (select {k: k from: U}) 'k)) (== a (if (== act 'New) (as 'sym "x") 'y)))}) 'i) -- (at (at T 'i) (where nq))
(at (select {m: (sum (== (in a (at (select {k: k from: U}) 'k)) (== a (if (== act 'New) (as 'sym "x") 'y)))) from: T by: g}) 'm) -- (at (select {m: (sum q) from: (update {from: T q: nq}) by: g}) 'm)
;; both arms are evaluated: the effect in an arm ran, once for the column
(set cnt 0)
(at (select {from: T where: (== a (if (== act 'New) (bump (as 'sym "x")) 'y))}) 'i) -- rows
cnt -- 1
;; a `try` around the query sees no error
(at (try (select {from: T where: (H a act)}) (fn [e] e)) 'i) -- rows

;; ── 2. what the per-row pass and the planner cover still answers per row ──
(at (select {from: T where: (and (>= i 0) (== a (if (== act 'New) (as 'sym "x") 'y)))}) 'i) -- [0 1 5 12 13 17]
(at (select {from: T where: (try (== a (if (== act 'New) 'x 'y)) (fn [e] false))}) 'i) -- [0 1 5 12 13 17]
(at (select {m: (H a act) from: T}) 'm) -- [true true false false false true false false false false false false true true false false false true false false]
(at (select {m: (sum (== a (if (== act 'New) (bump 'x) 'y))) from: T by: g}) 'm) -- [2 4]
;; an opaque by: key whose whole-column run raises is run row by row
(at (select {c: (count i) from: T by: (H a act)}) 'c) -- [6 14]

;; ── 3. a condition the same on every row takes that row's arm ──
;; True on every row: the first arm, as before.  False on every row: the
;; fallback; tested whole, the non-empty vector was true and every row took
;; the first arm.
(at (select {from: T where: (== a (if (>= i 0) (bump (as 'sym "x")) 'y))}) 'i) -- [0 4 8 12 16]
(at (select {from: T where: (== a (if (< i 0) (bump (as 'sym "x")) 'y))}) 'i) -- [1 5 9 13 17]
;; each group's own condition: by the key the condition follows
(at (select {m: (sum (== a (if (== act 'New) (bump (as 'sym "x")) 'y))) from: T by: act}) 'm) -- [2 2 2]
;; a one-row table
(set H1 (fn [v w] (let k 1) (== v (if (>= w 0) 'x 'y))))
(set H0 (fn [v w] (let k 1) (== v (if (< w 0) 'x 'y))))
(at (select {from: T where: (H1 a i)}) 'i) -- [0 4 8 12 16]
(at (select {from: T where: (H0 a i)}) 'i) -- [1 5 9 13 17]
(set T1 (table [a act i] (list ['x] ['New] [0])))
(at (select {from: T1 where: (== a (if (== act 'New) (bump (as 'sym "x")) 'y))}) 'i) -- [0]

;; ── 4. a vector not derived from the rows, and no query ──
;; a global vector of the table's length chooses per row too: rows below 10
;; take 'y, the others 'x, and five rows match
(set Gv (> (til n) 9))
(count (select {from: T where: (== a (if Gv (bump (as 'sym "x")) 'y))})) -- 5
;; outside a query a boolean vector condition chooses per row (#1602)
(if (> (til 5) 2) 1 2) -- [2 2 2 1 1]
((fn [v] (if (> v 2) 1 2)) (til 5)) -- [2 2 2 1 1]
