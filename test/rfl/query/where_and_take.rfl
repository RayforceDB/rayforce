;; @requires: posix
;; `where: (and …) take: K` that the fused take declines: the optimizer
;; splits the `and` into chained filters, the inner ones leave a selection,
;; and an outer term whose verdicts survive a row subset narrows it as a
;; chained filter does before the first K rows are gathered.  Every form
;; answers what the unsplit `(== (and …) true)` does, null flags included,
;; flat and parted.
;; 3000 rows span three morsels; the parted copies, generation 0 and 2,
;; have three ragged partitions.
(.sys.exec "rm -rf /tmp/rfl_wat")
(set N 3000)
(set BS ['B0 'B1 'B2 'B3 'B4 'B5 'B6 'B7 'B8 'B9])
(set W (table [x a b n] (list (til N) (at ['A0 'A1] (% (til N) 2)) (at BS (% (* (til N) 7) 10)) (til N))))
(set W (update {from: W n: (if (== 0 (% x 3)) 0Nl n)}))
(.db.splayed.set "/tmp/rfl_wat/2024.01.01/t/" (select {from: W where: (< x 1500)}))
(.db.splayed.set "/tmp/rfl_wat/2024.01.02/t/" (select {from: W where: (and (>= x 1500) (< x 2200))}))
(.db.splayed.set "/tmp/rfl_wat/2024.01.03/t/" (select {from: W where: (>= x 2200)}))
(set PW (.db.parted.get "/tmp/rfl_wat/" 't))
(count PW) -- 3000

;; two terms past the fused take's cap of 8192
(set R (select {from: W where: (== (and (== a 'A1) (!= b 'B7)) true) take: 10000}))
(count R) -- 1200
(set S (select {from: W where: (and (== a 'A1) (!= b 'B7)) take: 10000}))
(at S 'x) -- (at R 'x)
(sum (nil? (at S 'n))) -- (sum (nil? (at R 'n)))
(sum (nil? (at S 'n))) -- 400
(at (select {from: W where: (and (== a 'A1) (!= b 'B7)) take: 3}) 'x) -- [3 5 7]

;; an `or` inside keeps the split at any K; K crosses a morsel
(set R (select {from: W where: (== (and (or (== a 'A1) (== b 'B4)) (!= b 'B8)) true) take: 1200}))
(set S (select {from: W where: (and (or (== a 'A1) (== b 'B4)) (!= b 'B8)) take: 1200}))
(count S) -- 1200
(sum (as 'I64 (== (at S 'x) (at R 'x)))) -- 1200
(sum (as 'I64 (== (nil? (at S 'n)) (nil? (at R 'n))))) -- 1200
(at S 'b) -- (at R 'b)

;; the outer term reads a column with nulls
(set R (select {from: W where: (== (and (== a 'A0) (> n 100)) true) take: 10000}))
(set S (select {from: W where: (and (== a 'A0) (> n 100)) take: 10000}))
(at S 'x) -- (at R 'x)
(sum (nil? (at S 'n))) -- 0

;; an outer term that reads other rows (a running sum, an aggregate) sees
;; the whole table, as in the unsplit form: one `where:` is not a sequence
;; of selects (#904)
(set R (select {from: W where: (== (and (== a 'A1) (< (sums x) 200)) true) take: 100}))
(set S (select {from: W where: (and (== a 'A1) (< (sums x) 200)) take: 100}))
(count S) -- 10
(at S 'x) -- (at R 'x)
(at (select {from: W where: (and (== a 'A1) (> x (avg x))) take: 3}) 'x) -- (at (select {from: W where: (== (and (== a 'A1) (> x (avg x))) true) take: 3}) 'x)

;; `like` and `in` outer terms
(set R (select {from: W where: (== (and (== a 'A1) (like b "B[1-3]")) true) take: 10000}))
(set S (select {from: W where: (and (== a 'A1) (like b "B[1-3]")) take: 10000}))
(count S) -- (count R)
(at S 'x) -- (at R 'x)
(set R (select {from: W where: (== (and (== a 'A1) (in b ['B1 'B5])) true) take: 10000}))
(set S (select {from: W where: (and (== a 'A1) (in b ['B1 'B5])) take: 10000}))
(count S) -- (count R)
(at S 'x) -- (at R 'x)

;; no row passes the inner terms, or the outer one; take 0
(count (select {from: W where: (and (or (== a 'A2) (== b 'B4)) (== b 'B5)) take: 5})) -- 0
(count (select {from: W where: (and (or (== a 'A1) (== b 'B4)) (== x -1)) take: 5})) -- 0
(count (select {from: W where: (and (or (== a 'A1) (== b 'B4)) (!= b 'B8)) take: 0})) -- 0

;; parted: every `and` takes the split path
(set R (select {from: PW where: (== (and (== a 'A1) (!= b 'B7)) true) take: 1500}))
(set S (select {from: PW where: (and (== a 'A1) (!= b 'B7)) take: 1500}))
(count S) -- 1200
(at S 'x) -- (at R 'x)
(at S 'b) -- (at R 'b)
(sum (nil? (at S 'n))) -- 400
(set S (select {from: PW where: (and (and (== a 'A1) (!= b 'B7)) (!= b 'B8)) take: 600}))
(at S 'x) -- (take (at (select {from: W where: (and (== a 'A1) (!= b 'B7) (!= b 'B8))}) 'x) 600)
(set S (select {from: PW where: (and (or (== a 'A1) (== b 'B4)) (!= b 'B8)) take: 1200}))
(sum (as 'I64 (== (at S 'x) (take (at (select {from: W where: (and (or (== a 'A1) (== b 'B4)) (!= b 'B8))}) 'x) 1200)))) -- 1200

;; parted, generation 2: the outer term reads compressed columns
(.db.splayed.set "/tmp/rfl_wat/g2/2024.01.01/t/" (select {from: W where: (< x 1500)}) "/tmp/rfl_wat/g2/.sym" {compress: true})
(.db.splayed.set "/tmp/rfl_wat/g2/2024.01.02/t/" (select {from: W where: (and (>= x 1500) (< x 2200))}) "/tmp/rfl_wat/g2/.sym" {compress: true})
(.db.splayed.set "/tmp/rfl_wat/g2/2024.01.03/t/" (select {from: W where: (>= x 2200)}) "/tmp/rfl_wat/g2/.sym" {compress: true})
(set P2 (.db.parted.get "/tmp/rfl_wat/g2/" 't))
(set R (select {from: P2 where: (== (and (== a 'A1) (!= b 'B7)) true) take: 1500}))
(set S (select {from: P2 where: (and (== a 'A1) (!= b 'B7)) take: 1500}))
(count S) -- 1200
(at S 'x) -- (at R 'x)
(sum (nil? (at S 'n))) -- 400
(set R (select {from: P2 where: (== (and (or (== a 'A1) (== b 'B4)) (> n 100)) true) take: 1200}))
(set S (select {from: P2 where: (and (or (== a 'A1) (== b 'B4)) (> n 100)) take: 1200}))
(count S) -- (count R)
(at S 'x) -- (at R 'x)
(at S 'b) -- (at R 'b)
(at (select {from: P2 where: (and (== a 'A1) (!= b 'B7)) take: 3}) 'x) -- [3 5 7]
(.sys.exec "rm -rf /tmp/rfl_wat")
