;; #760 — an F32 group key read through the shared column reader
;; (read_col_i64) fell to that reader's one-byte default arm: the parallel
;; group hash table hashed and stored one byte of each key, so a multi-core
;; group by an F32 key over more than a morsel of rows (65 536) emitted
;; garbage keys and split or merged groups — on a plain count, on a distinct
;; count beside the key, and for a composite key with an F32 member.  The
;; reader now decodes the 4-byte lane, with -0.0 canonicalised to +0.0 as the
;; F64 key readers do.
(set N 100000)
(set T (select {from: (table [p s x] (list (as 'F64 (% (til N) 10)) (take ['a 'b] N) (til N))) p: (as 'F32 p) s: s x: x}))
(set R (select {from: T by: p c: (count x) asc: p}))
(count R) -- 10
(at R 'p) -- (as 'F32 (til 10))
(at R 'c) -- (take [10000] 10)
(set Rd (select {from: T by: p n: (count (distinct x)) asc: p}))
(at Rd 'p) -- (as 'F32 (til 10))
(at Rd 'n) -- (take [10000] 10)
(set Rc (select {from: T by: [p s] c: (count x) n: (count (distinct x)) asc: [p s]}))
(count Rc) -- 10
(at Rc 'p) -- (as 'F32 (til 10))
(at Rc 's) -- (take ['a 'b] 10)
(at Rc 'c) -- (take [10000] 10)
(at Rc 'n) -- (take [10000] 10)
(at (select {from: T by: [s p] c: (count x) asc: [s p]}) 'p) -- (as 'F32 [0 2 4 6 8 1 3 5 7 9])
;; -0.0 and +0.0 are one group on the parallel path too, and a null key its own
(set Z (select {from: (table [z s x] (list (as 'F64 (% (til N) 4)) (take ['a 'b] N) (til N))) z: (as 'F32 (* (if (== z 1.0) -1.0 1.0) (if (< z 2.0) 0.0 z))) s: s x: x}))
(at (select {from: Z by: z c: (count x) asc: z}) 'c) -- [50000 25000 25000]
(at (select {from: Z by: [z s] c: (count x) n: (count (distinct x)) asc: [z s]}) 'n) -- [25000 25000 25000 25000]
(set Q (select {from: (table [z x] (list (as 'F64 (% (til N) 3)) (til N))) z: (as 'F32 (if (== z 0.0) 0Nf z)) x: x}))
(at (select {from: Q by: z c: (count x) asc: z}) 'c) -- [33334 33333 33333]
;; #765 — more than 256 distinct F32 keys: one byte per key capped the parallel
;; result at 256 groups.  1000 keys j/8 (exact in F32), 200 rows each.
(set NF 200000)
(set TF (select {from: (table [i] (list (til NF))) k: (as 'F32 (/ (as 'F64 (% i 1000)) 8.0)) g: (% i 3) v: i}))
(set RF (select {from: TF by: k c: (count v) s: (sum v) asc: k}))
(count RF) -- 1000
(all (== (at RF 'k) (/ (as 'F64 (til 1000)) 8.0))) -- true
(at RF 'c) -- (take [200] 1000)
(at RF 's) -- (+ 19900000 (* 200 (til 1000)))
(set RC (select {from: TF by: [k g] c: (count v) asc: [k g]}))
(count RC) -- 3000
(sum (at RC 'c)) -- 200000
(count (select {from: (select {from: (table [i] (list (til 70000))) k: (as 'F32 (/ (as 'F64 i) 7.0)) v: i}) by: k c: (count v)})) -- 70000
;; The group by above only reaches read_col_i64 on a 2..8-worker pool (larger
;; pools admit float keys to the v2 engine, which reads F32 natively), so on a
;; wide pool those checks pass without the F32 arm.  Joins hash and compare
;; their keys through the same reader on any pool size: one byte per key made
;; 1000 distinct F32 keys collide and the join fanned out to ~40M rows.
(set JF (inner-join [k] TF RF))
(count JF) -- 200000
(sum (at JF 'c)) -- 40000000
(count (left-join [k] TF RF)) -- 200000
(count (inner-join [k g] TF RC)) -- 200000
