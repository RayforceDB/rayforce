(try (at (select {s: (sum (as 'F64 W)) from: t where: (> v 100)}) 's) err) -- (try (at (select {s: (sum (as 'F64 w)) from: tw where: (> v 100)}) 's) err)
(try (at (select {s: (sum (as 'F64 W)) from: t by: g where: (> v 100)}) 's) err) -- (try (at (select {s: (sum (as 'F64 w)) from: tw by: g where: (> v 100)}) 's) err)
(try (at (update {s: (sum (as 'F64 W)) from: t }) 's) err) -- (try (at (update {s: (sum (as 'F64 w)) from: tw }) 's) err)
