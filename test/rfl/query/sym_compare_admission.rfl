;; Non-null SYM/numeric equality is not a comparison of internal IDs.
(set T768 (table [s b k n r] (list (take ['a 'b 'c] 9) (take [true false false] 9) (til 9) (as 'sym (take ["" "a" ""] 9)) (take ["a" "b" "c"] 9))))
(count (select {from: T768 where: (== s 1)})) !- type
(select {from: T768 where: (== 1 s)}) !- type
(select {from: T768 where: (!= s 1)}) !- type
(count (select {from: T768 where: (!= 1 s)})) !- type
(select {from: T768 where: (== s b)}) !- type
(select {from: T768 where: (!= b s)}) !- type
(count (select {from: T768 where: (== s 'b)})) !- type
(select {from: T768 where: (!= 'k s)}) !- type
(select {from: T768 where: (== s true) take: 2}) !- type
(select {from: T768 where: (and b (== s 1))}) !- type
(select {from: T768 where: (or b (== s 1))}) !- type
(select {from: T768 where: (== n 1)}) !- type
(at (select {from: T768 where: (== s 'a)}) 'k) -- [0 3 6]
(at (select {from: T768 where: (== s "a")}) 'k) -- [0 3 6]
(at (select {from: T768 where: (== r "a")}) 'k) -- [0 3 6]
(count (select {from: T768 where: (== s 's)})) -- 9
(count (select {from: T768 where: (== s 'zz)})) -- 0
(at (select {from: T768 where: (== n 0Nl)}) 'k) -- [0 2 3 5 6 8]
(at (select {from: T768 where: (!= 0Nl n)}) 'k) -- [1 4 7]
(select {from: T768 where: (== (quote a) 1)}) !- type
