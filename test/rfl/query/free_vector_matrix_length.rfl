;; The free-vector rule (#1462): a vector of another length than the
;; table is a length error in every aggregate, on every route.  One case per line.
(set t (table [g v] (list [a a b b b c c c c c] (til 10))))
(set W [1 2 3])
(select {s: (sum W) from: t }) !- length
(select {s: (sum W) from: t where: (> v 5)}) !- length
(select {s: (sum W) from: t by: g}) !- length
(update {s: (sum W) from: t }) !- length
(update {s: (sum W) from: t where: (> v 5)}) !- length
(update {s: (sum W) from: t by: g}) !- length
(select {s: (count W) from: t }) !- length
(select {s: (count W) from: t where: (> v 5)}) !- length
(select {s: (count W) from: t by: g}) !- length
(update {s: (count W) from: t }) !- length
(update {s: (count W) from: t where: (> v 5)}) !- length
(update {s: (count W) from: t by: g}) !- length
(select {s: (avg W) from: t }) !- length
(select {s: (avg W) from: t where: (> v 5)}) !- length
(select {s: (avg W) from: t by: g}) !- length
(update {s: (avg W) from: t }) !- length
(update {s: (avg W) from: t where: (> v 5)}) !- length
(update {s: (avg W) from: t by: g}) !- length
(select {s: (min W) from: t }) !- length
