(select {s: (wsum W v) from: t by: g}) !- length
(update {s: (wsum W v) from: t }) !- length
(update {s: (wsum W v) from: t where: (> v 5)}) !- length
(update {s: (wsum W v) from: t by: g}) !- length
(select {s: (pearson_corr W v) from: t }) !- length
(select {s: (pearson_corr W v) from: t where: (> v 5)}) !- length
(select {s: (pearson_corr W v) from: t by: g}) !- length
(update {s: (pearson_corr W v) from: t }) !- length
(update {s: (pearson_corr W v) from: t where: (> v 5)}) !- length
(update {s: (pearson_corr W v) from: t by: g}) !- length
(select {s: (quantile W 0.5) from: t }) !- length
(select {s: (quantile W 0.5) from: t where: (> v 5)}) !- length
(select {s: (quantile W 0.5) from: t by: g}) !- length
(update {s: (quantile W 0.5) from: t }) !- length
