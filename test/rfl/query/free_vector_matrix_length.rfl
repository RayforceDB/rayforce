(select {s: (mode W) from: t by: g}) !- length
(update {s: (mode W) from: t }) !- length
(update {s: (mode W) from: t where: (> v 5)}) !- length
(update {s: (mode W) from: t by: g}) !- length
(select {s: (count (distinct W)) from: t }) !- length
