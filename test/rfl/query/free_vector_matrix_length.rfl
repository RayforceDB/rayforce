(update {s: (min W) from: t by: g}) !- length
(select {s: (max W) from: t }) !- length
(select {s: (max W) from: t where: (> v 5)}) !- length
(select {s: (max W) from: t by: g}) !- length
(update {s: (max W) from: t }) !- length
(update {s: (max W) from: t where: (> v 5)}) !- length
(update {s: (max W) from: t by: g}) !- length
(select {s: (first W) from: t }) !- length
(select {s: (first W) from: t where: (> v 5)}) !- length
(select {s: (first W) from: t by: g}) !- length
(update {s: (first W) from: t }) !- length
(update {s: (first W) from: t where: (> v 5)}) !- length
(update {s: (first W) from: t by: g}) !- length
