(select {s: (med W) from: t where: (> v 5)}) !- length
(select {s: (med W) from: t by: g}) !- length
(update {s: (med W) from: t }) !- length
(update {s: (med W) from: t where: (> v 5)}) !- length
(update {s: (med W) from: t by: g}) !- length
(select {s: (dev W) from: t }) !- length
(select {s: (dev W) from: t where: (> v 5)}) !- length
(select {s: (dev W) from: t by: g}) !- length
(update {s: (dev W) from: t }) !- length
