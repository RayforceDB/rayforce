(update {s: (stddev W) from: t by: g}) !- length
(select {s: (dev_pop W) from: t }) !- length
(select {s: (dev_pop W) from: t where: (> v 5)}) !- length
(select {s: (dev_pop W) from: t by: g}) !- length
