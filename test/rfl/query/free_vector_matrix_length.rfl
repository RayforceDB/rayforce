(select {s: (scov v W) from: t where: (> v 5)}) !- length
(select {s: (scov v W) from: t by: g}) !- length
(update {s: (scov v W) from: t }) !- length
(update {s: (scov v W) from: t where: (> v 5)}) !- length
(update {s: (scov v W) from: t by: g}) !- length
(select {s: (wavg v W) from: t }) !- length
(select {s: (wavg v W) from: t where: (> v 5)}) !- length
(select {s: (wavg v W) from: t by: g}) !- length
(update {s: (wavg v W) from: t }) !- length
(update {s: (wavg v W) from: t where: (> v 5)}) !- length
(update {s: (wavg v W) from: t by: g}) !- length
