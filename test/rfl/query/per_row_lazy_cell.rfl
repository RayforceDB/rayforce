;; #1680: a helper run per row whose result is a lazy chain (reverse,
;; distinct, asc, desc return one) gave cells that held the chain.  The
;; first read of a cell materialized it; every later read of that cell was
;; `domain: lazy handle already materialized`, so a column printed once and
;; then read again (or compared, as this runner does) gave errors.  A cell
;; now holds the value.
(set T3 (table [g i b] (list [0 0 1 1 1 2 2 2] (til 8) [5 2 7 2 9 1 4 6])))
(set Hq (fn [x] (let y [3 1 2]) (reverse y)))
(set Hd (fn [x] (let y [3 1 3 2]) (distinct y)))
(set Ha (fn [x] (let y [3 1 2]) (asc y)))
(set Hs (fn [x] (let y [3 1 2]) (desc y)))
(at (select {v: (Hq b) from: T3}) 'v) -- (list [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3])
(at (select {v: (Hd b) from: T3}) 'v) -- (take (enlist [3 1 2]) 8)
(at (select {v: (Ha b) from: T3}) 'v) -- (take (enlist [1 2 3]) 8)
(at (select {v: (Hs b) from: T3}) 'v) -- (take (enlist [3 2 1]) 8)
(at (select {v: (Hq b) from: T3 where: (> i 3)}) 'v) -- (take (enlist [2 1 3]) 4)
(at (select {v: (Hq b) w: (Hq b) from: T3}) 'w) -- (take (enlist [2 1 3]) 8)
(at (select {v: ((fn [x] (let y [3 1 2]) (reverse y)) b) from: T3}) 'v) -- (take (enlist [2 1 3]) 8)
;; grouped, as before
(at (select {v: (Hq b) from: T3 by: g}) 'v) -- (take (enlist [2 1 3]) 3)
;; a column read more than once gives the same values each time
(set R (at (select {v: (Hq b) from: T3}) 'v))
(format "%" R) -- "(list [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3])"
(format "%" R) -- "(list [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3] [2 1 3])"
(first R) -- [2 1 3]
(sum (raze R)) -- 48
