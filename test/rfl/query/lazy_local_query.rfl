;; A query reading a local that holds a lazy value (a parameter holding
;; (distinct x)) answered as if the value were one item (#1868): the
;; planner took the handle as a scalar, since ray_is_atom is true of every
;; type from RAY_LAMBDA up.  The planner now reads the local's concrete
;; value, and each query answers as it does over the same value given
;; concretely, the free-vector rule's errors included.
(set T (table [a b] (list [1 2 1 3] [10 20 30 40])))
(set E1868 (fn [f x] (try (f x) (fn [e] (at e 'code)))))
(set q1 (fn [v] (count (select {from: T where: (> a (count v))}))))
(set q2 (fn [v] (at (update {from: T b: (+ b 1) where: (> a (count v))}) 'b)))
(set q3 (fn [v] (at (select {from: T n: (+ a (count v))}) 'n)))
(set q4 (fn [v] (at (select {from: T s: (sum v)}) 's)))
(set q5 (fn [v] (count (do (select {from: T where: (> a (count v))}) (select {from: T where: (> a (count v))})))))
(set q6 (fn [v] (count (select {from: T where: (in a v)}))))
(set q7 (fn [v] (at (select {from: T n: (count v) by: a}) 'n)))
(q1 (distinct [1 2 1])) -- 1
(q1 (distinct [1 2 1])) -- (q1 [1 2])
(q2 (distinct [1 2 1])) -- [10 20 30 41]
(q2 (distinct [1 2 1])) -- (q2 [1 2])
(E1868 q3 (distinct [1 2 1])) -- (E1868 q3 [1 2])
(E1868 q4 (distinct [1 2 1])) -- (E1868 q4 [1 2])
(q5 (distinct [1 2 1])) -- 1
(q5 (distinct [1 2 1])) -- (q5 [1 2])
(q6 (distinct [1 2 1])) -- (q6 [1 2])
(E1868 q7 (distinct [1 2 1])) -- (E1868 q7 [1 2])
;; asc and reverse keep their order through the query
(at ((fn [v] (select {from: T n: (at v 0)})) (asc [3 1 2])) 'n) -- [1 1 1 1]
(at ((fn [v] (select {from: T n: (at v 0)})) (reverse [3 1 2])) 'n) -- [2 2 2 2]
;; a value that fails to materialize: a read raises the value's own error,
;; an operand the query skips raises nothing, and a read after a caught
;; failure raises the same error again
(set bad1868 (fn [] (sum (distinct ['a 'b]))))
(set own1868 (try ((fn [v] (count v)) (bad1868)) (fn [e] (at e 'msg))))
(try ((fn [v] (count (select {from: T where: (> a (count v))}))) (bad1868)) (fn [e] (at e 'msg))) -- own1868
((fn [v] (count (select {from: T where: (and false (> (count v) 0))}))) (bad1868)) -- 0
(try ((fn [v] (do (try (select {from: T where: (> a (count v))}) 0) (count v))) (bad1868)) (fn [e] (at e 'msg))) -- own1868

;; the planner's classifiers read a local's settled value whichever lookup
;; comes first: a lazy local answers as its concrete value over splayed and
;; parted sources and a nested select too
(.sys.exec "rm -rf /tmp/rfl_lazy_local_query")
(.db.splayed.set "/tmp/rfl_lazy_local_query/s/t/" (table [k a b] (list [0 0 1 1] [1 2 1 3] [10 20 30 40])))
(set SP1868 (.db.splayed.get "/tmp/rfl_lazy_local_query/s/t/"))
(.db.splayed.set "/tmp/rfl_lazy_local_query/p/2024.01.01/t/" (table [k a b] (list [0 0] [1 2] [10 20])))
(.db.splayed.set "/tmp/rfl_lazy_local_query/p/2024.01.02/t/" (table [k a b] (list [1 1] [1 3] [30 40])))
(set PT1868 (.db.parted.get "/tmp/rfl_lazy_local_query/p/" 't))
(set E2 (fn [f] (list (try (f (distinct [1 2 1]) (distinct [5 6 7 8 5])) (fn [e] (at e 'code))) (try (f [1 2] [5 6 7 8]) (fn [e] (at e 'code))))))
(set same1868 (fn [f] (do (set r (E2 f)) (identical (at r 0) (at r 1)))))
(same1868 (fn [v w] (count (select {from: SP1868 where: (> a (count v))})))) -- true
(same1868 (fn [v w] (at (select {from: SP1868 n: (+ a w)}) 'n))) -- true
(same1868 (fn [v w] (at (select {from: SP1868 n: (+ (sum a) (first v)) by: k}) 'n))) -- true
(same1868 (fn [v w] (count (select {from: PT1868 where: (in a v)})))) -- true
(same1868 (fn [v w] (at (select {from: PT1868 n: ((fn [x] (+ x (count v))) a) by: k}) 'n))) -- true
(same1868 (fn [v w] (at (select {from: PT1868 n: (* a (count v))}) 'n))) -- true
(same1868 (fn [v w] (at (select {from: (select {from: SP1868 where: (> b 0)}) n: (at w 0)}) 'n))) -- true
(same1868 (fn [v w] (count (select {from: (select {from: SP1868 where: (> b 0)}) c: (count a) by: {g: (> a (count v))}})))) -- true
(.sys.exec "rm -rf /tmp/rfl_lazy_local_query") -- 0

;; a grouped select's output that reads no column is evaluated once and
;; broadcast into every group: a lazy local there is its value, and one that
;; fails to materialize raises its error, as the query without by: does
;; (#1881; it answered a table whose cells raised when read)
(set TB1881 (table [k a] (list [0 0 1 1] [1 2 3 4])))
(set bad1881 (fn [] (sum (distinct ['a 'b]))))
(try ((fn [v] (select {n: v from: TB1881 by: k})) (bad1881)) (fn [e] (at e 'code))) -- 'type
(try ((fn [v] (select {n: v from: TB1881})) (bad1881)) (fn [e] (at e 'code))) -- 'type
(try ((fn [v] (select {n: (+ a v) from: TB1881 by: k})) (bad1881)) (fn [e] (at e 'code))) -- 'type
(try ((fn [v] (update {n: v from: TB1881 by: k})) (bad1881)) (fn [e] (at e 'code))) -- 'type
(at ((fn [v] (select {n: v from: TB1881 by: k})) (distinct [7 8 7])) 'n) -- (at ((fn [v] (select {n: v from: TB1881 by: k})) [7 8]) 'n)
(type (at (at ((fn [v] (select {n: v from: TB1881 by: k})) (distinct [7 8 7])) 'n) 0)) -- 'I64
