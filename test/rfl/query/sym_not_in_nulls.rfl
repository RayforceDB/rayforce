;; @requires: posix (splayed fixture cleanup via .sys.exec)
;; #739: null SYM rows must fail both in and not-in, whether the probe
;; uses the domain LUT or falls back after all literals miss the file domain.
(.sys.exec "rm -rf /tmp/rfl_sym_not_in_nulls") -- 0
(set T (table [s x] (list (as 'SYM (list "a" "" "b" "a" "" "c")) [1 0Nl 2 1 0Nl 3])))
(.db.splayed.set "/tmp/rfl_sym_not_in_nulls/" T)
(set U (.db.splayed.get "/tmp/rfl_sym_not_in_nulls/"))

;; Matched/mixed and wholly absent probes, scalar and vector forms.
(at (select {from: T where: (not-in s 'a)}) 'x) -- [2 3]
(at (select {from: U where: (not-in s 'a)}) 'x) -- [2 3]
(at (select {from: T where: (not-in s ['a 'zz])}) 'x) -- [2 3]
(at (select {from: U where: (not-in s ['a 'zz])}) 'x) -- [2 3]
(at (select {from: T where: (not-in s 'zz)}) 'x) -- [1 2 1 3]
(at (select {from: U where: (not-in s 'zz)}) 'x) -- [1 2 1 3]
(at (select {from: T where: (not-in s ['zz 'qq])}) 'x) -- [1 2 1 3]
(at (select {from: U where: (not-in s ['zz 'qq])}) 'x) -- [1 2 1 3]
(count (select {from: T where: (not-in s ['a 'zz])})) -- 2
(count (select {from: U where: (not-in s ['a 'zz])})) -- 2
(count (select {from: T where: (not-in x [1 9])})) -- 2
(count (select {from: U where: (not-in x [1 9])})) -- 2

;; Null set elements are ignored; empty/all-null sets still exclude null rows.
(set WithNull (as 'SYM (list "a" "" "zz")))
(set NullSet (as 'SYM (list "")))
(set EmptySet (as 'SYM (list)))
(at (select {from: T where: (not-in s WithNull)}) 'x) -- [2 3]
(at (select {from: U where: (not-in s WithNull)}) 'x) -- [2 3]
(at (select {from: T where: (not-in s NullSet)}) 'x) -- [1 2 1 3]
(at (select {from: U where: (not-in s NullSet)}) 'x) -- [1 2 1 3]
(at (select {from: T where: (not-in s EmptySet)}) 'x) -- [1 2 1 3]
(at (select {from: U where: (not-in s EmptySet)}) 'x) -- [1 2 1 3]

;; Projection checks the entire boolean output, including both null positions.
(at (select {v: (not-in s ['a 'zz]) from: T}) 'v) -- [false false true false false true]
(at (select {v: (not-in s ['a 'zz]) from: U}) 'v) -- [false false true false false true]
(at (select {v: (not-in s 'zz) from: T}) 'v) -- [true false true true false true]
(at (select {v: (not-in s 'zz) from: U}) 'v) -- [true false true true false true]

;; Positive membership must retain its existing null-matches-nothing behavior.
(at (select {from: T where: (in s WithNull)}) 'x) -- [1 1]
(at (select {from: U where: (in s WithNull)}) 'x) -- [1 1]
(count (select {from: T where: (in s NullSet)})) -- 0
(count (select {from: U where: (in s NullSet)})) -- 0
(.sys.exec "rm -rf /tmp/rfl_sym_not_in_nulls") -- 0
