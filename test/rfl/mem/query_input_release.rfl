;; query_input_release.rfl — a query over a table built for that one call
;; must give the table back.
;;
;; Every node the executor evaluates hands back an OWNED reference, the
;; constant table node included.  The window, sort and limit cases once
;; skipped the release when the input equalled the graph's table, taking it
;; for a borrowed reference — and a query's root is a constant node over that
;; very table, so one input table leaked per call.  Invisible while a global
;; kept the table alive; a whole table per call on a fresh one.
;;
;; Same method as the other probes in this directory: warm up, then two equal
;; windows of calls; the first may settle a slab or an arena, the second must
;; not move.  `bytes-allocated` is exact, so the bound is a few KB; the table
;; below is ~19 KB, so a single leaked call already fails it.
(set syms (as 'SYMBOL (map (fn [i] (format "inst%" i)) (til 700))))
(set mk (fn [p] (table [instrument rid v] (list (take syms 786) (as 'I64 (+ p (til 786))) (as 'I64 (til 786))))))
(set heapb (fn [] (at (.sys.mem) 'bytes-allocated)))
(set probe (fn [f warm reps] (do (map f (til warm)) (map f (til reps)) (set h0 (heapb)) (map f (til reps)) (< (- (heapb) h0) 4096))))

;; partitioned + ordered, trailing frame (the shape of the report)
(probe (fn [p] (count (window {from: (mk p) part: [instrument] order: [rid] frame: 2 funcs: {prev: (first v) n: (count v)}}))) 5 60) -- true
;; no part/order: the whole table is one partition
(probe (fn [p] (count (window {from: (mk p) funcs: {n: (count v)}}))) 5 60) -- true
;; running frame
(probe (fn [p] (count (window {from: (mk p) part: [instrument] order: [rid] frame: 'running funcs: {s: (sum v)}}))) 5 60) -- true
;; a where: on the window input (from: is materialised before the window)
(probe (fn [p] (count (window {from: (select {from: (mk p) where: (> rid 3)}) part: [instrument] order: [rid] funcs: {n: (count v)}}))) 5 60) -- true
;; the same guard sat under sort and limit: a sorted or limited select over
;; a table built for the call leaked it the same way
(probe (fn [p] (count (select {from: (mk p) asc: rid}))) 5 60) -- true
(probe (fn [p] (count (select {from: (mk p) desc: v take: 5}))) 5 60) -- true
(probe (fn [p] (count (select {from: (mk p) where: (> rid 3) take: 5}))) 5 60) -- true
(probe (fn [p] (count (select {from: (mk p) where: (> rid 3) asc: v}))) 5 60) -- true
(probe (fn [p] (count (select {from: (mk p) by: instrument s: (sum v) asc: s}))) 5 60) -- true
(probe (fn [p] (count (select {from: (mk p) by: instrument s: (sum v) desc: s take: 3}))) 5 60) -- true
;; a grouped select with a where: and no outputs: the fused filter keeps a
;; reference to its selection for the count(distinct) scatter, released at
;; the end of the select, which the no-output branch returns before.  One
;; selection per call, empty result included.
(set TW (table [x y] (list (% (til 100) 7) (til 100))))
(probe (fn [p] (count (select {by: x from: TW where: (> y 38)}))) 5 1000) -- true
(probe (fn [p] (count (select {by: (* x 2) from: TW where: (> y 38)}))) 5 1000) -- true
(probe (fn [p] (count (select {by: x from: TW where: (> y 1000)}))) 5 1000) -- true
;; a by-dict or a quoted key symbol is rewritten into an owned symbol vector,
;; released at the end of the select, which the no-output branch and the
;; eval-level grouping return before.  One vector per call.
(set TB (table [x y z s] (list (% (til 100) 7) (til 100) (% (til 100) 3) (as 'STR (% (til 100) 7)))))
(probe (fn [p] (count (select {by: {k: x} from: TB}))) 5 1000) -- true
(probe (fn [p] (count (select {by: 'x from: TB}))) 5 1000) -- true
(probe (fn [p] (count (select {by: 'x from: TB where: (> y 38)}))) 5 1000) -- true
(probe (fn [p] (count (select {by: {a: x b: z} from: TB}))) 5 1000) -- true
(probe (fn [p] (count (select {v: y by: {k: s} from: TB}))) 5 1000) -- true
;; the same selection on the error returns of a grouped select with a where:
;; (a rejected aggregate, a bad take:, a failing post-pass, a failing
;; count(distinct) scatter).  Each call is caught by try; the growth of a
;; bare caught raise is subtracted, so only the select's own is measured.
(set grow (fn [f warm reps] (do (map f (til warm)) (map f (til reps)) (set h0 (heapb)) (map f (til reps)) (- (heapb) h0))))
(set probe_caught (fn [f warm reps] (< (- (grow f warm reps) (grow (fn [p] (try (raise p) (fn [e] 0))) warm reps)) 4096)))
(set V100 (% (til 100) 5))
(probe_caught (fn [p] (try (select {t: (top y 0) by: x from: TB where: (> y 38)}) (fn [e] 0))) 5 1000) -- true
(probe_caught (fn [p] (try (select {s: (sum y) by: x from: TB where: (> y 38) take: "a"}) (fn [e] 0))) 5 1000) -- true
(probe_caught (fn [p] (try (select {r: (+ (sum y) [1 2 3]) by: x from: TB where: (> y 38)}) (fn [e] 0))) 5 1000) -- true
(probe_caught (fn [p] (try (select {d: (count (distinct z)) by: V100 from: TB where: (> y 38)}) (fn [e] 0))) 5 1000) -- true
;; the owned by: symbol vector on the error returns of a by-dict or a quoted
;; key: ray_select_impl releases it, whichever exit the select took
(probe_caught (fn [p] (try (select {t: (top y 0) by: {k: x} from: TB}) (fn [e] 0))) 5 1000) -- true
(probe_caught (fn [p] (try (select {s: (sum y) by: {k: x} from: TB take: "a"}) (fn [e] 0))) 5 1000) -- true
(probe_caught (fn [p] (try (select {r: (+ (sum y) [1 2 3]) by: {k: x} from: TB}) (fn [e] 0))) 5 1000) -- true
(probe_caught (fn [p] (try (select {t: (top y 0) by: 'x from: TB}) (fn [e] 0))) 5 1000) -- true
;; a key the compiler rejects leaves its error on the graph, and freeing the
;; graph released it as a value, which an error is not: a by-dict value, a
;; by-dict value with no column, an eval-level computed key
(probe_caught (fn [p] (try (select {by: {k: (+ x 'a)} from: TB}) (fn [e] 0))) 5 1000) -- true
(probe_caught (fn [p] (try (select {by: {k: (+ 1 'a)} from: TB}) (fn [e] 0))) 5 1000) -- true
(probe_caught (fn [p] (try (select {c: (count (distinct y)) by: (+ x 'a) from: TB}) (fn [e] 0))) 5 1000) -- true
;; a where: that keeps every row hands back the input itself, with a
;; reference the no-output and eval-level groupings never dropped: the
;; whole input table per call, a nested select's result included
(set mkw (fn [] (table [x y z s] (list (% (til 1000) 7) (til 1000) (% (til 1000) 3) (as 'STR (% (til 1000) 5))))))
(probe (fn [p] (count (select {by: x from: (mkw) where: (>= y 0)}))) 5 60) -- true
(probe (fn [p] (count (select {by: (* x 2) from: (mkw) where: (>= y 0) desc: x take: 2}))) 5 60) -- true
(probe (fn [p] (count (select {by: [x z] from: (mkw) where: (>= y 0)}))) 5 60) -- true
(probe (fn [p] (count (select {by: s from: (mkw) where: (>= y 0)}))) 5 60) -- true
(probe (fn [p] (count (select {by: {k: x} from: (select {from: (mkw) where: (> y 38)}) where: (> y 0)}))) 5 60) -- true
;; a table kept in a global is not held past the selects over it
(set Tkw (mkw))
(set h0 (heapb))
(map (fn [p] (count (select {by: x from: Tkw where: (>= y 0)}))) (til 10))
(set Tkw 0)
(< (- (heapb) h0) -10000) -- true
;; try frees the error it catches, and the trace its unwind recorded: a
;; raise, a runtime error, a rethrow, a fallback value, in a function
(probe (fn [p] (try (raise p) (fn [e] 0))) 5 1000) -- true
(probe (fn [p] (try (+ p 'a) (fn [e] 0))) 5 1000) -- true
(probe (fn [p] (try (try (raise p) (fn [e] (raise e))) (fn [e] 0))) 5 1000) -- true
(probe (fn [p] (try (+ p 'a) 0)) 5 1000) -- true
;; and at the top level, where try is evaluated rather than compiled
(times 100 (try (raise 5) (fn [e] 0)))
(times 100 (try (try (raise 5) (fn [e] (raise e))) (fn [e] 0)))
(set h0 (heapb))
(times 1000 (try (raise 5) (fn [e] 0)))
(times 1000 (try (+ 1 'a) 0))
(times 1000 (try (try (raise 5) (fn [e] (raise e))) (fn [e] 0)))
(< (- (heapb) h0) 4096) -- true
;; the same table reused across calls must not be released twice: the
;; result is still right after many calls
(set T (mk 1))
(map (fn [p] (window {from: T part: [instrument] order: [rid] funcs: {n: (count v)}})) (til 50))
(count T) -- 786
(count (window {from: T part: [instrument] order: [rid] funcs: {n: (count v)}})) -- 786
(== (sum (at (window {from: T part: [instrument] order: [rid] frame: 'running funcs: {s: (sum v)}}) 's)) (sum (at (window {from: T part: [instrument] order: [rid] frame: 'running funcs: {s: (sum v)}}) 's))) -- true
