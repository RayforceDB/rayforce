;; One-to-one LEFT joins preserve left values and mutation isolation.
(set identity_left (table [k v s nested] (list [1 2 3] [10 0Nl 30] [z a b] (list [1 2] [3] [4 5]))))
(set identity_right (table [k r] (list [1 3] [100 300])))
(set identity_join (left-join [k] identity_left identity_right))
(at identity_join 'v) -- [10 0Nl 30]
(at identity_join 's) -- [z a b]
(at identity_join 'nested) -- (list [1 2] [3] [4 5])
(set identity_changed (update {v: 99 where: (== k 1) from: identity_join}))
(at identity_left 'v) -- [10 0Nl 30]
(at identity_join 'v) -- [10 0Nl 30]
(at identity_changed 'v) -- [99 0Nl 30]
(set identity_left (update {v: 77 where: (== k 3) from: identity_left}))
(at identity_join 'v) -- [10 0Nl 30]
(at identity_left 'v) -- [10 0Nl 77]
;; All unmatched rows still preserve the left side.
(count (left-join [k] identity_left (table [k r] (list [8] [80])))) -- 3
;; Duplicate matches must expand and gather the left side.
(at (left-join [k] identity_left (table [k r] (list [1 1 3] [4 5 6]))) 'k) -- [1 1 2 3]
;; FULL joins must allocate, since right-only rows change the left side.
(count (full-join [k] identity_left (table [k r] (list [1 8] [4 5])))) -- 4
