;; prefilter_compound.rfl -- answers of compound and SYM key joins whose large
;; left side is skipped through the right-side key bitmap prefilter (#595).
;;
;; A left row whose value on some key column no right row holds is dropped by
;; an inner join and emitted unmatched by a left join without being hashed.
;; These are the answers the full probe gives; test_join_prefilter.c pins that
;; the filter is actually taken and compares it against the plain probe.
;; @requires: posix

;; 20000 left rows over 97 books (venue, instrument); book b = row % 97 lives
;; on venue b % 6.  Book 3 holds 207 rows, book 40 holds 206.
(set PI (as 'SYM (map (fn [i] (format "I%" i)) (til 97))))
(set PV (at (as 'SYM (map (fn [i] (format "V%" i)) (til 6))) (% (til 97) 6)))
(set PL (table [venue instrument sid px] (list (take PV 20000) (take PI 20000) (% (til 20000) 5) (til 20000))))
(set PR (table [venue instrument sid w] (list (at PV [3 40]) (at PI [3 40]) [1 0] [100 200])))

;; ── two SYM keys ──────────────────────────────────────────────────────────
(count (inner-join [venue instrument] PL PR)) -- 413
(sum (at (inner-join [venue instrument] PL PR) 'px)) -- 4125153
(count (left-join [venue instrument] PL PR)) -- 20000
(sum (fill 0 (at (left-join [venue instrument] PL PR) 'w))) -- 61900
(count (select {from: (left-join [venue instrument] PL PR) where: (nil? w)})) -- 19587

;; ── three keys, the third an integer ──────────────────────────────────────
(count (inner-join [venue instrument sid] PL PR)) -- 83
(sum (at (inner-join [venue instrument sid] PL PR) 'px)) -- 832996
(count (left-join [venue instrument sid] PL PR)) -- 20000
(sum (fill 0 (at (left-join [venue instrument sid] PL PR) 'w))) -- 12500

;; ── a pair no left row holds: instrument 3 on book 40's venue ─────────────
(set PX (table [venue instrument w] (list (at PV [40]) (at PI [3]) [5])))
(count (inner-join [venue instrument] PL PX)) -- 0
(count (left-join [venue instrument] PL PX)) -- 20000
(sum (fill 0 (at (left-join [venue instrument] PL PX) 'w))) -- 0

;; ── null keys: null equals null, never a value ────────────────────────────
;; Every 50th left row has a null venue and instrument.
(set PNV (as 'SYM (map (fn [i] (if (== 0 (% i 50)) "" (format "V%" (% (% i 97) 6)))) (til 20000))))
(set PNI (as 'SYM (map (fn [i] (if (== 0 (% i 50)) "" (format "I%" (% i 97)))) (til 20000))))
(set PN (table [venue instrument px] (list PNV PNI (til 20000))))
(set PRN (table [venue instrument w] (list (as 'SYM ["V3" "V4" ""]) (as 'SYM ["I3" "I40" ""]) [100 200 7])))
(count (inner-join [venue instrument] PN PRN)) -- 804
(count (inner-join [venue instrument] PN PR)) -- 404
(count (left-join [venue instrument] PN PRN)) -- 20000
(sum (fill 0 (at (left-join [venue instrument] PN PRN) 'w))) -- 63400

;; ── an empty right side, and one where every left row matches ─────────────
(set PE (select {from: PR where: (> w 1000)}))
(count PE) -- 0
(count (inner-join [venue instrument] PL PE)) -- 0
(count (left-join [venue instrument] PL PE)) -- 20000
(set PA (table [venue instrument w] (list PV PI (til 97))))
(count (inner-join [venue instrument] PL PA)) -- 20000
(sum (at (inner-join [venue instrument] PL PA) 'w)) -- 959289
(count (left-join [venue instrument] PL PA)) -- 20000

;; ── FILE-domain keys from a splayed table, against runtime keys ───────────
(.sys.exec "rm -rf /tmp/rfl_join_prefilter")
(.db.splayed.set "/tmp/rfl_join_prefilter/l/" PL "/tmp/rfl_join_prefilter/.sym")
(set PF (.db.splayed.get "/tmp/rfl_join_prefilter/l/" "/tmp/rfl_join_prefilter/.sym"))
(count (inner-join [venue instrument] PF PR)) -- 413
(sum (at (inner-join [venue instrument] PF PR) 'px)) -- 4125153
(sum (fill 0 (at (left-join [venue instrument sid] PF PR) 'w))) -- 12500
(.sys.exec "rm -rf /tmp/rfl_join_prefilter")

;; ── SYM key domains: a join interns no vocabulary ─────────────────────────
;; A splayed column's ids are positions in its symfile.  The join compares a
;; same-domain key pair by raw id and translates only the ROWS of a
;; cross-domain pair, by string lookup (join_align_sym_keys), so the runtime
;; symbol table ((.sys.mem) 'sym-count) does not grow by a file's vocabulary
;; -- the old canonicalization to runtime ids interned the whole symfile on
;; the first join over it, however small the joined tables.  The vocabularies
;; come from CSV imports, which intern into the symfile alone, so every key
;; string is foreign to the runtime table until a line of this file names it;
;; the runtime-side tables are set up BEFORE the snapshots, and a snapshot is
;; taken inside one expression (a line interns its own names when it is
;; parsed), after a first call of (.sys.mem) and of nogrow.
(.sys.exec "rm -rf /tmp/rfl_join_symdom; mkdir -p /tmp/rfl_join_symdom") -- 0
(.sys.exec "printf 'k,v\\nsda,1\\nsdb,2\\n,3\\nsdc,4\\nsdd,5\\nsda,6\\nsde,7\\n' > /tmp/rfl_join_symdom/a.csv") -- 0
(.sys.exec "printf 'k,w\\nsdc,10\\n,20\\nsdz,30\\nsda,40\\n' > /tmp/rfl_join_symdom/b.csv") -- 0
(set SDT (.csv.splayed "/tmp/rfl_join_symdom/a.csv" "/tmp/rfl_join_symdom/a/"))
(set SDU (.csv.splayed "/tmp/rfl_join_symdom/b.csv" "/tmp/rfl_join_symdom/b/"))
(set SDA (.db.splayed.get "/tmp/rfl_join_symdom/a/"))
(set SDB (.db.splayed.get "/tmp/rfl_join_symdom/b/"))
(type (at SDA 'k)) -- 'SYM
;; same symfile: rows 4..7 of SDA, renamed
(set SDS (xcol (select {from: SDA where: (> v 3)}) [k u]))
;; runtime literals: sdq is in no file, sdy is only here; sde and sdz stay foreign
(set SDR (table [k x] (list (as 'SYM ["sdc" "" "sdq" "sda"]) [10 20 30 40])))
(set SDR2 (table [k w] (list (as 'SYM ["sdc" ""]) [10 20])))
;; a 70000-row runtime side: the right side above 65536 rows takes the radix path
(set SDBIG (table [k w] (list (as 'SYM (concat ["sda" "sdb" "sdc" "sdd"] (map (fn [i] (format "sdy%" i)) (til 69996)))) (til 70000))))
(set nogrow (fn [f] (do (let s0 (at (.sys.mem) 'sym-count)) (let r (f)) (list (- (at (.sys.mem) 'sym-count) s0) r))))
(set SDW (nogrow (fn [] (count (.sys.mem)))))
;; two symfiles: null equals null across them, sdz matches nothing on the left
(nogrow (fn [] (at (left-join [k] SDA SDB) 'w))) -- (list 0 [40 0Nl 20 10 0Nl 40 0Nl])
(nogrow (fn [] (at (inner-join [k] SDA SDB) 'v))) -- (list 0 [1 3 4 6])
(nogrow (fn [] (at (anti-join [k] SDA SDB) 'v))) -- (list 0 [2 5 7])
(nogrow (fn [] (semi-mask [k] SDA SDB))) -- (list 0 [true false true true false true false])
;; the same symfile on both sides
(nogrow (fn [] (at (left-join [k] SDA SDS) 'u))) -- (list 0 [6 0Nl 0Nl 4 5 6 7])
(nogrow (fn [] (at (inner-join [k] SDS SDA) 'v))) -- (list 0 [4 5 6 1 7])
;; a symfile against runtime literals, either side; an absent string matches nothing
(nogrow (fn [] (at (left-join [k] SDA SDR) 'x))) -- (list 0 [40 0Nl 20 10 0Nl 40 0Nl])
(nogrow (fn [] (at (inner-join [k] SDR SDA) 'v))) -- (list 0 [4 3 6 1])
(nogrow (fn [] (at (anti-join [k] SDR SDA) 'x))) -- (list 0 [30])
;; (the radix path emits left rows in partition order: pin sums)
(nogrow (fn [] (sum (fill 0 (at (left-join [k] SDA SDBIG) 'w))))) -- (list 0 6)
(nogrow (fn [] (count (select {from: (left-join [k] SDA SDBIG) where: (nil? w)})))) -- (list 0 2)
(nogrow (fn [] (count (inner-join [k] SDBIG SDA)))) -- (list 0 5)
(nogrow (fn [] (count (anti-join [k] SDBIG SDA)))) -- (list 0 69996)
;; full join: a right-only key is written into the left key column from its
;; string, so a runtime left interns exactly the right-only strings (sdz)...
(nogrow (fn [] (at (full-join [k] SDR SDB) 'w))) -- (list 1 [10 20 0Nl 40 30])
(as 'STR (at (full-join [k] SDR SDB) 'k)) -- ["sdc" "" "sdq" "sda" "sdz"]
;; ...and a file-domain left keeps its domain: a right-only key it holds is
;; stored by position
(nogrow (fn [] (at (full-join [k] (select {from: SDA where: (< v 5)}) SDS) 'u))) -- (list 0 [6 0Nl 0Nl 4 5 7])
(as 'STR (at (full-join [k] (select {from: SDA where: (< v 5)}) SDS) 'k)) -- ["sda" "sdb" "" "sdc" "sdd" "sde"]
;; the key columns of a join result are the inputs' cells
(as 'STR (at (left-join [k] SDA SDR2) 'k)) -- ["sda" "sdb" "" "sdc" "sdd" "sda" "sde"]
(as 'STR (at (inner-join [k] SDR SDA) 'k)) -- ["sdc" "" "sda" "sda"]
;; entries appended to an open symfile lie past its mapped prefix: the
;; translated side still finds them
(.sys.exec "printf 'k,v\\nsda,1\\nsdb,2\\nsdc,3\\n' > /tmp/rfl_join_symdom/c.csv") -- 0
(set SDCT (.csv.splayed "/tmp/rfl_join_symdom/c.csv" "/tmp/rfl_join_symdom/c/"))
(set SDC0 (.db.splayed.get "/tmp/rfl_join_symdom/c/"))
(set SDCW (.db.splayed.set "/tmp/rfl_join_symdom/c/" (table [k v] (list (as 'SYM ["sda" "sdnew" "sdother"]) [1 2 3]))))
(set SDC (.db.splayed.get "/tmp/rfl_join_symdom/c/"))
(set SDR3 (table [k x] (list (as 'SYM ["sdnew" "sda" "sdq" "sdother"]) [1 2 3 4])))
(at (inner-join [k] SDC SDR3) 'x) -- [2 1 4]
(at (inner-join [k] SDR3 SDC) 'x) -- [1 2 4]
(at (left-join [k] SDR3 SDC) 'v) -- [2 1 0Nl 3]
(.sys.exec "rm -rf /tmp/rfl_join_symdom") -- 0
