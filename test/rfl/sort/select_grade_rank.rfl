;; iasc / idesc / rank in a keyless select projection evaluate once over the
;; whole column, like asc / desc / reverse.  They used to run once per row and
;; fail with "iasc expects a vector" on the single cell.
(set T (table [a] (list [3 0N 1 2])))
(at (select {from: T r: (iasc a)}) 'r) -- (iasc [3 0N 1 2])
(at (select {from: T r: (idesc a)}) 'r) -- (idesc [3 0N 1 2])
(at (select {from: T r: (rank a)}) 'r) -- (rank [3 0N 1 2])
(at (select {from: T r: (rank (neg a))}) 'r) -- (rank (neg [3 0N 1 2]))
(at (update {from: T r: (iasc a)}) 'r) -- (iasc [3 0N 1 2])
(set G (table [g a] (list [1 1 1 1] [3 0N 1 2])))
(at (at (select {from: G by: g r: (rank a)}) 'r) 0) -- (rank [3 0N 1 2])
