(identical 1 1) -- true
(identical 1 1i) -- false
(identical null null) -- true
(identical null 0Nl) -- false
(identical 0Nl 0Nl) -- true
(identical 0Nl 0Nf) -- false
(identical [1 2] [1 2]) -- true
(identical [1 2] [1 3]) -- false
(identical [1 2] [1 2 3]) -- false
(identical (list 1 2) [1 2]) -- false
(identical (list 1 (list 2)) (list 1 (list 2i))) -- false
(identical (list (sum [1 2])) (list 3)) -- true
(identical [0.0 -0.0 0Nf] [-0.0 0.0 0Nf]) -- true
(identical {a: 1 b: 2} {a: 1 b: 2}) -- true
(identical {a: 1 b: 2} {b: 2 a: 1}) -- false
(identical + +) -- true
(set f (fn [x] x))
(identical f f) -- true
(identical f (fn [x] x)) -- false
(identical (table [a] (list [1 2])) (table [a] (list [1 2]))) -- true
(identical (table [a] (list [1 2])) (table [a] (list [1i 2i]))) -- false
(identical (== {a: 1 b: 2} 1) (dict [a b] (as 'B8 [true false]))) -- true
(identical (== 1 {a: 1 b: 2}) (dict [a b] (as 'B8 [true false]))) -- true
(identical (== {a: 1 b: 2} {a: 1 b: 3}) (dict [a b] (as 'B8 [true false]))) -- true
(identical (== {a: 1 b: 2} {b: 2 c: 3}) (dict [a b c] (as 'B8 [false true false]))) -- true
(identical (== (table [a] (list [1 2])) 1) (table [a] (list [true false]))) -- true
(identical (== (table [a] (list [1 2])) (table [a] (list [1i 3i]))) (table [a] (list [true false]))) -- true
(type (try (== (table [a] (list [1 2])) (table [b] (list [1 2]))) 'caught)) -- 'sym
(type (try (== (table [a] (list [1 2])) (table [a] (list [1]))) 'caught)) -- 'sym
(set compare (fn [x y] (list (== x y) (identical x y))))
(identical (at (compare {a: 1} {a: 1i}) 0) {a: true}) -- true
(at (compare {a: 1} {a: 1i}) 1) -- false
