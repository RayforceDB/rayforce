;; (if mask a b) with a boolean-vector condition chooses per row, outside a
;; query as inside one.  Both arms are evaluated; an arm is a vector of the
;; mask's length or an atom that broadcasts.  A scalar condition is unchanged
;; and still evaluates only the arm it takes.

;; ── tree-walking evaluator (top level) ──────────────────────────────────────
(if [true false] [1 2] [3 4]) -- [1 4]
(if [true false true] 10 [1 2 3]) -- [10 2 10]
(if [true false true] [1 2 3] 0) -- [1 0 3]
(if [true false] 1 2) -- [1 2]
(if [true false] 1.5 2) -- [1.5 2.0]
(if [true false] 'a 'b) -- ['a 'b]
(if [true false] "x" "y") -- ["x" "y"]
(if [true false] 2024.01.01 2024.06.01) -- [2024.01.01 2024.06.01]
(if (> [1 5 9] 4) [1 2 3] [10 20 30]) -- [10 2 3]
(if [] [] []) -- []
(if [true false] (+ 1 2) (+ 3 4)) -- [3 7]

;; a chain: a boolean vector picks per row between its arm and the rest of
;; the chain; a later scalar condition picks a whole arm, as it does alone
(if [true false false] [1 2 3] [false true false] [10 20 30] 0) -- [1 20 0]
(if [true false] 1 true 2 3) -- [1 2]
(if [true false] 1 false 2 3) -- [1 3]
(if [true false] 1 [false true] 2 3) -- [1 2]

;; arms of a scalar condition are still lazy
(set n 0)
(if true 1 (set n 5)) -- 1
n -- 0
(if false (set n 5) 2) -- 2
n -- 0

;; errors
(if [true false] [1 2 3] 0) !- length
(if [true false] 0 [1 2 3]) !- length
(if [true false] 1) !- domain
(if [true false] 1 [false true] 2) !- domain
(if [true false] 1 'a) !- type
(if [true false] 2024.01.01 5) !- type
(if [true false] (list 1 2) 3) !- type

;; ── bytecode compiler (inside a lambda) agrees ──────────────────────────────
(set fv (fn [m a b] (if m a b)))
(fv [true false] [1 2] [3 4]) -- [1 4]
(fv [true false] 1 2) -- [1 2]
(fv true 1 2) -- 1
(fv false 1 2) -- 2
(fv [true false] 'a 'b) -- ['a 'b]
(fv [true false] [1 2 3] 0) !- length
(fv [true false] 1 'a) !- type

;; locals are visible to the arms of the per-row path
(set fl (fn [m a] (let k 7) (if m a k)))
(fl [true false] [1 2]) -- [1 7]
(fl true 3) -- 3
(set fp (fn [m a] (if m (+ a 1) (* a 2))))
(fp [true false] [10 20]) -- [11 40]

;; a chain, and no else arm
(set fc (fn [m n] (if m 1 n 2 3)))
(fc [true false false] [false true false]) -- [1 2 3]
(fc false true) -- 2
(fc false false) -- 3
(set fn1 (fn [m a] (if m a)))
(fn1 true 5) -- 5
(fn1 false 5) -- 0
(fn1 [true false] [1 2]) !- domain

;; the compiled and interpreted spellings agree on the same operands
(set Mv [true false true false])
(set Av [1 2 3 4])
(set Bv [10 20 30 40])
(fv Mv Av Bv) -- (if Mv Av Bv)

;; ── the same choice as inside a query ───────────────────────────────────────
(set T (table [m a b] (list Mv Av Bv)))
(at (select {r: (if m a b) from: T}) 'r) -- (if Mv Av Bv)
(set Ts (table [m a b] (list Mv ['x 'y 'z 'w] ['p 'q 'r 's])))
(at (select {r: (if m a b) from: Ts}) 'r) -- (if Mv ['x 'y 'z 'w] ['p 'q 'r 's])
(set Td (table [m a b] (list Mv [2024.01.01 2024.01.02 2024.01.03 2024.01.04] [2025.01.01 2025.01.02 2025.01.03 2025.01.04])))
(at (select {r: (if m a b) from: Td}) 'r) -- (if Mv [2024.01.01 2024.01.02 2024.01.03 2024.01.04] [2025.01.01 2025.01.02 2025.01.03 2025.01.04])

;; ── long chains: no cap on the chain, compiled or interpreted ───────────────
;; (a compiled lambda once kept the whole-vector reading past 63 forms)
(eval (parse "(if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 999)")) -- [100 999]
((fn [z] (if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 999)) 0) -- [100 999]
(eval (parse "(if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 false 30 false 31 999)")) -- [100 999]
((fn [z] (if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 false 30 false 31 999)) 0) -- [100 999]
(eval (parse "(if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 false 30 false 31 false 32 999)")) -- [100 999]
((fn [z] (if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 false 30 false 31 false 32 999)) 0) -- [100 999]
(eval (parse "(if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 false 30 false 31 false 32 false 33 false 34 false 35 false 36 false 37 false 38 false 39 false 40 999)")) -- [100 999]
((fn [z] (if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 false 30 false 31 false 32 false 33 false 34 false 35 false 36 false 37 false 38 false 39 false 40 999)) 0) -- [100 999]
(eval (parse "(if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 false 30 false 31 false 32 false 33 false 34 false 35 false 36 false 37 false 38 false 39 false 40 false 41 false 42 false 43 false 44 false 45 false 46 false 47 false 48 false 49 false 50 false 51 false 52 false 53 false 54 false 55 false 56 false 57 false 58 false 59 false 60 false 61 false 62 false 63 false 64 false 65 false 66 false 67 false 68 false 69 false 70 false 71 false 72 false 73 false 74 false 75 false 76 false 77 false 78 false 79 false 80 false 81 false 82 false 83 false 84 false 85 false 86 false 87 false 88 false 89 false 90 false 91 false 92 false 93 false 94 false 95 false 96 false 97 false 98 false 99 false 100 false 101 false 102 false 103 false 104 false 105 false 106 false 107 false 108 false 109 false 110 false 111 false 112 false 113 false 114 false 115 false 116 false 117 false 118 false 119 false 120 false 121 false 122 false 123 false 124 false 125 false 126 false 127 false 128 false 129 false 130 false 131 false 132 false 133 false 134 false 135 false 136 false 137 false 138 false 139 false 140 false 141 false 142 false 143 false 144 false 145 false 146 false 147 false 148 false 149 false 150 false 151 false 152 false 153 false 154 false 155 false 156 false 157 false 158 false 159 false 160 false 161 false 162 false 163 false 164 false 165 false 166 false 167 false 168 false 169 false 170 false 171 false 172 false 173 false 174 false 175 false 176 false 177 false 178 false 179 false 180 false 181 false 182 false 183 false 184 false 185 false 186 false 187 false 188 false 189 false 190 false 191 false 192 false 193 false 194 false 195 false 196 false 197 false 198 false 199 false 200 999)")) -- [100 999]
((fn [z] (if [true false] 100 false 1 false 2 false 3 false 4 false 5 false 6 false 7 false 8 false 9 false 10 false 11 false 12 false 13 false 14 false 15 false 16 false 17 false 18 false 19 false 20 false 21 false 22 false 23 false 24 false 25 false 26 false 27 false 28 false 29 false 30 false 31 false 32 false 33 false 34 false 35 false 36 false 37 false 38 false 39 false 40 false 41 false 42 false 43 false 44 false 45 false 46 false 47 false 48 false 49 false 50 false 51 false 52 false 53 false 54 false 55 false 56 false 57 false 58 false 59 false 60 false 61 false 62 false 63 false 64 false 65 false 66 false 67 false 68 false 69 false 70 false 71 false 72 false 73 false 74 false 75 false 76 false 77 false 78 false 79 false 80 false 81 false 82 false 83 false 84 false 85 false 86 false 87 false 88 false 89 false 90 false 91 false 92 false 93 false 94 false 95 false 96 false 97 false 98 false 99 false 100 false 101 false 102 false 103 false 104 false 105 false 106 false 107 false 108 false 109 false 110 false 111 false 112 false 113 false 114 false 115 false 116 false 117 false 118 false 119 false 120 false 121 false 122 false 123 false 124 false 125 false 126 false 127 false 128 false 129 false 130 false 131 false 132 false 133 false 134 false 135 false 136 false 137 false 138 false 139 false 140 false 141 false 142 false 143 false 144 false 145 false 146 false 147 false 148 false 149 false 150 false 151 false 152 false 153 false 154 false 155 false 156 false 157 false 158 false 159 false 160 false 161 false 162 false 163 false 164 false 165 false 166 false 167 false 168 false 169 false 170 false 171 false 172 false 173 false 174 false 175 false 176 false 177 false 178 false 179 false 180 false 181 false 182 false 183 false 184 false 185 false 186 false 187 false 188 false 189 false 190 false 191 false 192 false 193 false 194 false 195 false 196 false 197 false 198 false 199 false 200 999)) 0) -- [100 999]

;; ── both arms always run: their side effects happen, a raising arm raises ───
(do (set n 0) (if [true false] (set n (+ n 1)) (set n (+ n 10))) n) -- 11
((fn [] (set n 0) (if [true false] (set n (+ n 1)) (set n (+ n 10))) n)) -- 11
(set arms (fn [x] (let a 0) (if (> x 1) (let a 7) (let a 9)) a))
(arms [1 2 3]) -- 9
(arms 5) -- 7
(arms 0) -- 9
(try (if (< [1 200] 100) [1 200] (raise 7)) (fn [e] e)) -- 7
(try ((fn [v] (if (< v 100) v (raise 7))) [1 200]) (fn [e] e)) -- 7
((fn [v] (if (< v 100) v (raise 7))) 5) -- 5

;; ── length one and empty ────────────────────────────────────────────────────
(if [true] 1 2) -- [1]
(if [false] 1 2) -- [2]
(if (as 'BOOL []) 1 2) -- []
(fv [true] 1 2) -- [1]
(fv (as 'BOOL []) 1 2) -- []

;; ── #1603: a cast arm inside an and in where: ───────────────────────────────
(set n3 12)
(set T3 (table [a act i] (list (at ['x 'y 'z 'w] (% (til n3) 4)) (at ['New 'Accepted 'Rejected] (% (til n3) 3)) (til n3))))
(at (select {from: T3 where: (== a (if (== act 'New) 'x 'y))}) 'i) -- [0 1 5]
(at (select {from: T3 where: (and (>= i 0) (== a (if (== act 'New) 'x 'y)))}) 'i) -- [0 1 5]
(at (select {from: T3 where: (== a (if (== act 'New) (as 'sym "x") 'y))}) 'i) -- [0 1 5]
(at (select {from: T3 where: (and (>= i 0) (== a (if (== act 'New) (as 'sym "x") 'y)))}) 'i) -- [0 1 5]
(at (select {from: T3 where: (and (>= i 0) (== a (if (== act 'New) 'x (as 'sym "y"))))}) 'i) -- [0 1 5]

;; ── recursion through an arm with a vector condition ───────────────────────
;; each level holds one of the runtime's 64 scope frames: a depth well inside
;; the cap answers, one past it raises limit (never a crash).  the same helper
;; with a scalar condition is not bound by it.
(set deepV (fn [m d] (if (== d 0) (if m 1 0) (if m (deepV m (- d 1)) 0))))
(sum (deepV [true false true] 40)) -- 2
(sum (deepV [true false true] 100)) !- limit
(deepV true 150) -- 1

;; ── where: predicates the planner leaves to the evaluator choose per row ────
;; (the evaluator's if used to give every row the first arm: #1610, #1611, #1629)
(set gw 0)
(set effw (fn [c] (set gw (+ gw 1)) c))
(at (select {from: T3 where: (== a (if (effw (== act 'New)) 'x 'y))}) 'i) -- [0 1 5]
(set helpw (fn [c] (let r (if c 'x 'y)) r))
(at (select {from: T3 where: (== a (helpw (== act 'New)))}) 'i) -- [0 1 5]
(set recw (fn [c d] (if (== d 0) (if c 'x 'y) (recw c (- d 1)))))
(at (select {from: T3 where: (== a (recw (== act 'New) 2))}) 'i) -- [0 1 5]
(set U3 (table [k] (list ['x])))
(at (select {from: T3 where: (== a (if (== act 'New) (first (at (select {k: k from: U3}) 'k)) 'y))}) 'i) -- [0 1 5]
