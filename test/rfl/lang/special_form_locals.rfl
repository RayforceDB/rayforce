;; Runtime special forms (alter / and / or / select / insert / ...)
;; re-evaluate their argument ASTs through the tree walker.  Inside a
;; COMPILED lambda the params and let-locals live in bytecode slots, so
;; the compiler materializes them into a scope frame around the dynamic
;; eval (OP_SCOPE_BEGIN / OP_SCOPE_END) and syncs let-updates back.
;; Regression test for "name: 'v' undefined" on (alter 'data concat v)
;; inside a lambda.

;; alter with a let-local and with a param
(set data (list))
((fn [] (let v 42) (alter 'data concat v)))
(count data) -- 1
(at data 0)  -- 42
((fn [x] (alter 'data concat x)) 7)
(count data) -- 2
(at data 1)  -- 7

(set alter_shadow [5 5])
((fn [] (let alter_shadow [1 2 3]) (alter 'alter_shadow set 0 9) alter_shadow)) -- [9 2 3]
alter_shadow -- [5 5]
((fn [] (let alter_shadow [1 2 3]) (alter 'alter_shadow concat [4]) alter_shadow)) -- [1 2 3 4]
((fn [] (let alter_shadow (list 1 2 3)) (alter 'alter_shadow remove 0) alter_shadow)) -- (list 2 3)
((fn [alter_shadow] (alter 'alter_shadow set 0 9) alter_shadow) [1 2 3]) -- [9 2 3]
alter_shadow -- [5 5]

;; and/or with params — must match the top-level (tree-walk) results:
;; scalar-falsy short-circuit returns the accumulator, otherwise the
;; element-wise combine yields a boolean
((fn [x] (and x 1)) 5) -- true
((fn [x] (and x 1)) 0) -- 0
((fn [x] (or x 9)) 0)  -- true
((fn [x] (or x 9)) 3)  -- 3

;; nested: local used in a special form deeper in the body
((fn [x] (let y (+ x 1)) (and y (or y 0))) 4) -- true

;; parameterized queries — table as a lambda argument
(set tbl (table [k v] (list (til 3) (til 3))))
(count (at ((fn [t] (select {from: t take: 2})) tbl) 'k)) -- 2

;; local scalar in a where clause
(count (at ((fn [n] (select {from: tbl where: (> v n)})) 0) 'k)) -- 2

;; insert with a local row
((fn [r] (insert 'tbl r)) (list 9 9))
(count (at tbl 'k)) -- 4

;; let-update inside a special form syncs back to the slot
((fn [] (let v 1) (and (let v 2) 1) v)) -- 2

;; errors inside the dynamic eval unwind the materialized frame: the
;; trap handler runs with a balanced scope stack, and the local slots
;; are still intact afterwards
((fn [x] (try (and x (undefined-name-xyz)) (fn [e] 0)) x) 6) -- 6

;; count of a select inside a lambda runs dynamically as a whole, so it is
;; counted off the selection as at top level: params, let-locals, a table
;; passed in and a closure's capture all resolve in its where
(set ctbl (table [k v] (list [1 2 3 4 5 6] [10 20 30 40 50 60])))
((fn [n] (count (select {from: ctbl where: (> v n)}))) 25) -- 4
((fn [] (let lo 15) (let hi 45) (count (select {from: ctbl where: (and (> v lo) (< v hi))})))) -- 3
((fn [t n] (count (select {from: t where: (== k n)}))) ctbl 3) -- 1
((fn [t] (count (select {from: t}))) ctbl) -- 6
(((fn [n] (fn [m] (count (select {from: ctbl where: (and (> v n) (< v m))})))) 10) 60) -- 4
((fn [n] (count (select {from: ctbl where: (> nosuchcol n)}))) 1) !- schema
;; a local or a global named select that is not the special form is called
((fn [select t] (count (select {from: t}))) (fn [d] [1 2 3]) ctbl) -- 3
;; take and first of a select in a compiled body: the frame's locals reach
;; the select and the count, a local select is called
((fn [t n] (at (take (select {from: t where: (> v 10) desc: v}) n) 'v)) ctbl 2) -- (at (take (select {from: ctbl where: (> v 10) desc: v}) 2) 'v)
((fn [t] (at (first (select {from: t desc: v})) 'v)) ctbl) -- (max (at ctbl 'v))
((fn [t] (let k 3) (count (take (select {from: t asc: v}) k))) ctbl) -- 3
((fn [t] (count (take (select {from: t where: (> v 1000)}) 2))) ctbl) -- 2
((fn [select t] (first (select {from: t}))) (fn [d] [7 8]) ctbl) -- 7
((fn [select t] (take (select {from: t}) 1)) (fn [d] [7 8]) ctbl) -- [7]
;; (last in the file: the global select stays rebound)
(set cnt_rebound (fn [n] (count (select {from: ctbl where: (> v n)}))))
(cnt_rebound 25) -- 4
(set select (fn [d] [1 2]))
(cnt_rebound 25) -- 2
((fn [n] (count (select {from: ctbl where: (> v n)}))) 25) -- 2
(count (select {from: ctbl where: (> v 25)})) -- 2
;; select rebound to another special form: the form it names now runs
(set select quote)
(first (select {from: ctbl})) !- type
(take (select {from: ctbl}) 2) -- (take (quote {from: ctbl}) 2)
(count (select {from: ctbl})) -- 1
((fn [] (count (select {from: ctbl})))) -- 1
