;; Every public vector type: direct, dictionary, table and compiled paths.
(set typed-eq (fn [a b] (== a b)))
;; B8
(set V (as 'B8 [true false]))
(set D (dict (til (count V)) V))
(set T (table [v] (list V)))
(identical V (de (ser V))) -- true
(== D D) -- (dict (til (count V)) (take [true] (count V)))
(== T T) -- (table [v] (list (take [true] (count V))))
(identical (typed-eq T T) (== T T)) -- true
(identical (== T (first V)) (== (first V) T)) -- true
(identical (== D (first V)) (== (first V) D)) -- true
;; U8
(set V (as 'U8 [1 2]))
(set D (dict (til (count V)) V))
(set T (table [v] (list V)))
(identical V (de (ser V))) -- true
(== D D) -- (dict (til (count V)) (take [true] (count V)))
(== T T) -- (table [v] (list (take [true] (count V))))
(identical (typed-eq T T) (== T T)) -- true
(identical (== T (first V)) (== (first V) T)) -- true
(identical (== D (first V)) (== (first V) D)) -- true
