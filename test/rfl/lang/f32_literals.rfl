;; F32 suffixes, exponent disambiguation, and printer/readback types.
(type 42e) -- 'f32
(type 1.5e) -- 'f32
(type -1.5e) -- 'f32
(type 0e) -- 'f32
(type -0e) -- 'f32
1.5e -- (as 'F32 1.5)
-42e -- (as 'F32 -42)
(type 1e3) -- 'f64
(type 1E3) -- 'f64
(type 1e+3) -- 'f64
(type 1e-3) -- 'f64
(type 1e3e) -- 'f32
(type 1E-3e) -- 'f32
1e3e -- (as 'F32 1000)
1e-3e -- (as 'F32 0.001)
1e39e -- (as 'F32 1e39)
-1e39e -- (as 'F32 -1e39)
1e-46e -- 0e
(type [1e -2.5e 0Ne]) -- 'F32
(nil? [1e -2.5e 0Ne]) -- [false false true]
(format "%" 1.5e) -- "1.5e"
(format "%" [1e 0Ne 3e]) -- "[1.0e 0Ne 3.0e]"
(type (eval (parse (format "%" 1.5e)))) -- 'f32
(type (eval (parse (format "%" [1e 0Ne 3e])))) -- 'F32
(eval (parse (format "%" [1e 0Ne 3e]))) -- [1e 0Ne 3e]
(type (eval (parse (format "%" 1e20e)))) -- 'f32
(type (eval (parse (format "%" 1e-20e)))) -- 'f32
(parse "1e+") !- parse
(parse "1e-") !- parse
(parse "1E") !- parse
(parse "1ee") !- parse
(parse "1.5ex") !- parse
(parse "1e3ee") !- parse

;; STR casts produce numeric data, while format produces literal syntax.
(as 'STR 1.5e) -- "1.5"
(as 'str -2.5e) -- "-2.5"
(as 'STR -0e) -- "0"
(as 'STR 0Ne) -- ""
(as 'STR [1.5e -2.5e 0e 0Ne]) -- ["1.5" "-2.5" "0" ""]
(as 'F32 (as 'STR 1.5e)) -- 1.5e
(as 'F64 (as 'STR 1.5e)) -- 1.5
(as 'F32 (as 'STR [1.5e -2.5e 0e 0Ne])) -- [1.5e -2.5e 0e 0Ne]
(as 'F64 (as 'STR [1.5e -2.5e 0e 0Ne])) -- [1.5 -2.5 0.0 0Nf]
;; Nine significant digits suffice for exact F32 readback, including values
;; beyond the display precision, scientific notation and subnormals.
(set f32_text_values [1.23456789e 1e20e 1e-20e 1e-40e])
(all (== f32_text_values (as 'F32 (as 'STR f32_text_values)))) -- true
(as 'STR f32_text_values) -- (as 'STR (as 'SYMBOL f32_text_values))
(format "%" 1.5e) -- "1.5e"
