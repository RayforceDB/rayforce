;; (if c1 r1 c2 r2 ... else?) — condition/result pairs tried in order, an
;; odd trailing arg is the fallback.  Covers the tree-walking evaluator
;; (top level) and the bytecode compiler (inside a lambda) alike.

;; ── tree-walking evaluator ──────────────────────────────────────────────────
(if false 1 false 2 3) -- 3
(if false 1 true 2 3) -- 2
(if true 1 false 2 3) -- 1
(if false 1 false 2 false 3 4) -- 4
(if false 1 false 2 true 3 4) -- 3
;; even arg count: no fallback, 0 when nothing matches
(if false 1 false 2) -- 0
(if false 1 true 2) -- 2
;; the three-arg form is unchanged
(if false 1 3) -- 3
(if true 1 3) -- 1
(if false 1) -- 0

;; ── bytecode compiler ──────────────────────────────────────────────────────
(set classify (fn [x] (if (> x 100) "high" (> x 50) "mid" "low")))
(classify 200) -- "high"
(classify 60) -- "mid"
(classify 10) -- "low"
((fn [] (if false 1 false 2 false 3 4))) -- 4
((fn [] (if false 1 false 2))) -- 0
((fn [] (if false 1 true 2))) -- 2

;; ── only the taken branch is evaluated ─────────────────────────────────────
(set n 0)
(if false (set n 1) true (set n 2) (set n 3))
n -- 2
(set m 0)
((fn [] (if false (set m 1) false (set m 2) (set m 3))))
m -- 3
;; conditions after the first truthy one are not evaluated
(set k 0)
((fn [] (if true 1 (set k 9) 2 3)))
k -- 0

;; ── inside queries ─────────────────────────────────────────────────────────
;; A chain with a fallback lowers to nested element-wise OP_IF (the planner
;; and the fused kernels), so where:, by: and projections see it row by row,
;; and a text literal becomes a SYM cell as in the three-argument form; a
;; pure helper holding one is inlined the same way.  A chain with no
;; fallback stays with the evaluator, which runs it per row in a projection.
(set Tq (table [v s] (list [1 3 6 9 150] ["a" "b" "c" "d" "e"])))
(set clq (fn [x] (if (> x 100) "high" (> x 5) "mid" "low")))
(at (select {k: (if (> v 100) "high" (> v 5) "mid" "low") from: Tq}) 'k) -- ['low 'low 'mid 'mid 'high]
(at (select {k: (clq v) from: Tq}) 'k) -- ['low 'low 'mid 'mid 'high]
(at (select {from: Tq where: (if (> v 100) false (> v 5) true false)}) 'v) -- [6 9]
(at (select {from: Tq where: (if (> v 100) (== s "e") (> v 5) (!= s "c") false)}) 'v) -- [9 150]
(set Bq (select {n: (count v) mx: (max v) from: Tq by: {k: (if (> v 100) "high" (> v 5) "mid" "low")}}))
(at Bq 'k)  -- ['low 'mid 'high]
(at Bq 'n)  -- [2 2 1]
(at Bq 'mx) -- [3 9 150]
(at (select {n: (count v) from: Tq by: {k: (clq v)}}) 'n) -- [2 2 1]
(at (update {k: (if (> v 100) 3 (> v 5) 2 1) from: Tq}) 'k) -- [1 1 2 2 3]
;; numeric chain with a nested arithmetic result and a where: on top
(at (select {k: (if (> v 100) (* v 2) (> v 5) (+ v 1) 0) from: Tq where: (> v 1)}) 'k) -- [0 7 10 300]
;; no fallback: the evaluator's per-row path, 0 where nothing matches
(at (select {k: (if (> v 100) 3 (> v 5) 2) from: Tq}) 'k) -- [0 0 2 2 3]
