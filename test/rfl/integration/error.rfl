;; Ported from test_lang_rf.inc::test_rf_error.

;; ========== TRY WITH SUCCESS ==========
(try (+ 1 2) (fn [e] 0)) -- 3
;; ========== TRY WITH ERROR ==========
(try (raise "error") (fn [e] 99)) -- 99
;; ========== NESTED TRY ==========
(try (try (raise "inner") (fn [e] (raise "outer"))) (fn [e] 42)) -- 42
;; ========== TRY INSIDE A FUNCTION ==========
;; A runtime error hands the handler a dict of its code and message inside
;; a function as at the top level, never the error object itself: that is
;; not refcounted, so a handler returning it rethrew it, and none freed it.
(try (+ 1 'a) (fn [e] e)) -- (dict [code msg] (list 'type "cannot add i64 and sym"))
((fn [x] (try (+ x 'a) (fn [e] e))) 1) -- (dict [code msg] (list 'type "cannot add i64 and sym"))
((fn [x] (try (+ x 'a) (fn [e] (type e)))) 1) -- 'DICT
((fn [x] (try (raise x) (fn [e] (+ e 1)))) 1) -- 2
((fn [x] (try (try (raise x) (fn [e] (raise (+ e 10)))) (fn [e] e))) 1) -- 11
((fn [x] (try (+ x 'a) 7)) 1) -- 7
