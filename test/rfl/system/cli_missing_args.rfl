;; CLI flags that require values must fail as option errors, not as attempts
;; to open the flag token as a script path.

(.sys.exec "rm -f /tmp/rfl_cli_missing_arg.out; for opt in -p --port -c --cores -t --timeit -Q --querylog -f --file -m --mem -u -U -l -L; do ./rayforce $opt </dev/null >/tmp/rfl_cli_missing_arg.out 2>&1; rc=$?; grep -Fq \"error: $opt expects a value\" /tmp/rfl_cli_missing_arg.out || exit 10; [ $rc -eq 2 ] || exit 11; done; for opt in -x --bogus; do ./rayforce $opt </dev/null >/tmp/rfl_cli_missing_arg.out 2>&1; rc=$?; grep -Fq \"error: unknown option '$opt'\" /tmp/rfl_cli_missing_arg.out || exit 12; [ $rc -eq 2 ] || exit 13; done") -- 0
