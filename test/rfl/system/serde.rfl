;; Ported from test_lang_rf.inc::test_rf_serde.

(de (ser null)) -- null
;; Typed null atoms must survive a serialize/deserialize roundtrip.
;; Regression for (de (ser 0Nl)) -> 0 and friends.
(de (ser 0Nl)) -- 0Nl
(de (ser 0Nf)) -- 0Nf
(de (ser 0Ni)) -- 0Ni
(de (ser 0Nh)) -- 0Nh
;; 0Nb isn't a parseable literal in Rayfall yet — covered at the C
;; level by test_store.c:/serde_typed_null_atoms.
;; Non-null atoms still roundtrip cleanly.
(de (ser 42)) -- 42
(de (ser 3.14)) -- 3.14
(de (ser 'hello)) -- 'hello
(de (ser "world")) -- "world"
(de (ser true)) -- true
;; Lazy scalar values materialise at the serialization boundary.
(de (ser (sum [1 2 3]))) -- 6

;; ────────────── homogeneous vectors round-trip ──────────────
(de (ser [1 2 3]))     -- [1 2 3]
(de (ser [1.5 2.5]))   -- [1.5 2.5]
(de (ser ["a" "b"]))   -- ["a" "b"]
(de (ser ['a 'b]))     -- ['a 'b]

;; ────────────── vectors with embedded nulls ──────────────
;; Both the value bits AND the null mask must survive serialize/deser.
(count (de (ser [1 0N 3]))) -- 3
(sum (de (ser [1 0N 3])))   -- 4

;; Container-frame count/length validation (table schema-vs-columns, ragged
;; columns, dict keys-vs-values) is covered in test/test_store.c
;; (store/serde_container_count_mismatch), which builds frames via
;; sizeof(ray_ipc_header_t) rather than hard-coding the wire layout.

;; ────────────── builtins serialize by their FULL name ──────────────
;; Regression: the encoder capped builtin names at 15 bytes, so a longer name
;; was written truncated and failed to resolve on decode.  Both of these
;; registered builtins exceed 15 chars.  Prove the round-trip BEHAVIOURALLY —
;; the decoded value is the real function, so calling it reaches that
;; function's own argument check; before the fix decode raised a 'name error.
;; A `-- .db.parted.tables` golden could NOT prove this: the formatter renders
;; a builtin through ray_fn_name's 13-byte inline copy, so both sides would
;; read `.db.parted.ta` and match on dev too.  Pointer identity is asserted at
;; the C level in test_store.c (store/serde_builtin_name_roundtrip).
((de (ser .db.parted.tables)) 123)    !- type
((de (ser .sys.querylog.enable)) 1 2) !- domain

;; ────────────── a parted table ──────────────
;; ser writes a parted table (.db.parted.get) as the flat table it stands
;; for, streamed from the partition segments without a flat copy: each
;; column byte-identical to the flattened column, the date key repeated on
;; every row of its partition, and de reads back a plain table.  It failed
;; with a misleading `domain: zero serialized size`.
(.sys.exec "rm -rf /tmp/rfl_serde_parted")
(set Gser (guid 7))
(set mkser (fn [lo n] (table [i j h f b s t g ts l] (list (+ lo (til n)) (as 'I32 (+ lo (til n))) (as 'I16 (+ lo (til n))) (as 'F64 (+ lo (til n))) (as 'B8 (% (+ lo (til n)) 2)) (take (drop ['x 'y 'zz 'x 'q 'r 'x] lo) n) (as 'STR (map (fn [x] (as 'STR x)) (+ lo (til n)))) (take (drop Gser lo) n) (as 'TIMESTAMP (+ lo (til n))) (map (fn [x] (list x (as 'STR x))) (+ lo (til n)))))))
(set Aser (mkser 0 3))
(set Bser (mkser 3 2))
(set Cser (mkser 5 2))
(.db.splayed.set "/tmp/rfl_serde_parted/f/2024.01.01/t/" Aser)
(.db.splayed.set "/tmp/rfl_serde_parted/f/2024.01.02/t/" Bser)
(.db.splayed.set "/tmp/rfl_serde_parted/f/2024.01.03/t/" Cser)
(set Pser (.db.parted.get "/tmp/rfl_serde_parted/f/" 't))
(set Dser [2024.01.01 2024.01.01 2024.01.01 2024.01.02 2024.01.02 2024.01.03 2024.01.03])
(set catser (fn [c] (concat (concat (at Aser c) (at Bser c)) (at Cser c))))
(set Fser (table [date i j h f b s t g ts l] (list Dser (catser 'i) (catser 'j) (catser 'h) (catser 'f) (catser 'b) (catser 's) (catser 't) (catser 'g) (catser 'ts) (catser 'l))))
(ser Pser) -- (ser Fser)
(ser Pser) -- (ser (select {from: Pser where: (>= i 0)}))
(de (ser Pser)) -- Fser
(count (de (ser Pser))) -- 7
(ser (list Pser 1)) -- (ser (list Fser 1))
(ser (dict [k] (list Pser))) -- (ser (dict [k] (list Fser)))
(de (ser (list 1 (dict [k] (list Pser))))) -- (list 1 (dict [k] (list Fser)))
;; a ragged table: the 2024.01.02 partition has no columns h..l, so their
;; segments are NULL; its rows go out as typed nulls (B8, which has none,
;; as false), exactly as the same flat table with nulls
(.db.splayed.set "/tmp/rfl_serde_parted/r/2024.01.01/t/" Aser)
(.db.splayed.set "/tmp/rfl_serde_parted/r/2024.01.02/t/" (table [i j] (list (at Bser 'i) (at Bser 'j))))
(.db.splayed.set "/tmp/rfl_serde_parted/r/2024.01.03/t/" Cser)
(set Rser (.db.parted.get "/tmp/rfl_serde_parted/r/" 't))
(set nulser (fn [c n] (concat (concat (at Aser c) n) (at Cser c))))
(set Gnul (at (left-join [k] (table [k] (list [0 0])) (table [k g] (list [1] (take Gser 1)))) 'g))
(set Nser (table [date i j h f b s t g ts l] (list Dser (catser 'i) (catser 'j) (nulser 'h (as 'I16 [0N 0N])) (nulser 'f (take 0Nf 2)) (nulser 'b [false false]) (nulser 's (as 'SYM (list "" ""))) (nulser 't (as 'STR (list "" ""))) (nulser 'g Gnul) (nulser 'ts (as 'TIMESTAMP [0N 0N])) (nulser 'l (list null null)))))
(ser Rser) -- (ser Nser)
(de (ser Rser)) -- Nser
(at (de (ser Rser)) 'f) -- [0.0 1.0 2.0 0Nf 0Nf 5.0 6.0]
(ser (list Rser 1)) -- (ser (list Nser 1))
;; and it prints as that flat table: typed nulls in the partition's rows
;; (format "%" printed the column flattened by `at`, short of those rows)
(format "%" Rser) -- (format "%" Nser)
(format "%" Pser) -- (format "%" Fser)
;; SYM segments of different index widths (W8, then W16 past 256 symbols)
;; and an integer partition key
(.db.splayed.set "/tmp/rfl_serde_parted/w/0/t/" (table [a s] (list [1 2 3] ['x 'y 'x])))
(.db.splayed.set "/tmp/rfl_serde_parted/w/1/t/" (table [a s] (list (til 400) (as 'SYM (map (fn [x] (as 'STR (+ 1000 x))) (til 400))))))
(.db.splayed.set "/tmp/rfl_serde_parted/w/2/t/" (table [a s] (list [7 8] ['y 'x])))
(set Wser (.db.parted.get "/tmp/rfl_serde_parted/w/" 't))
(ser Wser) -- (ser (select {from: Wser where: (>= a 0)}))
(at (at (de (ser Wser)) 's) [0 3 402 403 404]) -- ['x '1000 '1399 'y 'x]
(at (at (de (ser Wser)) 'part) [0 3 403]) -- [0 1 2]
(.sys.exec "rm -rf /tmp/rfl_serde_parted") -- 0
