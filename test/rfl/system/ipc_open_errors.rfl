;; @requires: posix  (fixtures/checks run through a POSIX shell via .sys.exec)
;; ipc_open_errors.rfl — `.ipc.open` names the failure it actually hit.
;;
;; Regression (#472): the connect and the wire handshake share one budget,
;; installed as SO_RCVTIMEO/SO_SNDTIMEO after the connect.  A server that
;; is alive and listening but inside a long evaluation completes the TCP
;; handshake in the kernel and never answers the wire handshake, so the
;; recv timed out — and ray_ipc_connect returned the generic -1 that
;; `.ipc.open` printed as "connection refused", byte-identical to a dead
;; port that fails instantly.
;;
;; Server lifecycle is shell-driven like ipc_diff.rfl (by pid, so no pattern
;; can match the shell that runs it, or another suite's): a second rayforce
;; on a free port of its own (test/serve.sh --listen, #1140) whose script
;; reads a FIFO nobody writes, so the listener is up (-p binds before the
;; script runs) and nobody serves the handshake until the teardown kills the
;; server.  The block is in the server itself, not in a timed child: a sleep
;; ends on its own clock, and once readiness detection took longer than the
;; sleep (lsof on macOS counted the sleep, which inherits the listening
;; socket, as a second listener) the server was answering before the first
;; open.  The refused connect goes to a port nothing listens on (serve.sh
;; --port).
(.sys.exec "rm -rf /tmp/rfl_ipc_deaf; mkdir -p /tmp/rfl_ipc_deaf; mkfifo /tmp/rfl_ipc_deaf/block; printf '(read \"/tmp/rfl_ipc_deaf/block\")\n' > /tmp/rfl_ipc_deaf.rfl") -- 0
;; the kernel accepts into the backlog even though nobody answers
(.sys.exec "test/serve.sh --listen /tmp/rfl_ipc_deaf/srv /tmp/rfl_ipc_deaf.rfl") -- 0
(.sys.exec "test/serve.sh --port > /tmp/rfl_ipc_deaf/free") -- 0
(set deaf (format "127.0.0.1:%" (trim (read "/tmp/rfl_ipc_deaf/srv/port"))))
(set dead (format "127.0.0.1:%" (trim (read "/tmp/rfl_ipc_deaf/free"))))

(.sys.exec "D=/tmp/rfl_ipc_deaf; printf '(println (.ipc.open \"127.0.0.1:%s\" 300))\n' $(cat $D/srv/port) > /tmp/rfl_ipc_c1.rfl")
(.sys.exec "D=/tmp/rfl_ipc_deaf; printf '(println (.ipc.open \"127.0.0.1:%s\" 300))\n' $(cat $D/free) > /tmp/rfl_ipc_c2.rfl")
(.sys.exec "D=/tmp/rfl_ipc_deaf; printf '(println (.ipc.open \"no-such-host.invalid:%s\" 300))\n' $(cat $D/free) > /tmp/rfl_ipc_c3.rfl")

;; listening but not answering: the budget expires, and the line says so
(.ipc.open deaf 300) !- io
(.sys.exec "D=/tmp/rfl_ipc_deaf; ./rayforce /tmp/rfl_ipc_c1.rfl </dev/null 2>&1 | grep -q \"error: io: connection timed out: 127.0.0.1:$(cat $D/srv/port)\"") -- 0

;; nothing bound: refused, and instantly
(.ipc.open dead 300) !- io
(.sys.exec "D=/tmp/rfl_ipc_deaf; ./rayforce /tmp/rfl_ipc_c2.rfl </dev/null 2>&1 | grep -q \"error: io: connection refused: 127.0.0.1:$(cat $D/free)\"") -- 0

;; a host that does not resolve is neither
(.sys.exec "D=/tmp/rfl_ipc_deaf; ./rayforce /tmp/rfl_ipc_c3.rfl </dev/null 2>&1 | grep -q \"error: io: connect failed: no-such-host.invalid:$(cat $D/free): \"") -- 0

(.sys.exec "D=/tmp/rfl_ipc_deaf; test/serve.sh --stop $D/srv KILL; rm -rf $D /tmp/rfl_ipc_deaf.rfl /tmp/rfl_ipc_c1.rfl /tmp/rfl_ipc_c2.rfl /tmp/rfl_ipc_c3.rfl; true")
