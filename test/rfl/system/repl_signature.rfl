;; .repl.signature: how a named global is called, read without calling it
;; (#947).  Lambdas give their parameters, builtins their calling convention
;; and documented usage; a missing name is an ordinary result.
(set zsg_add (fn [a b] (+ a b)))
(set zsg_calls 0)
(set zsg_bump (fn [x] (set zsg_calls (+ zsg_calls 1)) x))
(set zsg_v 42)
(set zsg_D (dict ['f 'n] (list (fn [x y z] x) 5)))
;; a lambda
(at (.repl.signature 'zsg_add) 'kind) -- 'lambda
(at (.repl.signature 'zsg_add) 'params) -- ['a 'b]
(at (.repl.signature 'zsg_add) 'arity) -- 2
(at (.repl.signature 'zsg_add) 'callable) -- true
(at (.repl.signature 'zsg_add) 'special) -- false
(at (.repl.signature 'zsg_add) 'usage) -- ""
;; an alias reports the function it holds; a reassignment the new one
(set zsg_al zsg_add)
(at (.repl.signature 'zsg_al) 'params) -- ['a 'b]
(set zsg_add (fn [x] x))
(at (.repl.signature 'zsg_add) 'params) -- ['x]
(at (.repl.signature 'zsg_al) 'params) -- ['a 'b]
;; asking does not call the function
(.repl.signature 'zsg_bump)
zsg_calls -- 0
;; builtins: the calling convention, the usage text, the own name
(at (.repl.signature 'count) 'kind) -- 'unary
(at (.repl.signature '+) 'kind) -- 'binary
(at (.repl.signature 'select) 'kind) -- 'vary
(at (.repl.signature 'min) 'usage) -- "(min <x: vector, atom or list>) or (min <a: num> <b: num>)"
(at (.repl.signature 'min) 'arity) -- 0Nl
(set zsg_m min)
(at (.repl.signature 'zsg_m) 'builtin) -- 'min
(at (.repl.signature 'zsg_m) 'kind) -- 'unary
;; the builtin's own name is read from the function object, not from the
;; first global holding it: a builtin name rebound to another builtin
;; reports the one it holds now, with that one's usage
(set zsg_first first)
(set first raise)
(at (.repl.signature 'first) 'builtin) -- 'raise
(at (.repl.signature 'first) 'usage) -- (at (.repl.signature 'raise) 'usage)
(set first zsg_first)
(at (.repl.signature 'first) 'builtin) -- 'first
(set zsg_keep count)
(set count til)
(at (.repl.signature 'count) 'builtin) -- 'til
(at (.repl.signature 'count) 'usage) -- (at (.repl.signature 'til) 'usage)
(set count zsg_keep)
(at (.repl.signature 'count) 'builtin) -- 'count
(at (.repl.signature 'zsg_keep) 'builtin) -- 'count
;; a name longer than the object inlines, directly and through an alias
(at (.repl.signature '.sys.querylog.enable) 'builtin) -- '.sys.querylog.enable
(set zsg_q .sys.querylog.enable)
(at (.repl.signature 'zsg_q) 'builtin) -- '.sys.querylog.enable
(at (.repl.signature 'zsg_q) 'usage) -- (at (.repl.signature '.sys.querylog.enable) 'usage)
;; a long name's usage is matched on the whole name, also where several
;; names share their first 13 bytes
(at (.repl.signature '.sys.querylog.enable) 'usage) -- "(.sys.querylog.enable [<on: i64, 0 or 1>])"
(at (.repl.signature '.sys.querylog) 'usage) -- "(.sys.querylog [<from: i64, a seq>])"
(at (.repl.signature '.sys.querylog.stats) 'usage) -- "(.sys.querylog.stats)"
(at (.repl.signature '.sys.profile.reset) 'usage) -- "(.sys.profile.reset)"
;; special forms and restricted builtins
(at (.repl.signature 'if) 'special) -- true
(at (.repl.signature 'set) 'special) -- true
(at (.repl.signature 'set) 'restricted) -- true
(at (.repl.signature '.sys.exec) 'restricted) -- true
(at (.repl.signature '.repl.signature) 'usage) -- "(.repl.signature <name: sym>)"
;; a value, a dict member, a missing name
(at (.repl.signature 'zsg_v) 'kind) -- 'value
(at (.repl.signature 'zsg_v) 'callable) -- false
(at (.repl.signature 'zsg_D.f) 'params) -- ['x 'y 'z]
(at (.repl.signature 'zsg_D.n) 'kind) -- 'value
(at (.repl.signature 'zsg_nosuch) 'kind) -- 'missing
;; a namespace root is a namespace, true and false are literals, not
;; undefined names; a user dict stays a value (above)
(at (.repl.signature '.sys) 'kind) -- 'namespace
(at (.repl.signature '.sys) 'bound) -- true
(at (.repl.signature 'true) 'kind) -- 'literal
(at (.repl.signature 'false) 'bound) -- false
(at (.repl.signature 'zsg_nosuch) 'bound) -- false
(at (.repl.signature 'zsg_D.nosuch) 'bound) -- false
;; summary: a builtin's one line from src/lang/sig.c (#1737), the held
;; builtin's through an alias; "" for anything else, never invented
(at (.repl.signature 'count) 'summary) -- "Count of elements"
(at (.repl.signature 'zsg_m) 'summary) -- (at (.repl.signature 'min) 'summary)
(at (.repl.signature '.sys.querylog.enable) 'summary) -- "Toggle query-statistics logging; returns new state"
(at (.repl.signature 'zsg_add) 'summary) -- ""
(at (.repl.signature 'zsg_v) 'summary) -- ""
(at (.repl.signature '.sys) 'summary) -- ""
(at (.repl.signature 'true) 'summary) -- ""
(at (.repl.signature 'zsg_nosuch) 'summary) -- ""
;; how a builtin treats a collection (#1744), from what the engine records:
;; atomic (RAY_FN_ATOMIC, it maps vectors and lists), elementwise per
;; argument over vectors (the row-shape record), aggregate (RAY_FN_AGGR)
(at (.repl.signature '+) 'atomic) -- true
(at (.repl.signature '+) 'elementwise) -- [true true]
(at (.repl.signature 'sin) 'atomic) -- false
(at (.repl.signature 'sin) 'elementwise) -- [true]
(at (.repl.signature 'in) 'elementwise) -- [true false]
(at (.repl.signature 'substr) 'elementwise) -- [true false false]
(at (.repl.signature 'and) 'elementwise) -- [true true]
;; a timestamp's date and time, trunc's values, split's text, the texts
;; .emb.tokens reads (#1755)
(at (.repl.signature 'date) 'elementwise) -- [true]
(at (.repl.signature 'time) 'elementwise) -- [true]
(at (.repl.signature 'trunc) 'elementwise) -- [false true]
(at (.repl.signature 'split) 'elementwise) -- [true false]
(at (.repl.signature '.emb.tokens) 'elementwise) -- [false true]
(at (.repl.signature 'sum) 'aggregate) -- true
(at (.repl.signature 'sum) 'elementwise) -- [false]
(at (.repl.signature 'min) 'aggregate) -- true
(at (.repl.signature 'min) 'elementwise) -- [false]
(at (.repl.signature 'zsg_m) 'aggregate) -- true
(at (.repl.signature 'select) 'elementwise) -- (as 'B8 [])
;; nothing for what is no builtin
(at (.repl.signature 'zsg_add) 'atomic) -- false
(at (.repl.signature 'zsg_add) 'elementwise) -- (as 'B8 [])
(at (.repl.signature 'zsg_v) 'aggregate) -- false
(at (.repl.signature '.sys) 'atomic) -- false
(at (.repl.signature 'true) 'elementwise) -- (as 'B8 [])
(at (.repl.signature 'zsg_nosuch) 'aggregate) -- false
;; the argument is a symbol
(.repl.signature "zsg_add") !- type
(.repl.signature 42) !- type
;; first, last, top and bot are aggregates, flagged as such (#1814)
(at (.repl.signature 'first) 'aggregate) -- true
(at (.repl.signature 'last) 'aggregate) -- true
(at (.repl.signature 'top) 'aggregate) -- true
(at (.repl.signature 'bot) 'aggregate) -- true
(at (.repl.signature 'reverse) 'aggregate) -- false
;; update, delete, insert and upsert are refused under -U only on a named
;; target: restricted_named, not restricted; set is refused whatever its
;; arguments (#1878)
(at (.repl.signature 'update) 'restricted) -- false
(at (.repl.signature 'update) 'restricted_named) -- true
(at (.repl.signature 'delete) 'restricted_named) -- true
(at (.repl.signature 'insert) 'restricted_named) -- true
(at (.repl.signature 'upsert) 'restricted_named) -- true
(at (.repl.signature 'set) 'restricted) -- true
(at (.repl.signature 'set) 'restricted_named) -- false
(at (.repl.signature 'count) 'restricted_named) -- false
