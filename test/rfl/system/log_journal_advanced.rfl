;; @requires: posix  (fixtures/checks run through a POSIX shell via .sys.exec)
;; Journal feature — invariants the basic test (log_journal.rfl) does
;; not cover.  Each phase uses a distinct base + port so a phase
;; failing mid-run doesn't pollute the next one's state.
;;
;; Phase A: -L sync mode survives kill -9 (durability promise of -L)
;; Phase B: user override of a builtin survives snapshot/restart
;;          (regression trap for the env user-flag invariant)
;; Phase C: per-entry eval error in log warns-and-continues, doesn't
;;          abort replay (commit message documents this; basic test
;;          only exercises framing badtail)
;; Phase D: .log.write is rejected inside auto-journaled IPC eval
;; Phase E: closure-bearing functions saved in a snapshot survive restart

;; ── IPC connect with handshake-level retry ──────────────────────────
;; Servers take a free port of their own and are stopped by their pid
;; (test/serve.sh, which also waits for a handshake), so suites running at
;; once never meet (#1140).  The retry below stays as a second guard.
;; A /dev/tcp probe reports ready the instant the server calls listen(),
;; but a server restarted on a journal base is still replaying when the
;; port first accepts SYNs — an .ipc.open landing in that window gets
;; `io` before the accept/handshake loop is live (intermittent on loaded
;; macOS CI).  The .ipc.open timeout arg bounds a *single* connect+
;; handshake (default already 5s), so it can't paper over this; retry the
;; open itself, short per-attempt, until the server completes a handshake.
(set wait_ipc (fn [addr n] (try (.ipc.open addr 500) (if (== n 0) (.ipc.open addr 500) (do (.sys.exec "sleep 0.1") (wait_ipc addr (- n 1)))))))

;; ════════════════════════════════════════════════════════════════════
;; Phase A — -L durability under kill -9
;; ════════════════════════════════════════════════════════════════════
;; The whole point of -L is "fsync per write so a hard kill mid-handler
;; doesn't lose the message".  -l (async) might survive SIGTERM thanks
;; to OS buffers but -L is the contract; if it stopped fsyncing the
;; current test suite would not notice.  Use kill -9 (no clean
;; shutdown, no fclose, no fflush) so only the on-disk bytes count.

(.sys.exec "rm -f /tmp/rftest_jdura*")
(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s1 -L /tmp/rftest_jdura") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s1/port"))))

(set hA (wait_ipc addr 50))
(.ipc.send hA "(set durable_a 7)") -- 7
(.ipc.send hA "(set durable_b \"survived\")") -- "survived"
(.ipc.close hA)

;; SIGKILL — no atexit, no fclose, no fflush.  Only the bytes the
;; SYNC fsync put on disk count.
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s1 KILL") -- 0

;; Restart with -L on the same base.  Both bindings must come back.
(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s2 -L /tmp/rftest_jdura") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s2/port"))))

(set hA2 (wait_ipc addr 50))
(.ipc.send hA2 "durable_a") -- 7
(.ipc.send hA2 "durable_b") -- "survived"
(.ipc.close hA2)
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s2 KILL") -- 0
(.sys.exec "rm -f /tmp/rftest_jdura*")

;; ════════════════════════════════════════════════════════════════════
;; Phase B — user override of a builtin survives snapshot
;; ════════════════════════════════════════════════════════════════════
;; (set + 42) flips the slot at `+` to user=1.  The slot SHOULD be
;; included in the next .log.snapshot so the override survives a
;; restart loaded from .qdb.  If the user-flag upgrade in
;; env_bind_global_impl regresses, this test catches it; the basic
;; log_journal test only writes fresh user globals (a/b/c/d) and
;; would miss the regression silently.

(.sys.exec "rm -f /tmp/rftest_jovr*")
(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s3 -l /tmp/rftest_jovr") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s3/port"))))

(set hB (wait_ipc addr 50))
;; Override the `+` builtin with a sentinel integer, then snapshot.
;; The snapshot's .qdb must contain `+` -> 42 so phase-B-restart can
;; load it from .qdb (not from log replay, which is also rolled).
(.ipc.send hB "(set + 42)") -- 42
(.ipc.send hB "+") -- 42
(.ipc.send hB "(.log.snapshot)")
(.ipc.close hB)
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s3 TERM") -- 0

(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s4 -l /tmp/rftest_jovr") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s4/port"))))

(set hB2 (wait_ipc addr 50))
;; The override must have survived the .qdb roundtrip.
(.ipc.send hB2 "+") -- 42
(.ipc.close hB2)
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s4 KILL") -- 0
(.sys.exec "rm -f /tmp/rftest_jovr*")

;; ════════════════════════════════════════════════════════════════════
;; Phase C — per-entry eval error during replay warns-and-continues
;; ════════════════════════════════════════════════════════════════════
;; Send 3 mutations.  Middle one references an undefined symbol —
;; will error on REPLAY (it errored on original eval too, but log
;; was written before eval).  Restart must still apply the first and
;; third.  Without the documented hybrid policy the whole replay
;; would abort and surviving server would not have c1 / c3 set.

(.sys.exec "rm -f /tmp/rftest_jerr*")
(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s5 -l /tmp/rftest_jerr") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s5/port"))))

(set hC (wait_ipc addr 50))
(.ipc.send hC "(set c1 100)") -- 100
;; This one errors on the server (undefined `not_a_thing`) — the
;; .ipc.send returns an error response, but the inbound message was
;; journaled before eval.
(try (.ipc.send hC "(set c2 not_a_thing)") (fn [e] 0))
(.ipc.send hC "(set c3 300)") -- 300
(.ipc.close hC)
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s5 TERM") -- 0

(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s6 -l /tmp/rftest_jerr") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s6/port"))))

(set hC2 (wait_ipc addr 50))
(.ipc.send hC2 "c1") -- 100
;; c2 is expected to be undefined (the bad replay entry was warn-
;; skipped, not applied).  Use try to catch the undefined-name error.
(try (.ipc.send hC2 "c2") (fn [e] "missing")) -- "missing"
(.ipc.send hC2 "c3") -- 300
(.ipc.close hC2)
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s6 KILL") -- 0
(.sys.exec "rm -f /tmp/rftest_jerr*")

;; ════════════════════════════════════════════════════════════════════
;; Phase D — .log.write inside auto-journaled IPC eval is rejected
;; ════════════════════════════════════════════════════════════════════
;; A journaled server logs every SYNC IPC payload before evaluation.
;; Letting the payload call .log.write as well would persist nested
;; writes in addition to the already-logged outer request.

(.sys.exec "rm -f /tmp/rftest_jwr*")
(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s7 -l /tmp/rftest_jwr") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s7/port"))))

(set hD (wait_ipc addr 50))
(.ipc.send hD "(.log.write \"(set d1 999)\")") !- domain
(.ipc.close hD)
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s7 TERM") -- 0
(.sys.exec "rm -f /tmp/rftest_jwr*")

;; ════════════════════════════════════════════════════════════════════
;; Phase E — function bindings survive snapshot restart
;; ════════════════════════════════════════════════════════════════════
;; A function-bearing snapshot must load into a fresh server runtime.
;; The binding should be callable after the .qdb restore, before any
;; post-snapshot log tail can recreate it.

(.sys.exec "rm -f /tmp/rftest_jsnapfn*")
(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s8 -l /tmp/rftest_jsnapfn") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s8/port"))))

(set hE (wait_ipc addr 50))
(.ipc.send hE "(set snapshot_inc ((fn [offset] (fn [x] (+ x offset))) 1))")
(.ipc.send hE "(snapshot_inc 41)") -- 42
(.ipc.send hE "(.log.snapshot)")
(.ipc.close hE)
(.sys.exec "test -s /tmp/rftest_jsnapfn.qdb") -- 0
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s8 TERM") -- 0
(.sys.exec "rm -f /tmp/rftest_jsnapfn.log") -- 0

(.sys.exec "test/serve.sh /tmp/rfl_jasrv/s9 -l /tmp/rftest_jsnapfn") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rfl_jasrv/s9/port"))))

(set hE2 (wait_ipc addr 50))
(.ipc.send hE2 "(snapshot_inc 41)") -- 42
(.ipc.close hE2)
(.sys.exec "test/serve.sh --stop /tmp/rfl_jasrv/s9 KILL") -- 0
(.sys.exec "rm -f /tmp/rftest_jsnapfn*; rm -rf /tmp/rfl_jasrv")
