;; @requires: posix
;; Parquet shapes common writers emit by default that the reader once
;; rejected (PR 657 review): RLE-encoded booleans (the v2 default), a
;; zero-row row group, and long strings past one 64 MiB batch pool.

;; RLE booleans, v1 and v2 pages, with nulls: 40 rows, 4 null, 22 true
(set b1 (.parquet.read "test/data/parquet/bool-rle-v1.parquet"))
(set b2 (.parquet.read "test/data/parquet/bool-rle-v2.parquet"))
(count b1) -- 40
(count (select {from: b1 where: (== b true)})) -- 22
(count (select {from: b2 where: (== b true)})) -- 22
(count (select {from: b2 where: (nil? b)})) -- 4
;; nullable booleans decode to I16 (BOOL has no null)
(at (at b2 'b) 4) -- 0
(at (at b2 'b) 39) -- 1

;; a zero-row group between two populated ones
(set eg (.parquet.read "test/data/parquet/empty-group.parquet"))
(count eg) -- 5
(sum (at eg 'x)) -- 13
(at (at eg 's) 3) -- "four"
(.sys.exec "rm -rf rf_test_pq_eg_parted") -- 0
(.parquet.parted "test/data/parquet/empty-group.parquet" "rf_test_pq_eg_parted" 'e) -- 5
(count (select {from: (.db.parted.get "rf_test_pq_eg_parted" 'e)})) -- 5
(.sys.exec "rm -rf rf_test_pq_eg_parted") -- 0

;; 8000 rows x 9000-byte strings (~72 MB decoded): the reader splits the
;; row group into batches whose string pools stay near 64 MiB.
(.sys.exec "python3 test/data/parquet/generate.py --long-strings rf_test_pq_long.parquet") -- 0
(set lg (.parquet.read "rf_test_pq_long.parquet"))
(count lg) -- 8000
(sum (at lg 'id)) -- 31996000
(sum (map count (at lg 'doc))) -- 72000000
(set nb 0)
(.parquet.each "rf_test_pq_long.parquet" (fn [batch] (set nb (+ nb 1)))) -- 8000
(> nb 1) -- true
(.sys.exec "rm -f rf_test_pq_long.parquet") -- 0
