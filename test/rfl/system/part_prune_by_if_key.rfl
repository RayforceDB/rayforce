(xasc (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (> v 100) 1 0)} from: C where: (== date 2026.01.07)}) (key (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (> v 100) 1 0)} from: C where: (== date 2026.01.07)}))) -- (xasc (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (> v 100) 1 0)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))}) (key (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (> v 100) 1 0)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))})))
(xasc (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (>= ts 2026.01.06D06:00:00.000)}) (key (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (>= ts 2026.01.06D06:00:00.000)}))) -- (xasc (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (or false (>= ts 2026.01.06D06:00:00.000) (>= ts 2026.01.06D06:00:00.000))}) (key (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (or false (>= ts 2026.01.06D06:00:00.000) (>= ts 2026.01.06D06:00:00.000))})))
(xasc (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}) (key (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}))) -- (xasc (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (or false (and (>= ts 2026.01.06D00:00:00.000) (> v 2)) (and (>= ts 2026.01.06D00:00:00.000) (> v 2)))}) (key (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (or false (and (>= ts 2026.01.06D00:00:00.000) (> v 2)) (and (>= ts 2026.01.06D00:00:00.000) (> v 2)))})))
(xasc (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (== date 2026.01.07)}) (key (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (== date 2026.01.07)}))) -- (xasc (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))}) (key (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))})))
