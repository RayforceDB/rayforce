;; @requires: posix  (fixtures run through a POSIX shell via .sys.exec)
;; #1604: a by: key that computes an if skips the partitions a comparison of
;; a timestamp column rules out, as a key of arithmetic does.  The key is an
;; if of the bounded grammar (branches of one type, I64, F64 or SYM;
;; conditions comparisons of a column with a constant): it reads only its
;; row, and since #1605 the evaluator's if chooses per row for a BOOL vector
;; condition, so every route groups the kept rows alike.
;;
;; A skip is made visible without a clock: two date partitions of 70 000
;; uncompressed rows (enough for the ts column to carry statistics), and
;; the second partition's ts values copied over the first partition's ts
;; data in place, keeping its header and statistics.  A select that skips
;; the first partition by its statistics counts the second's rows alone; one
;; that reads it counts them twice.  A second, untouched root checks every
;; answer against the same select with pruning off: the where written as
;; (or false p p), which narrows no partition.

(set R (format "/tmp/rfl_part_prune_by_if_%" (get (.sys.info) 'pid)))
(.sys.exec (format "rm -rf % && mkdir -p %/stale %/clean" R R R)) -- 0
(set n 70000)
(set mk (fn [d] (table [ts s v w] (list (+ d (* 1000000 (til n))) (at ['x 'y 'z] (% (til n) 3)) (at [1 0Nl 3 400 5 0Nl 7] (% (til n) 7)) (at [0.5 1.5 0Nf 100.0] (% (til n) 4))))))
(.db.splayed.set (format "%/stale/2026.01.05/t/" R) (mk 2026.01.05D00:00:00.000) (format "%/stale/.sym" R) {compress: false})
(.db.splayed.set (format "%/stale/2026.01.06/t/" R) (mk 2026.01.06D00:00:00.000) (format "%/stale/.sym" R) {compress: false})
(.sys.exec (format "dd if=%/stale/2026.01.06/t/ts of=%/stale/2026.01.05/t/ts bs=8 skip=4 seek=4 count=70000 conv=notrunc 2>/dev/null" R R)) -- 0
(set P (.db.parted.get (format "%/stale/" R) 't))
(.db.splayed.set (format "%/clean/2026.01.05/t/" R) (mk 2026.01.05D00:00:00.000) (format "%/clean/.sym" R) {compress: true})
(.db.splayed.set (format "%/clean/2026.01.06/t/" R) (mk 2026.01.06D00:00:00.000) (format "%/clean/.sym" R) {compress: true})
(.db.splayed.set (format "%/clean/2026.01.07/t/" R) (mk 2026.01.07D00:00:00.000) (format "%/clean/.sym" R) {compress: true})
(set C (.db.parted.get (format "%/clean/" R) 't))

;; the control: a key of arithmetic skips
(sum (at (select {c: (count v) by: {k: (% v 2)} from: P where: (>= ts 2026.01.06D00:00:00.000)}) 'c)) -- 70000
;; a key computing an if: SYM, I64 and F64 branches, nested, beside a column
;; key, as a bare by: expression, and with another where: conjunct
(sum (at (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: P where: (>= ts 2026.01.06D00:00:00.000)}) 'c)) -- 70000
(sum (at (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: P where: (>= ts 2026.01.06D00:00:00.000)}) 'c)) -- 70000
(sum (at (select {c: (count v) by: {k: (if (< w 50.5) w 0.0)} from: P where: (>= ts 2026.01.06D00:00:00.000)}) 'c)) -- 70000
(sum (at (select {c: (count v) by: {k: (if (== s 'x) 'X (if (== s 'y) 'Y 'Z))} from: P where: (>= ts 2026.01.06D00:00:00.000)}) 'c)) -- 70000
(sum (at (select {c: (count v) by: {k: (if (== s 'x) 'X 'O) s: s} from: P where: (>= ts 2026.01.06D00:00:00.000)}) 'c)) -- 70000
(sum (at (select {c: (count v) by: (if (> v 1000) 'big 'small) from: P where: (>= ts 2026.01.06D00:00:00.000)}) 'c)) -- 70000
(sum (at (select {c: (count v) by: {k: (if (and (> v 10) (!= s 'z)) 'A 'B)} from: P where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}) 'c)) -- 40000
;; still read whole: branches of two types
(sum (at (select {c: (count v) by: {k: (if (== s 'x) 1 2.5)} from: P where: (>= ts 2026.01.06D00:00:00.000)}) 'c)) -- 140000

;; every answer equals the one without pruning, on the untouched root
(xasc (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (>= ts 2026.01.06D06:00:00.000)}) (key (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (>= ts 2026.01.06D06:00:00.000)}))) -- (xasc (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (>= ts 2026.01.06D06:00:00.000) (>= ts 2026.01.06D06:00:00.000))}) (key (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (>= ts 2026.01.06D06:00:00.000) (>= ts 2026.01.06D06:00:00.000))})))
(xasc (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}) (key (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}))) -- (xasc (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (and (>= ts 2026.01.06D00:00:00.000) (> v 2)) (and (>= ts 2026.01.06D00:00:00.000) (> v 2)))}) (key (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (and (>= ts 2026.01.06D00:00:00.000) (> v 2)) (and (>= ts 2026.01.06D00:00:00.000) (> v 2)))})))
(xasc (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (== date 2026.01.07)}) (key (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (== date 2026.01.07)}))) -- (xasc (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))}) (key (select {c: (count v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))})))
(xasc (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (>= ts 2026.01.06D06:00:00.000)}) (key (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (>= ts 2026.01.06D06:00:00.000)}))) -- (xasc (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (>= ts 2026.01.06D06:00:00.000) (>= ts 2026.01.06D06:00:00.000))}) (key (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (>= ts 2026.01.06D06:00:00.000) (>= ts 2026.01.06D06:00:00.000))})))
(xasc (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}) (key (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}))) -- (xasc (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (and (>= ts 2026.01.06D00:00:00.000) (> v 2)) (and (>= ts 2026.01.06D00:00:00.000) (> v 2)))}) (key (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (and (>= ts 2026.01.06D00:00:00.000) (> v 2)) (and (>= ts 2026.01.06D00:00:00.000) (> v 2)))})))
(xasc (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (== date 2026.01.07)}) (key (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (== date 2026.01.07)}))) -- (xasc (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))}) (key (select {c: (sum v) m: (max w) a: (avg v) by: {k: (if (== s 'x) 'X 'O)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))})))
(xasc (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (>= ts 2026.01.06D06:00:00.000)}) (key (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (>= ts 2026.01.06D06:00:00.000)}))) -- (xasc (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (or false (>= ts 2026.01.06D06:00:00.000) (>= ts 2026.01.06D06:00:00.000))}) (key (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (or false (>= ts 2026.01.06D06:00:00.000) (>= ts 2026.01.06D06:00:00.000))})))
(xasc (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}) (key (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (and (>= ts 2026.01.06D00:00:00.000) (> v 2))}))) -- (xasc (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (or false (and (>= ts 2026.01.06D00:00:00.000) (> v 2)) (and (>= ts 2026.01.06D00:00:00.000) (> v 2)))}) (key (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (or false (and (>= ts 2026.01.06D00:00:00.000) (> v 2)) (and (>= ts 2026.01.06D00:00:00.000) (> v 2)))})))
(xasc (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (== date 2026.01.07)}) (key (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (== date 2026.01.07)}))) -- (xasc (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))}) (key (select {c: (count v) by: {k: (if (> v 100) 1 0)} from: C where: (or false (== date 2026.01.07) (== date 2026.01.07))})))
