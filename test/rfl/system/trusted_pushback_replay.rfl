;; @requires: posix  (fixtures/checks run through a POSIX shell via .sys.exec)
;; #787: a trusted verb whose body waits on a sync `.ipc.send` serves the
;; requests its peer sends back meanwhile.  Such a pushed request is logged
;; between the verb's request and that request's journal note, so the note
;; names its request by log offset: after a restart the verb's write
;; replays, as it ran.
;;
;; The peer (unrestricted) answers `(bounce)` by sending a request back
;; over the same connection.  The server (`-U pw -l`) trusts `slowput`, which calls the peer and then writes `kv`,
;; and `snap`.  A client sends `(snap)`, then `(slowput 5)`.  The server is
;; then restarted with a boot script that leaves `kv` alone; replay, which
;; reaches the peer again, must leave `kv` = 5.

;; Each process takes a free port of its own and is stopped by its pid
;; (test/serve.sh), so suites running at once never meet (#1140); the
;; scripts that name a port are written once it is known.
(.sys.exec "rm -rf /tmp/rftest_trustpush; mkdir -p /tmp/rftest_trustpush; true") -- 0
(write "/tmp/rftest_trustpush/peer.rfl" "(set bounce (fn [] (.ipc.send (.ipc.handle) \"(+ 1 1)\")))\n")
(.sys.exec "test/serve.sh /tmp/rftest_trustpush/peer /tmp/rftest_trustpush/peer.rfl") -- 0
(write "/tmp/rftest_trustpush/boot.rfl" (concat "(set slowput (fn [v] (let h (.ipc.open \"127.0.0.1:" (concat (trim (read "/tmp/rftest_trustpush/peer/port")) "\")) (.ipc.send h \"(bounce)\") (.ipc.close h) (set kv v) v))\n(set snap (fn [] (.log.snapshot) 0))\n(.sys.trust ['slowput 'snap])\n")))

;; Run 1: the trusted verb runs, with a pushed request inside it.
(.sys.exec "test/serve.sh --listen /tmp/rftest_trustpush/s1 -U pw -l /tmp/rftest_trustpush/J /tmp/rftest_trustpush/boot.rfl") -- 0
(write "/tmp/rftest_trustpush/client1.rfl" (concat "(set h (.ipc.open \"127.0.0.1:" (concat (trim (read "/tmp/rftest_trustpush/s1/port")) (concat ":u:pw\"))\n" "(set a (.ipc.send h \"(snap)\"))\n(set b (try (.ipc.send h \"(slowput 5)\") (fn [e] -1)))\n(set c (try (.ipc.send h \"kv\") (fn [e] -1)))\n(write \"/tmp/rftest_trustpush/out1\" (format \"% % %\" a b c))\n(exit 0)\n"))))
(.sys.exec "./rayforce /tmp/rftest_trustpush/client1.rfl </dev/null >/dev/null 2>&1") -- 0
(.sys.exec "grep -qx '0 5 5' /tmp/rftest_trustpush/out1") -- 0
(.sys.exec "test/serve.sh --stop /tmp/rftest_trustpush/s1") -- 0

;; Run 2: recovery replays the verb's request with its note, past the
;; pushed request logged between the two.
(.sys.exec "test/serve.sh --listen /tmp/rftest_trustpush/s2 -U pw -l /tmp/rftest_trustpush/J /tmp/rftest_trustpush/boot.rfl") -- 0
(write "/tmp/rftest_trustpush/client2.rfl" (concat "(set h (.ipc.open \"127.0.0.1:" (concat (trim (read "/tmp/rftest_trustpush/s2/port")) (concat ":u:pw\"))\n" "(set c (try (.ipc.send h \"kv\") (fn [e] -1)))\n(write \"/tmp/rftest_trustpush/out2\" (format \"%\" c))\n(exit 0)\n"))))
(.sys.exec "./rayforce /tmp/rftest_trustpush/client2.rfl </dev/null >/dev/null 2>&1") -- 0
(.sys.exec "grep -qx '5' /tmp/rftest_trustpush/out2") -- 0
(.sys.exec "grep -q '(0 eval errors)' /tmp/rftest_trustpush/s2/server.log") -- 0

(.sys.exec "test/serve.sh --stop /tmp/rftest_trustpush/s2 && test/serve.sh --stop /tmp/rftest_trustpush/peer") -- 0
(.sys.exec "rm -rf /tmp/rftest_trustpush; true") -- 0
