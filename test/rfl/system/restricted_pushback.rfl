;; @requires: posix  (fixtures/checks run through a POSIX shell via .sys.exec)
;; A request a peer sends back while server code waits on a sync `.ipc.send`
;; runs on the server's stack, restricted on a `-U` server, with the waiting
;; code's frames open.  It binds only in frames it opens itself: a `let`
;; that would land in the waiting code's frame is refused, while one inside
;; its own `do` still binds.
;;
;; The peer (port 19956, unrestricted) answers `(rebind)` and `(own)` by
;; sending a request back over the same connection.  The server (port 19957,
;; -U) runs its startup script against the peer and records what it saw.
;; Expected: `1 6` (the waiting frame's `v` kept, the pushed `do` evaluated).

(.sys.exec "pkill -KILL -f '[r]ayforce -p 1995[67]' 2>/dev/null; rm -rf /tmp/rftest_pushback; mkdir -p /tmp/rftest_pushback; true") -- 0
(write "/tmp/rftest_pushback/peer.rfl" "(set rebind (fn [] (.ipc.send (.ipc.handle) \"(let v 99)\")))\n(set own (fn [] (.ipc.send (.ipc.handle) \"(do (let u 5) (+ u 1))\")))\n")
(write "/tmp/rftest_pushback/server.rfl" "(set peer (.ipc.open \"127.0.0.1:19956\"))\n(set r (do (let v 1) (try (.ipc.send peer \"(rebind)\") (fn [e] 0)) v))\n(set w (try (.ipc.send peer \"(own)\") (fn [e] -1)))\n(write \"/tmp/rftest_pushback/out\" (format \"% %\" r w))\n(exit 0)\n")

(.sys.exec "./rayforce -p 19956 /tmp/rftest_pushback/peer.rfl </dev/null >/dev/null 2>&1 &")
(.sys.exec "for i in $(seq 50); do bash -c 'exec 3<>/dev/tcp/127.0.0.1/19956 2>/dev/null && printf \"\\003\\000\" >&3 && read -t2 -n1 -u3 _' 2>/dev/null && exit 0; sleep 0.1; done; exit 1") -- 0

(.sys.exec "./rayforce -p 19957 -U pw /tmp/rftest_pushback/server.rfl </dev/null >/dev/null 2>&1") -- 0
(.sys.exec "grep -qx '1 6' /tmp/rftest_pushback/out") -- 0

(.sys.exec "pkill -TERM -f '[r]ayforce -p 19956' 2>/dev/null; for i in $(seq 50); do pgrep -f '[r]ayforce -p 19956' >/dev/null || exit 0; sleep 0.1; done; exit 1") -- 0
(.sys.exec "rm -rf /tmp/rftest_pushback; true") -- 0
