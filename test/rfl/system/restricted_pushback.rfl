;; @requires: posix  (fixtures/checks run through a POSIX shell via .sys.exec)
;; A request a peer sends back while server code waits on a sync `.ipc.send`
;; runs on the server's stack, restricted on a `-U` server, with the waiting
;; code's frames open.  It binds only in frames it opens itself: a `let`
;; that would land in the waiting code's frame is refused, while one inside
;; its own `do` still binds.
;;
;; The peer (unrestricted) answers `(rebind)` and `(own)` by sending a
;; request back over the same connection.  The server (-U) runs its startup
;; script against the peer and records what it saw.  Each takes a free port
;; of its own (test/serve.sh), and the peer is stopped by its pid (#1140).
;; Expected: `1 6` (the waiting frame's `v` kept, the pushed `do` evaluated).

(.sys.exec "rm -rf /tmp/rftest_pushback; mkdir -p /tmp/rftest_pushback; true") -- 0
(write "/tmp/rftest_pushback/peer.rfl" "(set rebind (fn [] (.ipc.send (.ipc.handle) \"(let v 99)\")))\n(set own (fn [] (.ipc.send (.ipc.handle) \"(do (let u 5) (+ u 1))\")))\n")

(.sys.exec "test/serve.sh /tmp/rftest_pushback/peer /tmp/rftest_pushback/peer.rfl") -- 0
(write "/tmp/rftest_pushback/server.rfl" (concat "(set peer (.ipc.open \"127.0.0.1:" (concat (trim (read "/tmp/rftest_pushback/peer/port")) "\"))\n(set r (do (let v 1) (try (.ipc.send peer \"(rebind)\") (fn [e] 0)) v))\n(set w (try (.ipc.send peer \"(own)\") (fn [e] -1)))\n(write \"/tmp/rftest_pushback/out\" (format \"% %\" r w))\n(exit 0)\n")))

(.sys.exec "./rayforce -p $(test/serve.sh --port) -U pw /tmp/rftest_pushback/server.rfl </dev/null >/dev/null 2>&1") -- 0
(.sys.exec "grep -qx '1 6' /tmp/rftest_pushback/out") -- 0

(.sys.exec "test/serve.sh --stop /tmp/rftest_pushback/peer") -- 0
(.sys.exec "rm -rf /tmp/rftest_pushback; true") -- 0
