;; `apply` zip-applies a binary fn over two args (vectors or scalars).
;; Signature: (apply fn x y).

;; scalar/scalar — returns a scalar
(apply + 5 10) -- 15
(apply * 3 4) -- 12

;; vec/vec — zip-applies pairwise
(apply + [1 2 3] [10 20 30]) -- [11 22 33]
(apply * [1 2 3] [4 5 6]) -- [4 10 18]
(apply - [10 20] [1 2]) -- [9 18]
(apply + [1 2] [3 4]) -- [4 6]
(apply * [1 2 3] [10 20 30]) -- [10 40 90]

;; Mismatched lengths take the shorter side.
(apply + [1 2 3 4] [10 20]) -- [11 22]

;; lambda
(apply (fn [x y] (+ x (* 2 y))) [1 2] [10 20]) -- [21 42]

;; floats
(apply + [1.5 2.5] [0.5 0.5]) -- [2.0 3.0]

;; result count matches input count
(set V (rand 50 100))
(set W (rand 50 100))
(count V) -- (count (apply + V W))

;; results are collected as map's are: a typed vector for atoms of one type
(type (apply + [1 2 3] [10 20 30])) -- 'I64
(type (apply + [1.5 2.5] [0.5 0.5])) -- 'F64
(type (apply concat ["a" "b"] ["x" "y"])) -- 'STR
(apply concat ["a" "b"] ["x" "y"]) -- ["ax" "by"]
(type (apply (fn [a b] (list a b)) [1 2] [3 4])) -- 'LIST
(apply (fn [a b] (list a b)) [1 2] [3 4]) -- (list (list 1 3) (list 2 4))
(apply (fn [a b] (if (> a 1) b a)) [1 2 3] [1.5 2.5 3.5]) -- (list 1 2.5 3.5)

;; a list and a typed vector pair like two lists
(apply + [1 2] (list 10 20)) -- [11 22]
(apply + (list 1 2) [10 20]) -- [11 22]
(apply + [] []) -- (list)

;; exactly three arguments: a fourth would be dropped without a word
(apply + [1 2 3] [10 20 30] [100 200 300]) !- domain
(apply + [1 2 3]) !- domain
(apply + 1 2 3) !- domain

;; an atom beside a collection
(apply + [1 2 3] 5) !- type
(apply + 5 [1 2 3]) !- type

;; a large typed input is read in place
(set N (til 1000000))
(count (apply + N N)) -- 1000000
(last (apply + N N)) -- 1999998
