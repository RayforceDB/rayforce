;; map, fold, fold-right, scan and scan-right over typed vectors box one
;; element per call instead of the whole vector up front (#823).  Each
;; element type must still reach the function as the same atom, nulls
;; included, and an error part-way through must stop the walk cleanly.

;; element types reach the function unchanged
(map (fn [x] x) [1 2 3]) -- (list 1 2 3)
(map (fn [x] (+ x 1)) [1.5 2.5]) -- (list 2.5 3.5)
(map (fn [x] x) ['a 'b]) -- (list 'a 'b)
(map (fn [x] (count x)) (list "ab" "cde")) -- (list 2 3)
(map (fn [x] x) [true false]) -- (list true false)
(map (fn [x] (nil? x)) [1 0Nl 3]) -- (list false true false)
(map (fn [x] x) (as 'I32 [7 8])) -- (list 7i 8i)
(map (fn [x] x) []) -- (list)

;; binary map over a typed vector, and with a scalar
(map + 10 [1 2 3]) -- (list 11 12 13)
(map + 10 5) -- 15

;; fold: seeded, unseeded, single element, empty
(fold + 0 [1 2 3]) -- 6
(fold + [1 2 3]) -- 6
(fold + [42]) -- 42
(fold + 7 []) -- 7
(fold (fn [a x] (+ (* a 10) x)) 0 [1 2 3]) -- 123
(fold (fn [a x] (if (== x 'b) (+ a 1) a)) 0 ['a 'b 'b]) -- 2
(fold (fn [a x] (- a x)) [10 1 2]) -- 7

;; fold-right: order of arguments and of elements
(fold-right (fn [x a] (- x a)) [10 1 2]) -- 11
(fold-right (fn [x a] (+ (* a 10) x)) 0 [1 2 3]) -- 321
(fold-right + 5 []) -- 5

;; scan and scan-right through a lambda (the generic path)
(scan (fn [a x] (+ a x)) [1 2 3 4]) -- (list 1 3 6 10)
(scan (fn [a x] (+ a x)) [5]) -- (list 5)
(scan-right (fn [x a] (+ x a)) [1 2 3 4]) -- (list 10 9 7 4)
(scan-right (fn [x a] (+ x a)) [5]) -- (list 5)

;; the boxed element outlives its call when the function keeps it
(set kept (list))
(map (fn [x] (set kept (concat kept (list x)))) [4 5 6])
kept -- (list 4 5 6)

;; an error part-way through stops the walk
(map (fn [x] (if (== x 2) (+ x 'a) x)) [1 2 3]) !- type
(fold (fn [a x] (if (== x 2) (+ x 'a) (+ a x))) 0 [1 2 3]) !- type
(fold-right (fn [x a] (if (== x 2) (+ x 'a) (+ a x))) 0 [1 2 3]) !- type
(scan (fn [a x] (if (== x 3) (+ x 'a) (+ a x))) [1 2 3 4]) !- type
(scan-right (fn [x a] (if (== x 2) (+ x 'a) (+ a x))) [1 2 3 4]) !- type
