;; F32 vectors retain their element type through mapping and selecting verbs.
(set v (as 'F32 [2.5 -3.5]))
(type (+ v v)) -- 'F32
(type (- v v)) -- 'F32
(type (* v v)) -- 'F32
(type (neg v)) -- 'F32
(type (abs v)) -- 'F32
(type (floor v)) -- 'F32
(type (ceil v)) -- 'F32
(type (fill (as 'F32 0.0) (as 'F32 [1.0 0Nf]))) -- 'F32
(type (enlist (as 'F32 1.5) (as 'F32 2.5))) -- 'F32
(type (first v)) -- 'f32
(type (last v)) -- 'f32
(type (min v)) -- 'f32
(type (max v)) -- 'f32
(first (as 'F32 [0Nf 2.5])) -- 2.5e
(last (as 'F32 [2.5 0Nf])) -- 2.5e
(type (mins v)) -- 'F32
(type (maxs v)) -- 'F32
(type (mmin 2 v)) -- 'F32
(type (mmax 2 v)) -- 'F32
(type (min (as 'F32 [0Nf 2.5]))) -- 'f32
(nil? (min (as 'F32 [0Nf]))) -- true
(type (mins (as 'F32 [0Nf 2.5]))) -- 'F32
(at (table [x] (list (+ v v))) 'x) -- (as 'F32 [5.0 -7.0])
(set T (table [n] (list [1 2])))
(type (at (select {r: (+ n (as 'F32 2.5)) from: T}) 'r)) -- 'F64

;; Planner, bound-column and grouped reductions agree with eager vectors.
(set TF (table [g x] (list [0 0 1 1] (as 'F32 [2.5 0Nf -3.5 4.5]))))
(set RF (select {mn: (min x) mx: (max x) f: (first x) l: (last x) from: TF}))
(type (at RF 'mn)) -- 'F32
(type (at RF 'mx)) -- 'F32
(type (at RF 'f)) -- 'F32
(type (at RF 'l)) -- 'F32
(set RFG (select {mn: (min x) mx: (max x) f: (first x) l: (last x) from: TF by: g asc: g}))
(type (at RFG 'mn)) -- 'F32
(type (at RFG 'mx)) -- 'F32
(type (at RFG 'f)) -- 'F32
(type (at RFG 'l)) -- 'F32
(at RFG 'mn) -- (as 'F32 [2.5 -3.5])
(at RFG 'mx) -- (as 'F32 [2.5 4.5])
(at RFG 'f) -- (as 'F32 [2.5 -3.5])
(at RFG 'l) -- (as 'F32 [2.5 4.5])

;; Non-finite F32 arithmetic is null on the eager path, as inside select and
;; as for F64 (single-null float model): never a raw inf, never an unflagged NaN.
(set w (as 'F32 [3.0e38 1.0 -3.0e38 2.0]))
(+ w w) -- (as 'F32 [0Nf 2.0 0Nf 4.0])
(nil? (+ w w)) -- [true false true false]
(- w (neg w)) -- (as 'F32 [0Nf 2.0 0Nf 4.0])
(* w w) -- (as 'F32 [0Nf 1.0 0Nf 4.0])
(mins (+ w w)) -- (as 'F32 [0Nf 2.0 2.0 2.0])
(nil? (mins (+ w w))) -- [true false false false]
(maxs (+ w w)) -- (as 'F32 [0Nf 2.0 2.0 4.0])
(max (+ w w)) -- 4.0e
(min (+ w w)) -- 2.0e
(first (+ w w)) -- 2.0e
(type (+ w (as 'F32 1.0))) -- 'F32
(+ [1e308 1.0] [1e308 1.0]) -- [0Nf 2.0]
(at (select {x: (+ w w) from: (table [w] (list w))}) 'x) -- (as 'F32 [0Nf 2.0 0Nf 4.0])

;; Grouped and ungrouped extrema over an overflowed (null) F32 element are
;; the other elements' answer, or null when none remain, never +-3.40e+38.
(set TI (table [g x] (list [0 0 1 1] (+ w w))))
(at (select {mx: (max x) mn: (min x) f: (first x) l: (last x) from: TI by: g asc: g}) 'mx) -- (as 'F32 [2.0 4.0])
(at (select {mx: (max x) mn: (min x) f: (first x) l: (last x) from: TI by: g asc: g}) 'f) -- (as 'F32 [2.0 4.0])
(set TA (table [g x] (list [0 1] (+ (as 'F32 [3.0e38 3.0e38]) (as 'F32 [3.0e38 3.0e38])))))
(at (select {mx: (max x) mn: (min x) f: (first x) l: (last x) from: TA by: g asc: g}) 'mx) -- (as 'F32 [0Nf 0Nf])
(at (select {mx: (max x) mn: (min x) f: (first x) l: (last x) from: TA by: g asc: g}) 'l) -- (as 'F32 [0Nf 0Nf])
(at (select {f: (first x) l: (last x) mx: (max x) from: TA}) 'f) -- (as 'F32 [0Nf])
(at (select {f: (first x) l: (last x) mx: (max x) from: TA}) 'mx) -- (as 'F32 [0Nf])

;; Scalars: an F32 atom built by (as 'F32 x) is accepted by every elementwise
;; unary verb inside a query, as the I32 equivalents are.
(set T2 (table [x] (list (as 'F32 [1.5 2.0]))))
(at (select {a: (neg (as 'F32 2.5)) from: T2}) 'a) -- (as 'F32 [-2.5 -2.5])
(at (select {a: (abs (as 'F32 -2.5)) from: T2}) 'a) -- (as 'F32 [2.5 2.5])
(at (select {a: (floor (as 'F32 2.5)) from: T2}) 'a) -- (as 'F32 [2.0 2.0])
(at (select {a: (ceil (as 'F32 2.5)) from: T2}) 'a) -- (as 'F32 [3.0 3.0])
(at (select {a: (sqrt (as 'F32 4.0)) from: T2}) 'a) -- [2.0 2.0]
(at (select {a: (as 'F64 (as 'F32 2.5)) from: T2}) 'a) -- [2.5 2.5]
(at (select {a: (as 'I64 (as 'F32 2.5)) from: T2}) 'a) -- [2 2]
(at (select {a: (* x (neg (as 'F32 2.5))) from: T2}) 'a) -- (as 'F32 [-3.75 -5.0])
(type (at (select {a: (* x (neg (as 'F32 2.5))) from: T2}) 'a)) -- 'F32
(at (select {a: (neg (as 'I32 2)) from: T2}) 'a) -- [-2 -2]

;; Scans and moving extrema write F32 values, not doubles into an F32 column:
;; check the values, below and above the parallel threshold.
(mins (as 'F32 [2.5 -3.5 0Nf 1.25])) -- (as 'F32 [2.5 -3.5 -3.5 -3.5])
(maxs (as 'F32 [2.5 -3.5 0Nf 4.25])) -- (as 'F32 [2.5 2.5 2.5 4.25])
(mmin 2 (as 'F32 [2.5 -3.5 0Nf 1.25])) -- (as 'F32 [2.5 -3.5 -3.5 1.25])
(mmax 2 (as 'F32 [2.5 -3.5 0Nf 1.25])) -- (as 'F32 [2.5 2.5 -3.5 1.25])
(mins (as 'F32 [0Nf 2.5 -1.5])) -- (as 'F32 [0Nf 2.5 -1.5])
(set bn 20000)
(set bd (- (as 'F64 (% (* (til bn) 7919) 1009)) 500.25))
(set bf (as 'F32 bd))
(type (mins bf)) -- 'F32
(== (mins bf) (as 'F32 (mins bd))) -- (take [true] bn)
(== (maxs bf) (as 'F32 (maxs bd))) -- (take [true] bn)
(== (mmin 5 bf) (as 'F32 (mmin 5 bd))) -- (take [true] bn)
(== (mmax 5 bf) (as 'F32 (mmax 5 bd))) -- (take [true] bn)
(last (mins bf)) -- (as 'F32 (last (mins bd)))

;; Planner output types are pinned by composing the reductions and scans
;; with other F32 operands: every result stays F32, eager and in select.
(set cv (as 'F32 [2.5 -3.5 4.5 1.25]))
(min (mins cv)) -- -3.5e
(type (min (mins cv))) -- 'f32
(- cv (min cv)) -- (as 'F32 [6.0 0.0 8.0 4.75])
(+ (max cv) (as 'F32 1.0)) -- 5.5e
(- cv (first cv)) -- (as 'F32 [0.0 -6.0 2.0 -1.25])
(- (maxs cv) (mins cv)) -- (as 'F32 [0.0 6.0 8.0 8.0])
(+ cv (mmin 2 cv)) -- (as 'F32 [5.0 -7.0 1.0 2.5])
(set CT (table [x] (list cv)))
(set CS (select {a: (- x (min x)) b: (+ (max x) (as 'F32 1.0)) c: (- x (first x)) d: (- (maxs x) (mins x)) e: (min (mins x)) f: (+ x (mmin 2 x)) from: CT}))
(type (at CS 'a)) -- 'F32
(type (at CS 'b)) -- 'F32
(type (at CS 'c)) -- 'F32
(type (at CS 'd)) -- 'F32
(type (at CS 'e)) -- 'F32
(type (at CS 'f)) -- 'F32
(at CS 'a) -- (as 'F32 [6.0 0.0 8.0 4.75])
(at CS 'b) -- (as 'F32 [5.5 5.5 5.5 5.5])
(at CS 'c) -- (as 'F32 [0.0 -6.0 2.0 -1.25])
(at CS 'd) -- (as 'F32 [0.0 6.0 8.0 8.0])
(at CS 'e) -- (as 'F32 [-3.5 -3.5 -3.5 -3.5])
(at CS 'f) -- (as 'F32 [5.0 -7.0 1.0 2.5])
(set CL (select {mn: (min x) mx: (max x) from: CT}))
(type (at CL 'mn)) -- 'F32
(type (at CL 'mx)) -- 'F32
