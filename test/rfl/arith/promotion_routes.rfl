;; @also-unfused
;; The numeric promotion table (#1466) for every ordered pair of the seven
;; numeric types, on every route: atoms, vectors, an atom beside a vector,
;; and select, select where:, select by: (each group's vector), update and
;; update by: columns.  Each line is the 7x7 table of result types, rows the
;; left operand and columns the right, in the order of Ty.  The table is the
;; one docs/docs/language/math.md#result-types states: among the integers
;; B8 < U8 < I16 < I32 < I64 and the wider type wins; F32 stays F32 only
;; beside F32 and is F64 beside anything else (F32 with I64 is F64); F64
;; with anything is F64.  B8 with B8 is I64 for + - * div % and B8 for min
;; and max; / is always F64.  test/rfl/arith/promotion_matrix.rfl pins the
;; values; this file pins the types across the query routes.

(set Ty ['B8 'U8 'I16 'I32 'I64 'F32 'F64])
(set V (fn [x] (as x [1 0 1 1])))
(set Tb (fn [x y] (table [g k a b] (list ['p 'p 'q 'q] [1 2 3 4] (V x) (V y)))))
(set M (fn [f] (map (fn [x] (map (fn [y] (f x y)) Ty)) Ty)))

;; ── +
(M (fn [x y] (type (+ (V x) (V y))))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (+ (V x) (first (V y)))))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (+ (first (V x)) (V y))))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (+ (first (V x)) (first (V y)))))) -- (list ['i64 'u8 'i16 'i32 'i64 'f64 'f64] ['u8 'u8 'i16 'i32 'i64 'f64 'f64] ['i16 'i16 'i16 'i32 'i64 'f64 'f64] ['i32 'i32 'i32 'i32 'i64 'f64 'f64] ['i64 'i64 'i64 'i64 'i64 'f64 'f64] ['f64 'f64 'f64 'f64 'f64 'f32 'f64] ['f64 'f64 'f64 'f64 'f64 'f64 'f64])
(M (fn [x y] (type (at (select {v: (+ a b) from: (Tb x y)}) 'v)))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (at (select {v: (+ a b) from: (Tb x y) where: (> k 1)}) 'v)))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (first (at (select {v: (+ a b) from: (Tb x y) by: g}) 'v))))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (last (at (select {v: (+ a b) from: (Tb x y) by: g}) 'v))))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (at (update {v: (+ a b) from: (Tb x y)}) 'v)))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (at (update {v: (+ a b) from: (Tb x y) where: (> k 1)}) 'v)))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (at (update {v: (+ a b) from: (Tb x y) by: g}) 'v)))) -- (list ['I64 'U8 'I16 'I32 'I64 'F64 'F64] ['U8 'U8 'I16 'I32 'I64 'F64 'F64] ['I16 'I16 'I16 'I32 'I64 'F64 'F64] ['I32 'I32 'I32 'I32 'I64 'F64 'F64] ['I64 'I64 'I64 'I64 'I64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F32 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])

