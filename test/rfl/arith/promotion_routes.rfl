(M (fn [x y] (type (/ (first (V x)) (first (V y)))))) -- (list ['f64 'f64 'f64 'f64 'f64 'f64 'f64] ['f64 'f64 'f64 'f64 'f64 'f64 'f64] ['f64 'f64 'f64 'f64 'f64 'f64 'f64] ['f64 'f64 'f64 'f64 'f64 'f64 'f64] ['f64 'f64 'f64 'f64 'f64 'f64 'f64] ['f64 'f64 'f64 'f64 'f64 'f64 'f64] ['f64 'f64 'f64 'f64 'f64 'f64 'f64])
(M (fn [x y] (type (at (select {v: (/ a b) from: (Tb x y)}) 'v)))) -- (list ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (at (select {v: (/ a b) from: (Tb x y) where: (> k 1)}) 'v)))) -- (list ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (first (at (select {v: (/ a b) from: (Tb x y) by: g}) 'v))))) -- (list ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (last (at (select {v: (/ a b) from: (Tb x y) by: g}) 'v))))) -- (list ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (at (update {v: (/ a b) from: (Tb x y)}) 'v)))) -- (list ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (at (update {v: (/ a b) from: (Tb x y) where: (> k 1)}) 'v)))) -- (list ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])
(M (fn [x y] (type (at (update {v: (/ a b) from: (Tb x y) by: g}) 'v)))) -- (list ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64] ['F64 'F64 'F64 'F64 'F64 'F64 'F64])

;; The case in #1466: F32 with I64 is F64 on every route, so an update
;; that writes it back into the F32 column is a type error; an F32 operand
;; or a cast keeps the column F32.
(type (+ (as 'F32 [1 2]) 1)) -- 'F64
(set TF (table [f] (list (as 'F32 [1 2]))))
(type (at (select {r: (+ f 1) from: TF}) 'r)) -- 'F64
(update {f: (+ f 1) from: TF}) !- type
(at (update {f: (+ f 1e) from: TF}) 'f) -- [2.0e 3.0e]
(at (update {f: (as 'F32 (+ f 1)) from: TF}) 'f) -- [2.0e 3.0e]
