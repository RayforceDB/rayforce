;; @also-unfused
;; The numeric promotion table (#972, #973): one symmetric rule for atoms,
;; vectors, select and update.  B8 < U8 < I16 < I32 < I64 < F32 < F64, the
;; wider type wins, two operands of one type keep it (integers wrap there),
;; F32 beside any other type is F64.  + - * div % count B8 with B8 as I64;
;; min and max keep B8.  Every ordered pair of the seven types, for each verb:
;;   the vector, both operand orders, the atom, atom-vector and vector-atom
;;   forms, select and update over table columns, and select with a literal
;;   operand, all of the table's type, and all with the vector's values.
;; The operands wrap (200 * 200 in U8, 300 * 300 in I16, 50000 * 50000 in
;; I32, I64 max + 7), overflow F32, and hold zero divisors.

(set XB8 (as 'B8 [1 0 1 1 0]))
(set YB8 (as 'B8 [1 1 0 1 1]))
(set XU8 (as 'U8 [200 7 255 0 9]))
(set YU8 (as 'U8 [200 2 1 0 128]))
(set XI16 (as 'I16 [300 -7 32760 0 -300]))
(set YI16 (as 'I16 [300 2 100 0 -2]))
(set XI32 (as 'I32 [50000 -7 2147483640 0 -50000]))
(set YI32 (as 'I32 [50000 2 100 0 -2]))
(set XI64 (as 'I64 [7 -7 9223372036854775800 0 3000000000]))
(set YI64 (as 'I64 [7 2 100 0 -2]))
(set XF32 (as 'F32 [7.5 -7.5 1024.0 0.0 3e38]))
(set YF32 (as 'F32 [7.5 2.0 1.0 0.0 -2.0]))
(set XF64 (as 'F64 [7.5 -7.5 1e15 0.0 2.5]))
(set YF64 (as 'F64 [7.5 2.0 1.0 0.0 -2.0]))

;; the vector form, element by element against the atom form
(set atomwise (fn [f x y] (all (== (f x y) (map (fn [i] (f (at x i) (at y i))) (til (count x)))))))

;; ── +
(set V (+ XB8 YB8))
(set S (at (select {r: (+ a b) from: (table [a b] (list XB8 YB8))}) 'r))
(set U (at (update {r: (+ a b) from: (table [a b] (list XB8 YB8))}) 'r))
(set L (at (select {r: (+ a true) from: (table [a b] (list XB8 YB8))}) 'r))
(set R (at (select {r: (+ false b) from: (table [a b] (list XB8 YB8))}) 'r))
(list (type V) (type (+ YB8 XB8)) (type (+ (at XB8 0) (at YB8 0))) (type (+ (at XB8 1) YB8)) (type (+ XB8 (at YB8 1))) (type S) (type U) (type L) (type R)) -- (list 'I64 'I64 'i64 'I64 'I64 'I64 'I64 'I64 'I64)
(list (all (== V S)) (all (== V U)) (atomwise + XB8 YB8) (all (== L (+ XB8 (take (at YB8 1) 5)))) (all (== R (+ (take (at XB8 1) 5) YB8)))) -- (list true true true true true)
(set V (+ XB8 YU8))
(set S (at (select {r: (+ a b) from: (table [a b] (list XB8 YU8))}) 'r))
(set U (at (update {r: (+ a b) from: (table [a b] (list XB8 YU8))}) 'r))
(set L (at (select {r: (+ a 0x02) from: (table [a b] (list XB8 YU8))}) 'r))
(set R (at (select {r: (+ false b) from: (table [a b] (list XB8 YU8))}) 'r))
(list (type V) (type (+ YU8 XB8)) (type (+ (at XB8 0) (at YU8 0))) (type (+ (at XB8 1) YU8)) (type (+ XB8 (at YU8 1))) (type S) (type U) (type L) (type R)) -- (list 'U8 'U8 'u8 'U8 'U8 'U8 'U8 'U8 'U8)
(list (all (== V S)) (all (== V U)) (atomwise + XB8 YU8) (all (== L (+ XB8 (take (at YU8 1) 5)))) (all (== R (+ (take (at XB8 1) 5) YU8)))) -- (list true true true true true)
