;; ── explicit cases
;; #972: the issue's order- and form-dependent results
(type (+ (enlist true) (enlist 2i))) -- 'I32
(type (+ (enlist 2i) (enlist true))) -- 'I32
(type (min (enlist 2h) (enlist 3i))) -- 'I32
(type (min (enlist 3i) (enlist 2h))) -- 'I32
(type (div (enlist 0x07) (enlist 2i))) -- 'I32
(type (div (enlist 7i) (enlist 0x02))) -- 'I32
(type (+ true 2i)) -- 'i32
(type (div 7i 2i)) -- 'i32
(type (div (enlist 7i) (enlist 2i))) -- 'I32
(div 7.5 2.0) -- 3.0
(div -7.5 2.0) -- -4.0
(type (div (as 'F32 [7.5]) (as 'F32 [2.0]))) -- 'F32
(type (min (as 'F32 2.5) 1)) -- 'f64
(type (+ (as 'F32 2.5) 1)) -- 'f64
;; B8 with B8: + - * div % stay I64, min and max stay B8
(+ true true) -- 2
(type (+ [true false] [true true])) -- 'I64
(type (min [true false] [true true])) -- 'B8
;; same width wraps, as I64 does (#809)
(+ 0xff 0x01) -- 0x00
(as 'I64 (* 300h 300h)) -- 24464
(as 'I64 (* 50000i 50000i)) -- -1794967296
(+ 9223372036854775807 2) -- -9223372036854775807
(type (+ true 0xff)) -- 'u8
(+ true 0xff) -- 0x00
;; #1227: % no longer narrows the dividend to the divisor's type
(% 7.5 0x02) -- 1.5
(% 300 0xff) -- 45
(% [7.5 300.0] [0x02 0xff]) -- [1.5 45.0]
(% 300 [0xff]) -- [45]
;; a U8 result has no null: div / % by a zero U8 is 0
(div 0x07 0x00) -- 0x00
(% 0x07 0x00) -- 0x00
(nil? (div 7h 0h)) -- true
(type (div 7h 0h)) -- 'i16
(nil? (% 7 0x00)) -- false
;; #973: queries keep the planned type and wrap there
(set T (table [x y] (list [200h 300h] [7h 0h])))
(as 'I64 (at (select {r: (* x x) from: T}) 'r)) -- [-25536 24464]
(as 'I64 (at (update {r: (* x x) from: T}) 'r)) -- [-25536 24464]
(type (at (select {r: (* x x) from: T}) 'r)) -- 'I16
(as 'I64 (at (select {r: (+ (* x x) 1h) from: T}) 'r)) -- [-25535 24465]
;; a narrow intermediate wraps before the next op reads it
(as 'I64 (at (select {r: (div (* x x) 7h) from: T}) 'r)) -- [-3648 3494]
(at (select {r: (> (* x x) 0h) from: T}) 'r) -- [false true]
(count (select {from: T where: (> (* x x) 0h)})) -- 1
(at (select {r: (as 'I64 (* x x)) from: T}) 'r) -- [-25536 24464]
(as 'I64 (at (select {r: (neg (* x x)) from: T}) 'r)) -- [25536 -24464]
;; a produced null (zero divisor) survives the narrowing
(nil? (at (select {r: (% x y) from: T}) 'r)) -- [false true]
(nil? (at (select {r: (div x y) from: T}) 'r)) -- [false true]
;; aggregates read the planned values: the sum of the wrapped products
(at (select {s: (sum (* x x)) from: T}) 's) -- [-1072]
(sum (* [200h 300h] [200h 300h])) -- -1072
(at (select {s: (sum (+ x x)) from: T}) 's) -- [1000]
(set W (table [x] (list [32767h 32767h])))
(at (select {s: (sum (+ x x)) from: W}) 's) -- [-4]
(sum (+ [32767h 32767h] [32767h 32767h])) -- -4
(at (select {s: (sum (+ x 1h)) from: W}) 's) -- [-65536]
(sum (+ [32767h 32767h] 1h)) -- -65536
;; a pool-parallel fused evaluation
(set N (as 'I16 (til 200000)))
(set P (table [x] (list N)))
(type (at (select {r: (* x x) from: P}) 'r)) -- 'I16
(all (== (at (select {r: (* x x) from: P}) 'r) (* N N))) -- true
(all (== (at (update {r: (- (* x 3h) x) from: P}) 'r) (- (* N 3h) N))) -- true
(at (select {s: (sum (* x x)) from: P}) 's) -- (enlist (sum (* N N)))
;; floor / ceil of narrow integer arithmetic is the identity in its width
(set Q (table [i] (list [1i -2i 2147483647i])))
(type (at (select {r: (floor (neg i)) from: Q}) 'r)) -- 'I32
(as 'I64 (at (select {r: (floor (neg i)) from: Q}) 'r)) -- [-1 2 -2147483647]
(as 'I64 (at (select {r: (ceil (+ i i)) from: Q}) 'r)) -- [2 -4 -2]
(as 'I64 (ceil (+ [1i -2i 2147483647i] [1i -2i 2147483647i]))) -- [2 -4 -2]
;; SUM / AVG over a fused narrow expression (the narrow scalar kernels)
(at (select {s: (avg (* x 3h)) from: P}) 's) -- (enlist (avg (* N 3h)))
(set N8 (as 'U8 (til 200000)))
(set P8 (table [u] (list N8)))
(at (select {s: (sum (+ u u)) from: P8}) 's) -- (enlist (sum (+ N8 N8)))
(set N32 (as 'I32 (til 200000)))
(set P32 (table [i] (list N32)))
(at (select {s: (sum (* i i)) from: P32}) 's) -- (enlist (sum (* N32 N32)))
(at (select {s: (avg (* i i)) from: P32}) 's) -- (enlist (avg (* N32 N32)))
;; nulls, nested narrow chains and their consumers: select equals eager
(set Z (table [a b c g] (list [300h 0Nh 32767h -7h 100h] [300h 5h 1h 0Nh 2h] (as 'I32 [7 8 9 10 11]) ['x 'y 'x 'y 'x])))
(set A (at Z 'a))
(set B (at Z 'b))
(set C (at Z 'c))
(at (select {r: (+ (* a b) a) from: Z}) 'r) -- (+ (* A B) A)
(at (select {r: (+ (* a b) c) from: Z}) 'r) -- (+ (* A B) C)
(type (at (select {r: (+ (* a b) c) from: Z}) 'r)) -- 'I32
(at (select {r: (< (+ a 1h) 0h) from: Z}) 'r) -- (< (+ A 1h) 0h)
(nil? (at (select {r: (* (+ a b) b) from: Z}) 'r)) -- (nil? (* (+ A B) B))
(at (select {r: (- (* a 2h) (neg a)) from: Z}) 'r) -- (- (* A 2h) (neg A))
(at (select {s: (sum (* a a)) from: Z where: (> c 7i)}) 's) -- [10050]
(set W (table [x] (list [32767h 1h -2h])))
(as 'I64 (at (select {r: (+ (+ x 1h) 0h) from: W}) 'r)) -- [-32768 2 -1]
;; a long narrow chain: wraps once at the end, same values
(set D (as 'I16 (til 100)))
(set DT (table [x] (list D)))
(all (== (at (select {r: (+ (* (+ (* (+ (* (+ (* (+ (* x x) x) x) x) x) x) x) x) x) (* (- (* x 3h) x) (+ x 2h))) from: DT}) 'r) (+ (* (+ (* (+ (* (+ (* (+ (* D D) D) D) D) D) D) D) D) D) (* (- (* D 3h) D) (+ D 2h))))) -- true
;; temporal result types are not this table's
(type (- [2024.01.03] 2024.01.01)) -- 'I32
(type (- [2024.01.03] [2024.01.01])) -- 'I32
(type (min (enlist (as 'TIMESPAN 5000000000)) 5i)) -- 'I64
;; a narrow neg / abs that runs in the typed executor (the fused program is
;; out of registers below it) is computed, not left unwritten
(set RT (table [a b] (list [1h 0Nh 3h 4h] [10h 20h 30h 40h])))
(set RA [1h 0Nh 3h 4h])
(set RB [10h 20h 30h 40h])
(at (select {r: (neg (+ b (+ b (+ b (+ b (+ b (+ b (+ b (+ b a))))))))) from: RT}) 'r) -- (neg (+ RB (+ RB (+ RB (+ RB (+ RB (+ RB (+ RB (+ RB RA)))))))))
(at (select {r: (abs (* b (+ b (* b (+ b (* b (+ b (* b a)))))))) from: RT}) 'r) -- (abs (* RB (+ RB (* RB (+ RB (* RB (+ RB (* RB RA))))))))
(set RT32 (table [a b] (list [1i 0Ni 3i 4i] [10i 20i 30i 40i])))
(set RA32 [1i 0Ni 3i 4i])
(set RB32 [10i 20i 30i 40i])
(at (select {r: (neg (* b (+ b (* b (+ b (* b (+ b a))))))) from: RT32}) 'r) -- (neg (* RB32 (+ RB32 (* RB32 (+ RB32 (* RB32 (+ RB32 RA32)))))))
(at (select {r: (abs (* b (+ b (* b (+ b (* b (+ b a))))))) from: RT32}) 'r) -- (abs (* RB32 (+ RB32 (* RB32 (+ RB32 (* RB32 (+ RB32 RA32)))))))
;; F32 to a narrow type with nulls (typed executor)
(at (select {r: (as 'U8 a) from: (table [a] (list (as 'F32 [7.5 0Nf 1024.0 0.0 -2.5])))}) 'r) -- (as 'U8 (as 'F32 [7.5 0Nf 1024.0 0.0 -2.5]))
;; xbar follows the table for integer columns, in every form
(type (xbar [10h 25h] 5i)) -- 'I32
(type (xbar 10h 5i)) -- 'i32
(type (at (select {r: (xbar a 5i) from: (table [a] (list [10h 25h]))}) 'r)) -- 'I32
(xbar [-32767h 25h] 10) -- [-32770 20]
(type (xbar [10h 25h] 5h)) -- 'I16
;; % never overflows computing the remainder
(% -9223372036854775807 0xc8) -- 193
