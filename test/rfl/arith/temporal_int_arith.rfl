(at (update {r: (+ t i64) from: Q}) 'r) -- (+ (at Q 't) (at Q 'i64))
(at (select {r: (+ s i64) from: Q}) 'r) -- (+ (at Q 's) (at Q 'i64))
(at (select {r: (- s i64) from: Q}) 'r) -- (- (at Q 's) (at Q 'i64))
(at (select {r: (+ i64 s) from: Q}) 'r) -- (+ (at Q 'i64) (at Q 's))
(at (update {r: (+ s i64) from: Q}) 'r) -- (+ (at Q 's) (at Q 'i64))
(at (select {r: (+ s i16) from: Q}) 'r) -- (+ (at Q 's) (at Q 'i16))
(at (select {r: (- s i16) from: Q}) 'r) -- (- (at Q 's) (at Q 'i16))
(at (select {r: (+ i16 s) from: Q}) 'r) -- (+ (at Q 'i16) (at Q 's))
(at (update {r: (+ s i16) from: Q}) 'r) -- (+ (at Q 's) (at Q 'i16))
(at (select {r: (+ s b) from: Q}) 'r) -- (+ (at Q 's) (at Q 'b))
(at (select {r: (- s b) from: Q}) 'r) -- (- (at Q 's) (at Q 'b))
(at (select {r: (+ b s) from: Q}) 'r) -- (+ (at Q 'b) (at Q 's))
(at (update {r: (+ s b) from: Q}) 'r) -- (+ (at Q 's) (at Q 'b))
(repr (at (select {r: (- i32 t) from: Q}) 'r)) -- "[00:00:00.000 00:00:00.000 00:00:00.000 00:00:00.000 0Nt 0Nt 572:31:23.650]"
(repr (at (select {r: (- 5 t) from: Q}) 'r)) -- "[00:00:00.005 00:00:00.004 00:00:00.006 -596:31:23.642 -596:31:23.644 0Nt -23:59:59.994]"
(repr (at (select {r: (+ d 1) from: Q}) 'r)) -- "[2000.01.02 2000.01.03 2000.01.01 0Nd -5877611.06.24 0Nd 2024.01.02]"
(repr (at (select {r: (- d 4294967297) from: Q}) 'r)) -- "[1999.12.31 2000.01.01 1999.12.30 5881610.07.10 0Nd 0Nd 2023.12.31]"
(repr (at (select {r: (+ 2147483648 d) from: Q}) 'r)) -- "[0Nd -5877611.06.23 5881610.07.11 1999.12.31 2000.01.02 0Nd -5877587.06.22]"
(repr (at (select {r: (+ s 1) from: Q}) 'r)) -- "[2000.01.01D00:00:00.000000001 2000.01.01D00:00:00.000000002 2000.01.01D00:00:00.000000000 0Np 1707.09.22D00:12:43.145224194 0Np 2024.01.01D00:00:00.000000001]"
(repr (at (select {r: (- t 1000h) from: Q}) 'r)) -- "[-00:00:01.000 -00:00:00.999 -00:00:01.001 596:31:22.647 596:31:22.649 0Nt 23:59:58.999]"
(at (select {r: (+ (+ d 1) i16) from: Q}) 'r) -- [2000.01.02 2000.01.04 1999.12.31 0Nd 0Nd 0Nd 1934.04.17]
(repr (at (select {r: (- (+ d i32) 1) from: Q}) 'r)) -- "[1999.12.31 2000.01.02 1999.12.29 1999.12.29 0Nd 0Nd -5877587.06.22]"
(repr (at (select {r: (+ d 1) from: Q where: (> c 4)}) 'r)) -- "[2000.01.03 2000.01.01 -5877611.06.24 2024.01.02]"
(at (update {r: (+ t i16) from: Q where: (> c 4)}) 'r) -- [0Nt 00:00:00.002 -00:00:00.002 0Nt 0Nt 0Nt 23:59:27.232]
(repr (select {lo: (min (+ d i32)) hi: (max (+ d i32)) n: (count (+ d i32)) from: Q by: g})) -- "(table (as 'SYM (list \"g\" \"lo\" \"hi\" \"n\")) (list [0 1 2] [-5877587.06.23 2000.01.03 1999.12.30] [2000.01.01 2000.01.03 1999.12.30] [3 2 2]))"
(repr (select {a: (avg (+ d 1)) f: (first (+ s i64)) l: (last (- t u8)) from: Q by: g})) -- "(table (as 'SYM (list \"g\" \"a\" \"f\" \"l\")) (list [0 1 2] [4384.0 -1073741822.0 0.0] [2000.01.01D00:00:00.000000000 2000.01.01D00:00:00.000000002 1999.12.31D23:59:59.999999998] [23:59:59.799 596:31:23.647 -00:00:00.256]))"
(select {r: (avg (if (> c 4) d (+ d 1))) from: Q by: g}) -- (table (as 'SYM (list "g" "r")) (list [0 1 2] [4383.5 -1073741823.0 -1.0]))
(select {r: (first (if (> c 4) (+ t i32) t)) from: Q by: g}) -- (table (as 'SYM (list "g" "r")) (list [0 1 2] [00:00:00.000 00:00:00.002 -00:00:00.002]))
(count (select {from: Q where: (> (+ d 1) 2000.01.01)})) -- 3
(try (select {r: (- i32 d) from: Q}) (fn [e] (at e 'msg))) -- "cannot subtract i32 and date"
(try (select {r: (+ d 1.5) from: Q}) (fn [e] (at e 'msg))) -- "add: temporal arithmetic requires integer offsets, got date and f64"

;; a column with no null whose sum wraps onto the sentinel: the result is
;; null there, flagged as one (the DAG's integer kernels keep it a number)
(set W (table [d t s x y] (list (as 'DATE [2147483647i -1i 5i]) (as 'TIME [2147483647i 1i 2i]) (as 'TIMESTAMP [9223372036854775807 -1 5]) (as 'I32 [1i 2i 3i]) [1 -9223372036854775807 9223372036854775807])))
(at (select {r: (+ d 1) from: W}) 'r) -- [0Nd 2000.01.01 2000.01.07]
(at (select {r: (+ t x) from: W}) 'r) -- [0Nt 00:00:00.003 00:00:00.005]
(at (select {r: (+ s 1) from: W}) 'r) -- [0Np 2000.01.01D00:00:00.000000000 2000.01.01D00:00:00.000000006]
(repr (at (select {r: (+ s y) from: W}) 'r)) -- "[0Np 0Np 1707.09.22D00:12:43.145224196]"
(at (update {r: (- d -1i) from: W}) 'r) -- [0Nd 2000.01.01 2000.01.07]
(at (select {r: (+ d y) from: W}) 'r) -- [0Nd 2000.01.01 2000.01.05]
(at (select {r: (+ d -9223372036854775807) from: W}) 'r) -- [0Nd 2000.01.01 2000.01.07]
(at (select {r: (- t 9223372036854775807) from: W}) 'r) -- [0Nt 00:00:00.002 00:00:00.003]
(at (select {r: (if (> x 1) d (+ d 1)) from: W}) 'r) -- [0Nd 1999.12.31 2000.01.06]
(sum (nil? (at (select {r: (+ d 1) from: W}) 'r))) -- 1

;; read by anything but another such pair or a same-typed `if`, the pair is
;; answered by the builtins, as before it lowered: an aggregate without by:,
;; a mixed `if`, a `cond`, nil?, a sort by the output
(try (select {r: (sum (+ d 1)) from: Q}) (fn [e] (at e 'msg))) -- "sum expects a numeric or time-duration vector, got DATE"
(at (select {r: (first (+ d i32)) from: Q where: (> c 4)}) 'r) -- [2000.01.03]
(at (select {r: (dev (+ d i16)) from: Q}) 'r) -- [858977952.7502966]
(at (select {r: (nil? (+ d 1)) from: Q}) 'r) -- [false false false true false true false]
(repr (at (select {r: (if (> c 4) (+ d 1) t) from: Q}) 'r)) -- "(list 00:00:00.000 2000.01.03 2000.01.01 596:31:23.647 -5877611.06.24 0Nt 2024.01.02)"
(try (select {r: (cond ((> c 4) (+ d 1)) (else d)) from: Q}) (fn [e] (at e 'msg))) -- "'cond' undefined"
(repr (at (select {r: (if (> c 4) (+ t 1000) 0Nd) from: Q}) 'r)) -- "(list 0Nd 00:00:01.001 00:00:00.999 0Nd -596:31:22.647 0Nd 24:00:00.999)"
(repr (at (select {r: (+ d 1) from: Q asc: r}) 'r)) -- "[0Nd 0Nd -5877611.06.24 2000.01.01 2000.01.02 2000.01.03 2024.01.02]"
(at (update {r: (first (+ d 1)) from: Q by: g}) 'r) -- [2000.01.02 2000.01.03 2000.01.01 2000.01.02 2000.01.03 2000.01.01 2000.01.02]

;; a later projection reads the pair through its alias: the same readers
;; keep the builtin (the alias is the pair's node)
(set A (table [d t c s] (list (as 'DATE [8766i 8767i 0Ni 2147483647i 8770i]) (as 'TIME [1i 0Ni 3i 2147483647i 5i]) [1 5 7 2 9] (as 'STR (list "abcdef" "bcdefg" "cdefgh" "defghi" "efghij")))))
(try (at (select {r: (+ d 1) s: (nil? r) from: A}) 's) (fn [e] (at e 'msg))) -- [false false true true false]
(try (at (select {r: (+ d 1) s: (== r d) from: A}) 's) (fn [e] (at e 'msg))) -- [false false true false false]
(repr (try (at (select {r: (+ d 1) s: (if (> c 4) r t) from: A}) 's) (fn [e] (at e 'msg)))) -- "(list 00:00:00.001 2024.01.03 0Nd 596:31:23.647 2024.01.06)"
(try (at (select {d: (+ d 1) u: (nil? d) from: A}) 'u) (fn [e] (at e 'msg))) -- [false false true true false]
(try (at (select {r: (+ d 1) s: r u: (nil? s) from: A}) 'u) (fn [e] (at e 'msg))) -- [false false true true false]
(try (at (select {r: (+ d 1) s: (nil? r) from: A where: (> c 1)}) 's) (fn [e] (at e 'msg))) -- [false true true false]
(try (at (update {r: (+ d 1) s: (nil? r) from: A}) 's) (fn [e] (at e 'msg))) -- "'r' undefined"
(repr (try (at (select {r: (+ d 1) s: (if (> c 4) r d) from: A}) 's) (fn [e] (at e 'msg)))) -- "[2024.01.01 2024.01.03 0Nd 5881610.07.11 2024.01.06]"
(try (at (select {r: (+ d 1) s: (+ r 1) from: A}) 's) (fn [e] (at e 'msg))) -- [2024.01.03 2024.01.04 0Nd 0Nd 2024.01.07]
(try (at (select {r: (+ t 1) s: (lag r) from: A}) 's) (fn [e] (at e 'msg))) -- "lag expects a vector input, got time"
(try (at (select {r: (sums (+ t 1)) from: A}) 'r) (fn [e] (at e 'msg))) -- "sums expects a vector input, got time"
(try (at (select {r: (substr s 1 (+ d 1)) from: A}) 'r) (fn [e] (at e 'msg))) -- "substr: length must be an integer atom or I64/I32 vector"
(try (at (select {r: (replace s "a" (+ d 1)) from: A}) 'r) (fn [e] (at e 'msg))) -- "replace: to must be string or symbol atom"
(set BQ (table [d s x y g c] (list BD BS BI32 BI64 (% (til n) 7) (% (til n) 10))))
(identical (at (select {r: (+ d x) from: BQ}) 'r) (+ BD BI32)) -- true
(identical (at (select {r: (- s y) from: BQ}) 'r) (- BS BI64)) -- true
(identical (at (update {r: (+ d 1) from: BQ}) 'r) (+ BD 1)) -- true
(identical (at (select {r: (+ x d) from: BQ where: (> c 4)}) 'r) (+ (at BI32 (where (> (% (til n) 10) 4))) (at BD (where (> (% (til n) 10) 4))))) -- true
(select {a: (avg (+ d 1)) lo: (min (+ s y)) from: BQ by: g}) -- (table (as 'SYM (list "g" "a" "lo")) (list [0 1 2 3 4 5 6] [-16347507.825325325 -16414999.863563564 -16516998.088688688 -16404004.57977978 -16291011.07087087 -16178017.561961962 -16065024.053053053] [1707.10.08D22:55:48.151319930 1707.10.31D09:08:49.126752578 1707.11.22D19:21:50.102185226 1707.12.15D05:34:51.077617874 1708.01.06D15:47:52.053050522 1707.09.23D23:16:26.650764040 1707.09.23D09:13:51.849395959]))
(select {r: (avg (if (> c 4) d (+ d 1))) from: BQ by: g}) -- (table (as 'SYM (list "g" "r")) (list [0 1 2 3 4 5 6] [-16347508.325825825 -16415000.364064064 -16516998.589189189 -16404005.08028028 -16291011.57137137 -16178018.062462462 -16065024.553553553]))
