(at (update {r: (+ t i32) from: Q}) 'r) -- (+ (at Q 't) (at Q 'i32))
(at (select {r: (+ t i64) from: Q}) 'r) -- (+ (at Q 't) (at Q 'i64))
(at (select {r: (- t i64) from: Q}) 'r) -- (- (at Q 't) (at Q 'i64))
