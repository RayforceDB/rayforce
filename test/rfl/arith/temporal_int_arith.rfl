(at (select {r: (- d u8) from: Q}) 'r) -- (- (at Q 'd) (at Q 'u8))
(at (select {r: (+ u8 d) from: Q}) 'r) -- (+ (at Q 'u8) (at Q 'd))
(at (update {r: (+ d u8) from: Q}) 'r) -- (+ (at Q 'd) (at Q 'u8))
