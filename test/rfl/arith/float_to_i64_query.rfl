;; @also-unfused  (the raw cast sat on the unfused elementwise route)
;; #1343: a query's elementwise float -> I64 conversion goes through the
;; null-aware cast: a null gives the I64 null, and ±inf or an out-of-range
;; value saturates as the eager cast does.  A raw (int64_t) cast was
;; undefined there (UBSan in test-full).
(set X (as 'F32 [7.9 -7.9 0Nf 3e38 -3e38 0.0]))
(set Y (concat [7.9 -7.9 0Nf 1e300 -1e300 0.0] (list (/ 1.0 0.0) (/ -1.0 0.0))))
(set T (table [x] (list X)))
(set U (table [y] (list Y)))
(at (select {from: T r: (as 'I64 x)}) 'r) -- (as 'I64 X)
(at (select {from: T r: (as 'I64 x)}) 'r) -- [7 -7 0Nl 9223372036854775807 -9223372036854775807 0]
(at (select {from: U r: (as 'I64 y)}) 'r) -- (as 'I64 Y)
(at (select {from: T r: (signum x)}) 'r) -- (signum X)
(at (select {from: U r: (signum y)}) 'r) -- (signum Y)
;; every integer width (the narrow casts take their own null-aware arms:
;; regression coverage beside the I64 case)
(set N32 (as 'F32 [7.5 0Nf 1024.0 0.0 -2.5]))
(set N64 [7.5 0Nf 1024.0 0.0 -2.5])
(set T32 (table [a] (list N32)))
(set T64 (table [a] (list N64)))
(at (select {r: (as 'B8 a) from: T32}) 'r) -- (as 'B8 N32)
(at (select {r: (as 'U8 a) from: T32}) 'r) -- (as 'U8 N32)
(at (select {r: (as 'I16 a) from: T32}) 'r) -- (as 'I16 N32)
(at (select {r: (as 'I32 a) from: T32}) 'r) -- (as 'I32 N32)
(at (select {r: (as 'I64 a) from: T32}) 'r) -- (as 'I64 N32)
(at (select {r: (as 'B8 a) from: T64}) 'r) -- (as 'B8 N64)
(at (select {r: (as 'U8 a) from: T64}) 'r) -- (as 'U8 N64)
(at (select {r: (as 'I16 a) from: T64}) 'r) -- (as 'I16 N64)
(at (select {r: (as 'I32 a) from: T64}) 'r) -- (as 'I32 N64)
(at (update {r: (as 'I16 a) from: T32}) 'r) -- (as 'I16 N32)
;; the other float -> int64 conversions a query makes: the affine sum/avg
;; fold's bias, a constant fold of an out-of-range float literal, and the
;; fused sum/avg of a product that overflows to inf
(set FN [7.9 -7.9 1.5 1e300 -1e300 0.0 2.5])
(set TN (table [f] (list FN)))
(at (select {from: TN r: (sum (+ f 1e300))}) 'r) -- (enlist (sum (+ FN 1e300)))
(at (select {from: TN r: (avg (- f 1e300))}) 'r) -- (enlist (avg (- FN 1e300)))
(at (select {from: TN r: (+ f (* 1e300 2.0))}) 'r) -- (+ FN (* 1e300 2.0))
(at (select {from: TN r: (+ f (neg 1e300))}) 'r) -- (+ FN (neg 1e300))
(count (select {from: TN r: (sum (* f f))})) -- 1
(count (select {from: (table [a b] (list [1e200 2.0] [1e200 3.0])) r: (sum (* a b))})) -- 1
