;; #1395: casting a LIST to a typed vector reads one value per cell.  A cell
;; that casts to a vector (a GUID vector, `[1]`, a nested LIST) used to be
;; read as an atom: a GUID vector cell was followed as a pointer (a crash),
;; and an I64 vector cell gave its length (`(as 'I64 (list [1] [2]))` was
;; [1 1]).  Now a one-element cell is its element, an empty cell the type's
;; null, and a longer cell a type error.

;; GUID: atom cells, nulls and strings
(set G (first (guid 1)))
(set H (first (guid 1)))
(count (as 'GUID (list G H))) -- 2
(== (at (as 'GUID (list G H)) 1) H) -- true
(type (as 'GUID (list G H))) -- 'GUID
(nil? (as 'GUID (list 0Ng G))) -- [true false]
(== (at (as 'GUID (list "00000000-0000-0000-0000-000000000001")) 0) (as 'GUID "00000000-0000-0000-0000-000000000001")) -- true
(as 'GUID (list)) -- (as 'GUID [])
(as 'GUID (list 1 2)) !- type

;; GUID vector cells (the crash): one element, empty, nested, longer
(set V (guid 1))
(set W (guid 1))
(count (as 'GUID (list V W))) -- 2
(== (as 'GUID (list V W)) (concat V W)) -- [true true]
(== (at (as 'GUID (list G V)) 1) (first V)) -- true
(nil? (as 'GUID (list V (guid 0)))) -- [false true]
(== (at (as 'GUID (list (list G))) 0) G) -- true
(as 'GUID (list (guid 2))) !- type
(as 'GUID (list G (guid 3))) !- type

;; numeric, temporal and SYM targets: the same rule
(as 'I64 (list 1 2)) -- [1 2]
(as 'F64 (list 1 2.5)) -- [1.0 2.5]
(as 'I64 (list [1] [2])) -- [1 2]
(as 'I64 (list [1] () 3)) -- [1 0Nl 3]
(nil? (as 'I64 (list [1] () 3))) -- [false true false]
(as 'I64 (list (list (list 7)))) -- [7]
(as 'F64 (list [1.5] (list 2))) -- [1.5 2.0]
(as 'I32 (list [1] [2])) -- [1i 2i]
(as 'DATE (list [1] ())) -- [2000.01.02 0Nd]
(as 'SYM (list ['a] ['b])) -- ['a 'b]
(as 'SYM (list 'a 'b)) -- ['a 'b]
(as 'SYM (list "ab" (raze (take (list "a") 0)))) -- ['ab ']
(as 'I64 (list [1 2])) !- type
(as 'I64 (list 1 [2 3])) !- type
(as 'U8 (list [1 2])) !- type
(as 'F64 (list [1.5 2.5])) !- type
(as 'TIMESPAN (list [1 2])) !- type
(as 'SYM (list ['a 'b])) !- type
