(at SLR 'c) -- [18726 18726 18726 18726 18725 18725 18725]
(value SLR) -- (value SLP)
(nil? (at SLR 'a)) -- [false false false false false false false]
;; wide16: m, sum
(set SLR (select {a: (sum (strlen y)) c: (count y) from: SLU by: m asc: m}))
(set SLP (select {a: (sum (strlen y)) c: (count y) from: SLT by: m asc: m}))
