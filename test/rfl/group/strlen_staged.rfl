;; @requires: posix
;; Staged SYM strlen uses piece-relative rows and widths.
;; SUM and AVG are separate queries: exactly one strlen aggregate beside COUNT.
(.sys.exec "rm -rf /tmp/rfl_strlen_staged; mkdir -p /tmp/rfl_strlen_staged")
(set SLI (til 131079))
(set SLH (as 'I16 (- (% SLI 7) 3)))
(set SLM (as 'I32 SLH))
(set SLL (as 'I64 SLH))
(set SLQ (as 'I32 (- (% SLI 8192) 4096)))
(set SLY (as 'SYM (at ["" "a" "bb" "cccccc" "lengthier" "" "a" "" "cccccc" "lengthier" "" "a" "bb" "cccccc" "" "" "a" "bb" "cccccc" "lengthier" "" "" "bb" "cccccc" "lengthier" "" "a" "bb" "" "lengthier" "" "a" "bb" "cccccc" "lengthier"] (% SLI 35))))
(set SLT (table [h m l p y] (list SLH SLM SLL SLQ SLY)))
(.db.splayed.set "/tmp/rfl_strlen_staged/small/" SLT "/tmp/rfl_strlen_staged/small.sym" {compress: true})
(set SLU (.db.splayed.get "/tmp/rfl_strlen_staged/small/" "/tmp/rfl_strlen_staged/small.sym"))
;; small: h, sum
(set SLR (select {a: (sum (strlen y)) c: (count y) from: SLU by: h asc: h}))
(set SLP (select {a: (sum (strlen y)) c: (count y) from: SLT by: h asc: h}))
(as 'I64 (at SLR 'h)) -- [-3 -2 -1 0 1 2 3]
(type (at SLR 'h)) -- (type (at SLP 'h))
(at SLR 'a) -- [0 67411 67412 67416 67410 67410 67410]
(at SLR 'c) -- [18726 18726 18726 18726 18725 18725 18725]
(value SLR) -- (value SLP)
;; small: h, avg
(set SLR (select {a: (avg (strlen y)) c: (count y) from: SLU by: h asc: h}))
(set SLP (select {a: (avg (strlen y)) c: (count y) from: SLT by: h asc: h}))
(as 'I64 (at SLR 'h)) -- [-3 -2 -1 0 1 2 3]
(type (at SLR 'h)) -- (type (at SLP 'h))
(at SLR 'a) -- [0Nf 4.499766370736266 4.499833121954476 4.500100126827315 4.5 4.5 4.5]
(at SLR 'c) -- [18726 18726 18726 18726 18725 18725 18725]
(value SLR) -- (value SLP)
(nil? (at SLR 'a)) -- [true false false false false false false]
;; small: m, sum
(set SLR (select {a: (sum (strlen y)) c: (count y) from: SLU by: m asc: m}))
(set SLP (select {a: (sum (strlen y)) c: (count y) from: SLT by: m asc: m}))
(as 'I64 (at SLR 'm)) -- [-3 -2 -1 0 1 2 3]
(type (at SLR 'm)) -- (type (at SLP 'm))
(at SLR 'a) -- [0 67411 67412 67416 67410 67410 67410]
(at SLR 'c) -- [18726 18726 18726 18726 18725 18725 18725]
(value SLR) -- (value SLP)
;; small: m, avg
(set SLR (select {a: (avg (strlen y)) c: (count y) from: SLU by: m asc: m}))
(set SLP (select {a: (avg (strlen y)) c: (count y) from: SLT by: m asc: m}))
(as 'I64 (at SLR 'm)) -- [-3 -2 -1 0 1 2 3]
(type (at SLR 'm)) -- (type (at SLP 'm))
(at SLR 'a) -- [0Nf 4.499766370736266 4.499833121954476 4.500100126827315 4.5 4.5 4.5]
(at SLR 'c) -- [18726 18726 18726 18726 18725 18725 18725]
(value SLR) -- (value SLP)
(nil? (at SLR 'a)) -- [true false false false false false false]
;; small: l, sum
(set SLR (select {a: (sum (strlen y)) c: (count y) from: SLU by: l asc: l}))
(set SLP (select {a: (sum (strlen y)) c: (count y) from: SLT by: l asc: l}))
(as 'I64 (at SLR 'l)) -- [-3 -2 -1 0 1 2 3]
(type (at SLR 'l)) -- (type (at SLP 'l))
(at SLR 'a) -- [0 67411 67412 67416 67410 67410 67410]
(at SLR 'c) -- [18726 18726 18726 18726 18725 18725 18725]
(value SLR) -- (value SLP)
;; small: l, avg
(set SLR (select {a: (avg (strlen y)) c: (count y) from: SLU by: l asc: l}))
(set SLP (select {a: (avg (strlen y)) c: (count y) from: SLT by: l asc: l}))
(as 'I64 (at SLR 'l)) -- [-3 -2 -1 0 1 2 3]
(type (at SLR 'l)) -- (type (at SLP 'l))
(at SLR 'a) -- [0Nf 4.499766370736266 4.499833121954476 4.500100126827315 4.5 4.5 4.5]
(at SLR 'c) -- [18726 18726 18726 18726 18725 18725 18725]
(value SLR) -- (value SLP)
(nil? (at SLR 'a)) -- [true false false false false false false]
;; 8192 slots enables the piece-bounded prefetch loop.
(set SLR (select {a: (sum (strlen y)) c: (count y) from: SLU by: p asc: p}))
(set SLP (select {a: (sum (strlen y)) c: (count y) from: SLT by: p asc: p}))
(as 'I64 (at SLR 'p)) -- (- (til 8192) 4096)
(sum (at SLR 'c)) -- 131079
(value SLR) -- (value SLP)
;; 8192 slots enables the piece-bounded prefetch loop.
(set SLR (select {a: (avg (strlen y)) c: (count y) from: SLU by: p asc: p}))
(set SLP (select {a: (avg (strlen y)) c: (count y) from: SLT by: p asc: p}))
(as 'I64 (at SLR 'p)) -- (- (til 8192) 4096)
(sum (at SLR 'c)) -- 131079
(value SLR) -- (value SLP)
(set SLV (as 'SYM (map (fn [j] (format "v%" j)) (til 300))))
(set SLY (at (concat (enlist (as 'SYM "")) SLV) (% SLI 301)))
(set SLT (table [h m l p y] (list SLH SLM SLL SLQ SLY)))
(.db.splayed.set "/tmp/rfl_strlen_staged/wide16/" SLT "/tmp/rfl_strlen_staged/wide16.sym" {compress: true})
