;; parted_group_wide.rfl — wide parted GROUP BY (9 keys, 9 aggregates) that
;; genuinely DRIVES the streaming per-partition kernel.
;;
;; exec_group_parted (src/ops/group.c) only calls exec_group_per_partition when
;; the cardinality gate holds: est_groups*100 <= rows_per_part, where est_groups
;; is the product of per-key cardinalities.  A small fixture with every key
;; varying routes through the concat fallback instead, making the assertions
;; vacuous.  So here 8 of the 9 group keys are CONSTANT columns (cardinality 1)
;; and only ONE key varies with 3 distinct values → est_groups = 3; with 400
;; rows/partition rows_per_part = 400 >= 100*3 = 300, clearing the gate.
;;
;; Two assertions: (a) group-perpart-runs (from (.sys.mem)) strictly increments,
;; proving exec_group_per_partition actually ran; (b) the parted grouped result
;; equals the identical-data flat in-memory oracle, row-for-row (sorted by the
;; varying key), covering all 9 aggregate ops incl. AVG/STDDEV/VAR decomposition.

;; ─── fixture: 2 partitions, 400 rows each, 3 groups spanning both ────────────
;;   kv = (% (til 400) 3) → varying key with 3 distinct values (the only one)
;;   k1..k8 = constant columns (cardinality 1 each) so est_groups stays = 3
;;   v = F64 value column (partition 2 offset by 1000 so aggregates differ)
(set N 400)
(set KV (% (til N) 3))
(set C1 (+ 11 (* 0 (til N))))
(set C2 (+ 22 (* 0 (til N))))
(set C3 (+ 33 (* 0 (til N))))
(set C4 (+ 44 (* 0 (til N))))
(set C5 (+ 55 (* 0 (til N))))
(set C6 (+ 66 (* 0 (til N))))
(set C7 (+ 77 (* 0 (til N))))
(set C8 (+ 88 (* 0 (til N))))
(set V1 (as 'F64 (til N)))
(set V2 (as 'F64 (+ 1000 (til N))))
(set P1 (table [k0 k1 k2 k3 k4 k5 k6 k7 k8 v] (list KV C1 C2 C3 C4 C5 C6 C7 C8 V1)))
(set P2 (table [k0 k1 k2 k3 k4 k5 k6 k7 k8 v] (list KV C1 C2 C3 C4 C5 C6 C7 C8 V2)))
(.sys.exec "rm -rf /tmp/rfl_pgw")
(.db.splayed.set "/tmp/rfl_pgw/1/t/" P1)
(.db.splayed.set "/tmp/rfl_pgw/2/t/" P2)
(set Pw (.db.parted.get "/tmp/rfl_pgw/" 't))

;; identical-data flat in-memory table (part1 rows ++ part2 rows, same order)
(set KA (concat KV KV))
(set VA (concat V1 V2))
(set TF (table [k0 k1 k2 k3 k4 k5 k6 k7 k8 v] (list KA (concat C1 C1) (concat C2 C2) (concat C3 C3) (concat C4 C4) (concat C5 C5) (concat C6 C6) (concat C7 C7) (concat C8 C8) VA)))

;; ─── snapshot the streaming-kernel run counter BEFORE the parted group ───────
(set B (at (.sys.mem) 'group-perpart-runs))

;; ─── wide group: 9 keys, 9 aggregates, sorted by k0 for stable compare ───────
(set RP (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) sdv: (stddev v) vrv: (var v) fv: (first v) lv: (last v) by: {k0: k0 k1: k1 k2: k2 k3: k3 k4: k4 k5: k5 k6: k6 k7: k7 k8: k8} from: Pw asc: k0}))

;; ─── snapshot AFTER: the streaming per-partition kernel must have run ─────────
(set A (at (.sys.mem) 'group-perpart-runs))
;; PROVES exec_group_per_partition executed (else fixture routed via concat).
(> A B) -- true

(set RF (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) sdv: (stddev v) vrv: (var v) fv: (first v) lv: (last v) by: {k0: k0 k1: k1 k2: k2 k3: k3 k4: k4 k5: k5 k6: k6 k7: k7 k8: k8} from: TF asc: k0}))

;; cardinality: 3 groups
(count RP) -- 3
(count RP) -- (count RF)

;; key columns match flat oracle
(at RP 'k0) -- (at RF 'k0)
(at RP 'k4) -- (at RF 'k4)
(at RP 'k8) -- (at RF 'k8)
(at RP 'k0) -- [0 1 2]
(at RP 'k8) -- [88 88 88]

;; exact (order-independent integer-valued) aggregates match flat
(at RP 'sv)  -- (at RF 'sv)
(at RP 'cv)  -- (at RF 'cv)
(at RP 'mnv) -- (at RF 'mnv)
(at RP 'mxv) -- (at RF 'mxv)
(at RP 'fv)  -- (at RF 'fv)
(at RP 'lv)  -- (at RF 'lv)

;; float aggregates (avg/stddev/var) match flat within tolerance
(< (max (abs (- (at RP 'av)  (at RF 'av))))  0.000001) -- true
(< (max (abs (- (at RP 'sdv) (at RF 'sdv)))) 0.000001) -- true
(< (max (abs (- (at RP 'vrv) (at RF 'vrv)))) 0.000001) -- true

;; ─── cardinality gate over a full-span or nullable integer key ──────────────
;; The gate's range proxy hi - lo + 1 overflowed (UBSan abort) for an I64 key
;; spanning more than INT64_MAX or holding 0N next to a positive value, and in
;; i32 arithmetic for an I32 key spanning more than INT32_MAX or holding 0Ni.
(.sys.exec "rm -rf /tmp/rfl_pgs")
(.db.splayed.set "/tmp/rfl_pgs/1/t/" (table [a b c d v] (list [-9000000000000000000 9000000000000000000 3] [0N 5 3] (as 'I32 [-2000000000 2000000000 3]) (as 'I32 [0N 5 3]) [10 20 30])))
(.db.splayed.set "/tmp/rfl_pgs/2/t/" (table [a b c d v] (list [-9000000000000000000 9000000000000000000 4] [0N 5 4] (as 'I32 [-2000000000 2000000000 4]) (as 'I32 [0N 5 4]) [40 50 60])))
(set Ps (.db.parted.get "/tmp/rfl_pgs/" 't))
;; Route pinned too: 3 rows per partition, so the full-span keys saturate the
;; estimate to rows_per_part+1 and the nullable ones count 3 values plus the
;; null; est_groups*100 > rows_per_part either way, so none of these streams
;; per partition.  A span computed in signed arithmetic that wrapped small
;; would pick the per-partition route by accident and still sum right.
(set B (at (.sys.mem) 'group-perpart-runs))
(at (select {s: (sum v) from: Ps by: a asc: a}) 's) -- [50 30 60 70]
(at (select {s: (sum v) from: Ps by: b asc: b}) 's) -- [50 30 60 70]
(at (select {s: (sum v) from: Ps by: c asc: c}) 's) -- [50 30 60 70]
(at (select {s: (sum v) from: Ps by: d asc: d}) 's) -- [50 30 60 70]
(at (.sys.mem) 'group-perpart-runs) -- B
(.sys.exec "rm -rf /tmp/rfl_pgs")

;; A nullable low-cardinality key must still stream per partition: the gate
;; took the null sentinel as the low end of the range, so 0N next to 1..3
;; estimated rows_per_part+1 groups (I64) or ~2^31 (I32) and sent the group-by
;; to the concat path.  Four groups (null + 1..3) over 1000 rows/partition
;; clear est_groups*100 <= rows_per_part only when the null counts as one group.
(set NN 1000)
;; The same for the other integer-like widths — DATE, TIME, TIMESTAMP, I16 —
;; which had no range estimate at all (card = rows of the partition) and so
;; always left the per-partition path.
(set PN (fn [b] (table [k j d t p h v] (list (at [0N 1 2 3] (% (til NN) 4)) (as 'I32 (at [0N 1 2 3] (% (til NN) 4))) (as 'DATE (at [0N 1 2 3] (% (til NN) 4))) (as 'TIME (at [0N 1 2 3] (% (til NN) 4))) (as 'TIMESTAMP (at [0N 1 2 3] (% (til NN) 4))) (as 'I16 (at [0N 1 2 3] (% (til NN) 4))) (+ b (til NN))))))
(.sys.exec "rm -rf /tmp/rfl_pgn")
(.db.splayed.set "/tmp/rfl_pgn/1/t/" (PN 0))
(.db.splayed.set "/tmp/rfl_pgn/2/t/" (PN 1000))
(.db.splayed.set "/tmp/rfl_pgn/3/t/" (PN 2000))
(set Pn (.db.parted.get "/tmp/rfl_pgn/" 't))
(set B (at (.sys.mem) 'group-perpart-runs))
(at (select {s: (sum v) from: Pn by: k asc: k}) 's) -- [1123500 1124250 1125000 1125750]
(> (at (.sys.mem) 'group-perpart-runs) B) -- true
(set B (at (.sys.mem) 'group-perpart-runs))
(at (select {s: (sum v) from: Pn by: j asc: j}) 's) -- [1123500 1124250 1125000 1125750]
(> (at (.sys.mem) 'group-perpart-runs) B) -- true
(set B (at (.sys.mem) 'group-perpart-runs))
(at (select {s: (sum v) from: Pn by: d asc: d}) 's) -- [1123500 1124250 1125000 1125750]
(> (at (.sys.mem) 'group-perpart-runs) B) -- true
(set B (at (.sys.mem) 'group-perpart-runs))
(at (select {s: (sum v) from: Pn by: t asc: t}) 's) -- [1123500 1124250 1125000 1125750]
(> (at (.sys.mem) 'group-perpart-runs) B) -- true
(set B (at (.sys.mem) 'group-perpart-runs))
(at (select {s: (sum v) from: Pn by: p asc: p}) 's) -- [1123500 1124250 1125000 1125750]
(> (at (.sys.mem) 'group-perpart-runs) B) -- true
(set B (at (.sys.mem) 'group-perpart-runs))
(at (select {s: (sum v) from: Pn by: h asc: h}) 's) -- [1123500 1124250 1125000 1125750]
(> (at (.sys.mem) 'group-perpart-runs) B) -- true
(.sys.exec "rm -rf /tmp/rfl_pgn")

;; ─── cleanup ─────────────────────────────────────────────────────────────────
(.sys.exec "rm -rf /tmp/rfl_pgw")
