;; parted_group_wide.rfl — wide parted GROUP BY (9 keys, 9 aggregates) that
;; genuinely DRIVES the streaming per-partition kernel.
;;
;; exec_group_parted (src/ops/group.c) only calls exec_group_per_partition when
;; the cardinality gate holds: est_groups*100 <= rows_per_part, where est_groups
;; is the product of per-key cardinalities.  A small fixture with every key
;; varying routes through the concat fallback instead, making the assertions
;; vacuous.  So here 8 of the 9 group keys are CONSTANT columns (cardinality 1)
;; and only ONE key varies with 3 distinct values → est_groups = 3; with 400
;; rows/partition rows_per_part = 400 >= 100*3 = 300, clearing the gate.
;;
;; Two assertions: (a) group-perpart-runs (from (.sys.mem)) strictly increments,
;; proving exec_group_per_partition actually ran; (b) the parted grouped result
;; equals the identical-data flat in-memory oracle, row-for-row (sorted by the
;; varying key), covering all 9 aggregate ops incl. AVG/STDDEV/VAR decomposition.

;; ─── fixture: 2 partitions, 400 rows each, 3 groups spanning both ────────────
;;   kv = (% (til 400) 3) → varying key with 3 distinct values (the only one)
;;   k1..k8 = constant columns (cardinality 1 each) so est_groups stays = 3
;;   v = F64 value column (partition 2 offset by 1000 so aggregates differ)
(set N 400)
(set KV (% (til N) 3))
(set C1 (+ 11 (* 0 (til N))))
(set C2 (+ 22 (* 0 (til N))))
(set C3 (+ 33 (* 0 (til N))))
(set C4 (+ 44 (* 0 (til N))))
(set C5 (+ 55 (* 0 (til N))))
(set C6 (+ 66 (* 0 (til N))))
(set C7 (+ 77 (* 0 (til N))))
(set C8 (+ 88 (* 0 (til N))))
(set V1 (as 'F64 (til N)))
(set V2 (as 'F64 (+ 1000 (til N))))
(set P1 (table [k0 k1 k2 k3 k4 k5 k6 k7 k8 v] (list KV C1 C2 C3 C4 C5 C6 C7 C8 V1)))
(set P2 (table [k0 k1 k2 k3 k4 k5 k6 k7 k8 v] (list KV C1 C2 C3 C4 C5 C6 C7 C8 V2)))
(.sys.exec "rm -rf /tmp/rfl_pgw")
(.db.splayed.set "/tmp/rfl_pgw/1/t/" P1)
(.db.splayed.set "/tmp/rfl_pgw/2/t/" P2)
(set Pw (.db.parted.get "/tmp/rfl_pgw/" 't))

;; identical-data flat in-memory table (part1 rows ++ part2 rows, same order)
(set KA (concat KV KV))
(set VA (concat V1 V2))
(set TF (table [k0 k1 k2 k3 k4 k5 k6 k7 k8 v] (list KA (concat C1 C1) (concat C2 C2) (concat C3 C3) (concat C4 C4) (concat C5 C5) (concat C6 C6) (concat C7 C7) (concat C8 C8) VA)))

;; ─── snapshot the streaming-kernel run counter BEFORE the parted group ───────
(set B (at (.sys.mem) 'group-perpart-runs))

;; ─── wide group: 9 keys, 9 aggregates, sorted by k0 for stable compare ───────
(set RP (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) sdv: (stddev v) vrv: (var v) fv: (first v) lv: (last v) by: {k0: k0 k1: k1 k2: k2 k3: k3 k4: k4 k5: k5 k6: k6 k7: k7 k8: k8} from: Pw asc: k0}))

;; ─── snapshot AFTER: the streaming per-partition kernel must have run ─────────
(set A (at (.sys.mem) 'group-perpart-runs))
;; PROVES exec_group_per_partition executed (else fixture routed via concat).
(> A B) -- true

(set RF (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) sdv: (stddev v) vrv: (var v) fv: (first v) lv: (last v) by: {k0: k0 k1: k1 k2: k2 k3: k3 k4: k4 k5: k5 k6: k6 k7: k7 k8: k8} from: TF asc: k0}))

;; cardinality: 3 groups
(count RP) -- 3
(count RP) -- (count RF)

;; key columns match flat oracle
(at RP 'k0) -- (at RF 'k0)
(at RP 'k4) -- (at RF 'k4)
(at RP 'k8) -- (at RF 'k8)
(at RP 'k0) -- [0 1 2]
(at RP 'k8) -- [88 88 88]

;; exact (order-independent integer-valued) aggregates match flat
(at RP 'sv)  -- (at RF 'sv)
(at RP 'cv)  -- (at RF 'cv)
(at RP 'mnv) -- (at RF 'mnv)
(at RP 'mxv) -- (at RF 'mxv)
(at RP 'fv)  -- (at RF 'fv)
(at RP 'lv)  -- (at RF 'lv)

;; float aggregates (avg/stddev/var) match flat within tolerance
(< (max (abs (- (at RP 'av)  (at RF 'av))))  0.000001) -- true
(< (max (abs (- (at RP 'sdv) (at RF 'sdv)))) 0.000001) -- true
(< (max (abs (- (at RP 'vrv) (at RF 'vrv)))) 0.000001) -- true

;; ─── nullable inputs: AVG/VAR/STDDEV divide by the NON-NULL count (#767) ─────
;; The streaming kernel decomposes AVG into SUM+COUNT and VAR/STDDEV into
;; SUM+SUM(x²)+COUNT.  SUM skips nulls, so the COUNT must too — it used to be
;; the group row count, dividing the non-null sum by every row.  Fixture: 2
;; partitions × 600 rows, key g = i mod 3 (gate: 3*100 <= 600).  Every 4th row
;; is null; g=2 is null everywhere (all-null group → null avg/var, as flat);
;; g=1 is all null in partition 1 only.  f is F64, k the same values as I64.
(set mknull (fn [n off] (do (set i (+ (til n) off)) (set g (% i 3)) (set z (or (or (== g 2) (== (% i 4) 0)) (and (< off 1) (== g 1)))) (set f (/ (as 'F64 i) (as 'F64 (not z)))) (table [g f k] (list g f (as 'I64 f))))))
(.sys.exec "rm -rf /tmp/rfl_pgwn")
(.db.splayed.set "/tmp/rfl_pgwn/2024.01.01/t/" (mknull 600 0))
(.db.splayed.set "/tmp/rfl_pgwn/2024.01.02/t/" (mknull 600 600))
(set Pn (.db.parted.get "/tmp/rfl_pgwn/" 't))
(set Fn (concat (mknull 600 0) (mknull 600 600)))
(set qn (fn [T] (select {a: (avg f) v: (var f) vp: (var_pop f) d: (dev f) sd: (stddev f) sp: (stddev_pop f) ak: (avg k) vk: (var k) dk: (dev k) fi: (first f) la: (last k) from: T by: g asc: g})))
(set Bn (at (.sys.mem) 'group-perpart-runs))
(set NP (qn Pn))
(> (at (.sys.mem) 'group-perpart-runs) Bn) -- true
(set NF (qn Fn))
(at NP 'a)  -- [600.0 900.0 0Nf]
(at NP 'ak) -- [600.0 900.0 0Nf]
(at NP 'a)  -- (at NF 'a)
(at NP 'ak) -- (at NF 'ak)
(at NP 'fi) -- (at NF 'fi)
(at NP 'la) -- (at NF 'la)
(nil? (at NP 'v))  -- (nil? (at NF 'v))
(nil? (at NP 'vk)) -- (nil? (at NF 'vk))
(< (max (abs (- (take (at NP 'v)  2) (take (at NF 'v)  2)))) 0.000001) -- true
(< (max (abs (- (take (at NP 'vp) 2) (take (at NF 'vp) 2)))) 0.000001) -- true
(< (max (abs (- (take (at NP 'd)  2) (take (at NF 'd)  2)))) 0.000001) -- true
(< (max (abs (- (take (at NP 'sd) 2) (take (at NF 'sd) 2)))) 0.000001) -- true
(< (max (abs (- (take (at NP 'sp) 2) (take (at NF 'sp) 2)))) 0.000001) -- true
(< (max (abs (- (take (at NP 'vk) 2) (take (at NF 'vk) 2)))) 0.000001) -- true
(< (max (abs (- (take (at NP 'dk) 2) (take (at NF 'dk) 2)))) 0.000001) -- true
;; same under a pushed-down WHERE (k is not filtered, so its nulls survive)
(set wn (fn [T] (select {a: (avg k) v: (var k) from: T where: (> g 0) by: g asc: g})))
(at (wn Pn) 'a) -- (at (wn Fn) 'a)
(< (abs (- (first (at (wn Pn) 'v)) (first (at (wn Fn) 'v)))) 0.000001) -- true
;; ungrouped, and grouped by the MAPCOMMON partition column
(set un (fn [T] (select {a: (avg f) ak: (avg k) v: (var k) from: T})))
(at (un Pn) 'a)  -- (at (un Fn) 'a)
(at (un Pn) 'ak) -- (at (un Fn) 'ak)
(< (abs (- (first (at (un Pn) 'v)) (first (at (un Fn) 'v)))) 0.000001) -- true
(at (select {a: (avg f) ak: (avg k) from: Pn by: date}) 'a)  -- [300.0 900.0]
(at (select {a: (avg f) ak: (avg k) from: Pn by: date}) 'ak) -- [300.0 900.0]
;; mixed partitions: partition 1 has no nulls (its segments carry no
;; HAS_NULLS, so its divisor slot takes the free group row count), partition 2
;; does (that slot sums a not-null indicator).  A user (count f) sits next to
;; (avg f): both divisor columns were named "f_count" by the first partial, so
;; the merge — which scans by name — read the row count for avg's divisor.
(set mkclean (fn [n off] (do (set i (+ (til n) off)) (table [g f k] (list (% i 3) (as 'F64 i) i)))))
(.sys.exec "rm -rf /tmp/rfl_pgwm")
(.db.splayed.set "/tmp/rfl_pgwm/2024.01.01/t/" (mkclean 600 0))
(.db.splayed.set "/tmp/rfl_pgwm/2024.01.02/t/" (mknull 600 600))
(set Pm (.db.parted.get "/tmp/rfl_pgwm/" 't))
(set Fm (concat (mkclean 600 0) (mknull 600 600)))
(set qm (fn [T] (select {c: (count f) a: (avg f) v: (var f) ck: (count k) ak: (avg k) dk: (dev k) from: T by: g asc: g})))
(set Bm (at (.sys.mem) 'group-perpart-runs))
(set MP (qm Pm))
(> (at (.sys.mem) 'group-perpart-runs) Bm) -- true
(set MF (qm Fm))
(last (at MP 'a)) -- 300.5
(at MP 'a)  -- (at MF 'a)
(at MP 'ak) -- (at MF 'ak)
(at MP 'c)  -- (at MF 'c)
(at MP 'ck) -- (at MF 'ck)
(any (nil? (at MP 'v)))  -- false
(any (nil? (at MP 'dk))) -- false
(< (max (abs (- (at MP 'v)  (at MF 'v))))  0.000001) -- true
(< (max (abs (- (at MP 'dk) (at MF 'dk)))) 0.000001) -- true
;; ungrouped over the same mix
(set um (fn [T] (select {c: (count f) a: (avg f) v: (var k) from: T})))
(at (um Pm) 'a) -- (at (um Fm) 'a)
(at (um Pm) 'c) -- (at (um Fm) 'c)
(< (abs (- (first (at (um Pm) 'v)) (first (at (um Fm) 'v)))) 0.000001) -- true

;; ─── cleanup ─────────────────────────────────────────────────────────────────
(.sys.exec "rm -rf /tmp/rfl_pgw /tmp/rfl_pgwn /tmp/rfl_pgwm")
