;; parted_group_where.rfl — WHERE-FILTERED parted GROUP BY that STREAMS the
;; pushed-down selection per partition (exec_group_parted / Part A) and, for the
;; computed by-dict headline, defers the computed keys over a filtered parted
;; input (ray_select / Part B).
;;
;; Before this change a pushed-down WHERE (g->selection set) forced
;; exec_group_parted onto the full-concat fallback — the streaming kernel never
;; ran with a filter.  Now g->selection is a rowsel over the parted table's
;; GLOBAL concatenated row space (segment order); exec_group_per_partition
;; flattens it once, binary-searches each partition's [off_p, off_p+len_p)
;; range, rebases the ids to partition-local, and installs them as each
;; sub-group's own selection.  Zero-survivor partitions contribute an empty
;; partial (correct empty handling).
;;
;; The (.sys.mem) 'group-perpart-runs counter increments once per
;; exec_group_per_partition entry, so a strict increase proves the streaming
;; kernel ran; parity with an identical-data flat in-memory oracle under the
;; SAME WHERE proves correctness.
;;
;; Cardinality gate (exec_group_parted): est_groups*100 <= rows_per_part with
;; rows_per_part = total_rows/n_parts (UNFILTERED — models the concat fallback's
;; cost), est_groups capped by post-filter survivor density.  400 rows/partition
;; with 2-value keys keeps est_groups small so every filtered shape below clears.

;; ─── fixture: 4 partitions, 400 rows each ────────────────────────────────────
;;   ts = 0..399 (same every partition)  → (xbar ts 200) = {0,200}, 2 buckets
;;   sg = (% (til 400) 2) as SYM         → 2-value symbol key
;;   v  = 0..399 (same every partition)  → uniform filter selectivity for (a)-(c)
;;   u  = base_p + 0..399, base_p ∈ {0,400,800,1200} → partition-varying column
;;        used to zero out a whole partition in (d)
(set N 400)
(set TS (til N))
(set SG (as 'SYM (% (til N) 2)))
(set V  (as 'F64 (til N)))
(set U1 (til N))
(set U2 (+ 400  (til N)))
(set U3 (+ 800  (til N)))
(set U4 (+ 1200 (til N)))
(set P1 (table [ts sg v u] (list TS SG V U1)))
(set P2 (table [ts sg v u] (list TS SG V U2)))
(set P3 (table [ts sg v u] (list TS SG V U3)))
(set P4 (table [ts sg v u] (list TS SG V U4)))
(.sys.exec "rm -rf /tmp/rfl_pgwh")
(.db.splayed.set "/tmp/rfl_pgwh/1/t/" P1)
(.db.splayed.set "/tmp/rfl_pgwh/2/t/" P2)
(.db.splayed.set "/tmp/rfl_pgwh/3/t/" P3)
(.db.splayed.set "/tmp/rfl_pgwh/4/t/" P4)
(set Pw (.db.parted.get "/tmp/rfl_pgwh/" 't))

;; identical-data flat in-memory oracle (part1..part4 rows, same order)
(set TSA (concat (concat TS TS) (concat TS TS)))
(set SGA (concat (concat SG SG) (concat SG SG)))
(set VA  (concat (concat V V)   (concat V V)))
(set UA  (concat (concat U1 U2) (concat U3 U4)))
(set TF (table [ts sg v u] (list TSA SGA VA UA)))

;; ══════════════════════════════════════════════════════════════════════════
;; (a) BARE KEY + FILTER — `by: sg where: (> v 100)`.  Selection streams per
;;     partition (Part A); est_groups = 2 clears the gate.
;; ══════════════════════════════════════════════════════════════════════════
(set Ba (at (.sys.mem) 'group-perpart-runs))
(set RPa (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) by: sg from: Pw where: (> v 100) asc: sg}))
(set Aa (at (.sys.mem) 'group-perpart-runs))
;; PROVES exec_group_per_partition ran with a pushed-down selection.
(> Aa Ba) -- true
(set RFa (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) by: sg from: TF where: (> v 100) asc: sg}))
(count RPa) -- 2
(count RPa) -- (count RFa)
(at RPa 'sg)  -- (at RFa 'sg)
(at RPa 'sv)  -- (at RFa 'sv)
(at RPa 'cv)  -- (at RFa 'cv)
(at RPa 'mnv) -- (at RFa 'mnv)
(at RPa 'mxv) -- (at RFa 'mxv)
(< (max (abs (- (at RPa 'av) (at RFa 'av)))) 0.000001) -- true

;; ══════════════════════════════════════════════════════════════════════════
;; (b) FILTERED OPTIONS HEADLINE — `by: {tb: (xbar ts 200) s: sg} where: (> v
;;     100)`.  The computed+rename by-dict is DEFERRED over the FILTERED parted
;;     input (Part B) and the per-partition selection composes with the
;;     per-partition xbar key materialization (Part A).  est_groups = 2*2 = 4,
;;     4*100 = 400 <= 400 clears the gate.
;; ══════════════════════════════════════════════════════════════════════════
(set Bb (at (.sys.mem) 'group-perpart-runs))
(set RPb (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) by: {tb: (xbar ts 200) s: sg} from: Pw where: (> v 100) asc: tb}))
(set Ab (at (.sys.mem) 'group-perpart-runs))
;; PROVES exec_group_per_partition ran for the filtered computed by-dict.
(> Ab Bb) -- true
(set RFb (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) by: {tb: (xbar ts 200) s: sg} from: TF where: (> v 100) asc: tb}))
(count RPb) -- 4
(count RPb) -- (count RFb)
(at RPb 'tb)  -- (at RFb 'tb)
(at RPb 's)   -- (at RFb 's)
(at RPb 'sv)  -- (at RFb 'sv)
(at RPb 'cv)  -- (at RFb 'cv)
(at RPb 'mnv) -- (at RFb 'mnv)
(at RPb 'mxv) -- (at RFb 'mxv)
(< (max (abs (- (at RPb 'av) (at RFb 'av)))) 0.000001) -- true

;; ══════════════════════════════════════════════════════════════════════════
;; (c) HIGH-SELECTIVITY FILTER — `by: sg where: (> v 395)`.  Only v in 396..399
;;     survive: 4 rows/partition × 4 partitions = 16 survivors spread across
;;     ALL partitions.  Still streams (est_groups capped by survivor density);
;;     parity confirms sparse per-partition slicing is correct.
;; ══════════════════════════════════════════════════════════════════════════
(set Bc (at (.sys.mem) 'group-perpart-runs))
(set RPc (select {sv: (sum v) cv: (count v) by: sg from: Pw where: (> v 395) asc: sg}))
(set Ac (at (.sys.mem) 'group-perpart-runs))
;; PROVES exec_group_per_partition ran even with few survivors per partition.
(> Ac Bc) -- true
(set RFc (select {sv: (sum v) cv: (count v) by: sg from: TF where: (> v 395) asc: sg}))
(count RPc) -- (count RFc)
(at RPc 'sg) -- (at RFc 'sg)
(at RPc 'sv) -- (at RFc 'sv)
(at RPc 'cv) -- (at RFc 'cv)
;; survivors: v ∈ {396,398} (even sg=0) and {397,399} (odd sg=1), ×4 partitions
(at RPc 'cv) -- [8 8]

;; ══════════════════════════════════════════════════════════════════════════
;; (d) EMPTY-PARTITION HANDLING — a WHERE that filters out an ENTIRE partition.
;;     (d1) `> u 700`: P1 (u 0..399) contributes ZERO survivors — it is the
;;          FIRST partition, built as the empty schema reference.
;;     (d2) `< u 1200`: P4 (u 1200..1599) contributes ZERO survivors — a LATER
;;          partition, short-circuited (skipped).  Both assert parity.
;; ══════════════════════════════════════════════════════════════════════════
(set RPd1 (select {sv: (sum v) cv: (count v) mnv: (min v) by: sg from: Pw where: (> u 700) asc: sg}))
(set RFd1 (select {sv: (sum v) cv: (count v) mnv: (min v) by: sg from: TF where: (> u 700) asc: sg}))
(count RPd1) -- (count RFd1)
(at RPd1 'sg)  -- (at RFd1 'sg)
(at RPd1 'sv)  -- (at RFd1 'sv)
(at RPd1 'cv)  -- (at RFd1 'cv)
(at RPd1 'mnv) -- (at RFd1 'mnv)

(set RPd2 (select {sv: (sum v) cv: (count v) mxv: (max v) by: sg from: Pw where: (< u 1200) asc: sg}))
(set RFd2 (select {sv: (sum v) cv: (count v) mxv: (max v) by: sg from: TF where: (< u 1200) asc: sg}))
(count RPd2) -- (count RFd2)
(at RPd2 'sg)  -- (at RFd2 'sg)
(at RPd2 'sv)  -- (at RFd2 'sv)
(at RPd2 'cv)  -- (at RFd2 'cv)
(at RPd2 'mxv) -- (at RFd2 'mxv)

;;     (d3) grouped on the partition key alone, P1 the empty reference
;;          partition: its sub-group has no key and answers one row of
;;          empty-input aggregates, which must not surface as a group of P1.
(set Bd3 (at (.sys.mem) 'group-perpart-runs))
(set RPd3 (select {cv: (count v) by: part from: Pw where: (> u 700)}))
(> (at (.sys.mem) 'group-perpart-runs) Bd3) -- true
(at RPd3 'part) -- [2 3 4]
(at RPd3 'cv)   -- [99 400 400]
(set RPd4 (select {cv: (count v) by: part from: Pw where: (and (== part 3) (> v 100))}))
(at RPd4 'part) -- [3]
(at RPd4 'cv)   -- [299]
(set RPd5 (select {cv: (count v) sv: (sum v) by: part from: Pw where: (== part 3)}))
(at RPd5 'part) -- [3]
(at RPd5 'cv)   -- [400]
(set RPd6 (select {cv: (count v) by: {p: part} from: Pw where: (in part [2 4])}))
(at RPd6 'p)  -- [2 4]
(at RPd6 'cv) -- [400 400]
(count (select {cv: (count v) by: part from: Pw where: (> u 5000)})) -- 0

;; ══════════════════════════════════════════════════════════════════════════
;; (e) NO KEY AT ALL — a whole-table aggregate answers one row whatever the
;;     where: keeps (the aggregates of no rows), as over a flat table.  The
;;     row comes from the reference partition; when that partition held no
;;     rows its sub-group answered none, every later zero-survivor partition
;;     was skipped, and the select came back with 0 rows.  The avg of no rows
;;     is null (the merge divided by a zero count to 0.0).
;; ══════════════════════════════════════════════════════════════════════════
(set Re1 (select {c: (count v) s: (sum u) a: (avg v) mn: (min u) from: Pw where: (> u 5000)}))
(set Fe1 (select {c: (count v) s: (sum u) a: (avg v) mn: (min u) from: TF where: (> u 5000)}))
(count Re1) -- 1
(at Re1 'c)  -- (at Fe1 'c)
(at Re1 's)  -- (at Fe1 's)
(at Re1 'a)  -- [0Nf]
(at Re1 'a)  -- (at Fe1 'a)
(at Re1 'mn) -- (at Fe1 'mn)

;; empty partitions first and last, rows only in the middle one
(.sys.exec "rm -rf /tmp/rfl_pgwh_e")
(.db.splayed.set "/tmp/rfl_pgwh_e/2024.01.01/t/" (table [a b] (list (take [1] 0) (take [1] 0))))
(.db.splayed.set "/tmp/rfl_pgwh_e/2024.01.02/t/" (table [a b] (list [4 5] [40 50])))
(.db.splayed.set "/tmp/rfl_pgwh_e/2024.01.03/t/" (table [a b] (list (take [1] 0) (take [1] 0))))
(set Pe (.db.parted.get "/tmp/rfl_pgwh_e/" 't))
(set Fe (table [a b] (list [4 5] [40 50])))
(set Be2 (at (.sys.mem) 'group-perpart-runs))
(set Re2 (select {c: (count a) s: (sum b) from: Pe where: (> a 40)}))
(> (at (.sys.mem) 'group-perpart-runs) Be2) -- true
(count Re2) -- 1
(at Re2 'c) -- [0]
(at Re2 's) -- [0]
(at Re2 'c) -- (at (select {c: (count a) s: (sum b) from: Fe where: (> a 40)}) 'c)
(at (select {c: (count a) from: Pe where: (> a 40)}) 'c) -- [0]
(at (select {mx: (max b) a: (avg b) from: Pe where: (> a 40)}) 'mx) -- [0Nl]
(at (select {mx: (max b) a: (avg b) from: Pe where: (> a 40)}) 'a) -- [0Nf]
(at (select {c: (count a) s: (sum b) from: Pe where: (> a 4)}) 's) -- [50]
(at (select {c: (count a) s: (sum b) from: Pe}) 'c) -- [2]
;; keyed, the same where: keeps no group
(count (select {c: (count a) by: date from: Pe where: (> a 40)})) -- 0
(.sys.exec "rm -rf /tmp/rfl_pgwh_e")

;; ══════════════════════════════════════════════════════════════════════════
;; (f) ORDERED TAKE ON AN AGGREGATE (#729) — `asc:/desc: c take: N` and the
;;     `having` shape arm a top-N / threshold emit filter for the select's
;;     group.  It describes the MERGED groups: applied to each partition's
;;     partial it kept only that partition's top N, and the merge summed the
;;     survivors.  Uneven partitions with a small first one (keys 0..10) clear
;;     the cardinality gate, so every shape below streams per partition.
;; ══════════════════════════════════════════════════════════════════════════
(set mkp (fn [n m o] (table [k v] (list (% (* (+ o (til n)) 7919) m) (+ o (til n))))))
(set Q1 (mkp 40 11 0))
(set Q2 (mkp 6000 31 5))
(set Q3 (mkp 900 17 11))
(set Q4 (mkp 8000 29 3))
(.sys.exec "rm -rf /tmp/rfl_pgtk")
(.db.splayed.set "/tmp/rfl_pgtk/2024.01.01/t/" Q1)
(.db.splayed.set "/tmp/rfl_pgtk/2024.01.02/t/" Q2)
(.db.splayed.set "/tmp/rfl_pgtk/2024.01.03/t/" Q3)
(.db.splayed.set "/tmp/rfl_pgtk/2024.01.04/t/" Q4)
(set Pt (.db.parted.get "/tmp/rfl_pgtk/" 't))
(set TK (table [date k v] (list (concat (concat (take 2024.01.01 40) (take 2024.01.02 6000)) (concat (take 2024.01.03 900) (take 2024.01.04 8000))) (concat (concat (at Q1 'k) (at Q2 'k)) (concat (at Q3 'k) (at Q4 'k))) (concat (concat (at Q1 'v) (at Q2 'v)) (concat (at Q3 'v) (at Q4 'v))))))

(set Be (at (.sys.mem) 'group-perpart-runs))
(set RPe1 (select {c: (count v) by: k from: Pt asc: c take: 2}))
(set RPe2 (select {c: (sum v) by: k from: Pt desc: c take: 3}))
(set RPe3 (select {c: (min v) by: k from: Pt desc: c take: 3}))
(set RPe4 (select {c: (max v) by: k from: Pt asc: c take: 3}))
(set RPe5 (select {c: (count v) by: k from: Pt where: (>= date 2024.01.02) asc: c take: 2}))
(set RPe6 (select {c: (sum v) by: {kk: k} from: Pt where: (> v 100) desc: c take: 3}))
(set RPe7 (select {n: (count v) c: (sum v) by: k from: Pt desc: c take: 3}))
(set Ae (at (.sys.mem) 'group-perpart-runs))
;; PROVES all seven ran through exec_group_per_partition.
(- Ae Be) -- 7
(set RFe1 (select {c: (count v) by: k from: TK asc: c take: 2}))
(set RFe2 (select {c: (sum v) by: k from: TK desc: c take: 3}))
(set RFe3 (select {c: (min v) by: k from: TK desc: c take: 3}))
(set RFe4 (select {c: (max v) by: k from: TK asc: c take: 3}))
(set RFe5 (select {c: (count v) by: k from: TK where: (>= date 2024.01.02) asc: c take: 2}))
(set RFe6 (select {c: (sum v) by: {kk: k} from: TK where: (> v 100) desc: c take: 3}))
(set RFe7 (select {n: (count v) c: (sum v) by: k from: TK desc: c take: 3}))
(at RPe1 'k) -- (at RFe1 'k)
(at RPe1 'c) -- (at RFe1 'c)
(at RPe1 'c) -- [193 194]
(at RPe2 'k) -- (at RFe2 'k)
(at RPe2 'c) -- (at RFe2 'c)
(at RPe3 'k) -- (at RFe3 'k)
(at RPe3 'c) -- (at RFe3 'c)
(at RPe4 'k) -- (at RFe4 'k)
(at RPe4 'c) -- (at RFe4 'c)
(at RPe5 'k) -- (at RFe5 'k)
(at RPe5 'c) -- (at RFe5 'c)
(at RPe6 'kk) -- (at RFe6 'kk)
(at RPe6 'c) -- (at RFe6 'c)
(at RPe7 'k) -- (at RFe7 'k)
(at RPe7 'n) -- (at RFe7 'n)
(at RPe7 'c) -- (at RFe7 'c)

;; `having` over a per-partition group: the count threshold also applies to
;; the merged counts, not to each partition's partial counts.
(set RPe8 (select {from: (select {c: (count v) by: k from: Pt}) where: (> c 520)}))
(set RFe8 (select {from: (select {c: (count v) by: k from: TK}) where: (> c 520)}))
(count RPe8) -- 17
(count RPe8) -- (count RFe8)
(asc (at RPe8 'k)) -- (asc (at RFe8 'k))
(asc (at RPe8 'c)) -- (asc (at RFe8 'c))
(.sys.exec "rm -rf /tmp/rfl_pgtk")

;; Each key leads one partition and trails another, so a partition's own top
;; 2 is not the merged top 2: a top-N applied per partition kept dd and a
;; from partitions 1 and 2 only (dd 250250, a 250250 for desc:), and a 124500
;; and dd 124750 for asc:.
(.sys.exec "rm -rf /tmp/rfl_pgtq")
(.db.splayed.set "/tmp/rfl_pgtq/01/t/" (table [q v] (list (at ['a 'b 'c 'dd] (% (til 1000) 4)) (til 1000))))
(.db.splayed.set "/tmp/rfl_pgtq/02/t/" (table [q v] (list (at ['a 'b 'c 'dd] (% (+ 1 (til 1000)) 4)) (til 1000))))
(.db.splayed.set "/tmp/rfl_pgtq/03/t/" (table [q v] (list (at ['a 'b 'c 'dd] (% (+ 2 (til 1000)) 4)) (til 1000))))
(set Pq (.db.parted.get "/tmp/rfl_pgtq/" 't))
(set Bq (at (.sys.mem) 'group-perpart-runs))
(set RPq1 (select {from: Pq by: q s: (sum v) desc: s take: 2}))
(set RPq2 (select {from: Pq by: q s: (sum v) asc: s take: 2}))
(- (at (.sys.mem) 'group-perpart-runs) Bq) -- 2
(at RPq1 'q) -- ['dd 'a]
(at RPq1 's) -- [375000 374750]
(at RPq2 'q) -- ['c 'b]
(at RPq2 's) -- [374250 374500]
(.sys.exec "rm -rf /tmp/rfl_pgtq")

;; ══════════════════════════════════════════════════════════════════════════
;; (g) STR KEYS AND STR PARTIALS (#737) — a selective where caps est_groups by
;;     the survivors, so a STR key (plain or computed) streams too.  The merge
;;     concatenated the partials' STR cells raw, leaving the merged key column
;;     with no string pool: the merge group read the long strings through a
;;     NULL pointer.  10 partitions span two merge batches (the running
;;     result is merged again); strings are empty, inline and pooled.
;; ══════════════════════════════════════════════════════════════════════════
(set NS 2000)
(set RS (take ["short" "a_rather_long_reason_text_value" "" "x" "another_long_reason_string_here" "mid_size_str" "yy"] NS))
(set ES (% (til NS) 3))
(set SS (take ["https_example_com_some_long_page_1" "https_example_com_other_long_page_2" "q"] NS))
(set VS (til NS))
(set PS (table [r e s v] (list RS ES SS VS)))
(.sys.exec "rm -rf /tmp/rfl_pgwh_str")
(.db.splayed.set "/tmp/rfl_pgwh_str/01/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/02/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/03/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/04/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/05/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/06/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/07/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/08/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/09/t/" PS)
(.db.splayed.set "/tmp/rfl_pgwh_str/10/t/" PS)
(set Ps (.db.parted.get "/tmp/rfl_pgwh_str/" 't))
(set TFs (table [r e s v] (list (raze (take (list RS) 10)) (raze (take (list ES) 10)) (raze (take (list SS) 10)) (raze (take (list VS) 10)))))
(count TFs) -- 20000

;; (g1) bare STR key — the reported shape (count, desc, take)
(set Be1 (at (.sys.mem) 'group-perpart-runs))
(set RPe1 (select {from: Ps where: (== (% v 200) 7) by: r n: (count r) desc: n take: 12}))
(> (at (.sys.mem) 'group-perpart-runs) Be1) -- true
(set RPe1 (select {from: Ps where: (== (% v 200) 7) by: r n: (count r) asc: r}))
(set RFe1 (select {from: TFs where: (== (% v 200) 7) by: r n: (count r) asc: r}))
(at RPe1 'r) -- ["" "a_rather_long_reason_text_value" "another_long_reason_string_here" "mid_size_str" "short" "x" "yy"]
(at RPe1 'r) -- (at RFe1 'r)
(at RPe1 'n) -- (at RFe1 'n)

;; (g2) computed STR key beside an int key, STR min/max/first partials
(set Be2 (at (.sys.mem) 'group-perpart-runs))
(set RPe2 (select {from: Ps where: (== (% v 200) 7) by: {e: e k: (if (== e 0) s "")} n: (count v) mn: (min r) mx: (max r) fr: (first r) asc: e}))
(> (at (.sys.mem) 'group-perpart-runs) Be2) -- true
(set RFe2 (select {from: TFs where: (== (% v 200) 7) by: {e: e k: (if (== e 0) s "")} n: (count v) mn: (min r) mx: (max r) fr: (first r) asc: e}))
(at RPe2 'k)  -- ["https_example_com_some_long_page_1" "" ""]
(at RPe2 'k)  -- (at RFe2 'k)
(at RPe2 'n)  -- (at RFe2 'n)
(at RPe2 'mn) -- (at RFe2 'mn)
(at RPe2 'mx) -- (at RFe2 'mx)
(at RPe2 'fr) -- (at RFe2 'fr)
;; (g3) no where: a computed STR key with few values streams on its own
(set Be3 (at (.sys.mem) 'group-perpart-runs))
(set RPe3 (select {from: Ps by: {k: (if (== e 0) s "")} n: (count v) asc: k}))
(> (at (.sys.mem) 'group-perpart-runs) Be3) -- true
(at RPe3 'k) -- ["" "https_example_com_some_long_page_1"]
(at RPe3 'n) -- [13330 6670]

;; (g4) LIST partials: first/last over a LIST column are concatenated by
;;      reference (a raw copy aliased the partials' elements); 10 partitions
;;      span two merge batches here as well.
(set LS (take (list [1 2] [3] [4 5 6] [7]) NS))
(set PL (table [e v l] (list ES VS LS)))
(.sys.exec "rm -rf /tmp/rfl_pgwh_lst")
(.db.splayed.set "/tmp/rfl_pgwh_lst/01/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/02/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/03/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/04/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/05/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/06/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/07/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/08/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/09/t/" PL)
(.db.splayed.set "/tmp/rfl_pgwh_lst/10/t/" PL)
(set Pl (.db.parted.get "/tmp/rfl_pgwh_lst/" 't))
(set TFl (table [e v l] (list (raze (take (list ES) 10)) (raze (take (list VS) 10)) (raze (take (list LS) 10)))))
(set Be4 (at (.sys.mem) 'group-perpart-runs))
(set RPe4 (select {from: Pl where: (== (% v 50) 7) by: e n: (count v) fl: (first l) ll: (last l) asc: e}))
(> (at (.sys.mem) 'group-perpart-runs) Be4) -- true
(set RFe4 (select {from: TFl where: (== (% v 50) 7) by: e n: (count v) fl: (first l) ll: (last l) asc: e}))
(at RPe4 'e)  -- [0 1 2]
(at RPe4 'n)  -- (at RFe4 'n)
(at RPe4 'fl) -- (at RFe4 'fl)
(at RPe4 'll) -- (at RFe4 'll)

;; ══════════════════════════════════════════════════════════════════════════
;; (h) COMPOSITE KEY WITH A ROW OUTPUT (#731) — `b: b by: [s bo]` groups at
;;     eval level on boxed key cells; a cell is a SYM atom holding the RUNTIME
;;     id, and the key column was built at the source column's width, which
;;     sizes FILE-domain ids: the runtime ids were truncated into unrelated
;;     symbols.  Without a where the parted columns reached the row reader
;;     unflattened (`type` error).
;; ══════════════════════════════════════════════════════════════════════════
(.sys.exec "rm -rf /tmp/rfl_pgwh_cmp")
(.db.splayed.set "/tmp/rfl_pgwh_cmp/2024.01.01/t/" (table [s bo b] (list ['alpha 'beta 'alpha] [true false true] [91 92 93])))
(.db.splayed.set "/tmp/rfl_pgwh_cmp/2024.01.02/t/" (table [s bo b] (list ['gamma 'beta] [false true] [94 95])))
(set Pc (.db.parted.get "/tmp/rfl_pgwh_cmp/" 't))
(set RPf1 (select {b: b by: [s bo] from: Pc where: (> b 90)}))
(at RPf1 's)  -- ['alpha 'beta 'gamma 'beta]
(at RPf1 'bo) -- [true false false true]
(at RPf1 'b)  -- (list [91 93] [92] [94] [95])
(set RPf2 (select {b: b c: (+ b 1) by: [s bo] from: Pc}))
(at RPf2 's)  -- ['alpha 'beta 'gamma 'beta]
(at RPf2 'b)  -- (list [91 93] [92] [94] [95])
(at RPf2 'c)  -- (list [92 94] [93] [95] [96])
;; no outputs: the first row of each group, every column of it
(set RPf3 (select {by: [s bo] from: Pc}))
(at RPf3 's) -- ['alpha 'beta 'gamma 'beta]
(at RPf3 'b) -- [91 92 94 95]
(set RPf4 (select {by: [s bo] from: Pc where: (> b 0)}))
(at RPf4 's) -- ['alpha 'beta 'gamma 'beta]
(at RPf4 'b) -- [91 92 94 95]
;; a splayed (FILE-domain, non-parted) source took the same path
(.db.splayed.set "/tmp/rfl_pgwh_cmp/flat/" (table [s bo b] (list ['alpha 'beta 'alpha 'gamma 'beta] [true false true false true] [91 92 93 94 95])))
(set Sc (.db.splayed.get "/tmp/rfl_pgwh_cmp/flat/"))
(set RSc (select {b: b by: [s bo] from: Sc where: (> b 90)}))
(at RSc 's)  -- ['alpha 'beta 'gamma 'beta]
(at RSc 'bo) -- [true false false true]
(at RSc 'b)  -- (list [91 93] [92] [94] [95])
(at (select {b: b by: [s bo] from: Sc}) 's) -- ['alpha 'beta 'gamma 'beta]
;; a source wide enough for a two-byte index (300 symbols)
(set S16 (table [s bo b] (list (as 'SYM (% (til 600) 300)) (== (% (til 600) 2) 0) (til 600))))
(.db.splayed.set "/tmp/rfl_pgwh_cmp/w16/" S16)
(set Sw (.db.splayed.get "/tmp/rfl_pgwh_cmp/w16/"))
(set RPw (select {b: b by: [s bo] from: Sw}))
(set RFw (select {b: b by: [s bo] from: S16}))
(count RPw) -- 300
(at RPw 's) -- (at RFw 's)
(at RPw 'b) -- (at RFw 'b)

;; ─── cleanup ─────────────────────────────────────────────────────────────────
(.sys.exec "rm -rf /tmp/rfl_pgwh")
(.sys.exec "rm -rf /tmp/rfl_pgwh_str /tmp/rfl_pgwh_lst /tmp/rfl_pgwh_cmp")
