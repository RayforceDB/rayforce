(set Q (.db.parted.get "/tmp/rfl_parted_i64_sum_partial/carry70002/" 'hits))
(set F (concat (concat (concat (concat (concat (concat (concat (concat Z Z) N) Z) Z) Z) Z) W) O))
(set before (at (.sys.mem) 'group-perpart-runs))
(set gp (G Q))
(== (- (at (.sys.mem) 'group-perpart-runs) before) 1) -- true
(== (at gp 0) (at (G F) 0)) -- true
(== (at gp 0) (at (S Q) 0)) -- true
(== (at gp 0) (at (S F) 0)) -- true
(== (at gp 0) -9223372036854705805) -- true
