;; Nine partitions cross the eight-partition merge boundary.
;; An even number of 2^62 inputs can produce a non-null INT64_MIN partial.
(.sys.exec "rm -rf /tmp/rfl_parted_i64_sum_partial")
(set mk (fn [n v] (table [k x z] (list (* 0 (til n)) (+ v (* 0 (til n))) (+ 2 (* 0 (til n)))))))
(set G (fn [t] (at (select {s: (sum x) from: t by: k}) 's)))
(set S (fn [t] (at (select {s: (sum x) from: t}) 's)))
(set W (mk 70002 4611686018427387904))
(set O (mk 70003 1))
(set Z (mk 70000 0))
(set N (table [k x z] (list [0 0] [0N 0N] [2 2])))
