;; A group key computed from ONE symbol column (substr / str-find / if over
;; it) must give the same groups and aggregates whether the engine evaluates
;; the expression per row or once per distinct symbol.  Oracle: the key
;; materialised as a column first, then a plain group-by on that column.
;; Sizes past 4096 rows with few distinct symbols so the per-symbol path is
;; taken; a high-cardinality control and a null-bearing column exercise the
;; fallback.
(set N 20000)
(set i (til N))
(set hosts (map (fn [k] (format "h%.example.com" k)) (til 37)))
(set mk (fn [k] ((fn [j] (if (== 0 (% j 11)) "" (if (== 0 (% j 7)) (format "https://www.%/p/%" (at hosts (% (* 31 j) 37)) (% j 13)) (if (== 0 (% j 5)) (at hosts (% (* 31 j) 37)) (format "http://%/a/%" (at hosts (% (* 31 j) 37)) (% j 17)))))) (% k 500))))
(set ref (as 'SYMBOL (map mk i)))
(set v (as 'F64 (% (* i 7) 101)))
(set T (table [ref v] (list ref v)))

;; the derived key, as the engine sees it inside by:
(set KEYQ (fn [t] (select {from: t by: (let p (str-find ref "://") (let s (substr ref (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) c: (count ref) sv: (sum v) mn: (min ref) where: (!= ref "")})))
;; oracle: the same expression as a projected column, then group by it
(set KEYCOL (fn [t] (select {from: t p: (let p (str-find ref "://") (let s (substr ref (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) ref: ref v: v where: (!= ref "")})))
(set ORA (fn [t] (select {from: (KEYCOL t) by: p c: (count ref) sv: (sum v) mn: (min ref)})))
(set FP (fn [r] (ser (xasc (xasc (table [k c sv mn] (list (at (value r) 0) (at r 'c) (at r 'sv) (at r 'mn))) 'mn) 'c))))
(set FP2 (fn [r] (ser (xasc (xasc (table [k c] (list (at (value r) 0) (at r 'c))) 'k) 'c))))

(set R (KEYQ T))
(set O (ORA T))
(count R) -- 37
(count O) -- 37
(all (== (FP R) (FP O))) -- true
;; every host appears (the "" rows are filtered, the bare-host rows keep it)
(count (distinct (at (value R) 0))) -- 37

;; a key that stays a symbol of the column (identity-like) still matches
(set R2 (select {from: T by: (if (== (str-find ref "www.") 0) (substr ref 4 -1) ref) c: (count ref)}))
(set O2 (select {from: (select {from: T k: (if (== (str-find ref "www.") 0) (substr ref 4 -1) ref) ref: ref}) by: k c: (count ref)}))
(all (== (FP2 R2) (FP2 O2))) -- true

;; high cardinality: every row its own symbol — the fallback path, same answer
(set refu (as 'SYMBOL (map (fn [k] (format "http://%/u/%" (at hosts (% k 37)) k)) i)))
(set TU (table [ref v] (list refu v)))
(count (KEYQ TU)) -- 37
(all (== (FP (KEYQ TU)) (FP (ORA TU)))) -- true

;; nulls in the symbol column: rows with a null key group together, others unchanged
(set refn (as 'SYMBOL (map (fn [k] (if (== 0 (% k 97)) null (mk k))) i)))
(set TN (table [ref v] (list refn v)))
(set RN (KEYQ TN))
(set ON (ORA TN))
(== (count RN) (count ON)) -- true
(all (== (FP RN) (FP ON))) -- true

;; a second column referenced in the key expression must not take the shortcut
(set R3 (select {from: T by: (if (> v 50) (substr ref 0 4) ref) c: (count ref)}))
(set O3 (select {from: (select {from: T k: (if (> v 50) (substr ref 0 4) ref) ref: ref}) by: k c: (count ref)}))
(all (== (FP2 R3) (FP2 O3))) -- true

;; the key column is named by the same rule whether or not the per-symbol
;; path ran: below 4096 rows the row-wise path names it identically
(== (at (cols R) 0) 'p) -- true
(== (at (cols (KEYQ (take T 3000))) 0) 'p) -- true
(== (at (cols (select {from: T by: (substr ref 0 3) c: (count v)})) 0) 'ref) -- true
(== (at (cols (select {from: (take T 3000) by: (substr ref 0 3) c: (count v)})) 0) 'ref) -- true

;; positional operators are NOT functions of the symbol alone: they must be
;; evaluated over the rows, never over the distinct symbols
(set RD (select {from: T by: (differ ref) c: (count v)}))
(set OD (select {from: (select {from: T k: (differ ref) v: v}) by: k c: (count v)}))
(all (== (FP2 RD) (FP2 OD))) -- true
(set RF (select {from: TN by: (fills ref) c: (count v)}))
(set OF (select {from: (select {from: TN k: (fills ref) v: v}) by: k c: (count v)}))
(all (== (FP2 RF) (FP2 OF))) -- true

;; a free name that is a table-length global vector, not a column
(set G (as 'I64 (% (* i 13) 7)))
(set RG (select {from: T by: (if (> G 3) (substr ref 0 4) ref) c: (count v)}))
(set OG (select {from: (select {from: T k: (if (> G 3) (substr ref 0 4) ref) v: v}) by: k c: (count v)}))
(all (== (FP2 RG) (FP2 OG))) -- true

;; the derived name yields to an aggregate of the same name
(== (cols (select {from: T by: (substr ref 0 2) ref: (min ref) c: (count v)})) ['key 'ref 'c]) -- [true true true]
;; a quoted symbol that names a column of the table resolves to that column
;; in the compiled key — such a key is not a function of the symbol alone
(set RQ (select {from: T by: (if (== 'v ref) "same" "diff") c: (count v)}))
(set OQ (select {from: (select {from: T k: (if (== 'v ref) "same" "diff") v: v}) by: k c: (count v)}))
(count RQ) -- 1
(== (at (value RQ) 0) (at (value OQ) 0)) -- [true]
(== (at RQ 'c) (at OQ 'c)) -- [true]

;; ── the column's ids in a FILE domain (a splayed table read back) ──────
;; The per-symbol evaluation then runs over the vocabulary's bytes, a
;; chunk of distinct values at a time, and interns only the final key.
;; Same groups and aggregates as the in-memory table.  (Several chunks
;; over a small vocabulary: lang/select/derived_key_file_chunks in
;; test/test_lang.c, through the DEBUG-only chunk-length seam.)
(.sys.exec "rm -rf /tmp/rfl_dkey_file/") -- 0
(.db.splayed.set "/tmp/rfl_dkey_file/" T)
(set F (.db.splayed.get "/tmp/rfl_dkey_file/"))
(count F) -- 20000
(== (type (at F 'ref)) 'SYM) -- true
(set RF (KEYQ F))
(count RF) -- 37
(all (== (FP RF) (FP O))) -- true
(== (at (cols RF) 0) 'p) -- true
(all (== (FP2 (select {from: F by: (if (== (str-find ref "www.") 0) (substr ref 4 -1) ref) c: (count ref)})) (FP2 O2))) -- true
;; a key whose result is not a symbol keeps the one-shot evaluation
(set RL (select {from: F by: (strlen ref) c: (count ref)}))
(set OL (select {from: T by: (strlen ref) c: (count ref)}))
(all (== (FP2 RL) (FP2 OL))) -- true
;; nulls in the file-backed column
(.sys.exec "rm -rf /tmp/rfl_dkey_filen/") -- 0
(.db.splayed.set "/tmp/rfl_dkey_filen/" TN)
(set FN (.db.splayed.get "/tmp/rfl_dkey_filen/"))
(all (== (FP (KEYQ FN)) (FP ON))) -- true
(.sys.exec "rm -rf /tmp/rfl_dkey_file/ /tmp/rfl_dkey_filen/") -- 0

;; ── the key as a per-value program ─────────────────────────────────────
;; Over a FILE-domain column a key made of let / if / cond / and / or / not
;; / comparisons / + - * / str-find / substr / strlen / within / nil? runs
;; as a straight-line program once per distinct value, on the workers;
;; any other operator keeps the chunk DAG.  Reference for every key: the
;; same expression computed row by row with `map` over the column's
;; strings, then a plain grouping by that column.  70000 rows so both the
;; vocabulary rewrite (aggregates over the key column only) and the
;; per-row spread (an aggregate over another column) run.
(set U ["http://www.abc.com/x" "" "abc" "android-app://q/z" "http://www./" "https://www.x" "http:/a/b" "http://a" "://x/y" "ftp://h/x" "https://www.h.org/a/b" "http://h.org/" "www.x/y" "http" "https:///z" "HTTP://UP.ORG/a" "http://h.org/www./x" "https://ww.h.org/q" "http://www.www.h/" "http://s?te.org/o#o"])
(set mkv (fn [j] (if (< j (count U)) (at U j) (if (== 0 (% j 7)) (format "http://www.site%.org/p/%" (% j 41) j) (if (== 1 (% j 7)) (format "https://site%.org/q?x=%" (% j 41) j) (if (== 2 (% j 7)) (format "http://site%.org" (% j 41)) (if (== 3 (% j 7)) (format "android-app://com.app%/x" (% j 13)) (if (== 4 (% j 7)) (format "https://www.site%.org/" (% j 41)) (if (== 5 (% j 7)) (format "site%.org/path" (% j 41)) (format "http://Site%.org/a/b#%" (% j 41) j))))))))))
(set NP 70000)
(set ip (til NP))
(set refp (as 'SYMBOL (map (fn [k] (if (== 0 (% k 97)) null (mkv (% (* k 7919) 640)))) ip)))
(set vp (% (* ip 31) 1000))
(set TP (table [ref v] (list refp vp)))
(.sys.exec "rm -rf /tmp/rfl_dkey_prog/") -- 0
(.db.splayed.set "/tmp/rfl_dkey_prog/" TP)
(set FT (.db.splayed.get "/tmp/rfl_dkey_prog/"))
(count (distinct (at FT 'ref))) -- 423
(set SP (as 'STR (at TP 'ref)))
;; a key of the value alone, per row through the distinct values (the Q29
;; key and the two-column key below are mapped over every row)
(set DSP (distinct SP))
(set ISP (find DSP SP))
(set rowk (fn [f] (at (map f DSP) ISP)))
;; reference grouping over a materialised key column; fingerprint by key text
(set refg (fn [K] (select {from: (table [k ref v] (list (as 'SYMBOL K) refp vp)) by: k c: (count ref) sv: (sum v)})))
(set fpk (fn [r] (ser (xasc (table [k c] (list (as 'STR (at (value r) 0)) (at r 'c))) 'k))))
(set fpks (fn [r] (ser (xasc (table [k c sv] (list (as 'STR (at (value r) 0)) (at r 'c) (at r 'sv))) 'k))))

;; the URL-host key: http / https / www / no slash / empty / non-http / nulls
(set kq29 (fn [x] (do (let p (str-find x "://")) (let s (substr x (+ p 4) -1)) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s)) (let sl (str-find r "/")) (if (and (and (>= p 4) (<= p 5)) (== (substr x 1 4) "http") (not (nil? sl))) (substr r 1 sl) x))))
(set K29 (map kq29 SP))
(set O29 (refg K29))
(set R29 (select {from: FT by: (let p (str-find ref "://") (let s (substr ref (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) c: (count ref) l: (avg (strlen ref)) mn: (min ref) where: (!= ref "")}))
(set O29w (select {from: (table [k ref] (list (as 'SYMBOL K29) refp)) by: k c: (count ref) l: (avg (strlen ref)) mn: (min ref) where: (!= ref "")}))
(== (count R29) (count O29w)) -- true
(all (== (fpk R29) (fpk O29w))) -- true
(set FPL (fn [r] (ser (xasc (table [k l mn] (list (as 'STR (at (value r) 0)) (at r 'l) (as 'STR (at r 'mn)))) 'k))))
(all (== (FPL R29) (FPL O29w))) -- true
(at (cols R29) 0) -- 'p
;; the same key with an aggregate over another column: per-row spread
(set R29s (select {from: FT by: (let p (str-find ref "://") (let s (substr ref (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) c: (count ref) sv: (sum v)}))
(== (count R29s) (count O29)) -- true
(all (== (fpks R29s) (fpks O29))) -- true
;; an operator outside the program (abs) leaves the key to the chunk DAG: same groups
(set R29d (select {from: FT by: (let p (str-find ref "://") (let s (substr ref (+ p (abs 4)) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) c: (count ref) sv: (sum v)}))
(all (== (fpks R29d) (fpks O29))) -- true

;; cond, string literals in the arms, offsets past the end
(set R2 (select {from: FT by: (cond ((== (substr ref 1 5) "https") "secure") ((== (substr ref 1 4) "http") (substr ref 8 4)) (else (substr ref 1 3))) c: (count ref) sv: (sum v)}))
(set O2 (refg (rowk (fn [x] (if (== (substr x 1 5) "https") "secure" (if (== (substr x 1 4) "http") (substr x 8 4) (substr x 1 3)))))))
(all (== (fpks R2) (fpks O2))) -- true
;; null arithmetic: strlen of the empty value is null, so is the length below
(set R3 (select {from: FT by: (if (or (nil? (str-find ref "/")) (> (strlen ref) 24)) (substr ref 1 (- (strlen ref) 2)) ref) c: (count ref)}))
(set O3 (refg (rowk (fn [x] (if (or (nil? (str-find x "/")) (> (strlen x) 24)) (substr x 1 (- (strlen x) 2)) x)))))
(all (== (fpk R3) (fpk O3))) -- true
;; comparisons of nullable offsets, a product as the start
(set R4 (select {from: FT by: (if (!= (str-find ref "?") (str-find ref "#")) (substr ref (* 2 (str-find ref "o")) 3) "none") c: (count ref)}))
(set O4 (refg (rowk (fn [x] (if (!= (str-find x "?") (str-find x "#")) (substr x (* 2 (str-find x "o")) 3) "none")))))
(all (== (fpk R4) (fpk O4))) -- true
;; a search pattern with a wildcard
(set R5 (select {from: FT by: (substr ref (+ 1 (str-find ref "s?te")) 6) c: (count ref)}))
(set O5 (refg (rowk (fn [x] (substr x (+ 1 (str-find x "s?te")) 6)))))
(all (== (fpk R5) (fpk O5))) -- true
;; the key is an earlier binding, not the last operator
(set R6 (select {from: FT by: (let a (substr ref 1 3) (let b (str-find ref "x") a)) c: (count ref)}))
(all (== (fpk R6) (fpk (refg (rowk (fn [x] (substr x 1 3))))))) -- true
;; n-ary and, not, nil? over the value itself
(set R7 (select {from: FT by: (if (and (not (nil? ref)) (<= (strlen ref) 12) (>= (strlen ref) 3)) "short" (substr ref (- (strlen ref) 3) 4)) c: (count ref)}))
(set O7 (refg (rowk (fn [x] (if (and (not (nil? x)) (<= (strlen x) 12) (>= (strlen x) 3)) "short" (substr x (- (strlen x) 3) 4))))))
(all (== (fpk R7) (fpk O7))) -- true
;; another column in the key: never per value
(set R8 (select {from: FT by: (if (> v 500) (substr ref 1 4) ref) c: (count ref)}))
(set O8 (refg (map (fn [k] (if (> (at vp k) 500) (substr (at SP k) 1 4) (at SP k))) ip)))
(all (== (fpk R8) (fpk O8))) -- true
;; an operator outside the program (upper): the chunk DAG, same groups
(set R9 (select {from: FT by: (upper (substr ref 1 4)) c: (count ref)}))
(set O9 (refg (rowk (fn [x] (upper (substr x 1 4))))))
(all (== (fpk R9) (fpk O9))) -- true
;; a vocabulary past the parallel threshold (73k distinct values): the
;; program, the partitioned dedupe and the position ordering run on the
;; workers; the chunk DAG's interning (abs again) too
(set NB 80000)
(set mkb (fn [k] (if (== 0 (% k 13)) "" (if (== 0 (% k 11)) (format "android-app://app%/x%" (% k 7) k) (if (== 0 (% k 5)) (format "https://www.h%.org/p/%" (% k 97) k) (if (== 0 (% k 3)) (format "http://h%.org" k) (format "http://h%.org/q/%" (% k 97) k)))))))
(set refb (as 'SYMBOL (map mkb (til NB))))
(.sys.exec "rm -rf /tmp/rfl_dkey_progb/") -- 0
(.db.splayed.set "/tmp/rfl_dkey_progb/" (table [ref] (list refb)))
(set FB (.db.splayed.get "/tmp/rfl_dkey_progb/"))
(> (count (distinct (at FB 'ref))) 65536) -- true
(set KB (as 'SYMBOL (map kq29 (as 'STR refb))))
(set OB (select {from: (table [k ref] (list KB refb)) by: k c: (count ref) l: (avg (strlen ref)) mn: (min ref) where: (!= ref "")}))
(set RB (select {from: FB by: (let p (str-find ref "://") (let s (substr ref (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) c: (count ref) l: (avg (strlen ref)) mn: (min ref) where: (!= ref "")}))
(== (count RB) (count OB)) -- true
(all (== (FPL RB) (FPL OB))) -- true
(all (== (fpk RB) (fpk OB))) -- true
(set RBd (select {from: FB by: (let p (str-find ref "://") (let s (substr ref (+ p (abs 4)) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) c: (count ref) l: (avg (strlen ref)) mn: (min ref) where: (!= ref "")}))
(all (== (fpk RBd) (fpk OB))) -- true
;; unsorted, both evaluations give the groups in the same order
(all (== (as 'STR (at RB 'p)) (as 'STR (at RBd 'p)))) -- true
(.sys.exec "rm -rf /tmp/rfl_dkey_progb/") -- 0
(.sys.exec "rm -rf /tmp/rfl_dkey_prog/") -- 0
