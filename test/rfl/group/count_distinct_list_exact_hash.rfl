;; Restart each affected group from row zero; keep hash mode local to the group.
(set a 9007199254740993)
(set b 9007199254740992)
(set f 9007199254740992.0)
(set ts (as 'TIMESPAN [1 2]))
(set i64 [1 2])
(set i32 [1i 2i])
(set p (map (fn [i] (list i)) (% (til 1600) 16)))
(set cases (list (list (list a) (list f) (list b)) (list (list f) (list a) (list b)) (list ts i64 i32) (list i64 ts i32) (list (list 1 ts) (list 1 i64) (list 1 i32)) (list (list 1 i64) (list 1 ts) (list 1 i32)) (list (list a) (list b) (list a)) (list (list a) (list b) (list f) ts i64 i32)))
(set cs (map (fn [x] (concat p x)) cases))
(set e [18 17 17 18 17 18 18 19])
(set gs (fold concat (map (fn [i] (+ i (* 0 (til (count (at cs i)))))) (til (count cs)))))
(set T (table [g c] (list gs (fold concat cs))))
(map (fn [v] (count (distinct v))) cs) -- e
(at (select {from: T by: g n: (count (distinct c))}) 'n) -- e
(set r (til 200000))
(set ids (% r 5003))
(set gs (concat (% r 4) [0]))
(set small (concat (map (fn [i] (list i)) ids) (list 'marker)))
(set wide (concat (map (fn [i] (list i)) (+ 4611686018427387904 ids)) (list 'marker)))
(set query (fn [T] (select {from: T by: g n: (count (distinct c))})))
(set S (table [g c] (list gs small)))
(set W (table [g c] (list gs wide)))
(set oracle (fn [xs] (map (fn [g] (count (distinct (filter xs (== gs g))))) (til 4))))
(set E [5004 5003 5003 5003])
(set check (fn [T xs] (do (let Q (query T)) (list (type (at T 'c)) (identical (at Q 'g) (til 4)) (identical (at Q 'n) E) (identical (at Q 'n) (oracle xs))))))
(check S small) -- (list 'LIST true true true)
(check W wide) -- (list 'LIST true true true)
(set best (fn [g] (min (map (fn [i] (g)) (til 3)))))
(< (best (fn [] (timeit (query W)))) (* 10 (+ 2.0 (best (fn [] (timeit (query S))))))) -- true
