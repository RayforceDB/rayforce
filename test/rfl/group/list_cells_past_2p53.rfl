;; @requires: posix  (the 8-worker case runs as a child process through .sys.exec)
;; #1330: past ±2^53 an I64 and an F64 compare through double, so atom_eq is
;; not transitive (2^53+1 = 2^53.0 = 2^53, but 2^53+1 != 2^53).  `group`
;; and `by:` over such cells give the row-order answer on any number of
;; workers: the parallel directory (4 workers and up) used to vary from run
;; to run.  The harness runs at 2 workers, so test/data/group_past_2p53.rf
;; repeats every case under -c 8 and prints "ok" or the first that failed:
;; flat, negative, nested, dict and table cells, large integers with no float, the exact 2^53 boundary, and a time
;; bound against hashing every float alike.
(.sys.exec "o=$(env -u RAYFORCE_CORES ./rayforce -c 8 -f test/data/group_past_2p53.rf 2>&1 | tail -1); [ \"$o\" = ok ] || { echo \"$o\" >&2; exit 1; }") -- 0

;; the row-order answer at the harness's worker count
(set C (concat (list [7 7]) (at (list 9007199254740993 9007199254740992.0 9007199254740992) (% (til 89999) 3))))
(set T (table [c r] (list C (til 90000))))
(map count (value (group C))) -- [1 60000 29999]
(at (select {from: T by: c n: (count r)}) 'n) -- [1 60000 29999]
(count (distinct C)) -- 3
