;; @requires: posix  (the server is spawned and stopped through test/serve.sh)
;; A group by two or more keys with nothing else in the select
;; (`select {from: T by: [a b]}`) groups its keys with agg_group_keys, and
;; mapped any failure of it to `oom`: a cancel that landed while it grouped
;; answered `oom`, and the query log recorded an `oom` that never happened
;; (#1780).  That a cancel landing inside the grouping answers `cancel`,
;; leaves nothing behind and the next run answers in full is proven
;; in-process at known points of the query, independent of timing
;; (test_group_cancel_status in test/test_aware.c: the nth pool dispatch
;; finds the query cancelled).  This is the end to end case: requests with
;; a client deadline of 1 ms over IPC.  Whether a request is cancelled
;; before it starts, while it groups, or answers first depends on how the
;; client and the server are scheduled (#1867), so only what holds in every
;; case is asserted: each request the query log records is `ok` or
;; `cancel`, none `oom`, and the server answers the query afterwards.  The
;; server is its own process, with its own port (test/serve.sh), stopped by
;; its own pid only.
(.sys.exec "rm -rf /tmp/rf_gkoom")
(.sys.exec "test/serve.sh /tmp/rf_gkoom -Q 1") -- 0
(set addr (format "127.0.0.1:%" (trim (read "/tmp/rf_gkoom/port"))))
(set h (.ipc.open addr))
(.ipc.send h "(do (set T (table [a b] (list (% (til 16777216) 1000) (% (til 16777216) 7)))) 0)") -- 0
(set q "(count (select {from: T by: [a b]}))")
(.ipc.send h q) -- 7000
(set n0 (at (.ipc.send h "(.sys.querylog.stats)") 'next))
(set cut (fn [i] (do (set c (.ipc.open addr)) (try (.ipc.send c q 1) (fn [e] e)) (try (.ipc.close c) (fn [e] e)) i)))
(map cut (til 5)) -- [0 1 2 3 4]
(.ipc.send h "1") -- 1
(set st (.ipc.send h (format "(at (select {from: (.sys.querylog %) where: (== query \"%\")}) 'status)" n0 q)))
(count (where (== st 'oom))) -- 0
(count (where (or (== st 'ok) (== st 'cancel)))) -- (count st)
;; the server is usable after the cancels
(.ipc.send h q) -- 7000
(.sys.exec "test/serve.sh --stop /tmp/rf_gkoom") -- 0
