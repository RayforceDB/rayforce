;; A grouping keyed by an expression over one FILE-domain SYM column whose
;; every aggregate reads that column — count, min, max, sum/avg of strlen —
;; is decided over the column's distinct values: the rows are grouped by the
;; column once (a count per value), the key runs once per value, and the
;; aggregates are rewritten over that.  Every answer is checked against the
;; row-wise evaluation, which one aggregate over another column forces.
(.sys.exec "rm -rf /tmp/rfl_dkv/") -- 0
(set N 200000)
(set i (til N))
(set D 3000)
(set refs (map (fn [k] (if (== 0 (% k 11)) "" (if (== 0 (% k 3)) (format "http://www.host%.example.org/path/%/page?id=%" (% k 70) k (* k 13)) (if (== 0 (% k 7)) (format "ab%" (% k 10)) (format "https://host%.example.org/p/%" (% k 70) k))))) (til D)))
(set ref (as 'SYMBOL (map (fn [k] (at refs (% (* k 7919) D))) i)))
(set v (% (* i 31) 1000))
(set T (table [ref v] (list ref v)))
(.db.splayed.set "/tmp/rfl_dkv/" T)
(set F (.db.splayed.get "/tmp/rfl_dkv/"))
(set key (fn [t] (select {from: t by: (let p (str-find ref "://") (let s (substr ref (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) l: (avg (strlen ref)) c: (count ref) mn: (min ref) mx: (max ref) sl: (sum (strlen ref)) where: (!= ref "")})))
(set oracle (fn [t] (select {from: t by: (let p (str-find ref "://") (let s (substr ref (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr ref 1 4) "http") (not (nil? sl))) (substr r 1 sl) ref))))) l: (avg (strlen ref)) c: (count ref) mn: (min ref) mx: (max ref) sl: (sum (strlen ref)) sv: (sum v) where: (!= ref "")})))
(set same (fn [R O col] (all (== (at (select {from: R asc: c}) col) (at (select {from: O asc: c}) col)))))
(set R (key F))
(set O (oracle F))
(count R) -- 80
(== (count R) (count O)) -- true
(cols R) -- [p l c mn mx sl]
(type (at R 'l)) -- 'F64
(type (at R 'mn)) -- 'SYM
(same R O 'c) -- true
(same R O 'l) -- true
(same R O 'sl) -- true
(all (== (as 'STR (at (select {from: R asc: c}) 'mn)) (as 'STR (at (select {from: O asc: c}) 'mn)))) -- true
(all (== (as 'STR (at (select {from: R asc: c}) 'mx)) (as 'STR (at (select {from: O asc: c}) 'mx)))) -- true
(all (== (as 'STR (at (select {from: R asc: c}) 'p)) (as 'STR (at (select {from: O asc: c}) 'p)))) -- true
;; the same table in memory (the column's ids are runtime ids, read from
;; the table's own atoms) takes the same route and agrees
(set RM (key T))
(== (count RM) (count R)) -- true
(same RM R 'c) -- true
(same RM R 'l) -- true
;; ── the key values never enter the global symbol table ─────────────────
;; The key strings go into a domain of the key column's own, released with
;; the result: the runtime table ((.sys.mem) 'sym-count) is exactly as
;; large after the query as before it, over the file-backed table and over
;; the in-memory one.  The snapshot is taken inside one expression (a line
;; of this file interns its own names when it is parsed), and (.sys.mem) is
;; called once beforehand (its first call interns its own key names).
(count (.sys.mem)) -- 21
(set nogrow (fn [f] (do (let s0 (at (.sys.mem) 'sym-count)) (let r (f)) (list (- (at (.sys.mem) 'sym-count) s0) r))))
(set NG (nogrow (fn [] (key F))))
(at NG 0) -- 0
(same (at NG 1) O 'c) -- true
(set NGM (nogrow (fn [] (key T))))
(at NGM 0) -- 0
(same (at NGM 1) O 'l) -- true
;; the key column stays a symbol column, resolvable through its own domain
(type (at (at NG 1) 'p)) -- 'SYM
(count (distinct (as 'STR (at (at NGM 1) 'p)))) -- 80
;; and the result survives its source: the domain lives with the column
(set KEEP (at (at NGM 1) 'p))
(set NGM 0)
(count (distinct (as 'STR KEEP))) -- 80
;; no where: the null group is there, its avg is the null float, its min the empty symbol
(set R2 (select {from: F by: (substr ref 1 4) c: (count ref) l: (avg (strlen ref)) mn: (min ref)}))
(set O2 (select {from: F by: (substr ref 1 4) c: (count ref) l: (avg (strlen ref)) mn: (min ref) sv: (sum v)}))
(count R2) -- 12
(same R2 O2 'c) -- true
(all (== (nil? (at (select {from: R2 asc: c}) 'l)) (nil? (at (select {from: O2 asc: c}) 'l)))) -- true
(sum (at R2 'c)) -- 200000
;; sort and take on an output alias
(set R3 (select {from: F by: (substr ref 1 4) c: (count ref) where: (!= ref "") desc: c take: 3}))
(set O3 (select {from: F by: (substr ref 1 4) c: (count ref) sv: (sum v) where: (!= ref "") desc: c take: 3}))
(all (== (at R3 'c) (at O3 'c))) -- true
(all (== (as 'STR (at R3 'ref)) (as 'STR (at O3 'ref)))) -- true
;; an alias that spells the source column's name renames the key to `key`
(cols (select {from: F by: (substr ref 1 4) ref: (count ref) where: (!= ref "")})) -- [key ref]
;; unsorted output: groups in the order their first value appears in the
;; column's vocabulary, the same at every core count (the per-value counts
;; come out of a grouping whose order depends on the core count, and are
;; put back in vocabulary order first)
(set RU (select {from: F by: (substr ref 1 4) c: (count ref)}))
(as 'STR (at RU 'ref)) -- ["" "http" "ab5" "ab0" "ab9" "ab4" "ab3" "ab8" "ab2" "ab1" "ab6" "ab7"]
(at RU 'c) -- [18203 164471 1733 1736 1733 1733 1734 1731 1731 1731 1732 1732]
;; ── the same column under a name no global holds ───────────────────────
;; (`ref` is a global above as well; the having match below reads an
;; aggregate over a global's name as one over a constant, not a column)
(.sys.exec "rm -rf /tmp/rfl_dkv_u/") -- 0
(.db.splayed.set "/tmp/rfl_dkv_u/" (table [url v] (list (at T 'ref) (at T 'v))))
(set FU (.db.splayed.get "/tmp/rfl_dkv_u/"))
;; the key "" comes first, wherever its first value lies (the place a key
;; domain gives the empty string, and the row path's order)
(set E (select {from: FU by: (substr url 40 3) c: (count url) where: (!= url "")}))
(as 'STR (at E 'url)) -- ["" "/pa" "pag" "age" "e?i" "ge?"]
(at E 'c) -- [121196 34795 21138 4268 200 200]
(as 'STR (at (select {from: FU by: (substr url 40 3) c: (count url) sv: (sum v) where: (!= url "")}) 'url)) -- ["" "/pa" "pag" "age" "e?i" "ge?"]
;; the first value with a key, "https://host29.example.org/p/1919", keys "19"
(set E2 (select {from: FU by: (substr url 30 2) c: (count url) where: (!= url "")}))
(take (as 'STR (at E2 'url)) 6) -- ["" "19" "83" "/p" "16" "14"]
(take (at E2 'c) 6) -- [17660 4134 536 51927 3266 2998]
;; no where: the null value and the short values share the key "": the
;; group's min and max skip the null, its avg divides by the others' rows
(set N3 (select {from: FU by: (substr url 40 3) c: (count url) mn: (min url) mx: (max url) l: (avg (strlen url))}))
(set N3O (select {from: FU by: (substr url 40 3) c: (count url) mn: (min url) mx: (max url) l: (avg (strlen url)) sv: (sum v)}))
(as 'STR (at (select {from: N3 asc: url}) 'mn)) -- ["ab0" "http://www.host10.example.org/path/1200/page?id=15600" "http://www.host0.example.org/path/210/page?id=2730" "http://www.host3.example.org/path/3/page?id=39" "http://www.host2.example.org/path/72/page?id=936" "http://www.host0.example.org/path/1050/page?id=13650"]
(all (== (as 'STR (at (select {from: N3 asc: url}) 'mn)) (as 'STR (at (select {from: N3O asc: url}) 'mn)))) -- true
(all (== (as 'STR (at (select {from: N3 asc: url}) 'mx)) (as 'STR (at (select {from: N3O asc: url}) 'mx)))) -- true
(all (== (at (select {from: N3 asc: url}) 'l) (at (select {from: N3O asc: url}) 'l))) -- true
(all (== (at (select {from: N3 asc: url}) 'c) (at (select {from: N3O asc: url}) 'c))) -- true
;; ── an enclosing where over the count ──────────────────────────────────
;; `(select {from: (select {… c: (count url) …}) where: (> c N)})` arms
;; the group emit filter for the inner grouping: the groups it drops are
;; dropped before their key or min is made.  The enclosing where still runs,
;; so the answer is the row path's.
(set HQ (fn [t] (select {from: (select {from: t by: (let p (str-find url "://") (let s (substr url (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr url 1 4) "http") (not (nil? sl))) (substr r 1 sl) url))))) l: (avg (strlen url)) c: (count url) mn: (min url) where: (!= url "")}) where: (> c 2600)})))
(set HV (HQ FU))
(set HO (select {from: (select {from: FU by: (let p (str-find url "://") (let s (substr url (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr url 1 4) "http") (not (nil? sl))) (substr r 1 sl) url))))) l: (avg (strlen url)) c: (count url) mn: (min url) sv: (sum v) where: (!= url "")}) where: (> c 2600)}))
(count HV) -- 19
(same HV HO 'c) -- true
(same HV HO 'l) -- true
(all (== (as 'STR (at HV 'mn)) (as 'STR (at HO 'mn)))) -- true
(all (== (as 'STR (at HV 'p)) (as 'STR (at HO 'p)))) -- true
;; a grouping that sorts and takes picks among all its groups first: the
;; five longest have about 866 rows each, so none passes the where
(set TK (fn [t] (select {from: t by: (let p (str-find url "://") (let s (substr url (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr url 1 4) "http") (not (nil? sl))) (substr r 1 sl) url))))) l: (avg (strlen url)) c: (count url) mn: (min url) where: (!= url "") desc: l take: 5})))
(at (TK FU) 'c) -- [866 866 866 867 868]
(set TKH (fn [t] (select {from: (select {from: t by: (let p (str-find url "://") (let s (substr url (+ p 4) -1) (let r (if (== (str-find s "www.") 0) (substr s 5 -1) s) (let sl (str-find r "/") (if (and (within p [4 5]) (== (substr url 1 4) "http") (not (nil? sl))) (substr r 1 sl) url))))) l: (avg (strlen url)) c: (count url) mn: (min url) where: (!= url "") desc: l take: 5}) where: (> c 2600)})))
(count (TKH FU)) -- 0
;; the cut without a where: the kept group of the key "" holds the null value,
;; which its min skips
(set HQ2 (fn [t] (select {from: (select {from: t by: (substr url 40 3) c: (count url) mn: (min url) l: (avg (strlen url))}) where: (> c 30000)})))
(as 'STR (at (HQ2 FU) 'mn)) -- ["ab0" "http://www.host10.example.org/path/1200/page?id=15600"]
(at (HQ2 FU) 'c) -- [139399 34795]
;; a generation-2 (compressed) store of the same column agrees
(.sys.exec "rm -rf /tmp/rfl_dkv_z/") -- 0
(.db.splayed.set "/tmp/rfl_dkv_z/" (table [url v] (list (at T 'ref) (at T 'v))) "/tmp/rfl_dkv_z/.sym" {compress: true})
(set FZ (.db.splayed.get "/tmp/rfl_dkv_z/" "/tmp/rfl_dkv_z/.sym"))
(count (HQ FZ)) -- 19
(all (== (as 'STR (at (HQ FZ) 'mn)) (as 'STR (at HV 'mn)))) -- true
(all (== (at (HQ FZ) 'l) (at HV 'l))) -- true
(as 'STR (at (HQ2 FZ) 'mn)) -- ["ab0" "http://www.host10.example.org/path/1200/page?id=15600"]
(take (as 'STR (at (select {from: FZ by: (substr url 30 2) c: (count url) where: (!= url "")}) 'url)) 6) -- ["" "19" "83" "/p" "16" "14"]
(.sys.exec "rm -rf /tmp/rfl_dkv/ /tmp/rfl_dkv_u/ /tmp/rfl_dkv_z/") -- 0
