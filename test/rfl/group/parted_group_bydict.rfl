;; parted_group_bydict.rfl — per-partition streaming GROUP BY where the group
;; keys are supplied via a by-DICT of COMPUTED and/or RENAMED values over a
;; PARTED input table.
;;
;; Previously ray_select EAGERLY flattened every non-identity by-dict value
;; (ray_eval + ray_table_add_col over the whole flattened parted table) before
;; grouping, so exec_group_parted only ever saw a bare flat key and the
;; streaming per-partition kernel never ran for these shapes.  Now the by-dict
;; keys are DEFERRED: by_expr is rewritten to a SYM vec of the ALIAS names and
;; the value ASTs are compiled at the group-key site (compile_expr_dag per key),
;; so a rename lowers to the same OP_SCAN a bare key does and a computed key to a
;; DAG node the per-partition kernel materialises and streams.  Result key
;; columns are renamed to the by-dict aliases after execution.
;;
;; The (.sys.mem) 'group-perpart-runs counter increments once per
;; exec_group_per_partition entry, so a strict increase proves the streaming
;; kernel ran; parity with an identical-data flat oracle proves correctness.
;;
;; Cardinality gate (exec_group_parted): est_groups*100 <= rows_per_part.  With
;; 400 rows/partition, the varying key(s) must stay low-cardinality.  ts here is
;; a slow-moving field so (xbar ts 200) gives 2 buckets and sym/ex are 2-value
;; keys → est_groups stays 2..4 and clears 400.

;; ─── fixture: 2 partitions, 400 rows each ────────────────────────────────────
(set N 400)
(set TS (til N))                          ;; 0..399, monotone (same both parts)
(set SG (as 'SYM (% (til N) 2)))          ;; 2-value symbol key
(set EX (as 'SYM (% (til N) 2)))          ;; 2-value symbol key (exchange-like)
(set GS (as 'STR (% (til N) 2)))          ;; 2-value STRING key (negative guard)
(set V1 (as 'F64 (til N)))                ;; value, partition 1
(set V2 (as 'F64 (+ 1000 (til N))))       ;; value, partition 2
(set P1 (table [ts sg ex gs v] (list TS SG EX GS V1)))
(set P2 (table [ts sg ex gs v] (list TS SG EX GS V2)))
(.sys.exec "rm -rf /tmp/rfl_pgbd")
(.db.splayed.set "/tmp/rfl_pgbd/1/t/" P1)
(.db.splayed.set "/tmp/rfl_pgbd/2/t/" P2)
(set Pw (.db.parted.get "/tmp/rfl_pgbd/" 't))
;; identical-data flat in-memory oracle (part1 rows ++ part2 rows, same order)
(set TF (table [ts sg ex gs v] (list (concat TS TS) (concat SG SG) (concat EX EX) (concat GS GS) (concat V1 V2))))

;; ══════════════════════════════════════════════════════════════════════════
;; (a) HEADLINE: computed key + rename — `by: {tb: (xbar ts 200) s: sym}`.
;;     est_groups = 2 buckets * 2 syms = 4 → 4*100=400 <= 400 clears the gate.
;; ══════════════════════════════════════════════════════════════════════════
(set Ba (at (.sys.mem) 'group-perpart-runs))
(set RPa (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) by: {tb: (xbar ts 200) s: sg} from: Pw asc: tb}))
(set Aa (at (.sys.mem) 'group-perpart-runs))
;; PROVES exec_group_per_partition ran for the computed+rename by-dict.
(> Aa Ba) -- true
(set RFa (select {sv: (sum v) cv: (count v) mnv: (min v) mxv: (max v) av: (avg v) by: {tb: (xbar ts 200) s: sg} from: TF asc: tb}))
(count RPa) -- 4
(count RPa) -- (count RFa)
;; aliased key columns present under their by-dict names, matching the oracle
(at RPa 'tb)  -- (at RFa 'tb)
(at RPa 's)   -- (at RFa 's)
(at RPa 'sv)  -- (at RFa 'sv)
(at RPa 'cv)  -- (at RFa 'cv)
(at RPa 'mnv) -- (at RFa 'mnv)
(at RPa 'mxv) -- (at RFa 'mxv)
(< (max (abs (- (at RPa 'av) (at RFa 'av)))) 0.000001) -- true

;; ══════════════════════════════════════════════════════════════════════════
;; (b) PURE RENAME — `by: {s: sym}`.  est_groups = 2 clears the gate.
;; ══════════════════════════════════════════════════════════════════════════
(set Bb (at (.sys.mem) 'group-perpart-runs))
(set RPb (select {sv: (sum v) cv: (count v) by: {s: sg} from: Pw asc: s}))
(set Ab (at (.sys.mem) 'group-perpart-runs))
;; PROVES exec_group_per_partition ran for the pure-rename by-dict.
(> Ab Bb) -- true
(set RFb (select {sv: (sum v) cv: (count v) by: {s: sg} from: TF asc: s}))
(count RPb) -- 2
(at RPb 's)  -- (at RFb 's)
(at RPb 'sv) -- (at RFb 'sv)
(at RPb 'cv) -- (at RFb 'cv)

;; ══════════════════════════════════════════════════════════════════════════
;; (c) TWO RENAMES — `by: {s: sym e: ex}`.  est_groups = 2*2 = 4 (both keys
;;     move together: row r has sg=ex=r%2, so only 2 groups actually occur).
;; ══════════════════════════════════════════════════════════════════════════
(set Bc (at (.sys.mem) 'group-perpart-runs))
(set RPc (select {sv: (sum v) cv: (count v) by: {s: sg e: ex} from: Pw asc: s}))
(set Ac (at (.sys.mem) 'group-perpart-runs))
;; PROVES exec_group_per_partition ran for the two-rename by-dict.
(> Ac Bc) -- true
(set RFc (select {sv: (sum v) cv: (count v) by: {s: sg e: ex} from: TF asc: s}))
(count RPc) -- (count RFc)
(at RPc 's)  -- (at RFc 's)
(at RPc 'e)  -- (at RFc 'e)
(at RPc 'sv) -- (at RFc 'sv)
(at RPc 'cv) -- (at RFc 'cv)

;; ══════════════════════════════════════════════════════════════════════════
;; (d) NEGATIVE GUARD — mixed computed + STRING key `by: {tb: (xbar ts 200)
;;     g: gs}`.  A STR key routes to the eval-level toy grouper which gathers
;;     key columns by name; a deferred alias column would not exist there, so
;;     this shape MUST NOT be deferred — it falls back to eager flatten/concat.
;;     Assert CORRECTNESS (parity with the flat oracle), not streaming.
;; ══════════════════════════════════════════════════════════════════════════
(set RPd (select {sv: (sum v) cv: (count v) by: {tb: (xbar ts 200) g: gs} from: Pw asc: tb}))
(set RFd (select {sv: (sum v) cv: (count v) by: {tb: (xbar ts 200) g: gs} from: TF asc: tb}))
(count RPd) -- (count RFd)
(at RPd 'tb) -- (at RFd 'tb)
(at RPd 'g)  -- (at RFd 'g)
(at RPd 'sv) -- (at RFd 'sv)
(at RPd 'cv) -- (at RFd 'cv)

;; ══════════════════════════════════════════════════════════════════════════
;; (e) LIST by-dict value — `by: {a: l}` over a LIST column groups as `by: l`
;;     does (structural equality of the cells), under the alias.  The by-dict
;;     loop took only typed vectors and answered `by-dict val must be a
;;     column vector`, in memory as well.  Alongside: a composite key with a
;;     LIST part built its key column with vec_new(LIST) (non-aggregate and
;;     no-output forms), and the eval-level grouping read the cells of a
;;     parted table row by row without flattening it (LIST, STR and GUID keys
;;     beside a row output; a by-dict alias the flattened copy dropped).
;; ══════════════════════════════════════════════════════════════════════════
(set LX1 [1 2 3 4 5])
(set LX2 [10 20 30 40 50])
(set LS ['a 'b 'a 'b 'a])
(set LL (list [1 2] [3] [1 2] [0Nl] [3]))
(set LW ["p" "q" "p" "" "q"])
(set LGU (take (guid 2) 5))
(set LI (table [x s l w g] (list LX1 LS LL LW LGU)))
(.sys.exec "rm -rf /tmp/rfl_pgbd_list /tmp/rfl_pgbd_lsp")
(.db.splayed.set "/tmp/rfl_pgbd_list/1/t/" LI)
(.db.splayed.set "/tmp/rfl_pgbd_list/2/t/" (table [x s l w g] (list LX2 LS LL LW LGU)))
(.db.splayed.set "/tmp/rfl_pgbd_lsp/" LI)
(set LP (.db.parted.get "/tmp/rfl_pgbd_list/" 't))
(set LSP (.db.splayed.get "/tmp/rfl_pgbd_lsp/"))
;; flat oracle of the parted rows (part 1 ++ part 2)
(set LF (table [x s l w g] (list (concat LX1 LX2) (concat LS LS) (concat LL LL) (concat LW LW) (concat LGU LGU))))

;; in memory: the alias names the key, the groups are by: l's
(set RLa (select {x: (sum x) from: LI by: {a: l}}))
(key RLa) -- [a x]
(at RLa 'a) -- (list [1 2] [3] [0Nl])
(at RLa 'x) -- [4 7 4]
(at RLa 'x) -- (at (select {x: (sum x) from: LI by: l}) 'x)
(nil? (last (at RLa 'a))) -- [true]
(at (select {x: x from: LI by: {a: l}}) 'x) -- (list [1 3] [2 5] [4])
(at (select {x: (count x) from: LI where: (> x 1) by: {a: l}}) 'a) -- (list [3] [1 2] [0Nl])
(key (select {from: LI by: {a: l}})) -- [a x s l w g]
;; composite key with a LIST part, row output and no output
(set RLc (select {x: x from: LI by: [l s]}))
(at RLc 'l) -- (list [1 2] [3] [0Nl] [3])
(at RLc 's) -- ['a 'b 'b 'a]
(at RLc 'x) -- (list [1 3] [2] [4] [5])
(at (select {from: LI by: [l s]}) 'x) -- [1 2 4 5]
(set RLd (select {x: x from: LI by: {a: l t: s}}))
(key RLd) -- [a t x]
(at RLd 'a) -- (list [1 2] [3] [0Nl] [3])
(at RLd 'x) -- (list [1 3] [2] [4] [5])
(at (select {x: (sum x) from: LI by: {a: l t: s}}) 'x) -- [4 2 4 5]

;; splayed: the same answers
;; (at (select {x: (sum x) from: LSP by: {a: l}}) 'a) -- (at RLa 'a)   ;; xfail BUG: a splayed LIST column loses the null of an inner vector ([0Nl] reads back as [-9223372036854775808]), by: l and plain reads alike
(at (select {x: (sum x) from: LSP by: {a: l}}) 'a) -- (at (select {x: (sum x) from: LSP by: l}) 'l)
(at (select {x: (sum x) from: LSP by: {a: l}}) 'x) -- [4 7 4]
(at (select {x: x from: LSP by: {a: l t: s}}) 'x) -- (at RLd 'x)

;; parted: parity with the flat oracle
(set PLa (select {x: (sum x) from: LP by: {a: l}}))
;; (at PLa 'a) -- (at (select {x: (sum x) from: LF by: {a: l}}) 'a)   ;; xfail BUG: stored LIST column loses an inner vector's null (see the splayed line above)
(at PLa 'a) -- (at (select {x: (sum x) from: LP by: l}) 'l)
(at PLa 'x) -- [44 77 44]
(at PLa 'x) -- (at (select {x: (sum x) from: LF by: l}) 'x)
(at (select {x: (sum x) from: LP by: l}) 'x) -- [44 77 44]
(at (select {x: x from: LP by: l}) 'x) -- (at (select {x: x from: LF by: l}) 'x)
(at (select {x: x from: LP by: {a: l}}) 'x) -- (list [1 3 10 30] [2 5 20 50] [4 40])
(at (select {x: (sum x) from: LP where: (> x 2) by: {a: l}}) 'x) -- (at (select {x: (sum x) from: LF where: (> x 2) by: {a: l}}) 'x)
(at (select {x: (sum x) from: LP by: [l s]}) 'x) -- [44 22 44 55]
(at (select {x: x from: LP by: [l s]}) 'x) -- (at (select {x: x from: LF by: [l s]}) 'x)
(set PLd (select {x: x from: LP by: {a: l t: s}}))
;; (at PLd 'a) -- (at RLd 'a)   ;; xfail BUG: stored LIST column loses an inner vector's null (see the splayed line above)
(at PLd 'a) -- (at (select {x: x from: LP by: [l s]}) 'l)
(at PLd 'x) -- (list [1 3 10 30] [2 20] [4 40] [5 50])
(at (select {from: LP by: {a: l t: s}}) 'x) -- [1 2 4 5]
;; STR and GUID keys beside a row output read the parted cells the same way
(at (select {x: x from: LP by: w}) 'x) -- (at (select {x: x from: LF by: w}) 'x)
(at (select {x: x from: LP by: {a: w}}) 'x) -- (list [1 3 10 30] [2 5 20 50] [4 40])
(at (select {x: x from: LP by: g}) 'x) -- (at (select {x: x from: LF by: g}) 'x)
(at (select {x: x from: LP by: {a: g t: s}}) 'x) -- (at (select {x: x from: LF by: {a: g t: s}}) 'x)
(.sys.exec "rm -rf /tmp/rfl_pgbd_list /tmp/rfl_pgbd_lsp")

;; ─── cleanup ─────────────────────────────────────────────────────────────────
(.sys.exec "rm -rf /tmp/rfl_pgbd")
