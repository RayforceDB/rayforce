;; Invariants for `in` — membership test.

(in 2 [1 2 3]) -- true
(in 5 [1 2 3]) -- false
(in [1 5 2] [1 2 3]) -- [true false true]

;; every element of a vector is in itself
(set V [3 1 4 1 5 9 2 6])
(count V) -- (sum (in V V))

;; concat-monotonic: if x in v, x in (concat v w)
(set V2 [10 20 30])
(set W [40 50])
(count V2) -- (sum (in V2 (concat V2 W)))

;; ---- Regression tests ported from test_lang_rf.inc::test_rf_in ----
;; Ported from test_lang_rf.inc::test_rf_in.

(in 2 2) -- true
(in false [true false]) -- true
(in 0x12 [0x12 0x11 0x10]) -- true
(in 'e' "test") -- [true]
(in "asd" "asd") -- [true true true]
(in "asd" 'a') -- [true false false]
(in 1h [2h 3h]) -- false
(in 2h [2 3]) -- true
(in 1i [1i 0Ni 2i]) -- true
(in 2012.12.12 [2012.12.12 2012.12.13]) -- true
(in 10:00:00.000 [10:00:00.000 20:10:10.500]) -- true
(in 1 [0Nl]) -- false
(in 'a ['a 'b 'c 'dd]) -- true
(in 2024.01.01D10:00:00.000000000 []) -- false
(in 1.0 [1.0 2.0 3.0]) -- true
(in (guid 2) []) -- [false false]
(in 2 (list '3' 2)) -- true
(in 3 [1i 0Ni 2i]) -- false
(in [true false] [false]) -- [false true]
(in [0x00 0x01] [0x02 0x00]) -- [true false]
(in "test" "post") -- [true false true true]
(in [3h 2h 5h 0Nh] [1h 0Nh 2h 3h]) -- [true true false true]
(in [3 2 5 0Nl -32768] [1h 0Nh 2h 3h]) -- [true true false true false]
(in [3i 2i 5i 0Ni -32768i] [1h 0Nh 2h 3h]) -- [true true false true false]
(in [3i 2i 5i 0Ni] [1i 0Ni 2i 3i]) -- [true true false true]
(in [3h 2h 5h 0Nh] [1i 0Ni 2i 3i]) -- [true true false true]
(in [3h 2h 5h 0Nh] [1 0Nl 2 3]) -- [true true false true]
(in [3 2 5 0Nl -2147483648] [1i 0Ni 2i 3i]) -- [true true false true false]
(in [3i 2i 0Ni] [1 0Nl 2 3]) -- [true true true]
(in [3 2 5 0Nl] [1 0Nl 2 3]) -- [true true false true]
(in (list 3h 2i 5 0Nl) [1 0Nl 2 3]) -- (list true true false true)
(in [0 1 0Nl] 0Nl) -- [false false true]
(in [3] (list 3i 2 5)) -- [true]
(in 'a' (list "iu" "asd")) -- [false]
(in 'a' (list "iu" "asd" 'a')) -- [true]
(in "asd" (list "iu" "asd")) -- [false false false]
(in "asd" (list 'd' "asd")) -- [false false true]
(in (list "asd") (list "iu" "asd")) -- [true]
(in (list "asd" "iu") "asd") -- [true false]
(set l (guid 2)) (in l l) -- [true true]
(set l (guid 2)) (in (first l) l) -- true
(set l (guid 2)) (in l (first l)) -- [true false]
(set l (guid 2)) (in (first l) (list (first l))) -- true
(set l (guid 2)) (in (list (first l)) l) -- (list true)
(set l (guid 2)) (in (list (first l)) (list l)) -- (list false)
(set l (guid 2)) (in (list (first l)) (list (first l))) -- (list true)
;; ========== I16 x I8 "IN" TESTS (Bug fix: index_in_i16_i8) ==========
;; Test i16 values against i8 lookup set
(in [1h 2h 3h] [1 2]) -- [true true false]
;; i16 in i8 range
(in [100h 50h 25h] [50 100]) -- [true true false]
;; i16 values in i8 lookup
(in [-128h 127h 0h] [-128 0 127]) -- [true true true]
;; i8 boundary values
(in [200h 10h] [10]) -- [false true]
;; value outside i8 range
;; ========== I16 x I16 "IN" TESTS (Bug fix: index_in_i16_i16 wrong size) ==========
;; Test when x length > y length (was causing buffer overflow)
(in [1h 2h 3h 4h 5h] [2h 4h]) -- [false true false true false]
(in [10h 20h 30h 40h 50h 60h] [20h]) -- [false true false false false false]
;; Test when x length < y length
(in [1h 2h] [1h 2h 3h 4h 5h]) -- [true true]
;; Test with equal lengths
(in [1h 2h 3h] [3h 2h 1h]) -- [true true true]
;; Test with empty arrays
(in (list) [1h 2h]) -- []
(type (in (list) [1h 2h])) -- 'B8

;; ========== TEXT (SYM/STR) NULL SEMANTICS (#593) ==========
;; `in` admits the typed verdict-LUT kernel unless BOTH sides carry a null:
;; the kernel uses null-matches-nothing semantics while the hashset path is
;; null-equals-null, and the two disagree only on a null row against a null
;; set element.  The gate used to ask
;; ray_vec_may_have_nulls, which is unconditionally true for SYM and STR
;; (their null is a payload value, not an attribute bit) — so the kernel was
;; unreachable for text columns and every symbol `in` fell through to the
;; generic per-row hashset probe.  These pin the semantics on both sides of
;; that gate so the admission check cannot drift back.

;; null in the COLUMN, null needle — null equals null
(in (as 'SYM ["a" "" "b"]) (as 'SYM [""])) -- [false true false]
(in ["a" "" "b"] [""]) -- [false true false]

;; null in the column, non-null needle — the null matches nothing else
(in (as 'SYM ["a" "" "b"]) (as 'SYM ["a"])) -- [true false false]

;; null only in the NEEDLES: a null-free column has no row for the null
;; needle to equal, so both semantics agree and the kernel is admitted
(in (as 'SYM ["a" "b"]) (as 'SYM ["" "a"])) -- [true false]

;; nulls on both sides
(in (as 'SYM ["a" ""]) (as 'SYM ["" "z"])) -- [false true]

;; null-free text: this is the shape that now reaches the kernel
(in (as 'SYM ["a" "b" "c"]) (as 'SYM ["b" "c"])) -- [false true true]
(in ["a" "b" "c"] ["b" "c"]) -- [false true true]

;; ========== ONE-SIDED NULLS REACH THE KERNEL (#593) ==========
;; A nullable column against null-free needles (or the reverse) is admitted:
;; a null row can only match a null needle.  Before, one null row sent the
;; whole column to the hashset, whose i64/f64 hashes disagree across numeric
;; types — so the mixed-type rows below also answered wrongly.

;; nullable column, null-free needles, every null-bearing width
(in [1 0Nl 3] [1 3]) -- [true false true]
(in [1i 0Ni 3i] [1 3]) -- [true false true]
(in [1h 0Nh 3h] [1h]) -- [true false false]
(in [1.0 0Nf 3.0] [1.0 3.0]) -- [true false true]
(in [2024.01.01 0Nd] [2024.01.01]) -- [true false]
(in ["a" "" "b"] ["a"]) -- [true false false]

;; the i32 null sentinel is INT32_MIN: a non-null needle of that value must
;; not match the null row
(in [1i 0Ni 3i] [-2147483648 3]) -- [false false true]

;; null-free column, null needles: the null needle matches nothing
(in [1 2 3] [0Nl 3]) -- [false false true]
(in [1.0 2.0 3.0] [0Nf 3.0]) -- [false false true]
(in [2024.01.01 2024.01.02] [0Nd 2024.01.02]) -- [false true]
(in ["a" "b"] ["" "a"]) -- [true false]

;; mixed int/float with a null on one side — was [true false false] and
;; [false false false] on the hashset path
(in [1.0 0Nf 3.0] [1 3]) -- [true false true]
(in [1 0Nl 3] [1.0 3.0]) -- [true false true]

;; nulls on both sides still take the null-equals-null path
(in [1 0Nl 3] [0Nl 3]) -- [false true true]

;; empty needle set over a null-free symbol column
(in (as 'SYM ["a" "b"]) (as 'SYM [])) -- [false false]

;; a single needle is the degenerate case the issue reported: same answer as
;; the equality it should cost the same as
(in (as 'SYM ["a" "b" "a"]) (as 'SYM ["a"])) -- [true false true]
(== (as 'SYM ["a" "b" "a"]) 'a) -- [true false true]

;; duplicate needles must not double-count or change the verdict
(in (as 'SYM ["a" "b"]) (as 'SYM ["a" "a" "a"])) -- [true false]

;; ========== TEMPORAL EQUALS ONLY ITS OWN TYPE (#593 review) ==========
;; atom_eq never matches a DATE to an int or to a TIMESTAMP, and neither do
;; find / except or the hashset `in`.  The typed kernel compared raw
;; payloads — day 0 matched 0i, a DATE's day count matched a TIMESTAMP's
;; nanoseconds — so widening its gate made the answer depend on where the
;; nulls were.  Every shape below answers the same with nulls on either
;; side, none, or (for the hashset) both.

;; temporal column, int needles: nothing matches
(in [2000.01.01 2000.01.03] [0i 2i]) -- [false false]
(in [2000.01.01 0Nd 2000.01.03] [0i 2i]) -- [false false false]
(in [2000.01.01 2000.01.03] [0Ni 2i]) -- [false false]
(in [2000.01.01 0Nd] [0]) -- [false false]
(in [00:00:01.000 0Nt] [1000i]) -- [false false]
(in [2000.01.01D00:00:00.000000000 0Np] [0]) -- [false false]

;; int column, temporal needles: nothing matches
(in [0i 2i] [2000.01.01 2000.01.03]) -- [false false]
(in [0 0Nl] [2000.01.01]) -- [false false]
(in [0 1] [2000.01.01 0Nd]) -- [false false]

;; distinct temporal types never match — not even by raw payload
(in [2000.01.02] [2000.01.01D00:00:00.000000001]) -- [false]
(in [2000.01.02 0Nd] [2000.01.02D00:00:00.000000000]) -- [false false]
(in [2000.01.01D00:00:00.000000000 0Np] [2000.01.01]) -- [false false]
(in [00:00:00.001] [2000.01.01D00:00:00.000000001]) -- [false]

;; same with nulls on both sides: a date null is not an int null, as a
;; date is never an int (rayforce 1 answered the same)
(in [2000.01.01 0Nd] [0Ni 0i]) -- [false false]
(in [2000.01.01 0Nd] [0Nd]) -- [false true]

;; same-type temporal still matches, with or without nulls
(in [2000.01.01 0Nd 2000.01.03] [2000.01.03]) -- [false false true]
(in [2000.01.01 2000.01.03] [2000.01.01 0Nd]) -- [true false]

;; the fused where: and find agree with the bare in
(count (select {from: (table [d] (list [2000.01.01 2000.01.03 0Nd])) where: (in d [0i 2i])})) -- 0
(find [2000.01.01 2000.01.03] [0i]) -- [0Nl]

;; ========== LARGE NEEDLE SETS HASH INSIDE THE KERNEL ==========
;; Past the SIMD small-set size (8) the kernel hashes the needles instead of
;; scanning them per row, so a nullable column against thousands of needles
;; stays O(rows + needles).  Pins the boundary and the table's edge values.

;; 8 needles (SIMD path) and 9 (hash path) answer alike
(in [1 2 3 0Nl 20] [1 3 5 7 9 11 13 15]) -- [true false true false false]
(in [1 2 3 0Nl 20] [1 3 5 7 9 11 13 15 20]) -- [true false true false true]
(in [1.0 2.0 0Nf 20.0] [1.0 3.0 5.0 7.0 9.0 11.0 13.0 15.0 20.0]) -- [true false false true]

;; -0.0 and +0.0 share a slot; NaN / null never match
(in [-0.0 0.0 1.5] (as 'F64 (til 20))) -- [true true false]
(in [0Nf 2.5] (concat (as 'F64 (til 20)) [2.5])) -- [false true]

;; duplicates in a large set, and a large set against a nullable column
(sum (in (concat (til 1000) [0Nl]) (take (til 100) 5000))) -- 100
(sum (in (concat (til 1000) [0Nl]) (* 2 (til 1000)))) -- 500
(sum (in (concat (as 'F64 (til 1000)) [0Nf]) (as 'F64 (* 2 (til 1000))))) -- 500

;; a large set of narrow ints against a narrow column
(sum (in (as 'I32 (til 1000)) (as 'I32 (* 3 (til 100))))) -- 100
(sum (in (as 'I16 (til 1000)) (as 'I16 (* 3 (til 100))))) -- 100

;; ========== STRING COLUMNS ==========
;; A string element of a collection is one whole value.  Against a list of
;; strings or a string atom each element answered per character — a list of
;; per-character vectors that `where` refused — and inside a query the
;; executor refused any string column with nyi.  A lone string atom on the
;; left still answers per character, as above.
(in ["p" "qq"] (list "qq" "zz")) -- [false true]
(in ["p" "qq"] "qq") -- [false true]
(in ["p" "qq" ""] (list "qq" 1 'zz)) -- [false true false]
(not-in ["p" "qq"] (list "qq" "zz")) -- [true false]
(in (list "ab" "c") "c") -- [false true]
(in (list "ab" 1) (list "ab" 1)) -- [true true]
(in (list (list "ab") "c") "c") -- (list [false] true)
;; a bool answer first and a vector answer later still collect as a list —
;; each later answer was read as a bool, so a vector stood in by its length
(in (list "c" ["x" "x"]) "c") -- (list true [false false])
(not-in (list "c" ["x" "x"]) "c") -- (list false [true true])
(in (list "zz" (list "c")) "c") -- (list false [true])
(in (list 1 (list 1 2)) 1) -- (list true [true false])
(in (list 1 2 (list 3 1)) [1]) -- (list true false [false true])
(in "ab" (list "a" "b" "c")) -- [true true]

(set TS (table [s n] (list ["p" "qq" "zz" ""] [1 2 3 4])))
(at (select {from: TS where: (in s ["qq" "zz"])}) 'n) -- [2 3]
(at (select {from: TS where: (in s (list "qq" "zz"))}) 'n) -- [2 3]
(at (select {from: TS where: (in s "qq")}) 'n) -- [2]
;; the empty string is the string null: it matches nothing, even itself,
;; and not-in leaves it out too, as for every other column type
(at (select {from: TS where: (not-in s ["qq" "zz"])}) 'n) -- [1]
(at (select {from: TS where: (in s ["qq" ""])}) 'n) -- [2]
(at (select {from: TS where: (in s (take ["a"] 0))}) 'n) -- []
;; a string atom against the column is one verdict for every row
(count (select {from: TS where: (in "qq" s)})) -- 4
(count (select {from: TS where: (in "xx" s)})) -- 0
(at (select {from: TS by: (in s ["qq"]) c: (count n)}) 'c) -- [3 1]
;; a projection answers one verdict per row too, and does not drag the
;; projections beside it into per-character answers
(at (select {c: (in s (list "qq" "zz")) from: TS}) 'c) -- [false true true false]
(at (select {c: (not-in s (list "qq")) from: TS}) 'c) -- [true false true false]
(at (select {c: (in s "qq") d: (in s (list "x")) from: TS}) 'c) -- [false true false false]
(at (select {c: (in s (list "qq")) from: TS where: (> n 1)}) 'c) -- [true false false]
(at (update {c: (in s (list "qq")) from: TS}) 'c) -- [false true false false]
;; A projection the compiler declines still sorts by a column it does not
;; output — the key is carried for the sort (it raised nyi) ...
(at (select {c: (in s (list "qq")) from: TS desc: n}) 'c) -- [false false true false]
(at (select {c: (in s (list "qq")) from: TS asc: n take: 2}) 'c) -- [false true]
(at (select {c: (in s (list "qq")) from: TS where: (> n 1) desc: n}) 'c) -- [false false true]
(at (select {c: (reverse n) from: TS desc: n}) 'c) -- [1 2 3 4]
(key (select {c: (in s (list "qq")) from: TS desc: [s n]})) -- ['c]
;; ... and a by: aggregate over such an argument is evaluated per group (it
;; raised "failed to compile aggregation argument")
(set TG (table [s g n] (list ["p" "qq" "zz" "" "qq"] [1 1 2 2 2] [1 2 3 4 5])))
(at (select {c: (sum (in s (list "qq"))) from: TG by: g}) 'c) -- [1 1]
(at (select {c: (sum (in s (list "qq"))) m: (max n) from: TG by: g}) 'm) -- [2 5]
(at (select {c: (count (in s (list "qq" "zz"))) from: TG by: g where: (> n 1)}) 'c) -- [1 3]

;; Known bugs found alongside, not fixed here:
;; (at (select {c: (sum (in s (list "qq"))) from: TG by: (> n 2)}) 'c) -- [1 1]   ;; xfail BUG: an aggregate evaluated per group needs one column group key; a computed or multi-column key errors "could not resolve scalar group key symbol" (also (sum (reverse n)))
;; Name resolution inside a query (planned binder work), not `in` itself:
;; (at (select {c: (in 's (list 's)) from: TS}) 'c) -- [true]   ;; xfail BUG: a quoted symbol that names a column reads the column, here and in (== y 'y) or {c: 'y}
;; (do (set in concat) (at (select {c: (in s "!") from: TS}) 'c)) -- ["p!" "qq!" "zz!" "!"]   ;; xfail BUG: select still compiles a rebound `in` as membership

;; ========== NULLS OF DIFFERENT TYPES ==========
;; Two nulls are equal where two values of their types can be: the same
;; type, or both numeric (0Nl and 0Ni, as 1 and 1i).  A symbol null, the
;; empty string, an integer null, a date null and the untyped null are
;; different values, as 'a, "a", 1 and a date are — rayforce 1 answered so.
;; Every null used to equal every other one, and distinct collapsed them.
(in [' 'a] "") -- [false false]
(in [0Nl 1] "") -- [false false]
(in ['a '] [""]) -- [false false]
(in [0Nl 1] [""]) -- [false false]
(in (list 0Nl ') (list "")) -- [false false]
(in (list null 1) [0Nl]) -- [false false]
(in "" ['a ']) -- false
(in 0Nd [0Nl]) -- false
;; within a type, and across numeric widths, null still matches null
(in [' 'a] [']) -- [true false]
(in [0Nl 1] [0Nl]) -- [true false]
(in [0Nl 1] [0Ni]) -- [true false]
(in [0Nl] [0Nf]) -- [true]
(in ' ['a ']) -- true
(in ["" "a"] [""]) -- [true false]
(count (distinct (list ' "" 0Nl null))) -- 4
(count (distinct (list 0Nl 0Ni ' '))) -- 2
(count (except (list ' "" 0Nl) (list ""))) -- 2
(count (sect (list ' "" 0Nl) (list 0Ni))) -- 1
;; find follows the same rule
(find ['a '] "") -- 0Nl
(find ["a" ""] ') -- 0Nl
(find [2024.01.01 0Nd] 0Nl) -- 0Nl
(find [2024.01.01 0Nd] 0Nd) -- 1
(find [1 0Nl] 0Ni) -- 1
(find ['a '] ') -- 1

;; ... nested under another verb too: a string cell bound for one row is
;; one value, so (in cell set) is one verdict wherever it sits
(at (select {c: (not (in s (list "qq"))) from: TS}) 'c) -- [true false true true]
(at (select {c: (and (in s (list "qq")) (> n 1)) from: TS}) 'c) -- [false true false false]
(at (select {c: (if (in s (list "qq")) 1 0) from: TS}) 'c) -- [0 1 0 0]
(at (select {c: ((fn [x] (in x (list "qq"))) s) from: TS}) 'c) -- [false true false false]
(at (select {c: (in s (list "qq" 'zz 1)) from: TS}) 'c) -- [false true false false]
;; a set the compiler cannot take as a constant (an element computed at run
;; time) is evaluated row by row, and each string cell still answers once
(at (select {c: (not (in s (list "qq" (concat "z" "z")))) from: TS}) 'c) -- [true false false true]
(at (select {c: (if (in s (list (concat "q" "q"))) 1 0) from: TS}) 'c) -- [0 1 0 0]
;; the mark that makes a cell one value lasts for its row only: a cell the
;; projection hands back inside a list or a dict is a plain string after
(set TQ (table [s n] (list ["qq" "ab"] [1 2])))
(set RQ (select {c: (list s) from: TQ}))
(in (first (first (at RQ 'c))) "q") -- [true true]
(set RQ2 (select {c: (dict [k] (list s)) from: TQ}))
(in (at (first (at RQ2 'c)) 'k) (list "q")) -- [true true]
;; a lone string literal in a query still answers per character, per row
(at (select {c: (in "ab" (list "a" "b")) from: TS take: 1}) 'c) -- (list [true true])
;; a set held in a global list is read by the evaluator, not taken for a column
(set SETL (list "qq" "zz"))
(at (select {from: TS where: (in s SETL)}) 'n) -- [2 3]
(at (select {c: (in s SETL) from: TS}) 'c) -- [false true true false]
(set SETY (list 'qq 'zz))
(set TYS (table [y n] (list ['p 'qq 'zz] [1 2 3])))
(at (select {from: TYS where: (in y SETY)}) 'n) -- [2 3]
;; a LIST column's cell may be a vector: no verdict per row, a clean error
(set TLS (table [l n] (list (list ["a" "b"] "a" ["c"]) [1 2 3])))
(select {from: TLS where: (in l ["a"])}) !- nyi

;; a column of another type against a string set matches no row, as bare
(set TY (table [y n] (list ['p 'qq] [1 2])))
(in ['p 'qq] ["qq"]) -- [false false]
(count (select {from: TY where: (in y ["qq"])})) -- 0
(count (select {from: TY where: (not-in y ["qq"])})) -- 2
(count (select {from: TY where: (in n ["qq"])})) -- 0

;; a mapped (splayed) string column answers the same
(.sys.exec "rm -rf rf_in_str") -- 0
(.db.splayed.set "rf_in_str/" TS)
(set TM (.db.splayed.get "rf_in_str/"))
(at (select {from: TM where: (in s ["qq" "zz"])}) 'n) -- [2 3]
(at (select {from: TM where: (in s (list "zz"))}) 'n) -- [3]
(set TM 0)
(.sys.exec "rm -rf rf_in_str") -- 0
