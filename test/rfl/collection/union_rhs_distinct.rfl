;; A set (#1385): the distinct cells of A in order, then the first new cell of B.
(union [1 2] [3 3]) -- [1 2 3]
(union [1 2] [2 3 3 4 4]) -- [1 2 3 4]
(union [1 1 2] [3 3 2 4 3]) -- [1 2 3 4]
(set _union_chk (fn [a b] (identical (as 'LIST (union a b)) (union (as 'LIST a) (as 'LIST b)))))
(map (fn [t] (_union_chk (as t [1 1 2 0N]) (as t [2 3 3 0N 4 4]))) ['I16 'I32 'I64 'F32 'F64 'DATE 'TIME 'TIMESTAMP 'TIMESPAN]) -- (take [true] 9)
(_union_chk (as 'U8 [1 1 255]) (as 'U8 [255 128 128 0 0])) -- true
(_union_chk [true true] [false false true]) -- true
(_union_chk ['a 'a 'b '0N] ['b 'c 'c '0N 'd 'd]) -- true
(_union_chk ["a" "a" "b" ""] ["b" "c" "c" "" "d" "d"]) -- true
(set _ug1 (as 'GUID "00000000-0000-0000-0000-000000000001"))
(set _ug2 (as 'GUID "00000000-0000-0000-0000-000000000002"))
(_union_chk (enlist 0Ng _ug1 _ug1) (enlist _ug1 _ug2 _ug2 0Ng)) -- true
;; More than the stack-index capacity, all new RHS rows repeated.
(_union_chk [1 2] (% (til 1024) 32)) -- true
;; Existing span/point unit conversion, both operand directions.
(map (fn [t] (_union_chk (as t [1 2 0N]) (as 'TIMESPAN [1000000 1000000 5 5 0N 0N]))) ['TIME 'TIMESTAMP 'DATE 'I64 'I32 'F64]) -- (take [true] 6)
(map (fn [t] (_union_chk (as 'TIMESPAN [1000000 5 0N]) (as t [1 1 2 2 0N 0N]))) ['TIME 'TIMESTAMP 'DATE 'I64 'I32 'F64]) -- (take [true] 6)

;; Empty sides and a wholly covered RHS: the same identities and order.
(union (as 'I64 []) [3 3 4 4]) -- [3 4]
(union [1 1 2] (as 'I64 [])) -- [1 2]
(union [1 1 2] [2 2 1 1]) -- [1 2]
