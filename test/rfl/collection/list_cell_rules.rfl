;; @also-unfused
;; LIST cells follow the documented rules (#1361).
;; distinct over a list keeps each cell where it first occurs, atoms, vectors
;; and nested lists alike, as a typed vector does: it used to move the atoms
;; ahead of the vectors afterwards, which scrambled the vectors.
(distinct (list [1] [2] 3 [4] 5)) -- (list [1] [2] 3 [4] 5)
(distinct (list [1] 2 [1] 3 2 [4] [1])) -- (list [1] 2 3 [4])
(distinct (list 'a [1 2] "s" (list 1 [2]) 'a (list 1 [2]) [1 2] 7)) -- (list 'a [1 2] "s" (list 1 [2]) 7)
(distinct (list (list [1] 2) [3] (list [1] 2) 4 [3] (list (list 5)) (list (list 5)))) -- (list (list [1] 2) [3] 4 (list (list 5)))
(distinct (list [2i 2i] 1.0 [2i 2i] 1 (enlist 'x))) -- (list [2i 2i] 1.0 (enlist 'x))
;; past 64 cell pairs distinct hashes (list_set): same order
(set OL (concat (map (fn [i] (if (== 0 (% i 2)) (enlist (% i 7)) (% i 5))) (til 40)) (list [0] 1 [6])))
(distinct OL) -- (list [0] 1 [2] 3 [4] 0 [6] 2 [1] 4 [3] [5])
(count (distinct OL)) -- 12
(at (distinct OL) 0) -- [0]
