;; alter's index, .csv.parted's rows per partition and the moving windows
;; take the key rule of at: an integer atom (I64, I32, I16, U8), or for a
;; vector of keys an integer vector.  A float is not read as its bits, a
;; boolean is not 0 or 1, and a symbol is not ignored: each is a type
;; error naming its type, and nothing is changed (#1796).
(set msg (fn [e] (at e 'msg)))
;; alter on a list
(set L (list 10 20 30))
(alter 'L set 1.5 99) !- type
(alter 'L set true 99) !- type
(alter 'L set 'a 99) !- type
(alter 'L set [1.5] 99) !- type
(alter 'L set [true false] 99) !- type
(alter 'L remove 1.5) !- type
(alter 'L remove true) !- type
(alter 'L remove [true]) !- type
;; a boolean vector was never a mask: on dev each cell was an index, false
;; 0 and true 1, so [false false true] wrote cells 0 and 1, not cell 2, at
;; any length.  It is the same type error, full length or not
(alter 'L set [false false true] 99) !- type
(alter 'L remove [false false true]) !- type
L -- (list 10 20 30)
(try (alter 'L set 1.5 99) msg) -- "alter set: index must be an integer atom or an integer vector, got f64"
(try (alter 'L remove true) msg) -- "alter remove: index must be an integer atom or an integer vector, got b8"
;; the integer widths still index
(alter 'L set 1 99) -- 'L
L -- (list 10 99 30)
(alter 'L set (as 'I16 [0 2]) 7) -- 'L
L -- (list 7 99 7)
(alter 'L remove (as 'U8 [0])) -- 'L
L -- (list 99 7)
;; alter on a vector
(set V [10 20 30])
(alter 'V set 1.5 99) !- type
(alter 'V set true 99) !- type
(alter 'V set [true] 99) !- type
(alter 'V set [false false true] 99) !- type
V -- [10 20 30]
(alter 'V set 1i 99) -- 'V
V -- [10 99 30]
;; the moving windows, direct and in a select
(set v [1 2 3 4])
(msum true v) !- type
(mcount true v) !- type
(mavg true v) !- type
(mmin true v) !- type
(mmax true v) !- type
(mvar true v) !- type
(mdev true v) !- type
(set T (table [v] (list v)))
(select {s: (msum true v) from: T}) !- type
(msum 1 v) -- [1 2 3 4]
(msum 0x02 v) -- [1 3 5 7]
;; .csv.parted rows per partition
(.sys.exec "rm -rf /tmp/rf_key_count_types /tmp/rf_key_count_types_p.csv")
(write "/tmp/rf_key_count_types_p.csv" "a,b\n1,2\n3,4\n5,6\n")
(.csv.parted "/tmp/rf_key_count_types_p.csv" 1.5 "/tmp/rf_key_count_types/db1" 't) !- type
(.csv.parted "/tmp/rf_key_count_types_p.csv" true "/tmp/rf_key_count_types/db2" 't) !- type
(try (.csv.parted "/tmp/rf_key_count_types_p.csv" 1.5 "/tmp/rf_key_count_types/db1" 't) msg) -- "csv.parted: rows per partition must be an integer, got f64"
(count (.csv.parted "/tmp/rf_key_count_types_p.csv" 2 "/tmp/rf_key_count_types/db3" 't)) -- 3
(.sys.exec "rm -rf /tmp/rf_key_count_types /tmp/rf_key_count_types_p.csv")
