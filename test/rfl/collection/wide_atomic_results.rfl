;; fill and dyadic min/max keep homogeneous wide vector types.
(type (fill 'z (enlist 'a '))) -- 'SYM
(fill 'z (enlist 'a ')) -- ['a 'z]
(type (fill "z" (enlist "a" ""))) -- 'STR
(fill "z" (enlist "a" "")) -- ["a" "z"]

(type (min (enlist 'b 'a) (enlist 'a 'c))) -- 'SYM
(min (enlist 'b 'a) (enlist 'a 'c)) -- ['a 'a]
(type (max (enlist "b" "a") (enlist "a" "c"))) -- 'STR
(max (enlist "b" "a") (enlist "a" "c")) -- ["b" "c"]

(set g (guid 2))
(type (fill (first g) g)) -- 'GUID
(type (min g (reverse g))) -- 'GUID
(type (max g (reverse g))) -- 'GUID
(count (max g (reverse g))) -- 2

;; ── fill over a fixed-width vector runs one typed pass (fastmap_fill) ──
;; the result has the vector's type; the replacement is cast into it
(fill 0 [3 0Nl 1]) -- [3 0 1]
(type (fill 0 [3 0Nl 1])) -- 'I64
(fill 0 (as 'I32 [3 0N 1])) -- (as 'I32 [3 0 1])
(type (fill 0 (as 'I32 [3 0N 1]))) -- 'I32
(fill (as 'I16 9) (as 'I16 [0N 0N])) -- (as 'I16 [9 9])
(fill -1 (as 'I16 [3 0N])) -- (as 'I16 [3 -1])
(fill 2.5 [0Nf 1.0 0Nf]) -- [2.5 1.0 2.5]
(fill 2 [1.0 0Nf]) -- [1.0 2.0]
(type (fill 2 [1.0 0Nf])) -- 'F64
(fill 1 (as 'DATE [8766 0N])) -- (as 'DATE [8766 1])
(fill (as 'DATE 8770) (as 'DATE [8766 0N])) -- (as 'DATE [8766 8770])
(fill 2024.01.01D00:00:00.000000000 (enlist 0Np 2024.01.02D09:30:00.000000000)) -- (enlist 2024.01.01D00:00:00.000000000 2024.01.02D09:30:00.000000000)
;; a null first cell types the result from the replacement, as before
(type (fill 0 (as 'I32 [0N 3 1]))) -- 'I64
(fill 0 (as 'I32 [0N 3 1])) -- [0 3 1]
(type (fill 7 [0Nf 2.0])) -- 'I64
(fill 7 [0Nf 2.0]) -- [7 2]
(type (fill 7.0 [0Nf 2.0])) -- 'F64
;; a null replacement, an empty vector, no nulls at all
(fill 0Nl [3 0Nl 1]) -- [3 0Nl 1]
(fill 0 (as 'I64 [])) -- (as 'I64 [])
(fill 0 (til 4)) -- [0 1 2 3]
;; the cell is null by its payload, whatever the vector's null flag says
(fill 5 [0Nl 1]) -- [5 1]
;; a wide vector: the kernel's answer is the oracle's, cell by cell
(set V (% (* (til 100000) 7919) 1000))
(set VN (at (select {from: (table [v] (list V)) x: (if (< v 10) 0Nl v)}) 'x))
(count (where (nil? VN))) -- 1000
(fill -1 VN) -- (as 'I64 (map (fn [x] (fill -1 x)) VN))
(fill 7 VN) -- (at (select {from: (table [v] (list V)) x: (if (< v 10) 7 v)}) 'x)
;; the kernel runs well under the boxed map's time (one atom a cell);
;; the LIST form keeps the mapper and collapses to the same vector
(set best (fn [f] (min (map (fn [i] (f)) (til 3)))))
(set BIG (% (* (til 500000) 7919) 100000))
(set BIGL (as 'LIST (fill 0Nl BIG)))
(< (* 4 (best (fn [] (timeit (fill 0 BIG))))) (best (fn [] (timeit (fill 0 BIGL))))) -- true
