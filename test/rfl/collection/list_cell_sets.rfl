;; in keeps ray_in_fn's shapes: a leaf per answer, a list once a cell answers a vector
(in (list [1 2] 3) (list [1 2] 3)) -- (list [false false] true)
(in (list 3 [1 2] (list 1 [3 9])) (list [1 2] 3 1)) -- (list true [true false] (list true [true false]))
(in (list 1 2.0 'a) (list 2 'a)) -- [false true true]
(in [1 2 3] (list 1 [2] 3.0)) -- [true false true]
(in TS (list 1 2.0 1.4 (as 'TIMESPAN 2))) -- [true true]
(in (list (as 'TIMESPAN 1) 1.4 [1 2]) (list 1 (as 'TIMESPAN 2) TS)) -- (list true false [true true])
(in (list (as 'I64 []) 1) (list 1)) -- (list (as 'B8 []) true)
(in (list (list) 1) (list 1 [1])) -- (list (as 'B8 []) true)
(in (list) (list 1)) -- (as 'B8 [])
(in (list 1 [1]) (list)) -- (list false [false])
(in 1 (list [1] 1.0)) -- true
(in [1] (list [1] 1.0)) -- [true]
(in (list [1] [2]) (list [1] [2])) -- (list [false] [false])
;; string atoms and string vectors
(in (list "a" "b" 'a) (list "a" 'b)) -- [true false false]
(in ["a" "b"] (list "a" "c")) -- [true false]
(in (list ["a" "b"] "c") (list "a" "c")) -- (list [true false] true)
(in "ab" (list "ab" "a")) -- true
;; empty operands
(distinct (list)) -- ()
(except (list) (list 1)) -- ()
(except (list 1 [2]) (list)) -- (list 1 [2])
(sect (list 1 [2]) (list)) -- ()
(sect (list) (list 1)) -- ()
(union (list) (list 1 1 [2] [2])) -- (list 1 [2])
(union (list 1 1 [2]) (list)) -- (list 1 1 [2])
;; a typed left operand against a list: unboxed as before, an empty result typed
(except [1 2 3 2] (list 2.0 [3])) -- (list 1 3)
(except [1 2] (list 1 2.0)) -- (as 'I64 [])
(except TS (list 1 [2])) -- (list 0D00:00:00.000000002)
(except ['a 'b 'a] (list 'a)) -- (list (as 'SYM "b"))
(sect [1 2 2 3] (list 2 3.0 [1])) -- (list 2 2 3)
(sect I32 (list 1.0)) -- (list 1i)
(union [1 2] (list 2.0 3 [1])) -- (list 1 2 3 [1])
(except (list 1 2 [3]) [2 3]) -- (list 1 [3])
(sect (list 1 2 [3]) [2 3]) -- (list 2)
(union (list 1 [3]) [1 2 1]) -- (list 1 [3] 2)
(except (list 1 2 1 [1]) 1) -- (list 2 [1])
;; the same mixes past the cutoff
(in (list 3 [1 2] (list 1 [3 9])) (Z (list [1 2] 3 1))) -- (list true [true false] (list true [true false]))
(in [1 2 3] (Z (list 1 [2] 3.0))) -- [true false true]
(in TS (Z (list 1 2.0 1.4 (as 'TIMESPAN 2)))) -- [true true]
;; a TIMESPAN only on the left: its leaves round the numbers they meet
(in TS (list 1 2.0 1.4)) -- [true true]
(in TS (Z (list 1 2.0 1.4))) -- [true true]
(in (list 3 TS) (Z (list 1 2.0))) -- (list false [true true])
(in (list 3 (list 0 (as 'TIMESPAN 1))) (Z (list 1 2.0))) -- (list false [false true])
(in (list (as 'TIMESPAN 2) 1.6) (Z (list 2 (as 'TIME 1)))) -- [true false]
(in (list (as 'TIMESPAN 1) 1.4 [1 2]) (Z (list 1 (as 'TIMESPAN 2) TS))) -- (list true false [true true])
(in (list (as 'I64 []) 1) (Z (list 1))) -- (list (as 'B8 []) true)
(in (list "a" "b" 'a) (Z (list "a" 'b))) -- [true false false]
(in (list ["a" "b"] "c") (Z (list "a" "c"))) -- (list [true false] true)
(except [1 2 3 2] (Z (list 2.0 [3]))) -- (list 1 3)
(except [1 2] (Z (list 1 2.0))) -- (as 'I64 [])
(except TS (Z (list 1 [2]))) -- (list 0D00:00:00.000000002)
(except ['a 'b 'a] (Z (list 'a))) -- (list (as 'SYM "b"))
(sect [1 2 2 3] (Z (list 2 3.0 [1]))) -- (list 2 2 3)
(sect I32 (Z (list 1.0))) -- (list 1i)
(union [1 2] (Z (list 2.0 3 [1]))) -- (list 1 2 3 [1])
(union (list) (Z (list 1 1 [2] [2]))) -- (list 1 [2])
;; 20k cells with duplicates
(set VK (map (fn [i] (enlist (% i 1000))) (til 20000)))
(set AK (as 'LIST (% (til 20000) 1500)))
(set MK (concat VK (concat AK (map (fn [i] (as 'I32 (enlist i))) (til 500)))))
(count (distinct VK)) -- 1000
(take (distinct VK) 3) -- (list [0] [1] [2])
(count (distinct AK)) -- 1500
(count (distinct MK)) -- 3000
;; first-occurrence order: VK's 1000, AK's 1500, then the I32 cells (#1361)
(take (distinct MK) 2) -- (list [0] [1])
(at (distinct MK) 1000) -- 0
(at (distinct MK) 2499) -- 1499
(at (distinct MK) 2500) -- (as 'I32 [0])
(count (except VK (take VK 500))) -- 10000
(take (except VK (take VK 500)) 2) -- (list [500] [501])
(count (except MK (take VK 700))) -- 26500
(count (sect VK (take VK 300))) -- 6000
(count (sect MK (concat (take AK 10) (take VK 10)))) -- 340
(count (union (take VK 500) VK)) -- 1000
(count (union (take AK 100) MK)) -- 3000
(sum (raze (in VK (take VK 250)))) -- 0
(count (in VK (take VK 250))) -- 20000
(sum (in AK (take AK 100))) -- 1400
(sum (raze (in MK (take MK 1200)))) -- 0
(sum (in (% (til 20000) 3000) (take AK 2000))) -- 10500
;; Beside a TIMESPAN, a TIMESTAMP equals it by time of day (span_eval), so
;; the hash must agree past the cutoff too: tpd2 is tpd a day later.
(set tsd (as 'TIMESPAN 1000000000))
(set tpd (as 'TIMESTAMP 1000000000))
(set tpd2 (+ tpd 86400000000000))
(count (distinct (list tsd tpd tpd2))) -- 1
(count (distinct (Z (list tsd tpd tpd2)))) -- 1
(count (except (Z (list tpd tpd2)) (Z (list tsd)))) -- 0
(all (in (Z (list tpd tpd2)) (Z (list tsd)))) -- true
(count (sect (Z (list tpd2)) (Z (list tsd)))) -- 65
(count (distinct (Z (list tpd tpd2)))) -- 2
(.sys.exec "rm -rf /tmp/rfl_list_cell_sets_1314") -- 0
