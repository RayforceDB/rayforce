;; #1314: distinct, in, except, sect and union over LIST operands hash the
;; cells (ray_key_hash) and decide with atom_eq, the equality the nested
;; scans used.  Every expectation is the answer dev gave before the change.
;; Each rule runs small (the scan, below the cutoff) and padded past it
;; (Z appends 64 copies of the first cell, which changes no answer).
(.sys.exec "rm -rf /tmp/rfl_list_cell_sets_1314") -- 0
(.db.splayed.set "/tmp/rfl_list_cell_sets_1314/a/t/" (table [s] (list [a b c])) "/tmp/rfl_list_cell_sets_1314/a/sym")
(.db.splayed.set "/tmp/rfl_list_cell_sets_1314/b/t/" (table [s] (list [z y x c b a])) "/tmp/rfl_list_cell_sets_1314/b/sym")
(set N (at (.db.splayed.get "/tmp/rfl_list_cell_sets_1314/a/t/" "/tmp/rfl_list_cell_sets_1314/a/sym") 's))
(set M3 (take (at (.db.splayed.get "/tmp/rfl_list_cell_sets_1314/b/t/" "/tmp/rfl_list_cell_sets_1314/b/sym") 's) -3))
(set W [a b c])
(set G "8ec25d82-9ee6-44ef-b9d0-4971d6f97dd4")
(set TS (as 'TIMESPAN [1 2]))
(set I32 (as 'I32 [1 2]))
(set Z (fn [xs] (concat xs (at xs (* 0 (til 64))))))

;; rule 1: numeric atoms of different types meet through f64
(distinct (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3)) -- (list 1 2 3)
(distinct (Z (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3))) -- (list 1 2 3)
(in (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3) (list 1.0 (as 'I16 2))) -- [true true true true true true true false]
(in (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3) (Z (list 1.0 (as 'I16 2)))) -- [true true true true true true true false]
(in (list 1.0 (as 'I16 2)) (Z (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3))) -- [true true]
(except (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3) (list 1.0 (as 'I16 2))) -- (list 3)
(except (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3) (Z (list 1.0 (as 'I16 2)))) -- (list 3)
(except (list 1.0 (as 'I16 2)) (Z (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3))) -- ()
(sect (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3) (list 1.0 (as 'I16 2))) -- (list 1 1.0 1i 2 2e true 0x02)
(sect (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3) (Z (list 1.0 (as 'I16 2)))) -- (list 1 1.0 1i 2 2e true 0x02)
(sect (list 1.0 (as 'I16 2)) (Z (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3))) -- (list 1.0 2h)
(union (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3) (list 1.0 (as 'I16 2))) -- (list 1 1.0 1i 2 2e true 0x02 3)
(union (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3) (Z (list 1.0 (as 'I16 2)))) -- (list 1 1.0 1i 2 2e true 0x02 3)
(union (list 1.0 (as 'I16 2)) (Z (list 1 1.0 (as 'I32 1) 2 (as 'F32 2.0) true (as 'U8 2) 3))) -- (list 1.0 2h 3)
;; rule 2: numeric vector cells need the same type
(distinct (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1])) -- (list [1 2] [1i 2i] [1.0 2.0] [1h 2h] [2 1])
(distinct (Z (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]))) -- (list [1 2] [1i 2i] [1.0 2.0] [1h 2h] [2 1])
(in (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]) (list I32 [2.0 1.0])) -- (list [false false] [false false] [false false] [false false] [false false] [false false])
(in (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]) (Z (list I32 [2.0 1.0]))) -- (list [false false] [false false] [false false] [false false] [false false] [false false])
(in (list I32 [2.0 1.0]) (Z (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]))) -- (list [false false] [false false])
(except (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]) (list I32 [2.0 1.0])) -- (list [1 2] [1.0 2.0] [1 2] [1h 2h] [2 1])
(except (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]) (Z (list I32 [2.0 1.0]))) -- (list [1 2] [1.0 2.0] [1 2] [1h 2h] [2 1])
(except (list I32 [2.0 1.0]) (Z (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]))) -- (list [2.0 1.0])
(sect (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]) (list I32 [2.0 1.0])) -- (list [1i 2i])
(sect (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]) (Z (list I32 [2.0 1.0]))) -- (list [1i 2i])
(sect (list I32 [2.0 1.0]) (Z (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]))) -- (list [1i 2i])
(union (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]) (list I32 [2.0 1.0])) -- (list [1 2] [1i 2i] [1.0 2.0] [1 2] [1h 2h] [2 1] [2.0 1.0])
(union (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]) (Z (list I32 [2.0 1.0]))) -- (list [1 2] [1i 2i] [1.0 2.0] [1 2] [1h 2h] [2 1] [2.0 1.0])
(union (list I32 [2.0 1.0]) (Z (list [1 2] I32 [1.0 2.0] [1 2] (as 'I16 [1 2]) [2 1]))) -- (list [1i 2i] [2.0 1.0] [1 2] [1.0 2.0] [1h 2h] [2 1])
;; rule 3: a TIMESPAN vector meets a numeric vector element by element
(distinct (list TS [1 2] [1 3] (as 'TIMESPAN [1 3]))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 3])
(distinct (Z (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 3])
(in (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])) (list [1 2])) -- (list [false false] [false false] [false false] [false false])
(in (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])) (Z (list [1 2]))) -- (list [false false] [false false] [false false] [false false])
(in (list [1 2]) (Z (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])))) -- (list [false false])
(except (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])) (list [1 2])) -- (list [1 3] [0D00:00:00.000000001 0D00:00:00.000000003])
(except (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])) (Z (list [1 2]))) -- (list [1 3] [0D00:00:00.000000001 0D00:00:00.000000003])
(except (list [1 2]) (Z (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])))) -- ()
(sect (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])) (list [1 2])) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2])
(sect (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])) (Z (list [1 2]))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2])
(sect (list [1 2]) (Z (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])))) -- (list [1 2])
(union (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])) (list [1 2])) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1 3] [0D00:00:00.000000001 0D00:00:00.000000003])
(union (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])) (Z (list [1 2]))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1 3] [0D00:00:00.000000001 0D00:00:00.000000003])
(union (list [1 2]) (Z (list TS [1 2] [1 3] (as 'TIMESPAN [1 3])))) -- (list [1 2] [1 3])
;; rule 3b: not transitive, TIMESPAN first
(distinct (list TS [1 2] I32)) -- (list [0D00:00:00.000000001 0D00:00:00.000000002])
(distinct (Z (list TS [1 2] I32))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002])
(in (list TS [1 2] I32) (list [1 2] I32)) -- (list [false false] [false false] [false false])
(in (list TS [1 2] I32) (Z (list [1 2] I32))) -- (list [false false] [false false] [false false])
(in (list [1 2] I32) (Z (list TS [1 2] I32))) -- (list [false false] [false false])
(except (list TS [1 2] I32) (list [1 2] I32)) -- ()
(except (list TS [1 2] I32) (Z (list [1 2] I32))) -- ()
(except (list [1 2] I32) (Z (list TS [1 2] I32))) -- ()
(sect (list TS [1 2] I32) (list [1 2] I32)) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1i 2i])
(sect (list TS [1 2] I32) (Z (list [1 2] I32))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1i 2i])
(sect (list [1 2] I32) (Z (list TS [1 2] I32))) -- (list [1 2] [1i 2i])
(union (list TS [1 2] I32) (list [1 2] I32)) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1i 2i])
(union (list TS [1 2] I32) (Z (list [1 2] I32))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1i 2i])
(union (list [1 2] I32) (Z (list TS [1 2] I32))) -- (list [1 2] [1i 2i])
;; rule 3b: not transitive, I64 first
(distinct (list [1 2] TS I32)) -- (list [1 2] [1i 2i])
(distinct (Z (list [1 2] TS I32))) -- (list [1 2] [1i 2i])
(in (list [1 2] TS I32) (list TS)) -- (list [false false] [false false] [false false])
(in (list [1 2] TS I32) (Z (list TS))) -- (list [false false] [false false] [false false])
(in (list TS) (Z (list [1 2] TS I32))) -- (list [false false])
(except (list [1 2] TS I32) (list TS)) -- ()
(except (list [1 2] TS I32) (Z (list TS))) -- ()
(except (list TS) (Z (list [1 2] TS I32))) -- ()
(sect (list [1 2] TS I32) (list TS)) -- (list [1 2] [0D00:00:00.000000001 0D00:00:00.000000002] [1i 2i])
(sect (list [1 2] TS I32) (Z (list TS))) -- (list [1 2] [0D00:00:00.000000001 0D00:00:00.000000002] [1i 2i])
(sect (list TS) (Z (list [1 2] TS I32))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002])
(union (list [1 2] TS I32) (list TS)) -- (list [1 2] [0D00:00:00.000000001 0D00:00:00.000000002] [1i 2i])
(union (list [1 2] TS I32) (Z (list TS))) -- (list [1 2] [0D00:00:00.000000001 0D00:00:00.000000002] [1i 2i])
(union (list TS) (Z (list [1 2] TS I32))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002])
;; rule 3b: not transitive, I32 first
(distinct (list I32 [1 2] TS)) -- (list [1i 2i] [1 2])
(distinct (Z (list I32 [1 2] TS))) -- (list [1i 2i] [1 2])
(in (list I32 [1 2] TS) (list [1 2])) -- (list [false false] [false false] [false false])
(in (list I32 [1 2] TS) (Z (list [1 2]))) -- (list [false false] [false false] [false false])
(in (list [1 2]) (Z (list I32 [1 2] TS))) -- (list [false false])
(except (list I32 [1 2] TS) (list [1 2])) -- (list [1i 2i])
(except (list I32 [1 2] TS) (Z (list [1 2]))) -- (list [1i 2i])
(except (list [1 2]) (Z (list I32 [1 2] TS))) -- ()
(sect (list I32 [1 2] TS) (list [1 2])) -- (list [1 2] [0D00:00:00.000000001 0D00:00:00.000000002])
(sect (list I32 [1 2] TS) (Z (list [1 2]))) -- (list [1 2] [0D00:00:00.000000001 0D00:00:00.000000002])
(sect (list [1 2]) (Z (list I32 [1 2] TS))) -- (list [1 2])
(union (list I32 [1 2] TS) (list [1 2])) -- (list [1i 2i] [1 2] [0D00:00:00.000000001 0D00:00:00.000000002])
(union (list I32 [1 2] TS) (Z (list [1 2]))) -- (list [1i 2i] [1 2] [0D00:00:00.000000001 0D00:00:00.000000002])
(union (list [1 2]) (Z (list I32 [1 2] TS))) -- (list [1 2] [1i 2i])
;; rule 3b: not transitive, I32 then TIMESPAN then I64
(distinct (list I32 TS [1 2])) -- (list [1i 2i] [1 2])
(distinct (Z (list I32 TS [1 2]))) -- (list [1i 2i] [1 2])
(in (list I32 TS [1 2]) (list I32 TS)) -- (list [false false] [false false] [false false])
(in (list I32 TS [1 2]) (Z (list I32 TS))) -- (list [false false] [false false] [false false])
(in (list I32 TS) (Z (list I32 TS [1 2]))) -- (list [false false] [false false])
(except (list I32 TS [1 2]) (list I32 TS)) -- ()
(except (list I32 TS [1 2]) (Z (list I32 TS))) -- ()
(except (list I32 TS) (Z (list I32 TS [1 2]))) -- ()
(sect (list I32 TS [1 2]) (list I32 TS)) -- (list [1i 2i] [0D00:00:00.000000001 0D00:00:00.000000002] [1 2])
(sect (list I32 TS [1 2]) (Z (list I32 TS))) -- (list [1i 2i] [0D00:00:00.000000001 0D00:00:00.000000002] [1 2])
(sect (list I32 TS) (Z (list I32 TS [1 2]))) -- (list [1i 2i] [0D00:00:00.000000001 0D00:00:00.000000002])
(union (list I32 TS [1 2]) (list I32 TS)) -- (list [1i 2i] [0D00:00:00.000000001 0D00:00:00.000000002] [1 2])
(union (list I32 TS [1 2]) (Z (list I32 TS))) -- (list [1i 2i] [0D00:00:00.000000001 0D00:00:00.000000002] [1 2])
(union (list I32 TS) (Z (list I32 TS [1 2]))) -- (list [1i 2i] [0D00:00:00.000000001 0D00:00:00.000000002])
;; rule 4: SYM cells compare by text across domains and widths
(distinct (list N W (reverse M3) [a b d] M3 [a b])) -- (list (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "d")) (as 'SYM (list "c" "b" "a")) (as 'SYM (list "a" "b")))
(distinct (Z (list N W (reverse M3) [a b d] M3 [a b]))) -- (list (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "d")) (as 'SYM (list "c" "b" "a")) (as 'SYM (list "a" "b")))
(in (list N W (reverse M3) [a b d] M3 [a b]) (list W)) -- (list [false false false] [false false false] [false false false] [false false false] [false false false] [false false])
(in (list N W (reverse M3) [a b d] M3 [a b]) (Z (list W))) -- (list [false false false] [false false false] [false false false] [false false false] [false false false] [false false])
(in (list W) (Z (list N W (reverse M3) [a b d] M3 [a b]))) -- (list [false false false])
(except (list N W (reverse M3) [a b d] M3 [a b]) (list W)) -- (list (as 'SYM (list "a" "b" "d")) (as 'SYM (list "c" "b" "a")) (as 'SYM (list "a" "b")))
(except (list N W (reverse M3) [a b d] M3 [a b]) (Z (list W))) -- (list (as 'SYM (list "a" "b" "d")) (as 'SYM (list "c" "b" "a")) (as 'SYM (list "a" "b")))
(except (list W) (Z (list N W (reverse M3) [a b d] M3 [a b]))) -- ()
(sect (list N W (reverse M3) [a b d] M3 [a b]) (list W)) -- (list (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "c")))
(sect (list N W (reverse M3) [a b d] M3 [a b]) (Z (list W))) -- (list (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "c")))
(sect (list W) (Z (list N W (reverse M3) [a b d] M3 [a b]))) -- (list (as 'SYM (list "a" "b" "c")))
(union (list N W (reverse M3) [a b d] M3 [a b]) (list W)) -- (list (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "d")) (as 'SYM (list "c" "b" "a")) (as 'SYM (list "a" "b")))
(union (list N W (reverse M3) [a b d] M3 [a b]) (Z (list W))) -- (list (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "d")) (as 'SYM (list "c" "b" "a")) (as 'SYM (list "a" "b")))
(union (list W) (Z (list N W (reverse M3) [a b d] M3 [a b]))) -- (list (as 'SYM (list "a" "b" "c")) (as 'SYM (list "a" "b" "d")) (as 'SYM (list "c" "b" "a")) (as 'SYM (list "a" "b")))
;; rule 5: STR atoms compare by bytes
(distinct (list "a" "a" "b" "" 'a "ab")) -- (list "a" "b" "" (as 'SYM "a") "ab")
(distinct (Z (list "a" "a" "b" "" 'a "ab"))) -- (list "a" "b" "" (as 'SYM "a") "ab")
(in (list "a" "a" "b" "" 'a "ab") (list "a" 'b)) -- [true true false false false false]
(in (list "a" "a" "b" "" 'a "ab") (Z (list "a" 'b))) -- [true true false false false false]
(in (list "a" 'b) (Z (list "a" "a" "b" "" 'a "ab"))) -- [true false]
(except (list "a" "a" "b" "" 'a "ab") (list "a" 'b)) -- (list "b" "" (as 'SYM "a") "ab")
(except (list "a" "a" "b" "" 'a "ab") (Z (list "a" 'b))) -- (list "b" "" (as 'SYM "a") "ab")
(except (list "a" 'b) (Z (list "a" "a" "b" "" 'a "ab"))) -- (list (as 'SYM "b"))
(sect (list "a" "a" "b" "" 'a "ab") (list "a" 'b)) -- (list "a" "a")
(sect (list "a" "a" "b" "" 'a "ab") (Z (list "a" 'b))) -- (list "a" "a")
(sect (list "a" 'b) (Z (list "a" "a" "b" "" 'a "ab"))) -- (list "a")
(union (list "a" "a" "b" "" 'a "ab") (list "a" 'b)) -- (list "a" "a" "b" "" (as 'SYM "a") "ab" (as 'SYM "b"))
(union (list "a" "a" "b" "" 'a "ab") (Z (list "a" 'b))) -- (list "a" "a" "b" "" (as 'SYM "a") "ab" (as 'SYM "b"))
(union (list "a" 'b) (Z (list "a" "a" "b" "" 'a "ab"))) -- (list "a" (as 'SYM "b") "b" "" (as 'SYM "a") "ab")
