;; ray_key_hash under RAY_KEY_SPAN_VEC (a TIMESPAN vector cell present):
;; a vector atom_eq can call equal to a TIMESPAN vector hashes its length
;; and each element as the number span_eval compares (TIME as ns, a
;; TIMESTAMP by time of day, floats rounded, every null alike); SYM, STR,
;; DATE and GUID vectors keep their content hash.  The set expectations
;; are dev's answers, where every such vector hashed to 0 (the scan).
;; Each rule runs small and padded past the cutoff (Z appends 64 copies of
;; the first cell, which changes no answer).
(set TS (as 'TIMESPAN [1 2]))
(set I32 (as 'I32 [1 2]))
(set MS (as 'TIMESPAN [1000000 2000000]))
(set TM (as 'TIME [1 2]))
(set SEC (as 'TIMESPAN [1000000000 2000000000]))
(set TP [2024.01.01D00:00:01.000000000 2024.01.02D00:00:02.000000000])
(set TPB [1999.12.31D00:00:01.000000000 1990.06.01D00:00:02.000000000])
(set TSN (as 'TIMESPAN (concat 0Nl 1)))
(set Z (fn [xs] (concat xs (at xs (* 0 (til 64))))))
;; numeric vectors equal by element
(distinct (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1])) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1.5 2.0] [2 1])
(distinct (Z (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1.5 2.0] [2 1])
(distinct (list [2 1] [1.5 2.0] (as 'F32 [1.0 2.0]) (as 'I16 [1 2]) [1.0 2.0] I32 [1 2] TS)) -- (list [2 1] [1.5 2.0] [1e 2e] [1h 2h] [1.0 2.0] [1i 2i] [1 2])
(distinct (Z (list [2 1] [1.5 2.0] (as 'F32 [1.0 2.0]) (as 'I16 [1 2]) [1.0 2.0] I32 [1 2] TS))) -- (list [2 1] [1.5 2.0] [1e 2e] [1h 2h] [1.0 2.0] [1i 2i] [1 2])
(in (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]) (list [1 2] I32)) -- (list [false false] [false false] [false false] [false false] [false false] [false false] [false false] [false false])
(in (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]) (Z (list [1 2] I32))) -- (list [false false] [false false] [false false] [false false] [false false] [false false] [false false] [false false])
(except (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]) (list [1 2] I32)) -- (list [1.0 2.0] [1h 2h] [1e 2e] [1.5 2.0] [2 1])
(except (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]) (Z (list [1 2] I32))) -- (list [1.0 2.0] [1h 2h] [1e 2e] [1.5 2.0] [2 1])
(sect (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]) (list [1 2] I32)) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1i 2i])
(sect (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]) (Z (list [1 2] I32))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1i 2i])
(union (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]) (list [1 2] I32)) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1i 2i] [1.0 2.0] [1h 2h] [1e 2e] [1.5 2.0] [2 1])
(union (list TS [1 2] I32 [1.0 2.0] (as 'I16 [1 2]) (as 'F32 [1.0 2.0]) [1.5 2.0] [2 1]) (Z (list [1 2] I32))) -- (list [0D00:00:00.000000001 0D00:00:00.000000002] [1 2] [1i 2i] [1.0 2.0] [1h 2h] [1e 2e] [1.5 2.0] [2 1])
(in (list [2 1] [1.5 2.0] (as 'F32 [1.0 2.0]) (as 'I16 [1 2]) [1.0 2.0] I32 [1 2] TS) (list TS)) -- (list [false false] [false false] [false false] [false false] [false false] [false false] [false false] [false false])
