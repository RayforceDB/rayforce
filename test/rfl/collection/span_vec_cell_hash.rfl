(except (list [2 1] [1.5 2.0] (as 'F32 [1.0 2.0]) (as 'I16 [1 2]) [1.0 2.0] I32 [1 2] TS) (Z (list TS))) -- (list [2 1] [1.5 2.0])
(sect (list [2 1] [1.5 2.0] (as 'F32 [1.0 2.0]) (as 'I16 [1 2]) [1.0 2.0] I32 [1 2] TS) (list TS)) -- (list [1e 2e] [1h 2h] [1.0 2.0] [1i 2i] [1 2] [0D00:00:00.000000001 0D00:00:00.000000002])
(sect (list [2 1] [1.5 2.0] (as 'F32 [1.0 2.0]) (as 'I16 [1 2]) [1.0 2.0] I32 [1 2] TS) (Z (list TS))) -- (list [1e 2e] [1h 2h] [1.0 2.0] [1i 2i] [1 2] [0D00:00:00.000000001 0D00:00:00.000000002])
(union (list [2 1] [1.5 2.0] (as 'F32 [1.0 2.0]) (as 'I16 [1 2]) [1.0 2.0] I32 [1 2] TS) (list TS)) -- (list [2 1] [1.5 2.0] [1e 2e] [1h 2h] [1.0 2.0] [1i 2i] [1 2] [0D00:00:00.000000001 0D00:00:00.000000002])
