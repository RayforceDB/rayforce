E -- [3 4 2 3 2 2 3 3 4 3 5 2 5 4]
(set GI (fold concat (map (fn [i] (+ i (* 0 (til (count (at CS i)))))) (til NG))))
(set T (table [g c r] (list GI C (til (count C)))))
(at (select {from: T by: g n: (count (distinct c))}) 'n) -- E
(raze (map (fn [k] (at (select {from: T where: (== g k) n: (count (distinct c))}) 'n)) (til NG))) -- E
;; copies of each group's first cell change no count
(set CP (map (fn [k] (Z (at CS k))) (til NG)))
(set TP2 (table [g c] (list (fold concat (map (fn [i] (+ i (* 0 (til (count (at CP i)))))) (til NG))) (fold concat CP))))
(at (select {from: TP2 by: g n: (count (distinct c))}) 'n) -- E
;; by: a LIST column groups as `group` does; W, equal to no cell, keeps the column a LIST
(set W (as 'I16 [9 9 9 9 9]))
(set BY (fn [cells] (drop (at (select {from: (table [c r] (list (concat (list W) cells) (til (+ 1 (count cells))))) by: c n: (count r)}) 'n) 1)))
(map (fn [k] (BY (at CS k))) (til NG)) -- (map (fn [k] (map count (value (group (at CS k))))) (til NG))
(map (fn [k] (count (BY (at CS k)))) (til NG)) -- E
;; past the parallel directory's row floor
(set BIG (map (fn [i] (list 'x i)) (til 70000)))
(set BB (map (fn [k] (BY (concat (at CS k) BIG))) (til NG)))
(map count BB) -- (+ E 70000)
(map (fn [k] (take (at BB k) (at E k))) (til NG)) -- (map (fn [k] (map count (value (group (at CS k))))) (til NG))
