;; @requires: posix  (fixtures/checks run through a POSIX shell via .sys.exec)
;; take over a parted table handle (.db.parted.get): the parted columns and
;; the MAPCOMMON partition key are not dense vectors, so the table arm of
;; take materializes just the rows it needs (head or tail window, or all
;; rows when the count wraps) and then answers exactly as for the flat table
;; with the same rows (#855).
(.sys.exec "rm -rf /tmp/rfl_take_parted")
;; partition 2024.01.02 lacks the b and name columns (NULL segments, read
;; back as typed nulls); c carries i64 nulls.
(.db.splayed.set "/tmp/rfl_take_parted/2024.01.01/t/" (table [a s c b name] (list [1 2] [x y] [10 0Nl] [0.5 1.5] (list "alpha" "beta"))))
(.db.splayed.set "/tmp/rfl_take_parted/2024.01.02/t/" (table [a s c] (list [3 4 5] [z w v] [0Nl 40 50])))
(.db.splayed.set "/tmp/rfl_take_parted/2024.01.03/t/" (table [a s c b name] (list [6 7] [u x] [60 70] [6.5 7.5] (list "gamma" "delta"))))
(set _tp (.db.parted.get "/tmp/rfl_take_parted/" 't))
(set _tf (table [date a s c b name] (list [2024.01.01 2024.01.01 2024.01.02 2024.01.02 2024.01.02 2024.01.03 2024.01.03] [1 2 3 4 5 6 7] [x y z w v u x] [10 0Nl 0Nl 40 50 60 70] [0.5 1.5 0Nf 0Nf 0Nf 6.5 7.5] (list "alpha" "beta" "" "" "" "gamma" "delta"))))
(count _tp) -- 7

;; the issue's repro: head and tail
(count (take _tp 2)) -- 2
(at (take _tp 2) 'a) -- [1 2]
(at (take _tp -2) 'a) -- [6 7]
(take _tp 2) -- (at _tp (til 2))
(take _tp -2) -- (at _tp [5 6])

;; same rows as the flat table, crossing partition boundaries
(take _tp 3) -- (take _tf 3)
(take _tp -4) -- (take _tf -4)
(take _tp 7) -- (take _tf 7)
(take _tp -7) -- (take _tf -7)

;; the partition key, sym and string columns
(at (take _tp 3) 'date) -- [2024.01.01 2024.01.01 2024.01.02]
(at (take _tp -3) 'date) -- [2024.01.02 2024.01.03 2024.01.03]
(at (take _tp 3) 's) -- ['x 'y 'z]
(at (take _tp -3) 's) -- ['v 'u 'x]
(at (take _tp 2) 'name) -- (list "alpha" "beta")
(at (take _tp -2) 'name) -- (list "gamma" "delta")

;; nulls in a column and in the partition without the column stay null
(at (take _tp 4) 'c) -- [10 0Nl 0Nl 40]
(nil? (at (at (take _tp 2) 'c) 1)) -- true
(at (take _tp -5) 'b) -- [0Nf 0Nf 0Nf 6.5 7.5]
(nil? (at (at (take _tp -5) 'name) 0)) -- true
(at (at (take _tp -5) 'name) 3) -- "gamma"

;; zero rows keeps the schema
(count (take _tp 0)) -- 0
(take _tp 0) -- (take _tf 0)

;; a count past the row count wraps, as for flat tables and vectors
(count (take _tp 9)) -- 9
(take _tp 9) -- (take _tf 9)
(take _tp -9) -- (take _tf -9)
(at (take _tp 9) 'date) -- [2024.01.01 2024.01.01 2024.01.02 2024.01.02 2024.01.02 2024.01.03 2024.01.03 2024.01.01 2024.01.01]

;; range take [start amount]
(take _tp [1 3]) -- (take _tf [1 3])
(take _tp [-3 2]) -- (take _tf [-3 2])
(take _tp [5 10]) -- (take _tf [5 10])
(count (take _tp [7 2])) -- 0
;; at by rows reads the partitions that hold them, nothing flattened:
;; any order, repeats, a row of the partition without b and name, and the
;; single-row forms, exactly as the flat table answers
(at _tp [6 0 3 3 1]) -- (at _tf [6 0 3 3 1])
(at _tp [1 2 4]) -- (at _tf [1 2 4])
(at _tp [4 3 2 1 0]) -- (at _tf [4 3 2 1 0])
(at _tp (where (> (at _tp 'a) 2))) -- (at _tf (where (> (at _tf 'a) 2)))
(at _tp 3) -- (at _tf 3)
(at _tp 0) -- (at _tf 0)
(first _tp) -- (first _tf)
(last _tp) -- (last _tf)
(at _tp 7) !- domain
(at _tp [0 7]) !- domain
;; a whole column: dense segments copied, nulls kept
(at _tp 'a) -- (at _tf 'a)
(at _tp 'c) -- (at _tf 'c)
(at _tp 'b) -- (at _tf 'b)
(.sys.exec "rm -rf /tmp/rfl_take_parted")

;; take over a compressed (generation 2) table: an encoded column is read
;; for the rows taken only, and every form answers exactly as for the same
;; table saved plain.
(.sys.exec "rm -rf /tmp/rfl_take_gen2")
(set _gi (til 70000))
(set _gt (table [a b s] (list (* (- (% _gi 1000) 500) 7919) (* 0.5 (as 'F64 (% _gi 301))) (as 'SYM (at ["red" "green" "blue" "cyan"] (% _gi 4))))))
(.db.splayed.set "/tmp/rfl_take_gen2/c/" _gt "/tmp/rfl_take_gen2/c.sym" {compress: true})
(.db.splayed.set "/tmp/rfl_take_gen2/p/" _gt "/tmp/rfl_take_gen2/p.sym")
(set _gc (.db.splayed.get "/tmp/rfl_take_gen2/c/" "/tmp/rfl_take_gen2/c.sym"))
(set _gp (.db.splayed.get "/tmp/rfl_take_gen2/p/" "/tmp/rfl_take_gen2/p.sym"))
(take _gc 5) -- (take _gp 5)
(take _gc -5) -- (take _gp -5)
(take _gc 0) -- (take _gp 0)
(take _gc 70000) -- (take _gp 70000)
(take _gc -70000) -- (take _gp -70000)
(take _gc 70003) -- (take _gp 70003)
(take _gc [3 4]) -- (take _gp [3 4])
(take _gc [-3 10]) -- (take _gp [-3 10])
(take _gc [69998 10]) -- (take _gp [69998 10])
(take _gc [70000 2]) -- (take _gp [70000 2])
(take _gc [66000 8000]) -- (take _gp [66000 8000])
(at (take _gc -2) 'a) -- [3943662 3951581]
;; at by rows on the compressed table reads the rows' vectors only
(at _gc [69999 5 5 40000 0]) -- (at _gp [69999 5 5 40000 0])
(at _gc 12345) -- (at _gp 12345)
(first _gc) -- (first _gp)
;; and on compressed partitions of it (the partition key the only extra column)
(.db.splayed.set "/tmp/rfl_take_gen2/z/2024.01.01/t/" (take _gt [0 30000]) "/tmp/rfl_take_gen2/z/.sym" {compress: true})
(.db.splayed.set "/tmp/rfl_take_gen2/z/2024.01.02/t/" (take _gt [30000 25000]) "/tmp/rfl_take_gen2/z/.sym" {compress: true})
(.db.splayed.set "/tmp/rfl_take_gen2/z/2024.01.03/t/" (take _gt [55000 15000]) "/tmp/rfl_take_gen2/z/.sym" {compress: true})
(set _gz (.db.parted.get "/tmp/rfl_take_gen2/z/" 't))
(set _gzr (fn [r] (select {a: a b: b s: s from: r})))
(_gzr (at _gz [69999 29999 30000 5 5 54999 55000])) -- (at _gp [69999 29999 30000 5 5 54999 55000])
(_gzr (at _gz (til 70000))) -- _gp
(at (at _gz [29999 30000 69999]) 'date) -- [2024.01.01 2024.01.02 2024.01.03]
(at _gz 54999) -- (at (at _gz [54999]) 0)
(.sys.exec "rm -rf /tmp/rfl_take_gen2")
