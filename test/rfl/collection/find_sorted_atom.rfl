;; Scalar-atom find on sorted and unsorted integer vectors: hand-computed
;; answers, not route proof (test/test_idx_route.c pins the routes).
;; [0..5 5 5 6..50 50 51..99]: 5 repeats at rows 5-7, 50 at rows 52-53.
(set s (.attr.set 'sorted (asc (concat (til 100) [5 5 50]))))
(find s 0) -- 0
(find s 5) -- 5
(find s 50) -- 52
(find s 99) -- 102
(type (find s 99)) -- 'i64
;; Misses below, above and inside the range are a typed null.
(find s -1) -- 0Nl
(find s 100) -- 0Nl
(find (.attr.set 'sorted [1 3 5 7]) 4) -- 0Nl
(type (find s 100)) -- 'i64
(find s 0Nl) -- 0Nl
;; The same values unmarked answer the same.
(find (.attr.drop s) 50) -- 52
(find (.attr.drop s) 100) -- 0Nl
(find (reverse (.attr.drop s)) 50) -- 49
;; Each integer width, same-type atoms.
(set s8 (.attr.set 'sorted (asc (as 'U8 (concat (til 256) [200])))))
(find s8 (as 'U8 200)) -- 200
(find s8 (as 'U8 255)) -- 256
(find s8 (as 'U8 0)) -- 0
(set s16 (.attr.set 'sorted (as 'I16 (- (til 100) 50))))
(find s16 (as 'I16 -50)) -- 0
(find s16 (as 'I16 49)) -- 99
(find s16 (as 'I16 50)) -- 0Nl
(set s32 (.attr.set 'sorted (as 'I32 (* 2 (til 100)))))
(find s32 (as 'I32 98)) -- 49
(find s32 (as 'I32 97)) -- 0Nl
;; Mixed widths and floats keep their numeric comparison.
(find s32 98) -- 49
(find s32 98.0) -- 49
(find s8 200) -- 200
(find s 50.0) -- 52
(find (.attr.set 'sorted [1.0 2.0 3.0]) 2.0) -- 1
;; Empty and one-row sorted vectors; a hash index keeps its answer.
(find (.attr.set 'sorted (as 'I64 [])) 2) -- 0Nl
(find (.attr.set 'sorted [7]) 7) -- 0
(find (.attr.set 'sorted [7]) 8) -- 0Nl
(find (.idx.hash s) 50) -- 52
;; A take of the sorted vector (not marked sorted) answers within its own rows.
(find (take s 10) 5) -- 5
(find (take s 10) 50) -- 0Nl
