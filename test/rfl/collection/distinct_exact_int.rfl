;; #1333: keep representatives in input order before the legacy atom reorder.
(set p (as 'LIST (+ 10 (til 80))))
(set a 9007199254740993)
(set b 9007199254740992)
(set f 9007199254740992.0)
(identical (distinct (concat p (list a f b))) (concat p (list a b))) -- true
(identical (distinct (concat p (list f a b))) (concat p (list f))) -- true
(identical (distinct (concat p (list (list a) (list f) (list b)))) (concat p (list (list a) (list b)))) -- true
(identical (distinct (concat p (list (as 'TIMESPAN 2) 2 3))) (concat p (list (as 'TIMESPAN 2) 3))) -- true
(identical (distinct (list [1 2] [3 4] 'a [1 2] 'b [5 6] 'a 'b)) (list 'a 'b [1 2] [3 4] [5 6])) -- true
;; Compare against a small-integer control to tolerate slower instrumented builds.
(set ids (% (til 200000) 5000))
(set B 4611686018427387904)
(set small (concat (as 'LIST ids) (list 'marker)))
(set wide (concat (as 'LIST (+ B ids)) (list 'marker)))
(identical (distinct wide) (concat (as 'LIST (+ B (til 5000))) (list 'marker))) -- true
(set best (fn [f] (min (map (fn [i] (f)) (til 3)))))
(< (best (fn [] (timeit (distinct wide)))) (* 8 (+ 1.0 (best (fn [] (timeit (distinct small))))))) -- true
