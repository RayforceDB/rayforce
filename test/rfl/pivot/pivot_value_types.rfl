;; ---- first/last over a column with a null (row 4 opens cell c/x, row 5
;; closes it): OP_PIVOT skips nulls, the builtin only for I64/F64/F32,
;; so these columns take the generic route; flat table
(set R (pivot W 'k 'p 'fI16 first))
(identical R (table (as 'SYM (list "k" "x" "y")) (list (as 'SYM (list "a" "b" "c")) [1h 3h 0Nh] [2h 4h 0Nh]))) -- true
(set R (pivot W 'k 'p 'lI16 last))
(identical R (table (as 'SYM (list "k" "x" "y")) (list (as 'SYM (list "a" "b" "c")) [1h 3h 0Nh] [2h 4h 0Nh]))) -- true
(identical (pivot W 'k 'p 'fI16 first) (pivot W 'k 'p 'fI16 (fn [x] (first x)))) -- true
(identical (pivot W 'k 'p 'lI16 last) (pivot W 'k 'p 'lI16 (fn [x] (last x)))) -- true
