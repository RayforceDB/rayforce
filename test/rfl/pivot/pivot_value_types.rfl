;; GUID index
(set R (pivot P 'kGUID 'p 'n sum))
(identical R (table (as 'SYM (list "kGUID" "x" "y")) (list (as 'GUID (list (as 'GUID "00000007-1111-1111-1111-111111111111") (as 'GUID "00000003-1111-1111-1111-111111111111") (as 'GUID "00000005-1111-1111-1111-111111111111"))) [1 3 11] [2 4 0Nl]))) -- true
(set R (pivot P 'kGUID 'p 'n med))
(identical R (table (as 'SYM (list "kGUID" "x" "y")) (list (as 'GUID (list (as 'GUID "00000007-1111-1111-1111-111111111111") (as 'GUID "00000003-1111-1111-1111-111111111111") (as 'GUID "00000005-1111-1111-1111-111111111111"))) [1.0 3.0 5.5] [2.0 4.0 0Nf]))) -- true
(identical (pivot P 'kGUID 'p 'n sum) (pivot P 'kGUID 'p 'n (fn [x] (sum x)))) -- true
;; LIST index
(set R (pivot P 'kLIST 'p 'n sum))
(identical R (table (as 'SYM (list "kLIST" "x" "y")) (list (list [7 1] [3] [5 5]) [1 3 11] [2 4 0Nl]))) -- true
(set R (pivot P 'kLIST 'p 'n med))
(identical R (table (as 'SYM (list "kLIST" "x" "y")) (list (list [7 1] [3] [5 5]) [1.0 3.0 5.5] [2.0 4.0 0Nf]))) -- true
(identical (pivot P 'kLIST 'p 'n sum) (pivot P 'kLIST 'p 'n (fn [x] (sum x)))) -- true
;; ---- generic route: rows with a null index key all reach their group
(set T (table [k p v] (list [0Nl 0Nl 0Nl 1 0Nl] [x x x x y] [1 2 3 4 5])))
(set R (pivot T 'k 'p 'v med))
(identical R (table (as 'SYM (list "k" "x" "y")) (list [0Nl 1] [2.0 4.0] [5.0 0Nf]))) -- true
(set R (pivot T 'k 'p 'v (fn [x] (sum x))))
(identical R (table (as 'SYM (list "k" "x" "y")) (list [0Nl 1] [6 4] [5 0Nl]))) -- true
;; ---- generic route: results of mixed types, or vectors, box like select by:
(set T (table [k p v] (list [a a b b] [x x x y] [1 2 3 4])))
(set R (pivot T 'k 'p 'v (fn [x] (if (> (count x) 1) 1.5 2))))
;; (list 1.5 2) would build an F64 vector: pin the boxed cells one by one
(type (at R 'x)) -- 'LIST
(identical (at (at R 'x) 0) 1.5) -- true
(identical (at (at R 'x) 1) 2) -- true
(identical (at R 'y) [0Nl 2]) -- true
(set R (pivot T 'k 'p 'v (fn [x] x)))
(identical (at R 'x) (list [1 2] [3])) -- true
(type (at R 'y)) -- 'LIST
(identical (at (at R 'y) 0) null) -- true
(identical (at (at R 'y) 1) [4]) -- true
(.sys.exec "rm -rf /tmp/rfl_pivot_value_types")
