;; ---- an F64 index key whose first row holds -0.0 reads 0.0 on both routes
(set R (pivot P 'z 'p 'n med))
(identical R (table (as 'SYM (list "z" "x" "y")) (list [-0.0] [4.0] [3.0]))) -- true
;; identical does not tell -0.0 from 0.0; the printed key does
(repr (at R 'z)) -- "[0.0]"
(set R (pivot P 'z 'p 'n sum))
(identical R (table (as 'SYM (list "z" "x" "y")) (list [0.0] [15] [6]))) -- true
(repr (at R 'z)) -- "[0.0]"
