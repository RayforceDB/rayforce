;; (date 'local) and (timestamp 'local) follow the process time zone.
;; (date 'local) was one day behind east of UTC and (timestamp 'local) was
;; identical to (timestamp 'global).  The offset checks allow 2 s of clock
;; movement between the two reads.

;; UTC+14: local wall clock is 14 h ahead of the global timestamp.
(.os.setenv "TZ" "Etc/GMT-14")
(< (abs (- (- (as 'I64 (timestamp 'local)) (as 'I64 (timestamp 'global))) 50400000000000)) 2000000000) -- true
;; The local date matches the local timestamp's day, not the UTC instant of local midnight.
(== (as 'I64 (date 'local)) (div (as 'I64 (timestamp 'local)) 86400000000000)) -- true

;; UTC-11: local wall clock is 11 h behind.
(.os.setenv "TZ" "Etc/GMT+11")
(< (abs (- (- (as 'I64 (timestamp 'local)) (as 'I64 (timestamp 'global))) -39600000000000)) 2000000000) -- true
(== (as 'I64 (date 'local)) (div (as 'I64 (timestamp 'local)) 86400000000000)) -- true

;; UTC: local equals global.
(.os.setenv "TZ" "UTC")
(< (abs (- (as 'I64 (timestamp 'local)) (as 'I64 (timestamp 'global)))) 2000000000) -- true
(== (as 'I64 (date 'local)) (as 'I64 (date 'global))) -- true
