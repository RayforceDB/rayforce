(set orders (table [customer qty]
    (list (list "alice" "bob" "carol") [10 20 30])))

(set accounts (table [customer region]
    (list (list "alice" "carol" "dave") [east west north])))

;; String columns are valid join keys.
(show (inner-join [customer] orders accounts))
(show (left-join [customer] orders accounts))
